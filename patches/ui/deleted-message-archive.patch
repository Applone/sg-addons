+import AccountContext
+import Display
+import Foundation
+import Postbox
+import QuickLook
+import SGAdditionalCore
+import SGStrings
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import TextFormat
+import UIKit
+import UniformTypeIdentifiers
+import UniversalMediaPlayer
+
+private func archiveTitle(_ key: String, _ context: AccountContext) -> String {
+    i18n("Additional.Archive" + key, context.sharedContext.currentPresentationData.with { $0.strings.baseLanguageCode })
+}
+
+public func additionalClearArchivesConfirmation(
+    context: AccountContext, account: String?, chat: String? = nil, present: @escaping (ViewController) -> Void
+) {
+    let data = context.sharedContext.currentPresentationData.with { $0 }
+    let sheet = ActionSheetController(presentationData: data)
+    let title = chat == nil ? "ClearAll" : "ClearChat"
+    let notice = chat != nil ? "ClearChatNotice" : account == nil ? "ClearAllNotice" : "ClearAccountNotice"
+    let confirmation = ActionSheetButtonItem(
+        title: archiveTitle(title, context), color: .destructive,
+        action: { [weak sheet] in
+            sheet?.dismissAnimated()
+            let _ =
+                (context.sharedContext.activeAccountsWithInfo |> take(1)
+                |> mapToSignal { info -> Signal<[Bool], NoError> in
+                    let accounts = info.accounts.filter {
+                        account == nil || additionalAccountKey($0.account.peerId) == account
+                    }
+                    guard !accounts.isEmpty else { return .single([]) }
+                    return combineLatest(accounts.map { additionalPurgeArchive(account: $0.account, chat: chat) })
+                } |> deliverOnMainQueue).startStandalone(next: { results in
+                    if results.isEmpty || results.contains(false) {
+                        present(
+                            additionalError(
+                                context: context, error: SettingsError.invalid(archiveTitle("PurgeFailed", context))))
+                    }
+                })
+        })
+    sheet.setItemGroups([
+        ActionSheetItemGroup(items: [ActionSheetTextItem(title: archiveTitle(notice, context)), confirmation]),
+        ActionSheetItemGroup(items: [
+            ActionSheetButtonItem(
+                title: data.strings.Common_Cancel, color: .accent,
+                action: { [weak sheet] in sheet?.dismissAnimated() })
+        ]),
+    ])
+    present(sheet)
+}
+
+public func additionalDeletedMessagesController(context: AccountContext, chat: String) -> ViewController {
+    AdditionalDeletedMessagesController(context: context, chat: chat)
+}
+
+private final class AdditionalDeletedMessagesController: ViewController, UITableViewDataSource, UITableViewDelegate,
+    UISearchBarDelegate
+{
+    private let context: AccountContext
+    private let chat: String
+    private var presentation: PresentationData
+    private let table = UITableView(frame: .zero, style: .plain)
+    private let search = UISearchBar()
+    private let notice = UILabel()
+    private let timestamp = DateFormatter()
+    private let presentationSubscription = MetaDisposable()
+    private var archiveObserver: NSObjectProtocol?
+    private var entries: [ArchivedMessageEntry] = []
+    private var cursor: ArchiveCursor?
+    private var request = 0
+    private var loading = false
+    private var searching = false
+    private var refreshScheduled = false
+
+    init(context: AccountContext, chat: String) {
+        self.context = context
+        self.chat = chat
+        presentation = context.sharedContext.currentPresentationData.with { $0 }
+        super.init(
+            navigationBarPresentationData: NavigationBarPresentationData(
+                theme: NavigationBarTheme(rootControllerTheme: presentation.theme),
+                strings: NavigationBarStrings(presentationStrings: presentation.strings)))
+        title = archiveTitle("Title", context)
+        timestamp.dateStyle = .short
+        timestamp.timeStyle = .short
+        updateNavigation()
+    }
+
+    required init(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+
+    deinit {
+        presentationSubscription.dispose()
+        if let archiveObserver { NotificationCenter.default.removeObserver(archiveObserver) }
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        table.transform = CGAffineTransform(scaleX: 1, y: -1)
+        table.separatorStyle = .none
+        table.rowHeight = UITableView.automaticDimension
+        table.estimatedRowHeight = 80
+        table.keyboardDismissMode = .onDrag
+        table.contentInsetAdjustmentBehavior = .never
+        table.dataSource = self
+        table.delegate = self
+        view.addSubview(table)
+
+        search.searchBarStyle = .minimal
+        search.delegate = self
+        search.isHidden = true
+        view.addSubview(search)
+
+        notice.numberOfLines = 0
+        notice.textAlignment = .center
+        notice.font = UIFont.preferredFont(forTextStyle: .body)
+        view.addSubview(notice)
+
+        presentationSubscription.set(
+            (context.sharedContext.presentationData |> deliverOnMainQueue).start(next: { [weak self] data in
+                self?.updatePresentation(data)
+            }))
+        archiveObserver = NotificationCenter.default.addObserver(
+            forName: .retainedMessagesChanged, object: nil, queue: .main
+        ) { [weak self] _ in
+            guard let self, !self.refreshScheduled else { return }
+            self.refreshScheduled = true
+            DispatchQueue.main.async { [weak self] in
+                self?.refreshScheduled = false
+                self?.load(reset: true)
+            }
+        }
+        load(reset: true)
+    }
+
+    override func containerLayoutUpdated(_ layout: ContainerViewLayout, transition: ContainedViewLayoutTransition) {
+        super.containerLayoutUpdated(layout, transition: transition)
+        let top = navigationLayout(layout: layout).navigationFrame.maxY
+        let searchHeight: CGFloat = searching ? 52 : 0
+        let insets = layout.insets(options: [.input])
+        search.frame = CGRect(x: 0, y: top, width: layout.size.width, height: searchHeight)
+        let tableTop = top + searchHeight
+        let frame = CGRect(
+            x: 0, y: tableTop, width: layout.size.width,
+            height: max(0, layout.size.height - tableTop - insets.bottom))
+        table.bounds.size = frame.size
+        table.center = CGPoint(x: frame.midX, y: frame.midY)
+        notice.frame = frame.insetBy(dx: 24, dy: 0)
+    }
+
+    private func updatePresentation(_ data: PresentationData) {
+        presentation = data
+        navigationBar?.updatePresentationData(
+            NavigationBarPresentationData(
+                theme: NavigationBarTheme(rootControllerTheme: data.theme),
+                strings: NavigationBarStrings(presentationStrings: data.strings)), transition: .immediate)
+        statusBar.statusBarStyle = data.theme.rootController.statusBarStyle.style
+        view.backgroundColor = data.theme.list.plainBackgroundColor
+        search.overrideUserInterfaceStyle = data.theme.overallDarkAppearance ? .dark : .light
+        search.searchTextField.textColor = data.theme.list.itemPrimaryTextColor
+        search.placeholder = data.strings.Common_Search
+        notice.textColor = data.theme.list.itemSecondaryTextColor
+        updateNavigation()
+        table.reloadData()
+    }
+
+    private func updateNavigation() {
+        let item: UIBarButtonItem
+        if searching {
+            item = UIBarButtonItem(
+                title: presentation.strings.Common_Cancel, style: .plain, target: self,
+                action: #selector(toggleSearch))
+        } else {
+            item = UIBarButtonItem(
+                image: PresentationResourcesRootController.navigationCompactSearchIcon(presentation.theme),
+                style: .plain, target: self, action: #selector(toggleSearch))
+            item.accessibilityLabel = presentation.strings.Common_Search
+        }
+        navigationItem.rightBarButtonItem = item
+    }
+
+    @objc private func toggleSearch() {
+        searching.toggle()
+        search.isHidden = !searching
+        updateNavigation()
+        requestLayout(transition: .immediate)
+        if searching {
+            search.becomeFirstResponder()
+        } else {
+            search.resignFirstResponder()
+            search.text = ""
+            load(reset: true)
+        }
+    }
+
+    func searchBar(_ searchBar: UISearchBar, textDidChange searchText: String) { load(reset: true) }
+
+    func searchBarSearchButtonClicked(_ searchBar: UISearchBar) { searchBar.resignFirstResponder() }
+
+    private func load(reset: Bool) {
+        if !reset && (loading || cursor == nil) { return }
+        request += 1
+        let generation = request
+        let account = additionalAccountKey(context.account.peerId)
+        let chat = self.chat
+        let query = (search.text ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+        let before = reset ? nil : cursor
+        loading = true
+        if reset {
+            entries = []
+            cursor = nil
+            table.reloadData()
+            notice.text = archiveTitle("Loading", context)
+        }
+        DispatchQueue.global(qos: .utility).async { [weak self] in
+            let result = Result {
+                try DeletedMessageArchive.shared.page(account: account, chat: chat, search: query, before: before)
+            }
+            DispatchQueue.main.async {
+                guard let self, generation == self.request else { return }
+                switch result {
+                case .success(let page):
+                    let start = self.entries.count
+                    self.entries += page.entries
+                    self.cursor = page.next
+                    self.notice.text =
+                        self.entries.isEmpty
+                        ? archiveTitle(query.isEmpty ? "Empty" : "NoResults", self.context) : nil
+                    if reset {
+                        self.table.reloadData()
+                        self.table.setContentOffset(.zero, animated: false)
+                    } else if self.entries.count > start {
+                        let rows = (start..<self.entries.count).map { IndexPath(row: $0, section: 0) }
+                        self.table.insertRows(at: rows, with: .none)
+                    }
+                case .failure(let error):
+                    self.cursor = nil
+                    if reset {
+                        self.notice.text = error.localizedDescription
+                    } else {
+                        self.present(additionalError(context: self.context, error: error), in: .window(.root))
+                    }
+                }
+                self.loading = false
+            }
+        }
+    }
+
+    func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { entries.count }
+
+    func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell =
+            (tableView.dequeueReusableCell(withIdentifier: "Message") as? AdditionalArchiveBubble)
+            ?? AdditionalArchiveBubble()
+        let message = entries[indexPath.row].message
+        let incoming = message.incoming ?? true
+        let colors = incoming ? presentation.theme.chat.message.incoming : presentation.theme.chat.message.outgoing
+        let revision = archiveRevision(message)
+        let text =
+            revision.text.isEmpty
+            ? NSAttributedString(
+                string: archiveTitle(
+                    message.payload.isEmpty ? "MissingLegacy" : "Kind." + message.kind.rawValue, context),
+                attributes: [
+                    .foregroundColor: colors.primaryTextColor, .font: UIFont.preferredFont(forTextStyle: .body),
+                ])
+            : additionalArchiveAttributedText(
+                revision, font: UIFont.preferredFont(forTextStyle: .body),
+                textColor: colors.primaryTextColor, linkColor: colors.linkTextColor, hideSpoilers: true)
+        cell.update(
+            incoming: incoming, text: text, sender: message.senderTitle,
+            date: timestamp.string(from: Date(timeIntervalSince1970: Double(message.timestamp))), colors: colors)
+        return cell
+    }
+
+    func tableView(_ tableView: UITableView, willDisplay cell: UITableViewCell, forRowAt indexPath: IndexPath) {
+        if indexPath.row >= entries.count - 5 { load(reset: false) }
+    }
+
+    func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        (navigationController as? NavigationController)?.pushViewController(
+            additionalArchivedMessageController(context: context, message: entries[indexPath.row].message))
+    }
+}
+
+private final class AdditionalArchiveBubble: UITableViewCell {
+    private let bubble = UIStackView()
+    private let sender = UILabel()
+    private let body = UILabel()
+    private let date = UILabel()
+    private var leading: NSLayoutConstraint!
+    private var trailing: NSLayoutConstraint!
+
+    init() {
+        super.init(style: .default, reuseIdentifier: "Message")
+        transform = CGAffineTransform(scaleX: 1, y: -1)
+        selectionStyle = .none
+        backgroundColor = .clear
+        bubble.axis = .vertical
+        bubble.spacing = 3
+        bubble.isLayoutMarginsRelativeArrangement = true
+        bubble.layoutMargins = UIEdgeInsets(top: 7, left: 11, bottom: 7, right: 11)
+        bubble.layer.cornerRadius = 15
+        bubble.translatesAutoresizingMaskIntoConstraints = false
+        for label in [sender, body, date] {
+            label.numberOfLines = 0
+            bubble.addArrangedSubview(label)
+        }
+        sender.font = UIFont.preferredFont(forTextStyle: .caption1)
+        date.font = UIFont.preferredFont(forTextStyle: .caption2)
+        date.textAlignment = .right
+        contentView.addSubview(bubble)
+        let margins = contentView.layoutMarginsGuide
+        leading = bubble.leadingAnchor.constraint(equalTo: margins.leadingAnchor)
+        trailing = bubble.trailingAnchor.constraint(equalTo: margins.trailingAnchor)
+        NSLayoutConstraint.activate([
+            bubble.widthAnchor.constraint(lessThanOrEqualTo: margins.widthAnchor, multiplier: 0.85),
+            bubble.topAnchor.constraint(equalTo: contentView.topAnchor, constant: 3),
+            bubble.bottomAnchor.constraint(equalTo: contentView.bottomAnchor, constant: -3),
+        ])
+    }
+
+    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+
+    func update(
+        incoming: Bool, text: NSAttributedString, sender name: String, date time: String,
+        colors: PresentationThemePartedColors
+    ) {
+        leading.isActive = incoming
+        trailing.isActive = !incoming
+        bubble.backgroundColor = colors.bubble.withoutWallpaper.fill.first
+        sender.textColor = colors.accentTextColor
+        sender.text = name
+        sender.isHidden = name.isEmpty
+        body.attributedText = text
+        date.textColor = colors.secondaryTextColor
+        date.text = time
+    }
+}
+
+private func archiveRevision(_ message: ArchivedMessage) -> MessageRevision {
+    (try? additionalArchivedRevision(message))
+        ?? MessageRevision(text: message.text, entities: [], messageDate: Int64(message.timestamp), editDate: nil)
+}
+
+private func additionalArchivedMessageController(
+    context: AccountContext, message: ArchivedMessage, historical: Bool = false
+) -> ViewController {
+    let model = AdditionalForm(context: context)
+    let attachments = (try? additionalArchivedAttachments(message)) ?? []
+    var revisions: [MessageRevision] = []
+    var versions: [ArchivedMessage] = []
+    var revealSpoilers = false
+    model.entries = { lang in
+        let formatter = DateFormatter()
+        formatter.dateStyle = .medium
+        formatter.timeStyle = .medium
+        var result = [
+            AdditionalFormEntry(
+                stableId: 0, section: 0, kind: .notice,
+                title: message.chatTitle + "\n" + message.senderTitle + "\n"
+                    + formatter.string(from: Date(timeIntervalSince1970: Double(message.timestamp)))),
+            AdditionalFormEntry(
+                stableId: 1, section: 0, kind: .notice, title: message.text,
+                richText: archiveRichText(
+                    archiveRevision(message), context: context, hideSpoilers: !revealSpoilers)),
+            AdditionalFormEntry(stableId: 2, section: 1, kind: .action, title: i18n("Additional.ArchiveCopy", lang)),
+        ]
+        result.append(
+            .init(
+                stableId: 6, section: 1, kind: .toggle, title: i18n("Additional.ArchiveShowSpoilers", lang),
+                value: revealSpoilers ? "1" : "0"))
+        if let details = try? additionalArchivedContext(message) {
+            if let reply = details.reply {
+                result.append(
+                    .init(
+                        stableId: 7, section: 0, kind: .notice,
+                        title: i18n("Additional.ArchiveReply", lang) + ": #" + String(reply)))
+            }
+            if details.isForwarded {
+                result.append(
+                    .init(
+                        stableId: 8, section: 0, kind: .notice,
+                        title: i18n("Additional.ArchiveForward", lang) + ": "
+                            + (details.forwardedFrom ?? i18n("Additional.ArchiveUnknownSender", lang))))
+            }
+        }
+        if message.payload.isEmpty {
+            result.append(
+                .init(stableId: 5, section: 0, kind: .notice, title: i18n("Additional.ArchiveMissingLegacy", lang)))
+        }
+        for (index, attachment) in attachments.enumerated() {
+            result.append(.init(stableId: 100 + index, section: 2, kind: .disclosure, title: attachment.filename))
+        }
+        for (index, version) in versions.enumerated() {
+            let revision = try? additionalArchivedRevision(version)
+            let time = revision?.editDate ?? Int64(version.timestamp)
+            result.append(
+                .init(
+                    stableId: 20000 + index, section: 4, kind: .disclosure,
+                    title: formatter.string(from: Date(timeIntervalSince1970: Double(time))) + " · "
+                        + i18n("Additional.ArchiveKind." + version.kind.rawValue, lang),
+                    value: String(version.text.prefix(80))))
+        }
+        for (index, revision) in revisions.enumerated() {
+            result.append(
+                .init(
+                    stableId: 10000 + index, section: 3, kind: .notice,
+                    title: revision.text,
+                    richText: archiveRichText(revision, context: context, hideSpoilers: !revealSpoilers)))
+        }
+        return result
+    }
+    model.input = { [weak model] id, value in
+        if id == 6 {
+            revealSpoilers = value == "1"
+            model?.refresh()
+        }
+    }
+    model.action = { [weak model] id in
+        guard let model else { return }
+        if id == 2 {
+            UIPasteboard.general.string = message.text
+        } else if id >= 20000, versions.indices.contains(id - 20000) {
+            model.push(
+                additionalArchivedMessageController(context: context, message: versions[id - 20000], historical: true))
+        } else if id >= 100, attachments.indices.contains(id - 100) {
+            let attachment = attachments[id - 100]
+            let suffix = UTType(mimeType: attachment.mimeType)?.preferredFilenameExtension
+            let mediaBox = context.account.postbox.mediaBox
+            guard
+                let path = attachment.resources.lazy.compactMap({
+                    mediaBox.completedResourcePath($0, pathExtension: suffix)
+                }).first
+            else {
+                model.error(SettingsError.invalid(archiveTitle("CacheMiss", context)))
+                return
+            }
+            let file = URL(fileURLWithPath: path)
+            if attachment.kind == .voice {
+                model.push(additionalArchiveAudioController(context: context, file: file))
+            } else {
+                let preview = AdditionalArchivePreview(file: file)
+                model.documentDelegate = preview
+                let controller = QLPreviewController()
+                controller.dataSource = preview
+                model.controller?.present(controller, animated: true)
+            }
+        }
+    }
+
+    let controller = model.make(title: archiveTitle("Title", context))
+    if !historical {
+        MessageArchive.shared.history(
+            MessageKey(account: message.id.account, chat: message.id.chat, id: Int64(message.id.message))
+        ) { [weak model] values in
+            revisions = values
+            model?.refresh()
+        }
+    }
+    if !historical {
+        DispatchQueue.global(qos: .utility).async { [weak model] in
+            let result = Result { try DeletedMessageArchive.shared.versions(message.id) }
+            DispatchQueue.main.async {
+                guard let model else { return }
+                switch result {
+                case .success(let values):
+                    versions = values
+                    model.refresh()
+                case .failure(let error): model.error(error)
+                }
+            }
+        }
+    }
+    return controller
+}
+
+private func archiveRichText(_ revision: MessageRevision, context: AccountContext, hideSpoilers: Bool = true)
+    -> NSAttributedString
+{
+    let data = context.sharedContext.currentPresentationData.with { $0 }
+    return additionalArchiveAttributedText(
+        revision, font: UIFont.preferredFont(forTextStyle: .body),
+        textColor: data.theme.list.itemPrimaryTextColor, linkColor: data.theme.list.itemAccentColor,
+        hideSpoilers: hideSpoilers)
+}
+
+func additionalArchiveAttributedText(
+    _ revision: MessageRevision, font: UIFont, textColor: UIColor, linkColor: UIColor, hideSpoilers: Bool
+) -> NSAttributedString {
+    let result = NSMutableAttributedString(
+        string: revision.text, attributes: [.font: font, .foregroundColor: textColor])
+    let units = Array(revision.text.utf16)
+    let entities = revision.entities.filter { entity in
+        guard entity.offset >= 0, entity.length > 0, entity.offset <= units.count,
+            entity.length <= units.count - entity.offset
+        else { return false }
+        return [entity.offset, entity.offset + entity.length].allSatisfy { boundary in
+            boundary == 0 || boundary == units.count || !(0xDC00...0xDFFF).contains(units[boundary])
+        }
+    }
+    for entity in entities {
+        let range = NSRange(location: entity.offset, length: entity.length)
+        switch entity.kind {
+        case "messageEntityBold", "messageEntityItalic":
+            let trait: UIFontDescriptor.SymbolicTraits = entity.kind == "messageEntityBold" ? .traitBold : .traitItalic
+            result.enumerateAttribute(.font, in: range, options: []) { value, span, _ in
+                let current = (value as? UIFont) ?? font
+                if let descriptor = current.fontDescriptor.withSymbolicTraits(
+                    current.fontDescriptor.symbolicTraits.union(trait))
+                {
+                    result.addAttribute(
+                        .font, value: UIFont(descriptor: descriptor, size: current.pointSize), range: span)
+                }
+            }
+        case "messageEntityCode", "messageEntityPre":
+            result.addAttribute(
+                .font, value: UIFont.monospacedSystemFont(ofSize: font.pointSize, weight: .regular), range: range)
+        case "messageEntityUnderline":
+            result.addAttribute(.underlineStyle, value: NSUnderlineStyle.single.rawValue, range: range)
+        case "messageEntityStrike":
+            result.addAttribute(.strikethroughStyle, value: NSUnderlineStyle.single.rawValue, range: range)
+        case "messageEntityUrl", "messageEntityTextUrl":
+            let target =
+                entity.kind == "messageEntityTextUrl"
+                ? entity.value : (revision.text as NSString).substring(with: range)
+            if let target, URL(string: target)?.scheme != nil {
+                result.addAttribute(
+                    NSAttributedString.Key(rawValue: TelegramTextAttributes.URL), value: target, range: range)
+                result.addAttribute(.foregroundColor, value: linkColor, range: range)
+            }
+        case "messageEntityBlockquote":
+            let paragraph = NSMutableParagraphStyle()
+            paragraph.headIndent = 12
+            paragraph.firstLineHeadIndent = 12
+            result.addAttribute(.paragraphStyle, value: paragraph, range: range)
+        default: break
+        }
+    }
+    if hideSpoilers {
+        for entity in entities where entity.kind == "messageEntitySpoiler" {
+            let range = NSRange(location: entity.offset, length: entity.length)
+            result.replaceCharacters(in: range, with: String(repeating: "•", count: entity.length))
+            result.removeAttribute(NSAttributedString.Key(rawValue: TelegramTextAttributes.URL), range: range)
+        }
+    }
+    return result
+}
+
+private final class AdditionalArchivePreview: NSObject, QLPreviewControllerDataSource {
+    let file: URL
+    init(file: URL) { self.file = file }
+    func numberOfPreviewItems(in controller: QLPreviewController) -> Int { 1 }
+    func previewController(_ controller: QLPreviewController, previewItemAt index: Int) -> QLPreviewItem {
+        file as NSURL
+    }
+}
+
+private final class AdditionalArchiveAudio: NSObject {
+    let player: MediaPlayer
+    var subscription: Disposable?
+    init(context: AccountContext, file: URL) {
+        let resource = LocalFileReferenceMediaResource(
+            localFilePath: file.path, randomId: Int64.random(in: Int64.min...Int64.max))
+        player = MediaPlayer(
+            audioSessionManager: context.sharedContext.mediaManager.audioSession, postbox: context.account.postbox,
+            userLocation: .other, userContentType: .other, resourceReference: .standalone(resource: resource),
+            tempFilePath: file.path,
+            streamable: .none, video: false, preferSoftwareDecoding: true, enableSound: true, fetchAutomatically: false,
+            isAudioVideoMessage: true)
+    }
+    deinit {
+        subscription?.dispose()
+        player.pause()
+    }
+}
+
+private func additionalArchiveAudioController(context: AccountContext, file: URL) -> ViewController {
+    let model = AdditionalForm(context: context)
+    let audio = AdditionalArchiveAudio(context: context, file: file)
+    model.documentDelegate = audio
+    var seek = "0"
+    var position = ""
+    model.entries = { lang in
+        [
+            .init(stableId: 0, section: 0, kind: .notice, title: position),
+            .init(stableId: 1, section: 1, kind: .action, title: i18n("Additional.ArchivePlay", lang)),
+            .init(stableId: 2, section: 1, kind: .action, title: i18n("Additional.ArchivePause", lang)),
+            .init(stableId: 3, section: 2, kind: .input, title: i18n("Additional.ArchiveSeek", lang), value: seek),
+            .init(stableId: 4, section: 2, kind: .action, title: i18n("Additional.ArchiveSeek", lang)),
+        ]
+    }
+    model.input = { _, value in seek = value }
+    model.action = { [weak model] id in
+        if id == 1 {
+            audio.player.play()
+        } else if id == 2 {
+            audio.player.pause()
+        } else if id == 4 {
+            guard let seconds = Double(seek), seconds.isFinite, seconds >= 0 else {
+                model?.error(SettingsError.invalid(archiveTitle("Seek", context)))
+                return
+            }
+            audio.player.seek(timestamp: seconds)
+        }
+    }
+    audio.subscription = (audio.player.status |> deliverOnMainQueue).start(next: { [weak model] status in
+        position = String(format: "%.0f / %.0f s", status.timestamp, status.duration)
+        model?.refresh()
+    })
+    return model.make(title: archiveTitle("Kind.voice", context))
+}
