+
+private func archiveTitle(_ key: String, _ context: AccountContext) -> String {
+    i18n("Additional.Archive" + key, context.sharedContext.currentPresentationData.with { $0.strings.baseLanguageCode })
+}
+
+private func archiveConfirm(_ model: AdditionalForm, action: @escaping () throws -> Void) {
+    let data = model.context.sharedContext.currentPresentationData.with { $0 }
+    let sheet = ActionSheetController(presentationData: data)
+    sheet.setItemGroups([
+        ActionSheetItemGroup(items: [
+            ActionSheetTextItem(title: archiveTitle("PurgeNotice", model.context)),
+            ActionSheetButtonItem(
+                title: data.strings.Common_Delete, color: .destructive,
+                action: { [weak sheet, weak model] in
+                    sheet?.dismissAnimated()
+                    do { try action() } catch { model?.error(error) }
+                }),
+        ]),
+        ActionSheetItemGroup(items: [
+            ActionSheetButtonItem(
+                title: data.strings.Common_Cancel, color: .accent, action: { [weak sheet] in sheet?.dismissAnimated() })
+        ]),
+    ])
+    model.controller?.present(sheet, in: .window(.root))
+}
+
+/// Works entirely from archive snapshots, including chats no longer present in Postbox.
+public func additionalDeletedMessagesController(
+    context: AccountContext, account: String? = nil, chat: String? = nil, deletedOnly initialDeletedOnly: Bool = true
+)
+    -> ViewController
+{
+    let account = account ?? additionalAccountKey(context.account.peerId)
+    let model = AdditionalForm(context: context)
+    var deletedOnly = initialDeletedOnly
+    var query = ""
+    var date = ""
+    var kind: ArchivedMessage.Kind?
+    var entries: [ArchivedMessageEntry] = []
+    var next: ArchiveCursor?
+    var generation = 0
+    var loading = false
+    var failure: String?
+    weak var weakModel = model
+    func load(reset: Bool) {
+        guard let model = weakModel else { return }
+        generation += 1
+        let request = generation
+        loading = true
+        failure = nil
+        if reset {
+            entries = []
+            next = nil
+        }
+        let search = query
+        let filter = kind
+        let onlyDeleted = deletedOnly
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.timeZone = TimeZone(secondsFromGMT: 0)
+        formatter.dateFormat = "yyyy-MM-dd"
+        formatter.isLenient = false
+        let parsed = date.isEmpty ? nil : formatter.date(from: date)
+        if !date.isEmpty, parsed == nil {
+            loading = false
+            failure = archiveTitle("Date", context)
+            model.refresh()
+            return
+        }
+        let cursor =
+            next
+            ?? parsed.map { ArchiveCursor(observed: Int64($0.timeIntervalSince1970) + 86_400, sequence: Int64.max) }
+        model.refresh()
+        DispatchQueue.global(qos: .utility).async { [weak model] in
+            let result = Result {
+                try DeletedMessageArchive.shared.page(
+                    account: account, chat: chat, search: search, kind: filter, before: cursor, deletedOnly: onlyDeleted
+                )
+            }
+            DispatchQueue.main.async {
+                guard let model, request == generation else { return }
+                loading = false
+                switch result {
+                case .success(let page):
+                    entries += page.entries
+                    next = page.next
+                case .failure(let error): failure = error.localizedDescription
+                }
+                model.refresh()
+            }
+        }
+    }
+    model.entries = { lang in
+        var result = [
+            AdditionalFormEntry(
+                stableId: 0, section: 0, kind: .input, title: i18n("Additional.ArchiveSearch", lang), value: query),
+            AdditionalFormEntry(
+                stableId: 1, section: 0, kind: .input, title: i18n("Additional.ArchiveDate", lang), value: date),
+            AdditionalFormEntry(stableId: 2, section: 0, kind: .action, title: i18n("Additional.ArchiveApply", lang)),
+            AdditionalFormEntry(
+                stableId: 3, section: 0, kind: .disclosure, title: i18n("Additional.ArchiveFilter", lang),
+                value: i18n("Additional.ArchiveKind." + (kind?.rawValue ?? "all"), lang)),
+            AdditionalFormEntry(
+                stableId: 4, section: 0, kind: .disclosure, title: i18n("Additional.ArchiveSettings", lang)),
+        ]
+        result.append(
+            .init(
+                stableId: 7, section: 0, kind: .toggle, title: i18n("Additional.ArchiveDeletedOnly", lang),
+                value: deletedOnly ? "1" : "0"))
+        if chat == nil {
+            result.append(
+                .init(stableId: 8, section: 0, kind: .disclosure, title: i18n("Additional.ArchiveChats", lang)))
+        }
+        if let failure { result.append(.init(stableId: 5, section: 1, kind: .notice, title: failure)) }
+        if entries.isEmpty {
+            result.append(
+                .init(
+                    stableId: 6, section: 1, kind: .notice,
+                    title: i18n(loading ? "Additional.ArchiveLoading" : "Additional.ArchiveEmpty", lang)))
+        }
+        for (index, entry) in entries.enumerated() {
+            let message = entry.message
+            let title = [
+                message.chatTitle, message.senderTitle,
+                message.text.isEmpty
+                    ? i18n("Additional.ArchiveKind." + message.kind.rawValue, lang) : String(message.text.prefix(120)),
+            ].filter { !$0.isEmpty }.joined(separator: " · ")
+            result.append(.init(stableId: index + 100, section: 2, kind: .disclosure, title: title))
+        }
+        if next != nil && !loading {
+            result.append(.init(stableId: 10, section: 3, kind: .action, title: i18n("Additional.ArchiveMore", lang)))
+        }
+        return result
+    }
+    model.input = { id, value in
+        if id == 0 {
+            query = value
+        } else if id == 1 {
+            date = value
+        } else if id == 7 {
+            deletedOnly = value == "1"
+            load(reset: true)
+        }
+    }
+    model.action = { [weak model] id in
+        guard let model else { return }
+        if id == 2 {
+            load(reset: true)
+        } else if id == 3 {
+            let data = context.sharedContext.currentPresentationData.with { $0 }
+            let sheet = ActionSheetController(presentationData: data)
+            let kinds: [ArchivedMessage.Kind?] = [nil] + ArchivedMessage.Kind.allCases.map { Optional($0) }
+            let items = kinds.map { value in
+                ActionSheetButtonItem(
+                    title: i18n("Additional.ArchiveKind." + (value?.rawValue ?? "all"), data.strings.baseLanguageCode),
+                    color: .accent,
+                    action: { [weak sheet] in
+                        sheet?.dismissAnimated()
+                        kind = value
+                        load(reset: true)
+                    })
+            }
+            sheet.setItemGroups([ActionSheetItemGroup(items: items)])
+            model.controller?.present(sheet, in: .window(.root))
+        } else if id == 4 {
+            model.push(additionalArchiveSettingsController(context: context, account: account, chat: chat))
+        } else if id == 8 {
+            model.push(additionalArchiveChatsController(context: context, account: account))
+        } else if id == 10 {
+            load(reset: false)
+        } else if id >= 100, entries.indices.contains(id - 100) {
+            model.push(
+                additionalArchivedMessageController(
+                    context: context, message: entries[id - 100].message, refresh: { load(reset: true) }))
+        }
+    }
+    let controller = model.make(title: archiveTitle("Title", context))
+    load(reset: true)
+    return controller
+}
+
+private func additionalArchivedMessageController(
+    context: AccountContext, message: ArchivedMessage, historical: Bool = false, refresh: @escaping () -> Void
+) -> ViewController {
+    let model = AdditionalForm(context: context)
+    var attachments: [ArchivedAttachment] = []
+    var revisions: [MessageRevision] = []
+    var versions: [ArchivedMessage] = []
+    var revealSpoilers = false
+    var attachmentFailure: String?
+    var loadGeneration = 0
+    model.entries = { lang in
+        let formatter = DateFormatter()
+        formatter.dateStyle = .medium
+        formatter.timeStyle = .medium
+        var result = [
+            AdditionalFormEntry(
+                stableId: 0, section: 0, kind: .notice,
+                title: message.chatTitle + "\n" + message.senderTitle + "\n"
+                    + formatter.string(from: Date(timeIntervalSince1970: Double(message.timestamp)))),
+            AdditionalFormEntry(
+                stableId: 1, section: 0, kind: .notice, title: message.text,
+                richText: archiveRichText(
+                    (try? additionalArchivedRevision(message))
+                        ?? MessageRevision(
+                            text: message.text, entities: [], messageDate: Int64(message.timestamp), editDate: nil),
+                    context: context, hideSpoilers: !revealSpoilers)),
+            AdditionalFormEntry(stableId: 2, section: 1, kind: .action, title: i18n("Additional.ArchiveCopy", lang)),
+            AdditionalFormEntry(stableId: 3, section: 1, kind: .action, title: i18n("Additional.ArchivePurge", lang)),
+        ]
+        if historical { result.removeAll { $0.stableId == 3 } }
+        result.append(
+            .init(
+                stableId: 6, section: 1, kind: .toggle, title: i18n("Additional.ArchiveShowSpoilers", lang),
+                value: revealSpoilers ? "1" : "0"))
+        if let details = try? additionalArchivedContext(message) {
+            if let reply = details.reply {
+                result.append(
+                    .init(
+                        stableId: 7, section: 0, kind: .notice,
+                        title: i18n("Additional.ArchiveReply", lang) + ": #" + String(reply)))
+            }
+            if details.isForwarded {
+                result.append(
+                    .init(
+                        stableId: 8, section: 0, kind: .notice,
+                        title: i18n("Additional.ArchiveForward", lang) + ": "
+                            + (details.forwardedFrom ?? i18n("Additional.ArchiveUnknownSender", lang))))
+            }
+        }
+        if message.payload.isEmpty {
+            result.append(
+                .init(stableId: 5, section: 0, kind: .notice, title: i18n("Additional.ArchiveMissingLegacy", lang)))
+        }
+        if let attachmentFailure {
+            result.append(.init(stableId: 4, section: 1, kind: .notice, title: attachmentFailure))
+        }
+        for (index, attachment) in attachments.enumerated() {
+            result.append(
+                .init(
+                    stableId: index + 100, section: 2, kind: .disclosure,
+                    title: i18n("Additional.ArchiveAttachment", lang) + " \(index + 1)",
+                    value: i18n("Additional.ArchiveStatus." + attachment.status, lang)))
+        }
+        for (index, version) in versions.enumerated() {
+            let revision = try? additionalArchivedRevision(version)
+            let time = revision?.editDate ?? Int64(version.timestamp)
+            result.append(
+                .init(
+                    stableId: 20000 + index, section: 4, kind: .disclosure,
+                    title: formatter.string(from: Date(timeIntervalSince1970: Double(time))) + " · "
+                        + i18n("Additional.ArchiveKind." + version.kind.rawValue, lang),
+                    value: String(version.text.prefix(80))))
+        }
+        for (index, revision) in revisions.enumerated() {
+            result.append(
+                .init(
+                    stableId: 10000 + index, section: 3, kind: .notice,
+                    title: revision.text,
+                    richText: archiveRichText(revision, context: context, hideSpoilers: !revealSpoilers)))
+        }
+        return result
+    }
+    model.input = { [weak model] id, value in
+        if id == 6 {
+            revealSpoilers = value == "1"
+            model?.refresh()
+        }
+    }
+    model.action = { [weak model] id in
+        guard let model else { return }
+        if id == 2 {
+            UIPasteboard.general.string = message.text
+        } else if id == 3 {
+            archiveConfirm(model) {
+                archivePurge(context: context, account: message.id.account, message: message.id) {
+                    [weak model] success in
+                    guard let model else { return }
+                    if success {
+                        refresh()
+                        model.controller?.navigationController?.popViewController(animated: true)
+                    } else {
+                        model.error(SettingsError.invalid(archiveTitle("PurgeFailed", context)))
+                    }
+                }
+            }
+        } else if id >= 20000, versions.indices.contains(id - 20000) {
+            model.push(
+                additionalArchivedMessageController(
+                    context: context, message: versions[id - 20000], historical: true, refresh: refresh))
+        } else if id >= 100, attachments.indices.contains(id - 100), let file = attachments[id - 100].file {
+            let attachment = attachments[id - 100]
+            do {
+                var info = try additionalArchivedAttachmentInfo(message, resource: attachment.resource)
+                if info == nil {
+                    for version in versions {
+                        if let value = try additionalArchivedAttachmentInfo(version, resource: attachment.resource) {
+                            info = value
+                            break
+                        }
+                    }
+                }
+                if info?.kind == .voice {
+                    model.push(additionalArchiveAudioController(context: context, file: file))
+                } else {
+                    let name = info?.filename ?? "file"
+                    let mimeType = info?.mimeType
+                    DispatchQueue.global(qos: .utility).async { [weak model] in
+                        let result = Result { try AdditionalArchivePreview(file: file, name: name, mimeType: mimeType) }
+                        DispatchQueue.main.async {
+                            guard let model, model.controller?.presentedViewController == nil else { return }
+                            switch result {
+                            case .success(let preview):
+                                model.documentDelegate = preview
+                                let controller = QLPreviewController()
+                                controller.dataSource = preview
+                                model.controller?.present(controller, animated: true)
+                            case .failure(let error): model.error(error)
+                            }
+                        }
+                    }
+                }
+            } catch { model.error(error) }
+        }
+    }
+    let controller = model.make(title: archiveTitle("Title", context))
+    if !historical {
+        MessageArchive.shared.history(
+            MessageKey(account: message.id.account, chat: message.id.chat, id: Int64(message.id.message))
+        ) { [weak model] values in
+            revisions = values
+            model?.refresh()
+        }
+    }
+    weak var weakModel = model
+    func loadDetails() {
+        guard let model = weakModel else { return }
+        loadGeneration += 1
+        let generation = loadGeneration
+        DispatchQueue.global(qos: .utility).async { [weak model] in
+            let result = Result {
+                let files = try DeletedMessageArchive.shared.attachments(
+                    account: message.id.account, message: message.id
+                ).filter {
+                    (try? additionalArchivedAttachmentInfo(message, resource: $0.resource)) != nil
+                }
+                let values = historical ? [] : try DeletedMessageArchive.shared.versions(message.id)
+                return (files, values)
+            }
+            DispatchQueue.main.async {
+                guard let model, generation == loadGeneration else { return }
+                switch result {
+                case .success(let values):
+                    attachments = values.0
+                    versions = values.1
+                    attachmentFailure = nil
+                case .failure(let error): attachmentFailure = error.localizedDescription
+                }
+                model.refresh()
+            }
+        }
+    }
+    var reloadScheduled = false
+    model.disposables.add(
+        (archiveAttachmentChanges(account: message.id.account) |> deliverOnMainQueue).start(next: {
+            guard !reloadScheduled else { return }
+            reloadScheduled = true
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.1) {
+                reloadScheduled = false
+                loadDetails()
+            }
+        }))
+    loadDetails()
+    return controller
+}
+
+private func archiveRichText(_ revision: MessageRevision, context: AccountContext, hideSpoilers: Bool = true)
+    -> NSAttributedString
+{
+    let data = context.sharedContext.currentPresentationData.with { $0 }
+    return additionalArchiveAttributedText(
+        revision, font: UIFont.preferredFont(forTextStyle: .body),
+        textColor: data.theme.list.itemPrimaryTextColor, linkColor: data.theme.list.itemAccentColor,
+        hideSpoilers: hideSpoilers)
+}
+
+func additionalArchiveAttributedText(
+    _ revision: MessageRevision, font: UIFont, textColor: UIColor, linkColor: UIColor, hideSpoilers: Bool
+) -> NSAttributedString {
+    let result = NSMutableAttributedString(
+        string: revision.text, attributes: [.font: font, .foregroundColor: textColor])
+    let units = Array(revision.text.utf16)
+    let entities = revision.entities.filter { entity in
+        guard entity.offset >= 0, entity.length > 0, entity.offset <= units.count,
+            entity.length <= units.count - entity.offset
+        else { return false }
+        return [entity.offset, entity.offset + entity.length].allSatisfy { boundary in
+            boundary == 0 || boundary == units.count || !(0xDC00...0xDFFF).contains(units[boundary])
+        }
+    }
+    for entity in entities {
+        let range = NSRange(location: entity.offset, length: entity.length)
+        switch entity.kind {
+        case "messageEntityBold", "messageEntityItalic":
+            let trait: UIFontDescriptor.SymbolicTraits = entity.kind == "messageEntityBold" ? .traitBold : .traitItalic
+            result.enumerateAttribute(.font, in: range, options: []) { value, span, _ in
+                let current = (value as? UIFont) ?? font
+                if let descriptor = current.fontDescriptor.withSymbolicTraits(
+                    current.fontDescriptor.symbolicTraits.union(trait))
+                {
+                    result.addAttribute(
+                        .font, value: UIFont(descriptor: descriptor, size: current.pointSize), range: span)
+                }
+            }
+        case "messageEntityCode", "messageEntityPre":
+            result.addAttribute(
+                .font, value: UIFont.monospacedSystemFont(ofSize: font.pointSize, weight: .regular), range: range)
+        case "messageEntityUnderline":
+            result.addAttribute(.underlineStyle, value: NSUnderlineStyle.single.rawValue, range: range)
+        case "messageEntityStrike":
+            result.addAttribute(.strikethroughStyle, value: NSUnderlineStyle.single.rawValue, range: range)
+        case "messageEntityUrl", "messageEntityTextUrl":
+            let target =
+                entity.kind == "messageEntityTextUrl"
+                ? entity.value : (revision.text as NSString).substring(with: range)
+            if let target, URL(string: target)?.scheme != nil {
+                result.addAttribute(
+                    NSAttributedString.Key(rawValue: TelegramTextAttributes.URL), value: target, range: range)
+                result.addAttribute(.foregroundColor, value: linkColor, range: range)
+            }
+        case "messageEntityBlockquote":
+            let paragraph = NSMutableParagraphStyle()
+            paragraph.headIndent = 12
+            paragraph.firstLineHeadIndent = 12
+            result.addAttribute(.paragraphStyle, value: paragraph, range: range)
+        default: break
+        }
+    }
+    if hideSpoilers {
+        for entity in entities where entity.kind == "messageEntitySpoiler" {
+            let range = NSRange(location: entity.offset, length: entity.length)
+            result.replaceCharacters(in: range, with: String(repeating: "•", count: entity.length))
+            result.removeAttribute(NSAttributedString.Key(rawValue: TelegramTextAttributes.URL), range: range)
+        }
+    }
+    return result
+}
+
+private final class AdditionalArchivePreview: NSObject, QLPreviewControllerDataSource {
+    let file: URL
+    private let temporary: TempBoxFile
+    init(file: URL, name: String, mimeType: String?) throws {
+        let candidate = URL(fileURLWithPath: name).pathExtension.lowercased()
+        let inferred = mimeType.flatMap { UTType(mimeType: $0)?.preferredFilenameExtension } ?? "bin"
+        let suffix =
+            !candidate.isEmpty && candidate.count <= 12
+                && candidate.utf8.allSatisfy({ (97...122).contains($0) || (48...57).contains($0) })
+            ? candidate : inferred
+        temporary = TempBox.shared.tempFile(fileName: "preview." + suffix)
+        self.file = URL(fileURLWithPath: temporary.path)
+        super.init()
+        do { try FileManager.default.copyItem(at: file, to: self.file) } catch {
+            TempBox.shared.dispose(temporary)
+            throw error
+        }
+    }
+    deinit { TempBox.shared.dispose(temporary) }
+    func numberOfPreviewItems(in controller: QLPreviewController) -> Int { 1 }
+    func previewController(_ controller: QLPreviewController, previewItemAt index: Int) -> QLPreviewItem {
+        file as NSURL
+    }
+}
