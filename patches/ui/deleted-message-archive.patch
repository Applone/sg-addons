+public func additionalArchiveSettingsController(context: AccountContext, account: String?, chat: String? = nil)
+    -> ViewController
+{
+    let model = AdditionalForm(context: context)
+    var profile = AddonSettings.shared.profile(account)
+    var quota = String(profile.archive.quotaMiB)
+    var size = String(profile.archive.fileLimitMiB)
+    var days = String(profile.retentionDays)
+    var usage = ""
+    model.entries = { lang in
+        var result = [
+            AdditionalFormEntry(
+                stableId: 0, section: 0, kind: .input, title: i18n("Additional.ArchiveQuota", lang), value: quota),
+            AdditionalFormEntry(
+                stableId: 1, section: 0, kind: .input, title: i18n("Additional.ArchiveFileLimit", lang), value: size),
+            AdditionalFormEntry(
+                stableId: 2, section: 0, kind: .input, title: i18n("Additional.Retention", lang), value: days),
+            AdditionalFormEntry(
+                stableId: 3, section: 1, kind: .toggle, title: i18n("Additional.ArchiveBots", lang),
+                value: profile.archive.bots ? "1" : "0"),
+            AdditionalFormEntry(
+                stableId: 4, section: 1, kind: .toggle, title: i18n("Additional.ArchiveMedia", lang),
+                value: profile.archive.media ? "1" : "0"),
+            AdditionalFormEntry(
+                stableId: 5, section: 1, kind: .disclosure, title: i18n("Additional.ArchiveNetwork", lang),
+                value: i18n("Additional.ArchiveNetwork." + profile.archive.network.rawValue, lang)),
+            AdditionalFormEntry(stableId: 6, section: 2, kind: .action, title: i18n("Additional.Save", lang)),
+            AdditionalFormEntry(
+                stableId: 7, section: 2, kind: .notice, title: i18n("Additional.ArchiveUsage", lang) + ": " + usage),
+            AdditionalFormEntry(stableId: 8, section: 2, kind: .action, title: i18n("Additional.ArchivePurge", lang)),
+        ]
+        if let chat {
+            for (index, value) in [
+                profile.archive.chats[chat]?.deleted, profile.archive.chats[chat]?.history,
+                profile.archive.chats[chat]?.media,
+            ].enumerated() {
+                result.append(
+                    .init(
+                        stableId: index + 20, section: 3, kind: .disclosure,
+                        title: i18n("Additional.ArchiveOverride.\(index)", lang),
+                        value: i18n(
+                            "Additional.ArchiveOverride." + (value.map { $0 ? "on" : "off" } ?? "inherit"), lang)))
+            }
+        }
+        if let error = DeletedMessageArchive.shared.status() {
+            result.append(.init(stableId: 9, section: 2, kind: .notice, title: error))
+        }
+        return result
+    }
+    model.input = { id, value in
+        switch id {
+        case 0: quota = value
+        case 1: size = value
+        case 2: days = value
+        case 3: profile.archive.bots = value == "1"
+        case 4: profile.archive.media = value == "1"
+        default: break
+        }
+    }
+    model.action = { [weak model] id in
+        guard let model else { return }
+        if id == 5 {
+            let values: [ArchivePolicy.Network] = [.wifi, .all, .cached]
+            profile.archive.network = values[(values.firstIndex(of: profile.archive.network)! + 1) % values.count]
+            model.refresh()
+        } else if id == 6 {
+            do {
+                guard let quotaValue = Int(quota), let sizeValue = Int(size), let daysValue = Int(days) else {
+                    throw SettingsError.invalid(archiveTitle("InvalidLimits", context))
+                }
+                profile.archive.quotaMiB = quotaValue
+                profile.archive.fileLimitMiB = sizeValue
+                profile.retentionDays = daysValue
+                try AddonSettings.shared.save(profile, account: account)
+                model.controller?.navigationController?.popViewController(animated: true)
+            } catch { model.error(error) }
+        } else if id == 8 {
+            archiveConfirm(model) {
+                archivePurge(
+                    context: context, account: account ?? additionalAccountKey(context.account.peerId), chat: chat
+                ) { [weak model] success in
+                    guard let model else { return }
+                    if success {
+                        usage = archiveTitle("Loading", context)
+                        model.refresh()
+                        let key = account ?? additionalAccountKey(context.account.peerId)
+                        DispatchQueue.global(qos: .utility).async { [weak model] in
+                            let result = Result { try DeletedMessageArchive.shared.storageBytes(account: key) }
+                            DispatchQueue.main.async {
+                                guard let model else { return }
+                                switch result {
+                                case .success(let bytes):
+                                    usage = ByteCountFormatter.string(fromByteCount: bytes, countStyle: .file)
+                                case .failure(let error): usage = error.localizedDescription
+                                }
+                                model.refresh()
+                            }
+                        }
+                    } else {
+                        model.error(SettingsError.invalid(archiveTitle("PurgeFailed", context)))
+                    }
+                }
+            }
+        } else if let chat, (20...22).contains(id) {
+            var value = profile.archive.chats[chat] ?? ArchiveChatOverride()
+            func cycle(_ value: Bool?) -> Bool? { value == nil ? true : value == true ? false : nil }
+            if id == 20 { value.deleted = cycle(value.deleted) }
+            if id == 21 { value.history = cycle(value.history) }
+            if id == 22 { value.media = cycle(value.media) }
+            profile.archive.chats[chat] = value
+            model.refresh()
+        }
+    }
+    let controller = model.make(title: archiveTitle("Settings", context))
+    DispatchQueue.global(qos: .utility).async { [weak model] in
+        let result = Result {
+            let key = account ?? additionalAccountKey(context.account.peerId)
+            let bytes = try DeletedMessageArchive.shared.storageBytes(account: key)
+            let attachments = try DeletedMessageArchive.shared.attachments(account: key)
+            return (
+                bytes, attachments.filter { $0.status == "pending" }.count,
+                attachments.filter { $0.status == "unavailable" || $0.status == "oversized" }.count
+            )
+        }
+        DispatchQueue.main.async {
+            guard let model else { return }
+            switch result {
+            case .success(let values):
+                usage =
+                    ByteCountFormatter.string(fromByteCount: values.0, countStyle: .file)
+                    + "\n\(values.1) " + archiveTitle("Status.pending", context)
+                    + " · \(values.2) " + archiveTitle("Status.unavailable", context)
+            case .failure(let error): usage = error.localizedDescription
+            }
+            model.refresh()
+        }
+    }
+    return controller
+}
+
+private func additionalArchiveChatsController(context: AccountContext, account: String) -> ViewController {
+    let model = AdditionalForm(context: context)
+    var chats: [ArchivedChat] = []
+    var loading = true
+    var error: String?
+    model.entries = { lang in
+        var entries: [AdditionalFormEntry] = []
+        if let error { entries.append(.init(stableId: 0, section: 0, kind: .notice, title: error)) }
+        if chats.isEmpty {
+            entries.append(
+                .init(
+                    stableId: 1, section: 0, kind: .notice,
+                    title: i18n(loading ? "Additional.ArchiveLoading" : "Additional.ArchiveEmpty", lang)))
+        }
+        for (index, chat) in chats.enumerated() {
+            entries.append(
+                .init(
+                    stableId: index + 100, section: 1, kind: .disclosure, title: chat.title,
+                    value: String(chat.messages)))
+        }
+        return entries
+    }
+    model.action = { [weak model] id in
+        guard let model, id >= 100, chats.indices.contains(id - 100) else { return }
+        model.push(
+            additionalDeletedMessagesController(
+                context: context, account: account, chat: chats[id - 100].id, deletedOnly: false))
+    }
+    let controller = model.make(title: archiveTitle("Chats", context))
+    DispatchQueue.global(qos: .utility).async { [weak model] in
+        let result = Result { try DeletedMessageArchive.shared.chats(account: account) }
+        DispatchQueue.main.async {
+            guard let model else { return }
+            loading = false
+            switch result {
+            case .success(let values): chats = values
+            case .failure(let failure): error = failure.localizedDescription
+            }
+            model.refresh()
+        }
+    }
+    return controller
+}
+
+private final class AdditionalArchiveAudio: NSObject {
+    let player: MediaPlayer
+    var subscription: Disposable?
+    init(context: AccountContext, file: URL) {
+        let resource = LocalFileReferenceMediaResource(
+            localFilePath: file.path, randomId: Int64.random(in: Int64.min...Int64.max))
+        player = MediaPlayer(
+            audioSessionManager: context.sharedContext.mediaManager.audioSession, postbox: context.account.postbox,
+            userLocation: .other, userContentType: .other, resourceReference: .standalone(resource: resource),
+            tempFilePath: file.path,
+            streamable: .none, video: false, preferSoftwareDecoding: true, enableSound: true, fetchAutomatically: false,
+            isAudioVideoMessage: true)
+    }
+    deinit {
+        subscription?.dispose()
+        player.pause()
+    }
+}
+
+private func additionalArchiveAudioController(context: AccountContext, file: URL) -> ViewController {
+    let model = AdditionalForm(context: context)
+    let audio = AdditionalArchiveAudio(context: context, file: file)
+    model.documentDelegate = audio
+    var seek = "0"
+    var position = ""
+    model.entries = { lang in
+        [
+            .init(stableId: 0, section: 0, kind: .notice, title: position),
+            .init(stableId: 1, section: 1, kind: .action, title: i18n("Additional.ArchivePlay", lang)),
+            .init(stableId: 2, section: 1, kind: .action, title: i18n("Additional.ArchivePause", lang)),
+            .init(stableId: 3, section: 2, kind: .input, title: i18n("Additional.ArchiveSeek", lang), value: seek),
+            .init(stableId: 4, section: 2, kind: .action, title: i18n("Additional.ArchiveSeek", lang)),
+        ]
+    }
+    model.input = { _, value in seek = value }
+    model.action = { [weak model] id in
+        if id == 1 {
+            audio.player.play()
+        } else if id == 2 {
+            audio.player.pause()
+        } else if id == 4 {
+            guard let seconds = Double(seek), seconds.isFinite, seconds >= 0 else {
+                model?.error(SettingsError.invalid(archiveTitle("Seek", context)))
+                return
+            }
+            audio.player.seek(timestamp: seconds)
+        }
+    }
+    audio.subscription = (audio.player.status |> deliverOnMainQueue).start(next: { [weak model] status in
+        position = String(format: "%.0f / %.0f s", status.timestamp, status.duration)
+        model?.refresh()
+    })
+    return model.make(title: archiveTitle("Kind.voice", context))
+}
+
+private func archivePurge(
+    context: AccountContext, account: String, chat: String? = nil, message: ArchivedMessageID? = nil,
+    completion: @escaping (Bool) -> Void
+) {
+    let _ =
+        (context.sharedContext.activeAccountsWithInfo |> take(1)
+        |> mapToSignal { info -> Signal<Bool, NoError> in
+            guard let selected = info.accounts.first(where: { additionalAccountKey($0.account.peerId) == account })
+            else { return .single(false) }
+            return additionalPurgeArchive(account: selected.account, chat: chat, message: message)
+        } |> deliverOnMainQueue).startStandalone(next: completion)
+}
+
+private func archiveAttachmentChanges(account: String) -> Signal<Void, NoError> {
+    Signal { subscriber in
+        let observer = NotificationCenter.default.addObserver(
+            forName: Notification.Name("SGAArchiveAttachmentChanged"), object: nil, queue: nil
+        ) { notification in
+            if notification.object as? String == account { subscriber.putNext(()) }
+        }
+        return ActionDisposable { NotificationCenter.default.removeObserver(observer) }
+    }
+}
