diff --git a/Swiftgram/SGSettingsUI/Tests/AdditionalArchivePresentationTests.swift b/Swiftgram/SGSettingsUI/Tests/AdditionalArchivePresentationTests.swift
new file mode 100644
index 00000000..ef2bfc3d
--- /dev/null
+++ b/Swiftgram/SGSettingsUI/Tests/AdditionalArchivePresentationTests.swift
@@ -0,0 +1,70 @@
+import SGAdditionalCore
+import TextFormat
+import UIKit
+import XCTest
+
+@testable import SGSettingsUI
+
+final class AdditionalArchivePresentationTests: XCTestCase {
+    func testEntryOrderingKeepsPaginationAfterMessages() {
+        let entries: [AdditionalFormEntry] = [
+            .init(stableId: 10, section: 3, kind: .action, title: "More"),
+            .init(stableId: 100, section: 2, kind: .notice, title: "Message"),
+            .init(stableId: 7, section: 0, kind: .toggle, title: "Filter"),
+            .init(stableId: 0, section: 0, kind: .input, title: "Search"),
+            .init(stableId: 5, section: 1, kind: .notice, title: "Status"),
+        ]
+        let sorted = entries.sorted()
+        XCTAssertEqual(sorted.map { $0.stableId }, [0, 7, 5, 100, 10])
+        for index in 1..<sorted.count { XCTAssertTrue(sorted[index - 1] < sorted[index]) }
+    }
+
+    private func render(_ text: String, entities: [RevisionEntity], hideSpoilers: Bool = true) -> NSAttributedString {
+        additionalArchiveAttributedText(
+            MessageRevision(text: text, entities: entities, messageDate: 1, editDate: nil),
+            font: UIFont.systemFont(ofSize: 16), textColor: .black, linkColor: .blue, hideSpoilers: hideSpoilers)
+    }
+
+    func testOverlappingBoldAndItalicArePreserved() {
+        let text = render(
+            "Hello",
+            entities: [
+                .init(kind: "messageEntityBold", offset: 0, length: 5, value: nil),
+                .init(kind: "messageEntityItalic", offset: 0, length: 5, value: nil),
+            ])
+        let font = text.attribute(.font, at: 0, effectiveRange: nil) as? UIFont
+        XCTAssertTrue(font?.fontDescriptor.symbolicTraits.contains(.traitBold) == true)
+        XCTAssertTrue(font?.fontDescriptor.symbolicTraits.contains(.traitItalic) == true)
+    }
+
+    func testHiddenSpoilersDoNotExposeAccessibleTextOrLinks() {
+        let source = "https://example.com"
+        let entities: [RevisionEntity] = [
+            .init(kind: "messageEntityUrl", offset: 0, length: source.utf16.count, value: nil),
+            .init(kind: "messageEntitySpoiler", offset: 0, length: source.utf16.count, value: nil),
+        ]
+        let hidden = render(source, entities: entities)
+        XCTAssertFalse(hidden.string.contains("example"))
+        XCTAssertNil(
+            hidden.attribute(NSAttributedString.Key(rawValue: TelegramTextAttributes.URL), at: 0, effectiveRange: nil))
+        let revealed = render(source, entities: entities, hideSpoilers: false)
+        XCTAssertEqual(revealed.string, source)
+        XCTAssertEqual(
+            revealed.attribute(NSAttributedString.Key(rawValue: TelegramTextAttributes.URL), at: 0, effectiveRange: nil)
+                as? String, source)
+    }
+
+    func testSpoilerReplacementPreservesUTF16AndRejectsSplitSurrogates() {
+        let source = "A😀x"
+        let hidden = render(
+            source,
+            entities: [
+                .init(kind: "messageEntitySpoiler", offset: 1, length: 2, value: nil),
+                .init(kind: "messageEntityBold", offset: 2, length: 1, value: nil),
+            ])
+        XCTAssertEqual(hidden.string, "A••x")
+        XCTAssertEqual(hidden.length, source.utf16.count)
+        let font = hidden.attribute(.font, at: 2, effectiveRange: nil) as? UIFont
+        XCTAssertFalse(font?.fontDescriptor.symbolicTraits.contains(.traitBold) == true)
+    }
+}
