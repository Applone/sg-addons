+func additionalRetentionController(context: AccountContext, account: String?) -> ViewController {
+    let model = AdditionalForm(context: context)
+    var value = String(AddonSettings.shared.profile(account).retentionDays)
+    model.entries = { lang in [AdditionalFormEntry(stableId: 0, section: 0, kind: .input, title: i18n("Additional.Retention", lang), value: value), AdditionalFormEntry(stableId: 1, section: 1, kind: .action, title: i18n("Additional.Save", lang))] }
+    model.input = { _, text in value = text }
+    model.action = { [weak model] _ in
+        guard let model else { return }
+        do {
+            guard let days = Int(value), (1...365).contains(days) else { throw SettingsError.invalid("1–365") }
+            var profile = AddonSettings.shared.profile(account); profile.retentionDays = days
+            try AddonSettings.shared.save(profile, account: account)
+            model.controller?.navigationController?.popViewController(animated: true)
+        } catch { model.error(error) }
+    }
+    return model.make(title: i18n("Additional.Retention", context.sharedContext.currentPresentationData.with { $0.strings.baseLanguageCode }))
+}
+
+func additionalPeersController(context: AccountContext, title: String, values initial: [String], changed: @escaping ([String]) -> Void) -> ViewController {
+    let model = AdditionalForm(context: context)
+    var values = initial
+    var names: [String: String] = [:]
+    model.entries = { lang in
+        [AdditionalFormEntry(stableId: 0, section: 0, kind: .action, title: i18n("Additional.Add", lang))] + values.enumerated().map { index, id in
+            AdditionalFormEntry(stableId: index + 1, section: 1, kind: .action, title: (names[id] ?? id) + " · " + i18n("Additional.Remove", lang))
+        }
+    }
+    model.action = { [weak model] id in
+        guard let model else { return }
+        if id > 0 {
+            guard values.indices.contains(id - 1) else { return }
+            values.remove(at: id - 1); changed(values); model.refresh()
+        } else {
+            let picker = context.sharedContext.makePeerSelectionController(PeerSelectionControllerParams(context: context, filter: [.excludeSecretChats, .doNotSearchMessages], title: title, selectForumThreads: false))
+            picker.peerSelected = { [weak model, weak picker] peer, _ in
+                guard let model, let key = additionalChatKey(peer.id) else { return }
+                names[key] = peer.debugDisplayTitle
+                if !values.contains(key) { values.append(key); changed(values) }
+                picker?.navigationController?.popViewController(animated: true)
+                model.refresh()
+            }
+            model.push(picker)
+        }
+    }
+    return model.make(title: title)
+}
+
+func additionalFiltersController(context: AccountContext, account: String?) -> ViewController {
+    let model = AdditionalForm(context: context)
+    model.entries = { lang in
+        var entries = [AdditionalFormEntry(stableId: 0, section: 0, kind: .action, title: i18n("Additional.Add", lang)), AdditionalFormEntry(stableId: 1, section: 0, kind: .action, title: i18n("Additional.Import", lang)), AdditionalFormEntry(stableId: 2, section: 0, kind: .action, title: i18n("Additional.Export", lang))]
+        entries += AddonSettings.shared.profile(account).filters.enumerated().map { index, rule in
+            AdditionalFormEntry(stableId: index + 10, section: 1, kind: .disclosure, title: rule.pattern.isEmpty ? rule.users.joined(separator: ", ") : rule.pattern, value: rule.enabled ? "✓" : "")
+        }
+        return entries
+    }
+    model.action = { [weak model] id in
+        guard let model else { return }
+        if id == 1 || id == 2 {
+            let delegate = AdditionalDocuments(model: model, account: account)
+            model.documentDelegate = delegate
+            do { try delegate.open(export: id == 2) } catch { model.error(error) }
+        } else {
+            model.push(additionalRuleController(context: context, account: account, index: id == 0 ? nil : id - 10))
+        }
+    }
+    return model.make(title: i18n("Additional.EditFilters", context.sharedContext.currentPresentationData.with { $0.strings.baseLanguageCode }))
+}
+
+private func additionalRuleController(context: AccountContext, account: String?, index: Int?) -> ViewController {
+    let model = AdditionalForm(context: context)
+    let initial = AddonSettings.shared.profile(account).filters
+    var rule = index.flatMap { initial.indices.contains($0) ? initial[$0] : nil } ?? FilterRule()
+    model.entries = { lang in
+        func entry(_ id: Int, _ section: Int32, _ kind: AdditionalFormEntry.Kind, _ key: String, _ value: String = "") -> AdditionalFormEntry {
+            AdditionalFormEntry(stableId: id, section: section, kind: kind, title: i18n("Additional." + key, lang), value: value)
+        }
+        return [entry(0, 0, .toggle, "Enabled", rule.enabled ? "1" : "0"), entry(1, 0, .input, "Pattern", rule.pattern), entry(2, 0, .disclosure, "Mode", i18n("Additional." + rule.mode, lang)), entry(3, 0, .toggle, "CaseSensitive", rule.caseSensitive ? "1" : "0"), entry(4, 0, .toggle, "Reversed", rule.reversed ? "1" : "0"), entry(5, 1, .disclosure, "Chats", String(rule.chats.count)), entry(6, 1, .disclosure, "ExcludeChats", String(rule.excludeChats.count)), entry(7, 1, .disclosure, "Users", String(rule.users.count)), entry(8, 2, .action, "Save")] + (index == nil ? [] : [entry(9, 2, .action, "Remove")])
+    }
+    model.input = { [weak model] id, text in
+        switch id { case 0: rule.enabled = text == "1"; case 1: rule.pattern = text; case 3: rule.caseSensitive = text == "1"; case 4: rule.reversed = text == "1"; default: break }
+        if id != 1 { model?.refresh() }
+    }
+    model.action = { [weak model] id in
+        guard let model else { return }
+        if id == 2 {
+            let modes = ["contains", "word", "regex"]
+            rule.mode = modes[((modes.firstIndex(of: rule.mode) ?? 0) + 1) % modes.count]
+            model.refresh()
+        } else if (5...7).contains(id) {
+            let keyPath: WritableKeyPath<FilterRule, [String]> = id == 5 ? \.chats : (id == 6 ? \.excludeChats : \.users)
+            let lang = context.sharedContext.currentPresentationData.with { $0.strings.baseLanguageCode }
+            model.push(additionalPeersController(context: context, title: i18n("Additional." + (id == 5 ? "Chats" : id == 6 ? "ExcludeChats" : "Users"), lang), values: rule[keyPath: keyPath], changed: { values in rule[keyPath: keyPath] = values; model.refresh() }))
+        } else if id == 8 || id == 9 {
+            do {
+                var profile = AddonSettings.shared.profile(account)
+                // Avoid applying an index to a list replaced by an import while this editor was open.
+                guard initial == profile.filters else { throw SettingsError.invalid("Filters changed. Reopen this editor.") }
+                if let index { if id == 9 { profile.filters.remove(at: index) } else { try rule.validate(); profile.filters[index] = rule } }
+                else { try rule.validate(); profile.filters.append(rule) }
+                try AddonSettings.shared.save(profile, account: account)
+                model.controller?.navigationController?.popViewController(animated: true)
+            } catch { model.error(error) }
+        }
+    }
+    return model.make(title: i18n("Additional.Filters", context.sharedContext.currentPresentationData.with { $0.strings.baseLanguageCode }))
+}
+
+func additionalDiagnosticsController(context: AccountContext) -> ViewController {
+    let model = AdditionalForm(context: context)
+    model.entries = { _ in [AdditionalFormEntry(stableId: 0, section: 0, kind: .notice, title: MessageArchive.shared.status() ?? "Message archive ready"), AdditionalFormEntry(stableId: 1, section: 1, kind: .notice, title: UserDefaults.standard.string(forKey: "SwiftgramAddonStorageStatus") ?? "Storage status unavailable")] }
+    return model.make(title: i18n("Additional.Diagnostics", context.sharedContext.currentPresentationData.with { $0.strings.baseLanguageCode }))
+}
+
+private final class AdditionalDocuments: NSObject, UIDocumentPickerDelegate {
+    weak var model: AdditionalForm?
+    let account: String?
+    private var exporting = false
+    init(model: AdditionalForm, account: String?) { self.model = model; self.account = account }
+    func open(export: Bool) throws {
+        guard let model, let controller = model.controller else { return }
+        let picker: UIDocumentPickerViewController
+        self.exporting = export
+        if export {
+            let directory = FileManager.default.temporaryDirectory.appendingPathComponent("AdditionalExport-" + UUID().uuidString)
+            try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+            let url = directory.appendingPathComponent("filters.json")
+            let encoder = JSONEncoder(); encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+            try encoder.encode(AddonSettings.shared.profile(account).filters).write(to: url, options: .atomic)
+            picker = UIDocumentPickerViewController(forExporting: [url], asCopy: true)
+        } else {
+            picker = UIDocumentPickerViewController(forOpeningContentTypes: [.json], asCopy: false)
+        }
+        picker.delegate = self
+        controller.present(picker, animated: true)
+    }
+    func documentPicker(_ controller: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
+        guard !exporting, let url = urls.first, let model else { return }
+        let access = url.startAccessingSecurityScopedResource()
+        defer { if access { url.stopAccessingSecurityScopedResource() } }
+        do {
+            let size = try url.resourceValues(forKeys: [.fileSizeKey]).fileSize ?? 0
+            guard size <= 4 * 1024 * 1024 else { throw SettingsError.invalid("Filter file exceeds 4 MB") }
+            let data = try Data(contentsOf: url)
+            guard data.count <= 4 * 1024 * 1024 else { throw SettingsError.invalid("Filter file exceeds 4 MB") }
+            var profile = AddonSettings.shared.profile(account)
+            profile.filters = try JSONDecoder().decode([FilterRule].self, from: data)
+            try AddonSettings.shared.save(profile, account: account)
+            model.refresh()
+        } catch { model.error(error) }
+    }
+}
+
+func additionalEditingContext(context: AccountContext, account: String?, completed: @escaping (AccountContext) -> Void) {
+    guard let account, account != additionalAccountKey(context.account.peerId) else { completed(context); return }
+    let _ = (context.sharedContext.activeAccountsWithInfo |> take(1) |> deliverOnMainQueue).start(next: { info in
+        guard let selected = info.accounts.first(where: { additionalAccountKey($0.account.peerId) == account }) else { return }
+        completed(context.sharedContext.makeTempAccountContext(account: selected.account))
+    })
+}
