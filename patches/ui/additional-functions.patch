+/// Read-only history. Its messages are constructed in memory and never enter Postbox.
+final class AdditionalHistoryController: ViewController {
+    private let context: AccountContext
+    private let original: Message
+    private let key: MessageKey
+    private let messages = Promise<([Message], Int32, Bool)>()
+    private var history: ChatHistoryListNodeImpl?
+    private var background: WallpaperBackgroundNode?
+    private let notice = UILabel()
+    private var presentationDisposable: Disposable?
+    private var latestVersion: Int64?
+
+    init(context: AccountContext, message: Message, key: MessageKey) {
+        self.context = context; self.original = message; self.key = key
+        let data = context.sharedContext.currentPresentationData.with { $0 }
+        super.init(navigationBarPresentationData: NavigationBarPresentationData(presentationData: data, style: .glass))
+        self.title = i18n("Additional.EditHistory", data.strings.baseLanguageCode)
+        self.navigationItem.backBarButtonItem = UIBarButtonItem(title: data.strings.Common_Back, style: .plain, target: nil, action: nil)
+        self.ready.set(.single(true))
+    }
+    required init(coder: NSCoder) { fatalError("init(coder:) is unavailable") }
+    deinit { presentationDisposable?.dispose() }
+
+    override func loadDisplayNode() {
+        self.displayNode = ASDisplayNode()
+        let data = context.sharedContext.currentPresentationData.with { $0 }
+        let background = createWallpaperBackgroundNode(context: context, forChatDisplay: true)
+        self.background = background
+        displayNode.addSubnode(background)
+        let interaction = historyInteraction(context: context, backgroundNode: background) { [weak self] message in
+            guard let self else { return }
+            let current = self.context.sharedContext.currentPresentationData.with { $0 }
+            let sheet = ActionSheetController(presentationData: current)
+            sheet.setItemGroups([ActionSheetItemGroup(items: [ActionSheetButtonItem(title: current.strings.Common_Copy, color: .accent, action: { [weak sheet] in
+                UIPasteboard.general.string = message.text; sheet?.dismissAnimated()
+            })]), ActionSheetItemGroup(items: [ActionSheetButtonItem(title: current.strings.Common_Cancel, color: .accent, action: { [weak sheet] in sheet?.dismissAnimated() })])])
+            self.present(sheet, in: .window(.root))
+        }
+        interaction.canReadHistory = false
+        let history = ChatHistoryListNodeImpl(context: context, updatedPresentationData: (data, context.sharedContext.presentationData), systemStyle: .glass,
+            chatLocation: .peer(id: original.id.peerId), chatLocationContextHolder: Atomic(value: nil), adMessagesContext: nil, tag: nil,
+            source: .custom(messages: messages.get(), messageId: nil, quote: nil, isSavedMusic: false, canReorder: false, richMessageId: nil, loadMore: nil),
+            subject: nil, controllerInteraction: interaction, selectedMessages: .single(nil), mode: .bubbles, isChatPreview: true, messageTransitionNode: { nil })
+        history.canReadHistory.set(.single(false))
+        history.enableUnreadAlignment = false
+        self.history = history
+        displayNode.addSubnode(history)
+        notice.numberOfLines = 0; notice.textAlignment = .center
+        notice.adjustsFontForContentSizeCategory = true
+        notice.font = UIFont.preferredFont(forTextStyle: .footnote)
+        notice.isAccessibilityElement = true
+        displayNode.view.addSubview(notice)
+        presentationDisposable = (context.sharedContext.presentationData |> deliverOnMainQueue).start(next: { [weak self] data in
+            self?.apply(data)
+        })
+        MessageArchive.shared.history(key) { [weak self] revisions in
+            guard let self else { return }
+            self.latestVersion = revisions.last?.version
+            let result: [Message] = revisions.enumerated().map { index, revision in
+                let id = MessageId(peerId: self.original.id.peerId, namespace: Namespaces.Message.Local, id: Int32(clamping: index + 1))
+                return Message(stableId: UInt32(index + 1), stableVersion: 0, id: id, globallyUniqueId: nil, groupingKey: nil, groupInfo: nil, threadId: nil,
+                    timestamp: Int32(clamping: revision.version), flags: self.original.flags.contains(.Incoming) ? [.Incoming] : [], tags: [], globalTags: [], localTags: [], customTags: [],
+                    forwardInfo: nil, author: self.original.author, text: revision.text,
+                    attributes: [TextEntitiesMessageAttribute(entities: additionalTextEntities(revision))], media: [], peers: self.original.peers,
+                    associatedMessages: SimpleDictionary(), associatedMessageIds: [], associatedMedia: [:], associatedThreadInfo: nil, associatedStories: [:])
+            }
+            self.messages.set(.single((Array(result.reversed()), 0, false)))
+            self.apply(self.context.sharedContext.currentPresentationData.with { $0 })
+            self.requestLayout(transition: .immediate)
+        }
+        apply(data)
+    }
+
+    private func apply(_ data: PresentationData) {
+        background?.update(wallpaper: data.chatWallpaper, animated: false)
+        notice.textColor = data.theme.list.itemSecondaryTextColor
+        notice.backgroundColor = data.theme.list.blocksBackgroundColor.withAlphaComponent(0.9)
+        let lang = data.strings.baseLanguageCode
+        if let version = latestVersion {
+            let formatter = DateFormatter(); formatter.dateStyle = .medium; formatter.timeStyle = .medium
+            notice.text = i18n("Additional.Latest", lang) + " · " + formatter.string(from: Date(timeIntervalSince1970: TimeInterval(version))) + "\n" + i18n("Additional.HistoryNotice", lang)
+        } else { notice.text = i18n("Additional.EmptyHistory", lang) }
+        self.navigationBar?.updatePresentationData(NavigationBarPresentationData(presentationData: data, style: .glass), transition: .immediate)
+        self.statusBar.statusBarStyle = data.theme.rootController.statusBarStyle.style
+        self.title = i18n("Additional.EditHistory", lang)
+    }
+    override func containerLayoutUpdated(_ layout: ContainerViewLayout, transition: ContainedViewLayoutTransition) {
+        super.containerLayoutUpdated(layout, transition: transition)
+        guard let history, let background else { return }
+        transition.updateFrame(node: background, frame: CGRect(origin: .zero, size: layout.size))
+        background.updateLayout(size: layout.size, displayMode: .aspectFill, transition: transition)
+        let top = self.navigationLayout(layout: layout).navigationFrame.maxY
+        let height = notice.sizeThatFits(CGSize(width: max(1, layout.size.width - 32), height: .greatestFiniteMagnitude)).height + 16
+        notice.frame = CGRect(x: 16, y: top + 8, width: layout.size.width - 32, height: height)
+        transition.updateFrame(node: history, frame: CGRect(origin: .zero, size: layout.size))
+        history.updateLayout(transition: transition, updateSizeAndInsets: ListViewUpdateSizeAndInsets(size: layout.size,
+            insets: UIEdgeInsets(top: top + height + 24, left: layout.safeInsets.left, bottom: layout.intrinsicInsets.bottom + 12, right: layout.safeInsets.right), duration: 0, curve: .Default(duration: nil)))
+    }
+}
