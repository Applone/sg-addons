+func additionalSettingsChanges() -> Signal<Int, NoError> {
+    Signal { subscriber in
+        subscriber.putNext(AddonSettings.shared.version())
+        let token = NotificationCenter.default.addObserver(forName: Notification.Name("SGASettingsDidChange"), object: nil, queue: .main) { _ in
+            subscriber.putNext(AddonSettings.shared.version())
+        }
+        return ActionDisposable { NotificationCenter.default.removeObserver(token) }
+    }
+}
+
+func additionalError(context: AccountContext, error: Error) -> ViewController {
+    let data = context.sharedContext.currentPresentationData.with { $0 }
+    return textAlertController(context: context, title: nil, text: error.localizedDescription, actions: [TextAlertAction(type: .defaultAction, title: data.strings.Common_OK, action: {})])
+}
+
+private struct AdditionalFormEntry: ItemListNodeEntry {
+    enum Kind: Equatable { case input, toggle, action, disclosure, notice }
+    let stableId: Int
+    let section: ItemListSectionId
+    let kind: Kind
+    let title: String
+    var value: String = ""
+    static func < (lhs: Self, rhs: Self) -> Bool { lhs.stableId < rhs.stableId }
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let model = arguments as! AdditionalForm
+        switch kind {
+        case .input:
+            return ItemListSingleLineInputItem(presentationData: presentationData, systemStyle: .glass, title: NSAttributedString(string: title), text: value, placeholder: title, type: .regular(capitalization: false, autocorrection: false), clearType: .always, sectionId: section, textUpdated: { model.input(self.stableId, $0) }, action: {})
+        case .toggle:
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, value: value == "1", sectionId: section, style: .blocks, updated: { model.input(self.stableId, $0 ? "1" : "0") })
+        case .action:
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: .generic, alignment: .natural, sectionId: section, style: .blocks, action: { model.action(self.stableId) })
+        case .disclosure:
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: title, label: value, sectionId: section, style: .blocks, action: { model.action(self.stableId) })
+        case .notice:
+            return ItemListTextItem(presentationData: presentationData, text: .plain(title), sectionId: section)
+        }
+    }
+}
+
+private final class AdditionalForm {
+    let context: AccountContext
+    let revision = ValuePromise<Int>(0, ignoreRepeated: false)
+    weak var controller: ItemListController?
+    var entries: (String) -> [AdditionalFormEntry] = { _ in [] }
+    var input: (Int, String) -> Void = { _, _ in }
+    var action: (Int) -> Void = { _ in }
+    var documentDelegate: AdditionalDocuments?
+    init(context: AccountContext) { self.context = context }
+    func refresh() { revision.set(0) }
+    func error(_ error: Error) { controller?.present(additionalError(context: context, error: error), in: .window(.root)) }
+    func push(_ next: ViewController) { (controller?.navigationController as? NavigationController)?.pushViewController(next) }
+    func make(title: String) -> ViewController {
+        let state = combineLatest(context.sharedContext.presentationData, revision.get(), additionalSettingsChanges())
+        |> deliverOnMainQueue
+        |> map { [self] data, _, _ -> (ItemListControllerState, (ItemListNodeState, AdditionalForm)) in
+            let presentation = ItemListPresentationData(data)
+            return (ItemListControllerState(presentationData: presentation, title: .text(title), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: data.strings.Common_Back)),
+                (ItemListNodeState(presentationData: presentation, entries: entries(data.strings.baseLanguageCode), style: .blocks), self))
+        }
+        let controller = ItemListController(context: context, state: state)
+        self.controller = controller
+        return controller
+    }
+}
