diff --git a/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalLocalPremium.swift b/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalLocalPremium.swift
new file mode 100644
index 0000000000000000000000000000000000000000..46c6c552271e08cc877826956e1f82d212a0e7f5
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalLocalPremium.swift
@@ -0,0 +1,86 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+import TelegramApi
+import SGAdditionalCore
+
+func additionalPresentationChanges() -> Signal<Void, NoError> {
+    Signal { subscriber in
+        subscriber.putNext(())
+        let token = NotificationCenter.default.addObserver(forName: Notification.Name("SGASettingsDidChange"), object: nil, queue: nil) { _ in subscriber.putNext(()) }
+        return ActionDisposable { NotificationCenter.default.removeObserver(token) }
+    }
+}
+
+private final class AdditionalBadgeExpiration {
+    static let shared = AdditionalBadgeExpiration()
+    private var deadlines: [String: Int32] = [:]
+    func schedule(account: String, until: Int32) {
+        DispatchQueue.main.async {
+            guard self.deadlines[account] != until else { return }
+            self.deadlines[account] = until
+            let delay = max(0, TimeInterval(until) - Date().timeIntervalSince1970)
+            DispatchQueue.main.asyncAfter(deadline: .now() + delay) {
+                guard self.deadlines[account] == until else { return }
+                self.deadlines.removeValue(forKey: account)
+                NotificationCenter.default.post(name: Notification.Name("SGASettingsDidChange"), object: nil)
+            }
+        }
+    }
+}
+
+public func additionalPresentationPeer(_ peer: Peer, account: PeerId) -> Peer {
+    guard peer.id == account, let user = peer as? TelegramUser,
+          AddonSettings.shared.profile(additionalAccountKey(account)).localPremium else { return peer }
+    // This copy is used only in view signals. Transactions and server subscription checks use the raw peer.
+    var flags = user.flags; flags.insert(.isPremium)
+    var result = user.withUpdatedFlags(flags)
+    if !user.flags.contains(.isPremium), let bytes = AdditionalLocalProfileState.shared.badge(account: additionalAccountKey(account)), !bytes.isEmpty,
+       let status = Api.parse(Buffer(data: bytes)) as? Api.EmojiStatus {
+        var badge = PeerEmojiStatus(apiStatus: status)
+        if let until = badge?.expirationDate {
+            if TimeInterval(until) <= Date().timeIntervalSince1970 { badge = nil }
+            else { AdditionalBadgeExpiration.shared.schedule(account: additionalAccountKey(account), until: until) }
+        }
+        result = result.withUpdatedEmojiStatus(badge)
+    }
+    return result
+}
+
+func additionalPresentationView(_ view: PostboxView, account: PeerId) -> PostboxView {
+    if let view = view as? BasicPeerView, let peer = view.peer {
+        return view.withUpdatedPeer(additionalPresentationPeer(peer, account: account))
+    }
+    if let view = view as? PeerView, let peer = view.peers[account] {
+        var peers = view.peers; peers[account] = additionalPresentationPeer(peer, account: account)
+        return view.withUpdatedPeers(peers)
+    }
+    return view
+}
+
+func additionalSelectBadgeIfLocal(account: Account, badge: Api.EmojiStatus, media: [Media]) -> Signal<Bool, NoError> {
+    account.postbox.transaction { transaction in
+        guard AddonSettings.shared.profile(additionalAccountKey(account.peerId)).localPremium,
+              let user = transaction.getPeer(account.peerId) as? TelegramUser,
+              !user.flags.contains(.isPremium) else { return false }
+        for file in media { transaction.storeMediaIfNotPresent(media: file) }
+        let buffer = Buffer(); badge.serialize(buffer, true)
+        AdditionalLocalProfileState.shared.select(badge: buffer.makeData(), account: additionalAccountKey(account.peerId))
+        return true
+    }
+}
+
+/// Older injected builds persisted their presentation flags into Postbox. Restore just those fields once.
+func additionalRestoreLegacyProfile(transaction: Transaction, account: PeerId) -> Bool {
+    let key = additionalAccountKey(account)
+    guard AdditionalLocalProfileState.shared.legacyProfileNeedsRestoration(account: key),
+          let data = AdditionalLocalProfileState.shared.legacyServerUser(account: key), !data.isEmpty,
+          let apiUser = Api.parse(Buffer(data: data)) as? Api.User,
+          let current = transaction.getPeer(account) as? TelegramUser else { return false }
+    let server = TelegramUser(user: apiUser)
+    guard server.id == account else { return false }
+    var flags = current.flags
+    if server.flags.contains(.isPremium) { flags.insert(.isPremium) } else { flags.remove(.isPremium) }
+    updatePeersCustom(transaction: transaction, peers: [current.withUpdatedFlags(flags).withUpdatedEmojiStatus(server.emojiStatus)], update: { _, updated in updated })
+    return true
+}
diff --git a/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalMessages.swift b/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalMessages.swift
new file mode 100644
index 0000000000000000000000000000000000000000..65814070885454d135f60ae4879d55d2a6a5f006
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalMessages.swift
@@ -0,0 +1,130 @@
+import Foundation
+import Postbox
+import SGAdditionalCore
+
+public func additionalAccountKey(_ id: PeerId) -> String { String(id.id._internalGetInt64Value()) }
+
+public func additionalChatKey(_ id: PeerId) -> String? {
+    let prefix: String
+    switch id.namespace {
+    case Namespaces.Peer.CloudUser: prefix = "user"
+    case Namespaces.Peer.CloudGroup: prefix = "chat"
+    case Namespaces.Peer.CloudChannel: prefix = "channel"
+    default: return nil
+    }
+    return "\(prefix):\(id.id._internalGetInt64Value())"
+}
+
+public func additionalMessageKey(account: PeerId, id: MessageId) -> MessageKey? {
+    guard id.namespace == Namespaces.Message.Cloud, let chat = additionalChatKey(id.peerId) else { return nil }
+    return MessageKey(account: additionalAccountKey(account), chat: chat, id: Int64(id.id))
+}
+
+public func additionalCanArchive(attributes: [MessageAttribute], media: [Media]) -> Bool {
+    !attributes.contains { $0 is AutoremoveTimeoutMessageAttribute || $0 is AutoclearTimeoutMessageAttribute }
+        && !media.contains { $0 is TelegramMediaAction }
+}
+
+public func additionalRevision(text: String, timestamp: Int32, attributes: [MessageAttribute]) -> MessageRevision {
+    let entities = (attributes.first { $0 is TextEntitiesMessageAttribute } as? TextEntitiesMessageAttribute)?.entities ?? []
+    return MessageRevision(text: text, entities: entities.map(additionalRevisionEntity), messageDate: Int64(timestamp),
+        editDate: (attributes.first { $0 is EditedMessageAttribute } as? EditedMessageAttribute).map { Int64($0.date) })
+}
+
+private func additionalRevisionEntity(_ entity: MessageTextEntity) -> RevisionEntity {
+    let kind: String
+    var value: String?
+    switch entity.type {
+    case .Bold: kind = "Bold"
+    case .Italic: kind = "Italic"
+    case .Code: kind = "Code"
+    case let .Pre(language): kind = "Pre"; value = language
+    case .Underline: kind = "Underline"
+    case .Strikethrough: kind = "Strike"
+    case .Spoiler: kind = "Spoiler"
+    case .Url: kind = "Url"
+    case let .TextUrl(url): kind = "TextUrl"; value = url
+    case let .TextMention(peerId): kind = "MentionName"; value = String(peerId.id._internalGetInt64Value())
+    case let .CustomEmoji(_, fileId): kind = "CustomEmoji"; value = String(fileId)
+    case let .BlockQuote(collapsed): kind = "Blockquote"; value = collapsed ? "1" : "0"
+    case .Mention: kind = "Mention"
+    case .Hashtag: kind = "Hashtag"
+    case .BotCommand: kind = "BotCommand"
+    case .Email: kind = "Email"
+    case .PhoneNumber: kind = "Phone"
+    case .BankCard: kind = "BankCard"
+    default: kind = "Unknown"
+    }
+    return RevisionEntity(kind: "messageEntity" + kind, offset: entity.range.lowerBound, length: entity.range.count, value: value)
+}
+
+public func additionalTextEntities(_ revision: MessageRevision) -> [MessageTextEntity] {
+    revision.entities.compactMap { entity in
+        guard entity.offset >= 0, entity.length > 0, entity.offset <= revision.text.utf16.count,
+              entity.length <= revision.text.utf16.count - entity.offset else { return nil }
+        let type: MessageTextEntityType
+        switch entity.kind {
+        case "messageEntityBold": type = .Bold
+        case "messageEntityItalic": type = .Italic
+        case "messageEntityCode": type = .Code
+        case "messageEntityPre": type = .Pre(language: entity.value)
+        case "messageEntityUnderline": type = .Underline
+        case "messageEntityStrike": type = .Strikethrough
+        case "messageEntitySpoiler": type = .Spoiler
+        case "messageEntityUrl": type = .Url
+        case "messageEntityTextUrl": type = .TextUrl(url: entity.value ?? "")
+        case "messageEntityBlockquote": type = .BlockQuote(isCollapsed: entity.value == "1")
+        case "messageEntityMention": type = .Mention
+        case "messageEntityHashtag": type = .Hashtag
+        case "messageEntityBotCommand": type = .BotCommand
+        case "messageEntityEmail": type = .Email
+        case "messageEntityPhone": type = .PhoneNumber
+        case "messageEntityBankCard": type = .BankCard
+        case "messageEntityCustomEmoji":
+            guard let id = entity.value.flatMap(Int64.init) else { return nil }
+            type = .CustomEmoji(stickerPack: nil, fileId: id)
+        case "messageEntityMentionName":
+            guard let id = entity.value.flatMap(Int64.init) else { return nil }
+            type = .TextMention(peerId: PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(id)))
+        default: return nil
+        }
+        return MessageTextEntity(range: entity.offset ..< entity.offset + entity.length, type: type)
+    }
+}
+
+/// One processor per authorized account, installed before state synchronization starts.
+final class AdditionalMessageProcessor {
+    let account: PeerId
+    private let filters = CompiledFilters()
+    init(account: PeerId) { self.account = account }
+    func process(_ message: StoreMessage) -> StoreMessage? {
+        guard AddonSettings.shared.anyEnabled(), case let .Id(id) = message.id,
+              let key = additionalMessageKey(account: account, id: id) else { return message }
+        let profile = AddonSettings.shared.profile(key.account)
+        let allowed = additionalCanArchive(attributes: message.attributes, media: message.media)
+        if !allowed, profile.saveDeleted || profile.saveEditHistory { MessageArchive.shared.exclude(key) }
+        if allowed {
+            if profile.saveDeleted { MessageArchive.shared.observe(key) }
+            if profile.saveEditHistory {
+                MessageArchive.shared.capture(additionalRevision(text: message.text, timestamp: message.timestamp, attributes: message.attributes), key: key, retentionDays: profile.retentionDays)
+            }
+            if profile.saveDeleted || profile.saveEditHistory { MessageArchive.shared.synchronize() }
+        }
+        if profile.filtersEnabled, message.flags.contains(.Incoming) {
+            var authors = [additionalChatKey(message.authorId ?? id.peerId)].compactMap { $0 }
+            if let original = message.forwardInfo?.authorId, let value = additionalChatKey(original) { authors.append(value) }
+            for attribute in message.attributes {
+                if let bot = (attribute as? InlineBotMessageAttribute)?.peerId, let value = additionalChatKey(bot) { authors.append(value) }
+            }
+            if filters.matches(text: message.text, chat: key.chat, authors: authors, profile: profile, account: key.account) { return nil }
+        }
+        return message
+    }
+}
+
+func additionalRetainDeleted(account: PeerId, id: MessageId, transaction: Transaction) -> Bool {
+    guard AddonSettings.shared.anyRetentionEnabled(), let key = additionalMessageKey(account: account, id: id),
+          AddonSettings.shared.profile(key.account).saveDeleted, let message = transaction.getMessage(id),
+          additionalCanArchive(attributes: message.attributes, media: message.media) else { return false }
+    return MessageArchive.shared.retain(key)
+}
