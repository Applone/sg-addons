+
+private final class StartupActionAdapter: PluginActionAdapter {
+    let started = DispatchSemaphore(value: 0)
+    private let lock = NSLock()
+    private var replies: [() -> Void] = []
+
+    func execute(
+        _ action: PluginAction, directory: URL, progress: @escaping (Double) -> Void,
+        completion: @escaping (PluginActionResult) -> Void
+    ) -> () -> Void {
+        lock.lock()
+        replies.append { completion(.init(id: action.id, status: "completed")) }
+        lock.unlock()
+        started.signal()
+        // Keep the reply available after cancellation to exercise late delivery.
+        return {}
+    }
+
+    func reply() {
+        lock.lock()
+        let reply = replies.isEmpty ? nil : replies.removeFirst()
+        lock.unlock()
+        CheckCore.require(reply != nil, "startup action has a pending reply")
+        reply?()
+    }
+}
