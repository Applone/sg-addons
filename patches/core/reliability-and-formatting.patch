+        // Use the lifecycle API to invalidate old generations before restoring desired state.
+        try registry.setSafeMode(true)
+        try desired.write(to: file, options: .atomic)
+        let reloaded = PluginRegistry(directory: directory, hostVersion: "13.0.1")
+        reloaded.registerActionAdapter(account: "77", adapter: adapter)
+        let event = PluginEvent(kind: .preRequest, name: "account.updateStatus", account: "77")
+        CheckCore.require(reloaded.dispatch(event) == event, "startup actions preserve first request")
+        CheckCore.require(adapter.started.wait(timeout: .now() + 2) == .success, "restored startup action reaches host")
+        adapter.reply()  // Deliberately late completion from the retired registry.
+        adapter.reply()  // Completion belonging to the restored registry.
+        let restored = reloaded.records()[0]
+        CheckCore.require(
+            restored.isEnabled(account: "77"),
+            "startup actions are validated as lifecycle actions, not request actions: " + (restored.error ?? "no error")
+        )
+        try reloaded.remove(manifest.id)
+    }
+
     static func run(root: URL) throws {
+        try startupActions(root: root)
         let registry = PluginRegistry(directory: root.appendingPathComponent("python-core"), hostVersion: "13.0.1")
         guard let examples = ProcessInfo.processInfo.environment["SGA_PLUGIN_EXAMPLES"] else {
