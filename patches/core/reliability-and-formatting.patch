 enum PythonPluginChecks {
+    static func startupActions(root: URL) throws {
+        let directory = root.appendingPathComponent("startup-actions")
+        let registry = PluginRegistry(directory: directory, hostVersion: "13.0.1")
+        let source = """
+            # /// script
+            # id = "startup-actions"
+            # name = "Startup actions"
+            # ///
+            __permissions__ = ["network", "sendMessages"]
+            __hooks__ = [{"event": "preRequest", "name": "account.updateStatus"}]
+            from swiftgram import BasePlugin
+            class Plugin(BasePlugin):
+                def on_plugin_load(self):
+                    self.send_message("user:42", "Started")
+                def pre_request_hook(self, event):
+                    return None
+            """
+        let adapter = StartupActionAdapter()
+        registry.registerActionAdapter(account: "77", adapter: adapter)
