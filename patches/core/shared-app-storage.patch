diff --git a/Swiftgram/SGAppGroupIdentifier/Sources/SGSharedStorage.swift b/Swiftgram/SGAppGroupIdentifier/Sources/SGSharedStorage.swift
new file mode 100644
index 00000000..7096bdc8
--- /dev/null
+++ b/Swiftgram/SGAppGroupIdentifier/Sources/SGSharedStorage.swift
@@ -0,0 +1,87 @@
+import Foundation
+import Darwin
+import SGSignedEntitlements
+
+private struct StorageFailure: Error { let message: String }
+
+enum SGSharedStorage {
+    struct Resolution { let group: String?; let url: URL?; let status: String }
+    static let resolution: Resolution = resolve()
+
+    private static func resolve() -> Resolution {
+        let manager = FileManager.default
+        let extensionProcess = Bundle.main.bundleURL.pathExtension == "appex"
+        let expected = "group.\(sgBaseBundleIdentifier())"
+        let requested = Bundle.main.object(forInfoDictionaryKey: "SwiftgramSharedAppGroup") as? String
+        let signed = SGAdditionalSignedGroups()
+        let candidates = requested.map { signed.contains($0) ? [$0] : [] } ?? (signed.contains(expected) ? [expected] : signed.sorted())
+        for group in candidates {
+            guard let container = manager.containerURL(forSecurityApplicationGroupIdentifier: group) else { continue }
+            do {
+                let url = try prepare(container: container, extensionProcess: extensionProcess)
+                return publish(Resolution(group: group, url: url, status: "App Group sharing ready"))
+            } catch {
+                if extensionProcess { return publish(Resolution(group: group, url: nil, status: "Open Swiftgram once to initialize shared storage, or check signing and storage access.")) }
+                // A failed migration must not publish an empty replacement account store.
+                return fallback(group: group)
+            }
+        }
+        if extensionProcess { return publish(Resolution(group: nil, url: nil, status: "Swiftgram and its extensions require the same signed App Group. Check Feather signing settings.")) }
+        return fallback(group: nil)
+    }
+    private static func publish(_ result: Resolution) -> Resolution {
+        UserDefaults.standard.set(result.status, forKey: "SwiftgramAddonStorageStatus")
+        return result
+    }
+    private static func legacy() throws -> URL {
+        try FileManager.default.url(for: .applicationSupportDirectory, in: .userDomainMask, appropriateFor: nil, create: true)
+            .appendingPathComponent("SwiftgramStartupFix/GroupContainer", isDirectory: true)
+    }
+    private static func fallback(group: String?) -> Resolution {
+        do {
+            let path = try legacy()
+            try FileManager.default.createDirectory(at: path, withIntermediateDirectories: true, attributes: [.protectionKey: FileProtectionType.completeUntilFirstUserAuthentication])
+            return publish(Resolution(group: group, url: path, status: "Private fallback only; sharing requires a common signed App Group."))
+        } catch { return publish(Resolution(group: group, url: nil, status: "Account storage could not be opened.")) }
+    }
+    private static func prepare(container: URL, extensionProcess: Bool) throws -> URL {
+        let manager = FileManager.default
+        let descriptor = open(container.appendingPathComponent(".swiftgram-addon-migration.lock").path, O_CREAT | O_RDWR, 0o600)
+        guard descriptor >= 0 else { throw StorageFailure(message: "Migration lock unavailable") }
+        defer { close(descriptor) }
+        var locked = false
+        for _ in 0..<100 {
+            if flock(descriptor, LOCK_EX | LOCK_NB) == 0 { locked = true; break }
+            usleep(50_000)
+        }
+        guard locked else { throw StorageFailure(message: "Migration busy") }
+        defer { flock(descriptor, LOCK_UN) }
+        if manager.fileExists(atPath: container.appendingPathComponent("telegram-data").path) { return container }
+        let destination = container.appendingPathComponent("SwiftgramSharedStorage", isDirectory: true)
+        if manager.fileExists(atPath: destination.path) { return destination }
+        guard !extensionProcess else { throw StorageFailure(message: "Main app initialization required") }
+        let source = try legacy()
+        let staging = container.appendingPathComponent(".swiftgram-migrate-" + UUID().uuidString, isDirectory: true)
+        var published = false
+        defer { if !published { try? manager.removeItem(at: staging) } }
+        if manager.fileExists(atPath: source.path) {
+            try manager.copyItem(at: source, to: staging)
+            var enumerationError: Error?
+            guard let files = manager.enumerator(at: source, includingPropertiesForKeys: [.isRegularFileKey, .isSymbolicLinkKey], errorHandler: { _, error in enumerationError = error; return false }) else { throw StorageFailure(message: "Migration verification unavailable") }
+            for case let file as URL in files {
+                let values = try file.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey])
+                guard values.isSymbolicLink != true else { throw StorageFailure(message: "Unexpected symbolic link in storage") }
+                if values.isRegularFile == true {
+                    let relative = String(file.path.dropFirst(source.path.count + 1))
+                    guard manager.contentsEqual(atPath: file.path, andPath: staging.appendingPathComponent(relative).path) else { throw StorageFailure(message: "Storage copy verification failed") }
+                }
+            }
+            if let error = enumerationError { throw error }
+        } else {
+            try manager.createDirectory(at: staging, withIntermediateDirectories: true, attributes: [.protectionKey: FileProtectionType.completeUntilFirstUserAuthentication])
+        }
+        try manager.moveItem(at: staging, to: destination)
+        published = true
+        return destination
+    }
+}
