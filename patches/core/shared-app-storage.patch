new file mode 100644
index 00000000..46b46e83
--- /dev/null
+++ b/Swiftgram/SGAppGroupIdentifier/SignedEntitlements/SGSignedEntitlements.m
@@ -0,0 +1,25 @@
+#import "SGSignedEntitlements.h"
+#import <Security/Security.h>
+#import <dlfcn.h>
+static id SGCEntitlement(NSString *name) {
+    typedef CFTypeRef (*CreateTask)(CFAllocatorRef);
+    typedef CFTypeRef (*CopyEntitlement)(CFTypeRef, CFStringRef, CFErrorRef *);
+    CreateTask create = (CreateTask)dlsym(RTLD_DEFAULT, "SecTaskCreateFromSelf");
+    CopyEntitlement copy = (CopyEntitlement)dlsym(RTLD_DEFAULT, "SecTaskCopyValueForEntitlement");
+    if (!create || !copy) return nil;
+    CFTypeRef task = create(NULL);
+    if (!task) return nil;
+    id value = CFBridgingRelease(copy(task, (__bridge CFStringRef)name, NULL));
+    CFRelease(task); return value;
+}
+NSArray<NSString *> *SGAdditionalSignedGroups(void) {
+    id value = SGCEntitlement(@"com.apple.security.application-groups");
+    if (![value isKindOfClass:NSArray.class]) return @[];
+    for (id item in value) if (![item isKindOfClass:NSString.class] || ![item length] || [item containsString:@"*"]) return @[];
+    return value;
+}
+BOOL SGAdditionalCloudKitAuthorized(void) {
+    id services = SGCEntitlement(@"com.apple.developer.icloud-services");
+    id containers = SGCEntitlement(@"com.apple.developer.icloud-container-identifiers");
+    return [services isKindOfClass:NSArray.class] && [services containsObject:@"CloudKit"] && [containers isKindOfClass:NSArray.class] && [containers count] > 0;
+}
