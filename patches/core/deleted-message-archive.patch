+    public func purgeMetadata(account: String, chat: String? = nil) throws {
+        try queue.sync {
+            flush()
+            try execute("BEGIN IMMEDIATE")
+            do {
+                for table in ["messages", "revisions", "disappearing_media"] {
+                    guard let sql = statement("DELETE FROM \(table) WHERE account=? AND (? IS NULL OR chat=?)") else {
+                        throw SettingsError.invalid("Cannot clear retained-message storage.")
+                    }
+                    defer { sqlite3_finalize(sql) }
+                    bind(sql, 1, account)
+                    if let chat {
+                        bind(sql, 2, chat)
+                        bind(sql, 3, chat)
+                    }
+                    guard sqlite3_step(sql) == SQLITE_DONE else {
+                        throw SettingsError.invalid("Cannot clear retained-message storage.")
+                    }
+                }
+                try execute("COMMIT")
+            } catch {
+                try? execute("ROLLBACK")
+                throw error
+            }
+            lock.lock()
+            let matches: (MessageKey) -> Bool = { $0.account == account && (chat == nil || $0.chat == chat) }
+            eligible = eligible.filter { !matches($0) }
+            deleted = deleted.filter { !matches($0) }
+            pending = pending.filter { !matches($0) }
+            lock.unlock()
+            DispatchQueue.main.async { NotificationCenter.default.post(name: .retainedMessagesChanged, object: nil) }
+        }
+    }
+}
+
+extension MessageArchive {
+    public func retainedKeys(account: String, chat: String? = nil) -> [MessageKey] {
+        synchronize()
+        lock.lock()
+        defer { lock.unlock() }
+        return deleted.filter { $0.account == account && (chat == nil || $0.chat == chat) }
+    }
+}
