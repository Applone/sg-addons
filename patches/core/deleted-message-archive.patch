+extension DeletedMessageArchive {
+    /// Registers shared ownership before starting a download. Purged snapshots cannot own files.
+    public func registerAttachment(message: ArchivedMessageID, resource: String, descriptor: Data) throws {
+        try queue.sync {
+            try transaction {
+                let owner = try prepare(
+                    "SELECT sequence FROM snapshots WHERE account=? AND chat=? AND namespace=? AND message=?")
+                defer { sqlite3_finalize(owner) }
+                bind(owner, id: message)
+                guard sqlite3_step(owner) == SQLITE_ROW else { return }
+                let sequence = sqlite3_column_int64(owner, 0)
+                let attachment = try prepare(
+                    "INSERT INTO attachments(id,account,resource,descriptor) VALUES(?,?,?,?) ON CONFLICT(account,resource) DO UPDATE SET descriptor=excluded.descriptor"
+                )
+                defer { sqlite3_finalize(attachment) }
+                bind(attachment, 1, UUID().uuidString)
+                bind(attachment, 2, message.account)
+                bind(attachment, 3, resource)
+                _ = descriptor.withUnsafeBytes {
+                    sqlite3_bind_blob(attachment, 4, $0.baseAddress, Int32($0.count), transient)
+                }
+                try done(attachment)
+                let reference = try prepare(
+                    "INSERT OR IGNORE INTO attachment_owners SELECT ?,id FROM attachments WHERE account=? AND resource=?"
+                )
+                defer { sqlite3_finalize(reference) }
+                sqlite3_bind_int64(reference, 1, sequence)
+                bind(reference, 2, message.account)
+                bind(reference, 3, resource)
+                try done(reference)
+            }
+        }
+    }
+
+    public func attachments(account: String, message: ArchivedMessageID? = nil) throws -> [ArchivedAttachment] {
+        try queue.sync {
+            let statement = try prepare(
+                """
+                SELECT a.id,a.resource,a.descriptor,a.status,a.bytes,a.filename,
+                  (SELECT GROUP_CONCAT(DISTINCT s.chat) FROM attachment_owners o JOIN snapshots s ON s.sequence=o.sequence WHERE o.attachment=a.id)
+                FROM attachments a
+                WHERE a.account=? AND EXISTS(SELECT 1 FROM attachment_owners o JOIN snapshots s ON s.sequence=o.sequence
+                  WHERE o.attachment=a.id AND (? IS NULL OR (s.chat=? AND s.namespace=? AND s.message=?)))
+                ORDER BY a.id
+                """)
+            defer { sqlite3_finalize(statement) }
+            bind(statement, 1, account)
+            if let message {
+                guard message.account == account else { return [] }
+                bind(statement, 2, message.chat)
+                bind(statement, 3, message.chat)
+                sqlite3_bind_int(statement, 4, message.namespace)
+                sqlite3_bind_int(statement, 5, message.message)
+            }
+            var result: [ArchivedAttachment] = []
+            while true {
+                let step = sqlite3_step(statement)
+                if step == SQLITE_DONE { break }
+                guard step == SQLITE_ROW, let bytes = sqlite3_column_blob(statement, 2) else {
+                    throw SettingsError.invalid("Cannot read archive attachments.")
+                }
+                let filename = sqlite3_column_text(statement, 5).map { String(cString: $0) }
+                result.append(
+                    ArchivedAttachment(
+                        chats: String(cString: sqlite3_column_text(statement, 6)).split(separator: ",").map(
+                            String.init),
+                        id: String(cString: sqlite3_column_text(statement, 0)),
+                        resource: String(cString: sqlite3_column_text(statement, 1)),
+                        descriptor: Data(bytes: bytes, count: Int(sqlite3_column_bytes(statement, 2))),
+                        status: String(cString: sqlite3_column_text(statement, 3)),
+                        bytes: sqlite3_column_int64(statement, 4),
+                        file: filename.map { directory.appendingPathComponent($0) }))
+            }
+            return result
+        }
+    }
+
+    /// Copies a complete resource with a streaming byte bound. Metadata commits only after atomic rename.
+    public func saveAttachment(id: String, account: String, source: URL, maximumBytes: Int64 = 104_857_600) throws {
+        guard maximumBytes >= 0 else { throw SettingsError.invalid("Invalid attachment size limit.") }
+        try queue.sync {
+            let owner = try prepare(
+                "SELECT 1 FROM attachments WHERE id=? AND account=? AND EXISTS(SELECT 1 FROM attachment_owners WHERE attachment=?)"
+            )
+            defer { sqlite3_finalize(owner) }
+            bind(owner, 1, id)
+            bind(owner, 2, account)
+            bind(owner, 3, id)
+            guard sqlite3_step(owner) == SQLITE_ROW else { return }
+            let values = try source.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileSizeKey])
+            guard values.isRegularFile == true, values.isSymbolicLink != true,
+                Int64(values.fileSize ?? 0) <= maximumBytes
+            else {
+                throw SettingsError.invalid("Archive attachment exceeds the file limit.")
+            }
+            let filename = "media-" + UUID().uuidString
+            let output = directory.appendingPathComponent(filename)
+            let staging = directory.appendingPathComponent(".transfer-" + UUID().uuidString)
+            var committed = false
+            defer {
+                try? FileManager.default.removeItem(at: staging)
+                if !committed { try? FileManager.default.removeItem(at: output) }
+            }
+            guard FileManager.default.createFile(atPath: staging.path, contents: nil) else {
+                throw SettingsError.invalid("Cannot create archive attachment.")
+            }
+            let reader = try FileHandle(forReadingFrom: source)
+            defer { try? reader.close() }
+            let writer = try FileHandle(forWritingTo: staging)
+            defer { try? writer.close() }
+            var size: Int64 = 0
+            while let chunk = try reader.read(upToCount: 1_048_576), !chunk.isEmpty {
+                size += Int64(chunk.count)
+                guard size <= maximumBytes else {
+                    throw SettingsError.invalid("Archive attachment grew beyond the file limit.")
+                }
+                try writer.write(contentsOf: chunk)
+            }
+            try writer.synchronize()
+            try FileManager.default.moveItem(at: staging, to: output)
+            let update = try prepare(
+                "UPDATE attachments SET filename=?,bytes=?,status='saved' WHERE id=? AND account=?")
+            defer { sqlite3_finalize(update) }
+            bind(update, 1, filename)
+            sqlite3_bind_int64(update, 2, size)
+            bind(update, 3, id)
+            bind(update, 4, account)
+            try done(update)
+            committed = true
+            try collectFiles()
+            attachmentChanged(account: account)
+        }
+    }
+
+    public func attachmentStatus(id: String, account: String, status: String) throws {
+        guard ["pending", "unavailable", "oversized"].contains(status) else {
+            throw SettingsError.invalid("Invalid attachment status.")
+        }
+        try queue.sync {
+            let statement = try prepare(
+                "UPDATE attachments SET status=? WHERE id=? AND account=? AND filename IS NULL AND status!=?")
+            defer { sqlite3_finalize(statement) }
+            bind(statement, 1, status)
+            bind(statement, 2, id)
+            bind(statement, 3, account)
+            bind(statement, 4, status)
+            try done(statement)
+            if sqlite3_changes(database) > 0 { attachmentChanged(account: account) }
+        }
+    }
+
+    public func storageBytes(account: String) throws -> Int64 { try queue.sync { try usedBytes(account) } }
+
+    private func usedBytes(_ account: String) throws -> Int64 {
+        let statement = try prepare(
+            """
+            SELECT COALESCE((SELECT SUM(length(payload)) FROM snapshots WHERE account=?),0)
+              + COALESCE((SELECT SUM(length(v.payload)) FROM snapshot_versions v JOIN snapshots s ON s.sequence=v.owner WHERE s.account=?),0)
+              + COALESCE((SELECT SUM(bytes) FROM attachments a WHERE account=?
+                AND EXISTS(SELECT 1 FROM attachment_owners WHERE attachment=a.id)),0)
+            """)
+        defer { sqlite3_finalize(statement) }
+        bind(statement, 1, account)
+        bind(statement, 2, account)
+        bind(statement, 3, account)
+        guard sqlite3_step(statement) == SQLITE_ROW else {
+            throw SettingsError.invalid("Cannot inspect archive storage.")
+        }
+        return sqlite3_column_int64(statement, 0)
+    }
+
+    private func collectFiles() throws {
+        try execute(
+            "DELETE FROM attachments WHERE NOT EXISTS(SELECT 1 FROM attachment_owners WHERE attachment=attachments.id)")
+        let statement = try prepare("SELECT filename FROM attachments WHERE filename IS NOT NULL")
+        defer { sqlite3_finalize(statement) }
+        var owned = Set<String>()
+        while sqlite3_step(statement) == SQLITE_ROW { owned.insert(String(cString: sqlite3_column_text(statement, 0))) }
+        for file in try FileManager.default.contentsOfDirectory(at: directory, includingPropertiesForKeys: nil) {
+            let name = file.lastPathComponent
+            if name.hasPrefix(".transfer-") || (name.hasPrefix("media-") && !owned.contains(name)) {
+                try FileManager.default.removeItem(at: file)
+            }
+        }
+    }
+}
+
+extension DeletedMessageArchive {
+    /// Clearing an archive is explicit deletion, so future refreshes must respect its tombstones.
+    @discardableResult public func purgeAll(
+        account: String, chat: String? = nil, thread: Int64? = nil,
+        minTimestamp: Int32? = nil, maxTimestamp: Int32? = nil
+    ) throws -> [ArchivedMessageID] {
+        try queue.sync {
+            let removed = try transaction { () -> [ArchivedMessageID] in
+                let rows = try prepare(
+                    "SELECT sequence,payload FROM snapshots WHERE account=? AND (? IS NULL OR chat=?)")
+                defer { sqlite3_finalize(rows) }
+                bind(rows, 1, account)
+                if let chat {
+                    bind(rows, 2, chat)
+                    bind(rows, 3, chat)
+                }
+                var selected: [(Int64, ArchivedMessageID)] = []
+                while true {
+                    let step = sqlite3_step(rows)
+                    if step == SQLITE_DONE { break }
+                    guard step == SQLITE_ROW, let bytes = sqlite3_column_blob(rows, 1) else {
+                        throw SettingsError.invalid("Cannot enumerate archived messages for deletion.")
+                    }
+                    let data = Data(bytes: bytes, count: Int(sqlite3_column_bytes(rows, 1)))
+                    let message = try JSONDecoder().decode(ArchivedMessage.self, from: data)
+                    if let thread, message.thread != thread { continue }
+                    if let minTimestamp, message.timestamp < minTimestamp { continue }
+                    if let maxTimestamp, message.timestamp > maxTimestamp { continue }
+                    selected.append((sqlite3_column_int64(rows, 0), message.id))
+                }
+                let tombstone = try prepare("INSERT OR IGNORE INTO purged VALUES(?,?,?,?)")
+                defer { sqlite3_finalize(tombstone) }
+                for (sequence, id) in selected {
+                    sqlite3_reset(tombstone)
+                    sqlite3_clear_bindings(tombstone)
+                    bind(tombstone, id: id)
+                    try done(tombstone)
+                    try removeSnapshot(sequence)
+                }
+                return selected.map { $0.1 }
+            }
+            try collectFiles()
+            return removed
+        }
+    }
+}
