+extension DeletedMessageArchive {
+    public func migrationCursor(account: String) throws -> ArchivedMessageID? {
+        try queue.sync {
+            let sql = try prepare("SELECT cursor FROM legacy_progress WHERE account=?")
+            defer { sqlite3_finalize(sql) }
+            bind(sql, 1, account)
+            let step = sqlite3_step(sql)
+            if step == SQLITE_DONE { return nil }
+            guard step == SQLITE_ROW, let bytes = sqlite3_column_blob(sql, 0) else {
+                throw SettingsError.invalid("Cannot read archive migration progress.")
+            }
+            return try JSONDecoder().decode(
+                ArchivedMessageID.self, from: Data(bytes: bytes, count: Int(sqlite3_column_bytes(sql, 0))))
+        }
+    }
