+import Foundation
+import SQLite3
+
+enum DeletedArchiveChecks {
+    static func storageFailure(root: URL) throws {
+        let store = DeletedMessageArchive(directory: root.appendingPathComponent("full-storage-checks"))
+        try store.freezeStorageGrowthForTesting()
+        let id = ArchivedMessageID(account: "77", chat: "user:42", message: 1)
+        let message = ArchivedMessage(
+            id: id, text: "Not committed", timestamp: 100, chatTitle: "Chat", senderTitle: "Sender", kind: .file,
+            payload: Data(repeating: 1, count: 1_048_576))
+        do {
+            _ = try store.capture(message)
+            fatalError("Full storage accepted snapshot")
+        } catch {}
+        let page = try store.page(account: "77", deletedOnly: false)
+        CheckCore.require(page.entries.isEmpty, "SQLITE_FULL rolls back the entire snapshot transaction")
+        let deleted = try store.markDeleted(id)
+        CheckCore.require(!deleted, "failed persistence cannot be marked as successfully retained")
+        let indexed = try store.page(account: "77", search: "Not committed", deletedOnly: false)
+        CheckCore.require(indexed.entries.isEmpty, "failed storage leaves no search index row")
+    }
+
+    static func versions(root: URL) throws {
+        let directory = root.appendingPathComponent("version-checks")
+        let store = DeletedMessageArchive(directory: directory)
+        let id = ArchivedMessageID(account: "77", chat: "user:42", message: 1)
+        func message(_ text: String, payload: UInt8, signature: UInt8) -> ArchivedMessage {
+            ArchivedMessage(
+                id: id, text: text, timestamp: 100, chatTitle: "Chat", senderTitle: "Sender", kind: .photo,
+                payload: Data([payload]), revisionSignature: Data([signature]), isBotDialog: true)
+        }
+        let original = message("Original", payload: 1, signature: 1)
+        _ = try store.capture(original, now: 100)
+        let botChats = try store.chats(account: "77")
+        CheckCore.require(botChats.first?.isBot == true, "bot-dialog identity survives independent archive storage")
+        _ = try store.capture(message("Original", payload: 2, signature: 1), now: 101, keepRevision: true)
+        let unchanged = try store.versions(id)
+        CheckCore.require(unchanged.isEmpty, "metadata refresh does not create a content revision")
+        _ = try store.capture(message("Original", payload: 3, signature: 2), now: 102, keepRevision: true)
+        let mediaEdit = try store.versions(id)
+        CheckCore.require(
+            mediaEdit.count == 1 && mediaEdit[0].payload == Data([2]), "media-only edit preserves prior native payload")
+        _ = try store.capture(message("Edited", payload: 4, signature: 3), now: 103, keepRevision: true)
+        let versions = try store.versions(id)
+        CheckCore.require(versions.count == 2, "content revisions remain ordered")
+        let size = try store.storageBytes(account: "77")
+        let currentSize = try JSONEncoder().encode(message("Edited", payload: 4, signature: 3)).count
+        CheckCore.require(size > Int64(currentSize), "versions contribute to quota")
+        let evicted = try store.enforcePolicy(account: "77", days: 1, now: 100_000)
+        CheckCore.require(evicted == [id], "expiry reports identities for host metadata cleanup")
+        let expired = try store.versions(id)
+        CheckCore.require(expired.isEmpty, "expiry deletes version payloads")
+        let resurrected = try store.capture(original, now: 100_001)
+        CheckCore.require(!resurrected, "history refresh cannot reset the age of an expired archive")
+        let futureDirectory = root.appendingPathComponent("future-schema")
+        try FileManager.default.createDirectory(at: futureDirectory, withIntermediateDirectories: true)
+        var db: OpaquePointer?
+        CheckCore.require(
+            sqlite3_open(futureDirectory.appendingPathComponent("archive.sqlite3").path, &db) == SQLITE_OK,
+            "future schema fixture")
+        CheckCore.require(
+            sqlite3_exec(db, "PRAGMA user_version=999", nil, nil, nil) == SQLITE_OK, "future schema version")
+        sqlite3_close(db)
+        let future = DeletedMessageArchive(directory: futureDirectory)
+        CheckCore.require(future.status() != nil, "future schema reports incompatibility")
+        do {
+            _ = try future.capture(original)
+            fatalError("Incompatible archive was mutated")
+        } catch {}
+    }
+
+    static func migration(root: URL) throws {
+        let old = MessageArchive.shared
+        let key = MessageKey(account: "991", chat: "user:42", id: 10)
+        old.observe(key)
+        CheckCore.require(old.retain(key), "legacy migration fixture retained")
+        CheckCore.require(
+            old.retainedKeys(account: "991") == [key],
+            "legacy cleanup exposes only retained keys for the selected account")
+        let rows = try old.legacyPage(account: "991", after: nil, limit: 1)
+        CheckCore.require(rows.count == 1 && rows[0].deleted != nil, "bounded legacy batch includes deletion metadata")
+        let next = try old.legacyPage(account: "991", after: rows[0].id, limit: 1)
+        CheckCore.require(next.isEmpty, "legacy cursor excludes previous batch")
+        let historyKey = MessageKey(account: "991", chat: "user:42", id: 11)
+        old.capture(
+            MessageRevision(text: "History only", entities: [], messageDate: 1, editDate: 2), key: historyKey,
+            retentionDays: 30)
+        let historyRows = try old.legacyPage(account: "991", after: rows[0].id)
+        CheckCore.require(
+            historyRows.count == 1 && historyRows[0].id.message == 11
+                && historyRows[0].revision?.text == "History only",
+            "migration includes history-only messages without retention metadata")
+
+        let directory = root.appendingPathComponent("migration-checks")
+        var store: DeletedMessageArchive? = DeletedMessageArchive(directory: directory)
+        let existing = ArchivedMessage(
+            id: rows[0].id, text: "Fresh", timestamp: 100, chatTitle: "Chat", senderTitle: "Sender", kind: .text,
+            payload: Data([9]))
+        _ = try store!.capture(existing)
+        let stale = ArchivedMessage(
+            id: existing.id, text: "Old", timestamp: 50, chatTitle: "Chat", senderTitle: "", kind: .text,
+            payload: Data())
+        _ = try store!.capture(stale, ifAbsent: true)
+        let preserved = try store!.page(account: "991", deletedOnly: false)
+        CheckCore.require(
+            preserved.entries[0].message == existing, "legacy import cannot overwrite a newer complete snapshot")
+        try store!.advanceMigration(existing.id)
+        store = nil
+        store = DeletedMessageArchive(directory: directory)
+        let cursor = try store!.migrationCursor(account: "991")
+        CheckCore.require(cursor == existing.id, "migration cursor survives restart")
+        let topic = ArchivedMessage(
+            id: ArchivedMessageID(account: "991", chat: "user:42", message: 11), text: "Topic", timestamp: 101,
+            chatTitle: "Chat", senderTitle: "", kind: .text, payload: Data([1]), thread: 7)
+        _ = try store!.capture(topic)
+        let removed = try store!.purgeAll(account: "991", thread: 7, minTimestamp: 100, maxTimestamp: 102)
+        CheckCore.require(removed == [topic.id], "range and topic purge excludes other messages")
+        try old.purgeMetadata(account: "991")
+        let cleared = try old.legacyPage(account: "991", after: nil)
+        CheckCore.require(
+            cleared.isEmpty && !old.isDeleted(key) && !old.retain(key),
+            "account purge clears legacy rows and memory indexes")
+        try store!.removeAccount("991")
+        let removedCursor = try store!.migrationCursor(account: "991")
+        CheckCore.require(removedCursor == nil, "account removal clears migration metadata")
+    }
+
+    static func attachments(root: URL) throws {
+        let directory = root.appendingPathComponent("attachment-checks")
+        var archive: DeletedMessageArchive? = DeletedMessageArchive(directory: directory)
+        func message(_ number: Int32) -> ArchivedMessage {
+            ArchivedMessage(
+                id: ArchivedMessageID(account: "77", chat: "user:42", message: number),
+                text: "Attachment", timestamp: 100, chatTitle: "Chat", senderTitle: "Sender",
+                kind: .file, payload: Data([1]))
+        }
+        let first = message(1)
+        let second = message(2)
+        _ = try archive!.capture(first)
+        _ = try archive!.capture(second)
+        for snapshot in [first, second] {
+            try archive!.registerAttachment(message: snapshot.id, resource: "shared", descriptor: Data([1, 2]))
+        }
+        let registered = try archive!.attachments(account: "77")
+        CheckCore.require(registered.count == 1, "resources deduplicate within an account")
+        let source = root.appendingPathComponent("cache-resource")
+        try Data("owned media".utf8).write(to: source)
+        try archive!.saveAttachment(id: registered[0].id, account: "77", source: source)
+        try FileManager.default.removeItem(at: source)
+        let saved = try archive!.attachments(account: "77")
+        let copy = try Data(contentsOf: saved[0].file!)
+        CheckCore.require(copy == Data("owned media".utf8), "attachment survives host cache deletion")
+        try archive!.purge(first.id)
+        CheckCore.require(
+            FileManager.default.fileExists(atPath: saved[0].file!.path), "shared resource survives first owner deletion"
+        )
+        archive = nil
+        try Data([0]).write(to: directory.appendingPathComponent(".transfer-interrupted"))
+        try Data([0]).write(to: directory.appendingPathComponent("media-orphan"))
+        archive = DeletedMessageArchive(directory: directory)
+        CheckCore.require(
+            !FileManager.default.fileExists(atPath: directory.appendingPathComponent("media-orphan").path),
+            "restart removes interrupted orphan files")
+        let reopened = try archive!.attachments(account: "77", message: second.id)
+        CheckCore.require(
+            reopened.count == 1 && reopened[0].status == "saved", "attachment ownership survives reopening")
+        try archive!.purge(second.id)
+        CheckCore.require(
+            !FileManager.default.fileExists(atPath: saved[0].file!.path), "last owner purge deletes attachment")
+        let late = try archive!.attachments(account: "77")
+        CheckCore.require(late.isEmpty, "purge removes attachment metadata")
+        _ = try archive!.capture(message(3))
+        try archive!.registerAttachment(message: message(3).id, resource: "large", descriptor: Data([3]))
+        let pending = try archive!.attachments(account: "77")
+        try Data(repeating: 1, count: 10).write(to: source)
+        do {
+            try archive!.saveAttachment(id: pending[0].id, account: "77", source: source, maximumBytes: 5)
+            fatalError("Oversized attachment accepted")
+        } catch {}
+        let failed = try archive!.attachments(account: "77")
+        CheckCore.require(failed[0].file == nil, "failed copy never publishes a file")
+        try archive!.attachmentStatus(id: pending[0].id, account: "77", status: "unavailable")
+        let unavailable = try archive!.attachments(account: "77")
+        CheckCore.require(unavailable[0].status == "unavailable", "download failure state is observable")
+        try archive!.attachmentStatus(id: pending[0].id, account: "88", status: "pending")
+        let isolated = try archive!.attachments(account: "77")
+        CheckCore.require(isolated[0].status == "unavailable", "status updates respect account scope")
+        try archive!.attachmentStatus(id: pending[0].id, account: "77", status: "pending")
+        let retry = try archive!.attachments(account: "77")
+        CheckCore.require(retry[0].status == "pending", "retry restores pending state")
+        try archive!.saveAttachment(id: pending[0].id, account: "77", source: source)
+        let total = try archive!.storageBytes(account: "77")
+        CheckCore.require(total > 10, "quota includes snapshot payload and owned media")
+        try archive!.enforcePolicy(account: "77", quota: 0)
+        let cleared = try archive!.attachments(account: "77")
+        CheckCore.require(cleared.isEmpty, "quota eviction releases attachments")
+    }
+
+    static func run(root: URL) throws {
+        let legacy = try JSONDecoder().decode(AddonProfile.self, from: Data("{}".utf8))
+        CheckCore.require(
+            legacy.archive.bots && !AddonProfile().archive.bots,
+            "bot capture migrates without changing existing choices")
+        var overrideProfile = AddonProfile()
+        CheckCore.require(
+            !overrideProfile.hasDeletedCapture && !overrideProfile.hasHistoryCapture,
+            "empty capture profile is disabled")
+        overrideProfile.archive.chats["user:42"] = ArchiveChatOverride(deleted: true, history: true)
+        CheckCore.require(
+            overrideProfile.hasDeletedCapture && overrideProfile.hasHistoryCapture,
+            "global feature gates include explicit chat overrides")
+        var policy = ArchivePolicy()
+        policy.chats["user:42"] = ArchiveChatOverride(deleted: true, media: false)
+        CheckCore.require(
+            policy.capturesDeleted(chat: "user:42", bot: true, enabled: false),
+            "chat capture overrides account and bot defaults")
+        CheckCore.require(!policy.capturesMedia(chat: "user:42"), "chat media override")
+        policy.quotaMiB = 0
+        do {
+            try policy.validate()
+            fatalError("Invalid quota accepted")
+        } catch {}
+        try storageFailure(root: root)
+        try versions(root: root)
+        try migration(root: root)
+        try attachments(root: root)
+        let directory = root.appendingPathComponent("snapshot-checks")
+        var archive: DeletedMessageArchive? = DeletedMessageArchive(directory: directory)
+        CheckCore.require(archive?.status() == nil, "archive schema is initialized")
+        let now: Int64 = 2_000_000_000
+        func message(_ id: Int32, account: String = "77", namespace: Int32 = 0, text: String = "searchable phrase")
+            -> ArchivedMessage
+        {
+            ArchivedMessage(
+                id: ArchivedMessageID(account: account, chat: "channel:42", namespace: namespace, message: id),
+                text: text, timestamp: 100, chatTitle: "Retained channel", senderTitle: "Sender",
+                kind: .text, payload: Data([1, 2, 3]))
+        }
+        let original = message(1)
+        let captured = try archive!.capture(original, now: now)
+        CheckCore.require(captured, "snapshot captured")
+        let deleted = try archive!.markDeleted(original.id, now: now + 1)
+        CheckCore.require(deleted, "remote deletion is durable")
+        _ = try archive!.capture(message(2), now: now)
+        _ = try archive!.capture(message(1, namespace: 1), now: now)
+        _ = try archive!.capture(message(1, account: "88"), now: now)
+        _ = try archive!.markDeleted(message(2).id, now: now + 1)
+        _ = try archive!.markDeleted(message(1, namespace: 1).id, now: now + 1)
+        let deletedIDs = try archive!.deletedMessageIDs(account: "77", chat: "channel:42")
+        CheckCore.require(
+            deletedIDs.count == 3 && Set(deletedIDs.map { $0.namespace }) == [0, 1],
+            "deleted identities preserve namespace for host cleanup")
+        let chats = try archive!.chats(account: "77")
+        CheckCore.require(
+            chats.count == 1 && chats[0].id == "channel:42" && chats[0].messages == 3 && chats[0].deleted == 3,
+            "archived chat directory includes cached peer title and independent message counts")
+        let foreignChats = try archive!.chats(account: "88")
+        CheckCore.require(
+            foreignChats.count == 1 && foreignChats[0].deleted == 0,
+            "captured chat directory includes nondeleted content and isolates accounts")
+        let first = try archive!.page(account: "77", limit: 1)
+        let second = try archive!.page(account: "77", before: first.next, limit: 1)
+        CheckCore.require(
+            first.next != nil && first.entries[0].message.id != second.entries[0].message.id,
+            "stable pagination breaks timestamp ties")
+        let search = try archive!.page(account: "77", search: "searchable phrase")
+        CheckCore.require(search.entries.count == 3, "indexed search includes namespace-distinct messages")
+        let foreign = try archive!.page(account: "88")
+        CheckCore.require(foreign.entries.isEmpty, "account and deletion status isolation")
+        archive = nil
+        archive = DeletedMessageArchive(directory: directory)
+        let reopened = try archive!.page(account: "77", chat: "channel:42")
+        CheckCore.require(
+            reopened.entries.count == 3 && reopened.entries.contains { $0.message == original },
+            "complete payload survives reopening without Postbox")
+        try archive!.purge(original.id)
+        let resurrection = try archive!.capture(original, now: now + 5)
+        CheckCore.require(!resurrection, "purge tombstone rejects delayed history")
+        let otherNamespace = try archive!.page(account: "77")
+        CheckCore.require(otherNamespace.entries.count == 2, "purge respects namespace")
+        try archive!.removeAccount("77")
+        let removed = try archive!.capture(message(9), now: now)
+        CheckCore.require(!removed, "removed account rejects late callbacks")
+        let empty = try archive!.page(account: "77", deletedOnly: false)
+        CheckCore.require(empty.entries.isEmpty, "account removal clears snapshots")
+        let untouched = try archive!.page(account: "88", deletedOnly: false)
+        CheckCore.require(untouched.entries.count == 1, "account removal preserves other account")
+        try archive!.authorizeAccount("77")
+        _ = try archive!.capture(message(10), now: now - 31 * 86_400)
+        _ = try archive!.capture(message(11), now: now - 30 * 86_400)
+        _ = try archive!.capture(message(12), now: now)
+        _ = try archive!.capture(message(10, text: "Updated"), now: now)
+        try archive!.enforcePolicy(account: "77", now: now)
+        let retained = try archive!.page(account: "77", deletedOnly: false)
+        CheckCore.require(
+            Set(retained.entries.map { $0.message.id.message }) == [11, 12],
+            "expiry honors boundary and original observation age")
+        try archive!.enforcePolicy(account: "77", quota: 0, now: now)
+        _ = try archive!.capture(message(20), now: now)
+        try archive!.purgeAll(account: "77", chat: "channel:42")
+        let bulkResurrection = try archive!.capture(message(20), now: now)
+        CheckCore.require(!bulkResurrection, "bulk purge tombstones prevent delayed refresh")
+        let preservedAccount = try archive!.page(account: "88", deletedOnly: false)
+        CheckCore.require(preservedAccount.entries.count == 1, "bulk purge respects account scope")
+        let evicted = try archive!.page(account: "77", deletedOnly: false)
+        CheckCore.require(evicted.entries.isEmpty, "quota evicts snapshots and search rows atomically")
+    }
+}
