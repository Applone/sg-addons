+    public func advanceMigration(_ id: ArchivedMessageID) throws {
+        try queue.sync {
+            let sql = try prepare("INSERT OR REPLACE INTO legacy_progress VALUES(?,?)")
+            defer { sqlite3_finalize(sql) }
+            bind(sql, 1, id.account)
+            let data = try JSONEncoder().encode(id)
+            _ = data.withUnsafeBytes { sqlite3_bind_blob(sql, 2, $0.baseAddress, Int32($0.count), transient) }
+            try done(sql)
+        }
+    }
+}
