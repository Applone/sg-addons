+extension MessageArchive {
+    /// Read bounded batches from the old metadata schema. Source rows remain until explicit purge.
+    public func legacyPage(account: String, after: ArchivedMessageID?, limit: Int = 50) throws
+        -> [LegacyArchivedMessage]
+    {
+        try queue.sync {
+            guard
+                let sql = statement(
+                    """
+                    WITH legacy AS (
+                      SELECT chat,id,seen,deleted FROM messages WHERE account=?1
+                      UNION ALL
+                      SELECT r.chat,r.id,MIN(r.observed),NULL FROM revisions r WHERE r.account=?1
+                        AND NOT EXISTS(SELECT 1 FROM messages m WHERE m.account=r.account AND m.chat=r.chat AND m.id=r.id)
+                      GROUP BY r.chat,r.id
+                    )
+                    SELECT chat,id,seen,deleted FROM legacy
+                      WHERE (?2 IS NULL OR chat>?3 OR (chat=?4 AND id>?5)) ORDER BY chat,id LIMIT ?6
+                    """)
+            else { throw SettingsError.invalid("Cannot read legacy archive.") }
+            defer { sqlite3_finalize(sql) }
+            bind(sql, 1, account)
+            if let after {
+                bind(sql, 2, after.chat)
+                bind(sql, 3, after.chat)
+                bind(sql, 4, after.chat)
+                sqlite3_bind_int64(sql, 5, Int64(after.message))
+            }
+            sqlite3_bind_int(sql, 6, Int32(min(100, max(1, limit))))
+            var entries: [LegacyArchivedMessage] = []
+            while true {
+                let step = sqlite3_step(sql)
+                if step == SQLITE_DONE { break }
+                guard step == SQLITE_ROW else { throw SettingsError.invalid("Cannot read legacy archive batch.") }
+                let chat = String(cString: sqlite3_column_text(sql, 0))
+                guard let id = Int32(exactly: sqlite3_column_int64(sql, 1)) else { continue }
+                let key = MessageKey(account: account, chat: chat, id: Int64(id))
+                entries.append(
+                    LegacyArchivedMessage(
+                        id: ArchivedMessageID(account: account, chat: chat, message: id),
+                        observed: sqlite3_column_int64(sql, 2),
+                        deleted: sqlite3_column_type(sql, 3) == SQLITE_NULL ? nil : sqlite3_column_int64(sql, 3),
+                        revision: readHistory(key).last))
+            }
+            return entries
+        }
+    }
