diff --git a/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalMessageArchive.swift b/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalMessageArchive.swift
new file mode 100644
index 00000000..1d066611
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalMessageArchive.swift
@@ -0,0 +1,364 @@
+import Foundation
+import Postbox
+import SGAdditionalCore
+import SwiftSignalKit
+
+/// This envelope versions Telegram-specific encoding independently of the SQLite schema.
+struct AdditionalArchivedPayload: Codable {
+    var version = 1
+    let attributes: [Data]
+    let media: [Data]
+    let peers: [Data]
+    let author: Int64?
+    let globallyUniqueId: Int64?
+    let groupingKey: Int64?
+    let threadId: Int64?
+    let flags: UInt32
+    let tags: UInt32
+    let globalTags: UInt32
+    let localTags: UInt32
+    let forward: Forward?
+
+    struct Forward: Codable {
+        let author: Int64?
+        let source: Int64?
+        let sourcePeer: Int64?
+        let sourceNamespace: Int32?
+        let sourceMessage: Int32?
+        let date: Int32
+        let signature: String?
+        let psa: String?
+        let flags: Int32
+    }
+}
+
+func additionalArchivedID(account: PeerId, id: MessageId) -> ArchivedMessageID? {
+    guard id.namespace == Namespaces.Message.Cloud, let chat = additionalChatKey(id.peerId) else { return nil }
+    return ArchivedMessageID(
+        account: additionalAccountKey(account), chat: chat, namespace: id.namespace, message: id.id)
+}
+
+@discardableResult func additionalArchiveSnapshot(
+    _ message: StoreMessage, account: PeerId, transaction: Transaction, observed: Int64? = nil, ifAbsent: Bool = false
+)
+    -> Bool
+{
+    guard case .Id(let id) = message.id, let identity = additionalArchivedID(account: account, id: id) else {
+        return false
+    }
+    func encode(_ object: PostboxCoding) -> Data {
+        let encoder = PostboxEncoder()
+        encoder.encodeRootObject(object)
+        return encoder.makeData()
+    }
+    let peerIDs = Set(
+        [id.peerId, message.authorId, message.forwardInfo?.authorId, message.forwardInfo?.sourceId].compactMap { $0 })
+    let peers = peerIDs.compactMap { transaction.getPeer($0) }
+    let payload = AdditionalArchivedPayload(
+        attributes: message.attributes.map { encode($0) }, media: message.media.map { encode($0) },
+        peers: peers.map { encode($0) }, author: message.authorId?.toInt64(),
+        globallyUniqueId: message.globallyUniqueId, groupingKey: message.groupingKey, threadId: message.threadId,
+        flags: message.flags.rawValue, tags: message.tags.rawValue, globalTags: message.globalTags.rawValue,
+        localTags: message.localTags.rawValue,
+        forward: message.forwardInfo.map {
+            .init(
+                author: $0.authorId?.toInt64(), source: $0.sourceId?.toInt64(),
+                sourcePeer: $0.sourceMessageId?.peerId.toInt64(),
+                sourceNamespace: $0.sourceMessageId?.namespace, sourceMessage: $0.sourceMessageId?.id,
+                date: $0.date, signature: $0.authorSignature, psa: $0.psaType, flags: $0.flags.rawValue)
+        })
+    let kind: ArchivedMessage.Kind
+    if message.media.contains(where: { $0 is TelegramMediaImage }) {
+        kind = .photo
+    } else if let file = message.media.compactMap({ $0 as? TelegramMediaFile }).first {
+        kind = file.isVoice ? .voice : file.isVideo ? .video : .file
+    } else {
+        kind = .text
+    }
+    do {
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        let signature = try encoder.encode(
+            AdditionalArchiveRevisionSignature(
+                revision: additionalRevision(
+                    text: message.text, timestamp: message.timestamp, attributes: message.attributes),
+                media: payload.media))
+        let snapshot = ArchivedMessage(
+            id: identity, text: message.text, timestamp: message.timestamp,
+            chatTitle: transaction.getPeer(id.peerId)?.debugDisplayTitle ?? identity.chat,
+            senderTitle: message.authorId.flatMap { transaction.getPeer($0)?.debugDisplayTitle } ?? "",
+            kind: kind, payload: try JSONEncoder().encode(payload), thread: message.threadId,
+            revisionSignature: signature, isBotDialog: (transaction.getPeer(id.peerId) as? TelegramUser)?.botInfo != nil
+        )
+        guard
+            try DeletedMessageArchive.shared.capture(
+                snapshot, now: observed ?? Int64(Date().timeIntervalSince1970), ifAbsent: ifAbsent,
+                keepRevision: additionalArchiveProfile(account: account, chat: id.peerId, transaction: transaction)
+                    .saveEditHistory)
+        else { return false }
+        let policy = AddonSettings.shared.profile(identity.account).archive
+        if policy.capturesMedia(chat: identity.chat) {
+            for resource in additionalArchiveResources(message.media) {
+                guard let encodedResource = resource as? PostboxCoding else { continue }
+                try DeletedMessageArchive.shared.registerAttachment(
+                    message: identity, resource: resource.id.stringRepresentation, descriptor: encode(encodedResource))
+            }
+        }
+        NotificationCenter.default.post(name: Notification.Name("SGAArchiveCaptured"), object: identity.account)
+        return true
+    } catch {
+        DeletedMessageArchive.shared.reportFailure(error)
+        return false
+    }
+}
+
+func additionalPurgeArchivedMessage(account: PeerId, id: MessageId) {
+    guard let identity = additionalArchivedID(account: account, id: id) else { return }
+    do { try DeletedMessageArchive.shared.purge(identity) } catch { DeletedMessageArchive.shared.reportFailure(error) }
+    if let key = additionalMessageKey(account: account, id: id) { MessageArchive.shared.exclude(key) }
+}
+
+func additionalArchiveResources(_ media: [Media]) -> [MediaResource] {
+    media.flatMap { item -> [MediaResource] in
+        if let image = item as? TelegramMediaImage { return image.representations.map { $0.resource } }
+        if let file = item as? TelegramMediaFile {
+            return [file.resource] + file.previewRepresentations.map { $0.resource }
+        }
+        return []
+    }
+}
+
+func additionalArchiveProfile(account: PeerId, chat: PeerId, transaction: Transaction) -> AddonProfile {
+    var profile = AddonSettings.shared.profile(additionalAccountKey(account))
+    guard let key = additionalChatKey(chat) else { return profile }
+    let bot = (transaction.getPeer(chat) as? TelegramUser)?.botInfo != nil
+    profile.saveDeleted = profile.archive.capturesDeleted(chat: key, bot: bot, enabled: profile.saveDeleted)
+    profile.saveEditHistory = profile.archive.capturesHistory(chat: key, bot: bot, enabled: profile.saveEditHistory)
+    return profile
+}
+
+public func additionalArchivedRevision(_ message: ArchivedMessage) throws -> MessageRevision {
+    let payload = try JSONDecoder().decode(AdditionalArchivedPayload.self, from: message.payload)
+    guard payload.version == 1 else { throw SettingsError.invalid("Unsupported archived message version.") }
+    let attributes = payload.attributes.compactMap {
+        PostboxDecoder(buffer: MemoryBuffer(data: $0)).decodeRootObject() as? MessageAttribute
+    }
+    return additionalRevision(text: message.text, timestamp: message.timestamp, attributes: attributes)
+}
+
+func additionalArchivePeer(_ chat: String) -> PeerId? {
+    let parts = chat.split(separator: ":")
+    guard parts.count == 2, let id = Int64(parts[1]) else { return nil }
+    let namespace: PeerId.Namespace
+    switch parts[0] {
+    case "user": namespace = Namespaces.Peer.CloudUser
+    case "chat": namespace = Namespaces.Peer.CloudGroup
+    case "channel": namespace = Namespaces.Peer.CloudChannel
+    default: return nil
+    }
+    return PeerId(namespace: namespace, id: ._internalFromInt64Value(id))
+}
+
+func additionalRemoveArchiveAccount(_ account: PeerId, record: AccountRecordId) {
+    let key = additionalAccountKey(account)
+    do {
+        try ArchiveSessions.shared.end(account: key, owner: String(record.rawValue)) {
+            try DeletedMessageArchive.shared.removeAccount(key)
+            try MessageArchive.shared.purgeMetadata(account: key)
+            additionalPluginForgetOrigins(account: account)
+        }
+    } catch { DeletedMessageArchive.shared.reportFailure(error) }
+}
+
+func additionalMigrateArchive(account: Account, entries: [LegacyArchivedMessage]) -> Signal<Bool, NoError> {
+    account.postbox.transaction { transaction -> Bool in
+        guard let session = account.additionalArchiveSession else { return false }
+        return ArchiveSessions.shared.perform(session) {
+            do {
+                for entry in entries {
+                    guard let peer = additionalArchivePeer(entry.id.chat) else {
+                        try DeletedMessageArchive.shared.advanceMigration(entry.id)
+                        continue
+                    }
+                    let id = MessageId(peerId: peer, namespace: entry.id.namespace, id: entry.id.message)
+                    if let message = transaction.getMessage(id),
+                        additionalCanArchive(attributes: message.attributes, media: message.media)
+                    {
+                        let stored = StoreMessage(
+                            id: message.id, customStableId: nil, globallyUniqueId: message.globallyUniqueId,
+                            groupingKey: message.groupingKey, threadId: message.threadId, timestamp: message.timestamp,
+                            flags: StoreMessageFlags(message.flags), tags: message.tags, globalTags: message.globalTags,
+                            localTags: message.localTags,
+                            forwardInfo: message.forwardInfo.map(StoreMessageForwardInfo.init),
+                            authorId: message.author?.id, text: message.text, attributes: message.attributes,
+                            media: message.media)
+                        guard
+                            additionalArchiveSnapshot(
+                                stored, account: account.peerId, transaction: transaction, observed: entry.observed,
+                                ifAbsent: true)
+                        else {
+                            if try DeletedMessageArchive.shared.isPurged(entry.id) {
+                                try DeletedMessageArchive.shared.advanceMigration(entry.id)
+                                continue
+                            }
+                            return false
+                        }
+                    } else {
+                        // An empty adapter payload explicitly denotes missing legacy content, not a fabricated message.
+                        let placeholder = ArchivedMessage(
+                            id: entry.id, text: entry.revision?.text ?? "",
+                            timestamp: Int32(clamping: entry.revision?.messageDate ?? 0),
+                            chatTitle: transaction.getPeer(peer)?.debugDisplayTitle ?? entry.id.chat, senderTitle: "",
+                            kind: .text, payload: Data(),
+                            isBotDialog: (transaction.getPeer(peer) as? TelegramUser)?.botInfo != nil)
+                        _ = try DeletedMessageArchive.shared.capture(placeholder, now: entry.observed, ifAbsent: true)
+                    }
+                    if let deleted = entry.deleted {
+                        _ = try DeletedMessageArchive.shared.markDeleted(entry.id, now: deleted)
+                    }
+                    try DeletedMessageArchive.shared.advanceMigration(entry.id)
+                }
+                return true
+            } catch {
+                DeletedMessageArchive.shared.reportFailure(error)
+                return false
+            }
+        } ?? false
+    }
+}
+
+func additionalPurgeArchiveChat(
+    transaction: Transaction, peer: PeerId, thread: Int64? = nil,
+    minTimestamp: Int32? = nil, maxTimestamp: Int32? = nil
+) {
+    guard transaction.messageProcessingSessionActive,
+        let state = transaction.getState() as? AuthorizedAccountState, let chat = additionalChatKey(peer)
+    else {
+        return
+    }
+    let account = additionalAccountKey(state.peerId)
+    do {
+        let ids = try DeletedMessageArchive.shared.purgeAll(
+            account: account, chat: chat, thread: thread,
+            minTimestamp: minTimestamp, maxTimestamp: maxTimestamp)
+        if thread == nil && minTimestamp == nil && maxTimestamp == nil {
+            try MessageArchive.shared.purgeMetadata(account: account, chat: chat)
+        } else {
+            for id in ids {
+                MessageArchive.shared.exclude(MessageKey(account: account, chat: chat, id: Int64(id.message)))
+            }
+        }
+    } catch { DeletedMessageArchive.shared.reportFailure(error) }
+}
