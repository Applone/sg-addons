@@ -0,0 +1,39 @@
+import Foundation
+
+public struct ArchiveSession: Equatable {
+    public let account: String
+    public let token: UUID
+    public let owner: String
+}
+
+/// Serializes account teardown with archive operations and rejects callbacks from a previous login.
+public final class ArchiveSessions {
+    public static let shared = ArchiveSessions()
+    private let lock = NSRecursiveLock()
+    private var sessions: [String: ArchiveSession] = [:]
+
+    public init() {}
+
+    @discardableResult public func begin(account: String, owner: String = "") -> ArchiveSession {
+        lock.lock()
+        defer { lock.unlock() }
+        let session = ArchiveSession(account: account, token: UUID(), owner: owner)
+        sessions[account] = session
+        return session
+    }
+
+    @discardableResult public func perform<T>(_ session: ArchiveSession, _ operation: () throws -> T) rethrows -> T? {
+        lock.lock()
+        defer { lock.unlock() }
+        guard sessions[session.account] == session else { return nil }
+        return try operation()
+    }
+
+    public func end(account: String, owner: String = "", _ cleanup: () throws -> Void) rethrows {
+        lock.lock()
+        defer { lock.unlock() }
+        if let current = sessions[account], current.owner != owner { return }
+        sessions.removeValue(forKey: account)
+        try cleanup()
+    }
+}
diff --git a/Swiftgram/SGAdditionalCore/Sources/DeletedMessageArchive.swift b/Swiftgram/SGAdditionalCore/Sources/DeletedMessageArchive.swift
