@@ -0,0 +1,86 @@
+import Foundation
+import Postbox
+import SGAdditionalCore
+import XCTest
+
+@testable import TelegramCore
+
+final class AdditionalArchiveTests: XCTestCase {
+    private func archived(
+        version: Int = 1, attributes: [MessageAttribute] = [], forward: AdditionalArchivedPayload.Forward? = nil
+    ) throws -> ArchivedMessage {
+        let encoded = attributes.map { attribute -> Data in
+            let encoder = PostboxEncoder()
+            encoder.encodeRootObject(attribute)
+            return encoder.makeData()
+        }
+        var payload = AdditionalArchivedPayload(
+            attributes: encoded, media: [], peers: [], author: nil,
+            globallyUniqueId: nil, groupingKey: nil, threadId: nil, flags: 0, tags: 0,
+            globalTags: 0, localTags: 0, forward: forward)
+        payload.version = version
+        return ArchivedMessage(
+            id: ArchivedMessageID(account: "77", chat: "channel:42", message: 1),
+            text: "Hello world", timestamp: 100, chatTitle: "Channel", senderTitle: "Sender", kind: .text,
+            payload: try JSONEncoder().encode(payload))
+    }
+
+    func testArchivedEntitiesRemainReadableWithoutPostbox() throws {
+        let message = try archived(attributes: [
+            TextEntitiesMessageAttribute(entities: [
+                MessageTextEntity(range: 0..<5, type: .Bold),
+                MessageTextEntity(range: 6..<11, type: .TextUrl(url: "https://example.com")),
+            ])
+        ])
+        let revision = try additionalArchivedRevision(message)
+        XCTAssertEqual(revision.text, "Hello world")
+        XCTAssertEqual(revision.messageDate, 100)
+        let restored = additionalTextEntities(revision)
+        XCTAssertEqual(restored.count, 2)
+        XCTAssertEqual(restored[0].range, 0..<5)
+        if case .TextUrl(let url) = restored[1].type {
+            XCTAssertEqual(url, "https://example.com")
+        } else {
+            XCTFail("Archived link lost its target")
+        }
+    }
+
+    func testReplyAndAnonymousForwardMetadataSurvivesWithoutLivePeers() throws {
+        let peer = PeerId(namespace: Namespaces.Peer.CloudUser, id: ._internalFromInt64Value(42))
+        let message = try archived(
+            attributes: [
+                ReplyMessageAttribute(
+                    messageId: MessageId(peerId: peer, namespace: Namespaces.Message.Cloud, id: 99),
+                    threadMessageId: nil, quote: nil, isQuote: false, innerSubject: nil)
+            ],
+            forward: .init(
+                author: nil, source: nil, sourcePeer: nil, sourceNamespace: nil,
+                sourceMessage: nil, date: 50, signature: nil, psa: nil, flags: 0))
+        let context = try additionalArchivedContext(message)
+        XCTAssertEqual(context.reply, 99)
+        XCTAssertTrue(context.isForwarded)
+        XCTAssertNil(context.forwardedFrom)
+    }
+
+    func testFutureAndMissingPayloadsFailExplicitly() throws {
+        XCTAssertThrowsError(try additionalArchivedRevision(archived(version: 999)))
+        let missing = ArchivedMessage(
+            id: ArchivedMessageID(account: "77", chat: "user:42", message: 1),
+            text: "Legacy text", timestamp: 0, chatTitle: "Chat", senderTitle: "", kind: .text, payload: Data())
+        XCTAssertThrowsError(try additionalArchivedRevision(missing))
+    }
+
+    func testPluginOriginsAreAccountScopedAndClearable() {
+        let first = PeerId(namespace: Namespaces.Peer.CloudUser, id: ._internalFromInt64Value(77))
+        let second = PeerId(namespace: Namespaces.Peer.CloudUser, id: ._internalFromInt64Value(88))
+        defer {
+            additionalPluginForgetOrigins(account: first)
+            additionalPluginForgetOrigins(account: second)
+        }
+        let correlation = additionalPluginCorrelation(account: first)
+        XCTAssertTrue(additionalPluginIsOrigin(correlation, account: first))
+        XCTAssertFalse(additionalPluginIsOrigin(correlation, account: second))
+        additionalPluginForgetOrigins(account: first)
+        XCTAssertFalse(additionalPluginIsOrigin(correlation, account: first))
+    }
+}
