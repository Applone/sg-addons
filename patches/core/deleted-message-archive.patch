+private struct AdditionalArchiveRevisionSignature: Encodable {
+    let revision: MessageRevision
+    let media: [Data]
+}
+
+func additionalArchiveStored(_ message: Message) -> StoreMessage {
+    StoreMessage(
+        id: message.id, customStableId: nil, globallyUniqueId: message.globallyUniqueId,
+        groupingKey: message.groupingKey, threadId: message.threadId, timestamp: message.timestamp,
+        flags: StoreMessageFlags(message.flags), tags: message.tags, globalTags: message.globalTags,
+        localTags: message.localTags, forwardInfo: message.forwardInfo.map(StoreMessageForwardInfo.init),
+        authorId: message.author?.id, text: message.text, attributes: message.attributes, media: message.media)
+}
+
+public struct ArchivedAttachmentInfo {
+    public let filename: String
+    public let mimeType: String
+    public let kind: ArchivedMessage.Kind
+}
+
+public func additionalArchivedAttachmentInfo(_ message: ArchivedMessage, resource: String) throws
+    -> ArchivedAttachmentInfo?
+{
+    let payload = try JSONDecoder().decode(AdditionalArchivedPayload.self, from: message.payload)
+    guard payload.version == 1 else { throw SettingsError.invalid("Unsupported archived message version.") }
+    for data in payload.media {
+        let media = PostboxDecoder(buffer: MemoryBuffer(data: data)).decodeRootObject() as? Media
+        if let file = media as? TelegramMediaFile {
+            if file.resource.id.stringRepresentation == resource {
+                return ArchivedAttachmentInfo(
+                    filename: file.fileName ?? (file.isVoice ? "voice.ogg" : file.isVideo ? "video.mp4" : "file"),
+                    mimeType: file.mimeType,
+                    kind: file.isVoice ? .voice : file.isVideo ? .video : .file)
+            }
+            if file.previewRepresentations.contains(where: { $0.resource.id.stringRepresentation == resource }) {
+                return ArchivedAttachmentInfo(filename: "preview.jpg", mimeType: "image/jpeg", kind: .photo)
+            }
+        }
+        if let image = media as? TelegramMediaImage,
+            image.representations.contains(where: { $0.resource.id.stringRepresentation == resource })
+        {
+            return ArchivedAttachmentInfo(filename: "photo.jpg", mimeType: "image/jpeg", kind: .photo)
+        }
+    }
+    return nil
+}
+
+/// Purges archive-owned copies and retained Postbox rows locally; it never sends Telegram deletion requests.
+public func additionalPurgeArchive(account: Account, chat: String? = nil, message: ArchivedMessageID? = nil) -> Signal<
+    Bool, NoError
+> {
+    account.postbox.transaction { transaction -> Bool in
+        guard let session = account.additionalArchiveSession, transaction.messageProcessingSessionActive else {
+            return false
+        }
+        return ArchiveSessions.shared.perform(session) {
+            let key = additionalAccountKey(account.peerId)
+            if let message, message.account != key { return false }
+            do {
+                var retained = Set(
+                    try DeletedMessageArchive.shared.deletedMessageIDs(account: key, chat: message?.chat ?? chat))
+                for legacy in MessageArchive.shared.retainedKeys(account: key, chat: message?.chat ?? chat) {
+                    if let id = Int32(exactly: legacy.id) {
+                        retained.insert(ArchivedMessageID(account: key, chat: legacy.chat, message: id))
+                    }
+                }
+                if let message {
+                    retained = retained.filter { $0 == message }
+                    try DeletedMessageArchive.shared.purge(message)
+                    MessageArchive.shared.exclude(
+                        MessageKey(account: key, chat: message.chat, id: Int64(message.message)))
+                    MessageArchive.shared.synchronize()
+                } else {
+                    try DeletedMessageArchive.shared.purgeAll(account: key, chat: chat)
+                    try MessageArchive.shared.purgeMetadata(account: key, chat: chat)
+                }
+                let ids = retained.compactMap { identity -> MessageId? in
+                    guard let peer = additionalArchivePeer(identity.chat) else { return nil }
+                    return MessageId(peerId: peer, namespace: identity.namespace, id: identity.message)
+                }
+                transaction.deleteMessages(ids, forEachMedia: nil)
+                return true
+            } catch {
+                DeletedMessageArchive.shared.reportFailure(error)
+                return false
+            }
+        } ?? false
+    }
+}
+
+public struct ArchivedMessageContext {
+    public let reply: Int32?
+    public let forwardedFrom: String?
+    public let isForwarded: Bool
+}
+
+public func additionalArchivedContext(_ message: ArchivedMessage) throws -> ArchivedMessageContext {
+    let payload = try JSONDecoder().decode(AdditionalArchivedPayload.self, from: message.payload)
+    guard payload.version == 1 else { throw SettingsError.invalid("Unsupported archived message version.") }
+    let attributes = payload.attributes.compactMap {
+        PostboxDecoder(buffer: MemoryBuffer(data: $0)).decodeRootObject() as? MessageAttribute
+    }
+    let peers = payload.peers.compactMap { PostboxDecoder(buffer: MemoryBuffer(data: $0)).decodeRootObject() as? Peer }
+    let reply = (attributes.first { $0 is ReplyMessageAttribute } as? ReplyMessageAttribute)?.messageId.id
+    let forwarded = payload.forward.flatMap { forward in
+        forward.author.flatMap { id in peers.first { $0.id.toInt64() == id }?.debugDisplayTitle }
+            ?? forward.source.flatMap { id in peers.first { $0.id.toInt64() == id }?.debugDisplayTitle }
+            ?? forward.signature ?? (forward.author ?? forward.source).map { "#" + String($0) }
+    }
+    return ArchivedMessageContext(reply: reply, forwardedFrom: forwarded, isForwarded: payload.forward != nil)
+}
