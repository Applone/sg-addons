@@ -0,0 +1,73 @@
+import XCTest
+
+@testable import Postbox
+
+final class AdditionalMessageProcessingTests: XCTestCase {
+    private var fixture: PostboxFixture!
+
+    override func setUp() {
+        super.setUp()
+        fixture = PostboxFixture(name: "AdditionalMessageProcessingTests")
+    }
+
+    override func tearDown() {
+        fixture.close()
+        fixture = nil
+        super.tearDown()
+    }
+
+    private static func message(_ text: String) -> StoreMessage {
+        StoreMessage(
+            id: MessageHistoryTableFixture.messageId(peer: 600, id: 1), customStableId: nil,
+            globallyUniqueId: nil, groupingKey: nil, threadId: nil, timestamp: 1000,
+            flags: [], tags: [], globalTags: [], localTags: [], forwardInfo: nil,
+            authorId: nil, text: text, attributes: [], media: [])
+    }
+
+    func testProcessorReceivesPreviousBodyBeforeAnEdit() {
+        var observations: [(String, String?)] = []
+        fixture.transaction { transaction in
+            transaction.setMessageProcessor { proposed, previous, _ in
+                observations.append((proposed.text, previous?.text))
+                return proposed
+            }
+            _ = transaction.addMessages([Self.message("Original")], location: .Random)
+        }
+        fixture.transaction { transaction in
+            transaction.updateMessage(MessageHistoryTableFixture.messageId(peer: 600, id: 1)) { _ in
+                .update(Self.message("Edited"))
+            }
+        }
+        XCTAssertEqual(observations.count, 2)
+        XCTAssertEqual(observations.first?.0, "Original")
+        XCTAssertNil(observations.first?.1)
+        XCTAssertEqual(observations.last?.0, "Edited")
+        XCTAssertEqual(observations.last?.1, "Original")
+    }
+
+    func testCancelledReplacementNotifiesDeletionObserver() {
+        let id = MessageHistoryTableFixture.messageId(peer: 600, id: 1)
+        var removed: [MessageId] = []
+        fixture.transaction { transaction in
+            _ = transaction.addMessages([Self.message("Original")], location: .Random)
+            transaction.setMessageDeletionObserver { removed += $0 }
+            transaction.setMessageProcessor { _, _, _ in nil }
+            transaction.updateMessage(id) { _ in .update(Self.message("Filtered")) }
+            XCTAssertNil(transaction.getMessage(id))
+        }
+        XCTAssertEqual(removed, [id])
+    }
+
+    func testTransactionSessionValidatorTracksRevocation() {
+        var active = true
+        fixture.transaction { transaction in
+            XCTAssertFalse(transaction.messageProcessingSessionActive)
+            transaction.setMessageProcessingSessionValidator { active }
+            XCTAssertTrue(transaction.messageProcessingSessionActive)
+        }
+        fixture.transaction { transaction in
+            active = false
+            XCTAssertFalse(transaction.messageProcessingSessionActive)
+        }
+    }
+}
