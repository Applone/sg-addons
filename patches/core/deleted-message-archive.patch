diff --git a/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalArchiveMedia.swift b/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalArchiveMedia.swift
new file mode 100644
index 00000000..001278c2
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalArchiveMedia.swift
@@ -0,0 +1,221 @@
+import Foundation
+import Postbox
+import SGAdditionalCore
+import SwiftSignalKit
+
+/// Account-owned bounded downloads. The SQLite queue fences every file commit against purged ownership.
+final class AdditionalArchiveMedia: Disposable {
+    private weak var account: Account?
+    private let queue = Queue(name: "Swiftgram.ArchiveMedia")
+    private var network: NetworkType = .none
+    private var subscription: Disposable?
+    private var settingsObserver: NSObjectProtocol?
+    private var captureObserver: NSObjectProtocol?
+    private var scanScheduled = false
+    private var timer: SwiftSignalKit.Timer?
+    private var active: [String: DisposableSet] = [:]
+    private var stopped = false
+    private var migrating = false
+    private var migrated = false
+    private let migration = MetaDisposable()
+
+    init(account: Account) {
+        self.account = account
+        settingsObserver = NotificationCenter.default.addObserver(
+            forName: Notification.Name("SGASettingsDidChange"), object: nil, queue: nil
+        ) { [weak self] _ in
+            guard let self else { return }
+            self.queue.async { [weak self] in self?.reconfigure() }
+        }
+        let key = additionalAccountKey(account.peerId)
+        captureObserver = NotificationCenter.default.addObserver(
+            forName: Notification.Name("SGAArchiveCaptured"), object: nil, queue: nil
+        ) { [weak self] notification in
+            guard notification.object as? String == key, let self else { return }
+            self.queue.async { [weak self] in
+                guard let self, !self.stopped, !self.scanScheduled else { return }
+                self.scanScheduled = true
+                self.queue.after(0.1) { [weak self] in
+                    self?.scanScheduled = false
+                    self?.scan()
+                }
+            }
+        }
+        subscription = (account.networkType |> deliverOn(queue)).start(next: { [weak self] type in
+            guard let self else { return }
+            self.network = type
+            self.reconfigure()
+        })
+        queue.async { [weak self] in
+            guard let self else { return }
+            let timer = SwiftSignalKit.Timer(
+                timeout: 15, repeat: true, completion: { [weak self] in self?.scan() }, queue: self.queue)
+            self.timer = timer
+            timer.start()
+            self.scan()
+        }
+    }
+
+    func dispose() {
+        subscription?.dispose()
+        if let settingsObserver { NotificationCenter.default.removeObserver(settingsObserver) }
+        if let captureObserver { NotificationCenter.default.removeObserver(captureObserver) }
+        migration.dispose()
+        queue.async { [self] in
+            stopped = true
+            timer?.invalidate()
+            for disposable in active.values { disposable.dispose() }
+            active.removeAll()
+        }
+    }
+
+    private func reconfigure() {
+        guard !stopped, let account, let session = account.additionalArchiveSession else { return }
+        ArchiveSessions.shared.perform(session) {
+            for disposable in active.values { disposable.dispose() }
+            active.removeAll()
+            do {
+                let key = additionalAccountKey(account.peerId)
+                for attachment in try DeletedMessageArchive.shared.attachments(account: key)
+                where attachment.status == "unavailable" || attachment.status == "oversized" {
+                    try DeletedMessageArchive.shared.attachmentStatus(
+                        id: attachment.id, account: key, status: "pending")
+                }
+            } catch { DeletedMessageArchive.shared.reportFailure(error) }
+        }
+        scan()
+    }
+
+    private func scan() {
+        guard !stopped, let account else { return }
+        guard let session = account.additionalArchiveSession else { return }
+        ArchiveSessions.shared.perform(session) { scanActive(account: account, session: session) }
+    }
+
+    private func scanActive(account: Account, session: ArchiveSession) {
+        let key = additionalAccountKey(account.peerId)
+        let profile = AddonSettings.shared.profile(key)
+        if !migrated && !migrating {
+            do {
+                let cursor = try DeletedMessageArchive.shared.migrationCursor(account: key)
+                let entries = try MessageArchive.shared.legacyPage(account: key, after: cursor)
+                if entries.isEmpty {
+                    migrated = true
+                } else {
+                    migrating = true
+                    migration.set(
+                        (additionalMigrateArchive(account: account, entries: entries) |> deliverOn(queue)).start(next: {
+                            [weak self] success in
+                            guard let self else { return }
+                            self.migrating = false
+                            if success { self.queue.after(0.1) { [weak self] in self?.scan() } }
+                        }))
+                }
+            } catch { DeletedMessageArchive.shared.reportFailure(error) }
+        }
+
+        do {
+            let evicted = try DeletedMessageArchive.shared.enforcePolicy(
+                account: key, days: profile.retentionDays, quota: Int64(profile.archive.quotaMiB) * 1_048_576)
+            var expiredMessages: [MessageId] = []
+            for id in evicted {
+                let legacy = MessageKey(account: key, chat: id.chat, id: Int64(id.message))
+                if MessageArchive.shared.isDeleted(legacy), let peer = additionalArchivePeer(id.chat) {
+                    expiredMessages.append(MessageId(peerId: peer, namespace: id.namespace, id: id.message))
+                }
+                MessageArchive.shared.exclude(legacy)
+            }
+            if !evicted.isEmpty { MessageArchive.shared.synchronize() }
+            if !expiredMessages.isEmpty {
+                let ids = expiredMessages
+                let _ = account.postbox.transaction { transaction -> Void in
+                    ArchiveSessions.shared.perform(session) { transaction.deleteMessages(ids, forEachMedia: nil) }
+                }.start()
+            }
+            let botChats = Set(try DeletedMessageArchive.shared.chats(account: key).filter { $0.isBot }.map { $0.id })
+            let attachments = try DeletedMessageArchive.shared.attachments(account: key)
+            let allowed = attachments.filter { attachment in
+                attachment.chats.contains {
+                    (profile.archive.capturesDeleted(chat: $0, bot: botChats.contains($0), enabled: profile.saveDeleted)
+                        || profile.archive.capturesHistory(
+                            chat: $0, bot: botChats.contains($0), enabled: profile.saveEditHistory))
+                        && profile.archive.capturesMedia(chat: $0)
+                }
+            }
+            let canFetch =
+                profile.archive.network != .cached && network != .none
+                && (profile.archive.network == .all || network == .wifi)
+            let owned = canFetch ? Set(allowed.map { $0.id }) : []
+            for id in Array(active.keys) where !owned.contains(id) { active.removeValue(forKey: id)?.dispose() }
+            for attachment in allowed where attachment.file == nil && active[attachment.id] == nil {
+                guard
+                    let resource = PostboxDecoder(buffer: MemoryBuffer(data: attachment.descriptor)).decodeRootObject()
+                        as? MediaResource
+                else { continue }
+                if let size = resource.size, size > Int64(profile.archive.fileLimitMiB) * 1_048_576 {
+                    try DeletedMessageArchive.shared.attachmentStatus(
+                        id: attachment.id, account: key, status: "oversized")
+                    continue
+                }
+                if let path = account.postbox.mediaBox.completedResourcePath(resource) {
+                    do {
+                        try DeletedMessageArchive.shared.saveAttachment(
+                            id: attachment.id, account: key, source: URL(fileURLWithPath: path),
+                            maximumBytes: Int64(profile.archive.fileLimitMiB) * 1_048_576)
+                    } catch {
+                        try DeletedMessageArchive.shared.attachmentStatus(
+                            id: attachment.id, account: key, status: "unavailable")
+                        DeletedMessageArchive.shared.reportFailure(error)
+                    }
+                    continue
+                }
+                guard active.count < 2, attachment.status == "pending",
+                    profile.saveDeleted || profile.saveEditHistory || !profile.archive.chats.isEmpty,
+                    profile.archive.network != .cached, network != .none,
+                    profile.archive.network == .all || network == .wifi
+                else { continue }
+                let set = DisposableSet()
+                active[attachment.id] = set
+                let finish: (String?) -> Void = { [weak self] status in
+                    guard let self, self.active[attachment.id] === set else { return }
+                    if let status {
+                        try? DeletedMessageArchive.shared.attachmentStatus(
+                            id: attachment.id, account: key, status: status)
+                    }
+                    self.active.removeValue(forKey: attachment.id)?.dispose()
+                }
+                set.add(
+                    (fetchedMediaResource(
+                        mediaBox: account.postbox.mediaBox, userLocation: .other,
+                        userContentType: .other, reference: .standalone(resource: resource)) |> deliverOn(queue)).start(
+                            error: { _ in finish("unavailable") }))
+                set.add(
+                    (account.postbox.mediaBox.resourceData(resource, option: .incremental(waitUntilFetchStatus: false))
+                        |> deliverOn(queue)).start(next: { data in
+                            guard
+                                let active = ArchiveSessions.shared.perform(
+                                    session, { self.active[attachment.id] === set }), active
+                            else { return }
+                            let limit = Int64(profile.archive.fileLimitMiB) * 1_048_576
+                            if data.size > limit {
+                                finish("oversized")
+                                return
+                            }
+                            guard data.complete else { return }
+                            do {
+                                try ArchiveSessions.shared.perform(session) {
+                                    try DeletedMessageArchive.shared.saveAttachment(
+                                        id: attachment.id, account: key, source: URL(fileURLWithPath: data.path),
+                                        maximumBytes: limit)
+                                }
+                                finish(nil)
+                            } catch { finish("unavailable") }
+                        }))
+                queue.after(60) { [weak self, weak set] in
+                    guard let self, let set, self.active[attachment.id] === set else { return }
+                    finish("unavailable")
+                }
+            }
+        } catch { DeletedMessageArchive.shared.reportFailure(error) }
+    }
+}
