+            return 1
+        }
+        CheckCore.require(rejected == nil && !invoked, "logged-out callbacks never execute")
+        let replacement = sessions.begin(account: "77", owner: "new-record")
+        let stale: Int? = sessions.perform(original) { 1 }
+        CheckCore.require(stale == nil, "reauthorization cannot revive an old session token")
+        sessions.end(account: "77", owner: "old-record") { invoked = true }
+        CheckCore.require(
+            !invoked && sessions.perform(replacement, { true }) == true,
+            "late cleanup from an old account record preserves the new login")
+        let unrelated = sessions.begin(account: "88")
+        sessions.end(account: "77", owner: "new-record") {}
+        CheckCore.require(sessions.perform(unrelated, { true }) == true, "session revocation respects account identity")
+        let session = sessions.begin(account: "99")
+        let entered = DispatchSemaphore(value: 0)
+        let release = DispatchSemaphore(value: 0)
+        let operationDone = DispatchSemaphore(value: 0)
+        let removalDone = DispatchSemaphore(value: 0)
+        DispatchQueue.global().async {
+            sessions.perform(session) {
+                entered.signal()
+                CheckCore.require(release.wait(timeout: .now() + 2) == .success, "release in-flight archive operation")
+            }
+            operationDone.signal()
+        }
+        CheckCore.require(entered.wait(timeout: .now() + 2) == .success, "archive operation entered")
+        DispatchQueue.global().async {
+            sessions.end(account: "99") {}
+            removalDone.signal()
+        }
+        CheckCore.require(
+            removalDone.wait(timeout: .now() + 0.02) == .timedOut, "logout waits for in-flight archive mutation")
+        release.signal()
+        CheckCore.require(operationDone.wait(timeout: .now() + 2) == .success, "archive operation completes")
+        CheckCore.require(removalDone.wait(timeout: .now() + 2) == .success, "logout finishes after mutation")
+        CheckCore.require(sessions.perform(session, { true }) == nil, "late mutations remain rejected")
+    }
+}
