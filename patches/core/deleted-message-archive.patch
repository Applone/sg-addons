+++ b/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalArchiveMaintenance.swift
@@ -0,0 +1,83 @@
+import Foundation
+import Postbox
+import SGAdditionalCore
+import SwiftSignalKit
+
+final class AdditionalArchiveMaintenance: Disposable {
+    private weak var account: Account?
+    private let queue = Queue(name: "Swiftgram.ArchiveMaintenance")
+    private var timer: SwiftSignalKit.Timer?
+    private var stopped = false
+    private var pruning = false
+    private var migrating = false
+    private var migrated = false
+    private let migration = MetaDisposable()
+    private let cleanup = MetaDisposable()
+
+    init(account: Account) {
+        self.account = account
+        queue.async { [weak self] in
+            guard let self, !self.stopped else { return }
+            let timer = SwiftSignalKit.Timer(
+                timeout: 15, repeat: true, completion: { [weak self] in self?.scan() }, queue: self.queue)
+            self.timer = timer
+            timer.start()
+            self.scan()
+        }
+    }
+
+    func dispose() {
+        migration.dispose()
+        cleanup.dispose()
+        queue.async { [self] in
+            stopped = true
+            timer?.invalidate()
+        }
+    }
+
+    private func scan() {
+        guard !stopped, let account, let session = account.additionalArchiveSession else { return }
+        let key = additionalAccountKey(account.peerId)
+        if !migrated && !migrating {
+            do {
+                let cursor = try DeletedMessageArchive.shared.migrationCursor(account: key)
+                let entries = try MessageArchive.shared.legacyPage(account: key, after: cursor)
+                if entries.isEmpty {
+                    migrated = true
+                } else {
+                    migrating = true
+                    migration.set(
+                        (additionalMigrateArchive(account: account, entries: entries) |> deliverOn(queue)).start(next: {
+                            [weak self] success in
+                            guard let self else { return }
+                            self.migrating = false
+                            if success { self.queue.after(0.1) { [weak self] in self?.scan() } }
+                        }))
+                }
+            } catch { DeletedMessageArchive.shared.reportFailure(error) }
+        }
+
+        guard !pruning else { return }
+        pruning = true
+        cleanup.set(
+            (account.postbox.transaction { transaction in
+                ArchiveSessions.shared.perform(session) {
+                    do {
+                        let ids = try DeletedMessageArchive.shared.enforcePolicy(
+                            account: key, days: AddonSettings.shared.profile(key).retentionDays)
+                        let messages = ids.compactMap { id -> MessageId? in
+                            let legacy = MessageKey(account: key, chat: id.chat, id: Int64(id.message))
+                            guard MessageArchive.shared.isDeleted(legacy), let peer = additionalArchivePeer(id.chat)
+                            else { return nil }
+                            MessageArchive.shared.exclude(legacy)
+                            return MessageId(peerId: peer, namespace: id.namespace, id: id.message)
+                        }
+                        if !messages.isEmpty {
+                            MessageArchive.shared.synchronize()
+                            transaction.deleteMessages(messages, forEachMedia: nil)
+                        }
+                    } catch { DeletedMessageArchive.shared.reportFailure(error) }
+                }
+            } |> deliverOn(queue)).start(completed: { [weak self] in self?.pruning = false }))
+    }
+}
