+++ b/Swiftgram/SGAdditionalCore/Sources/DeletedMessageArchive.swift
@@ -0,0 +1,895 @@
+import Foundation
+import SQLite3
+
+/// A stable identity independent of Postbox's cache and local row identifiers.
+public struct ArchivedMessageID: Codable, Hashable {
+    public let account: String
+    public let chat: String
+    public let namespace: Int32
+    public let message: Int32
+
+    public init(account: String, chat: String, namespace: Int32 = 0, message: Int32) {
+        self.account = account
+        self.chat = chat
+        self.namespace = namespace
+        self.message = message
+    }
+}
+
+public struct ArchivedMessage: Codable, Equatable {
+    public let id: ArchivedMessageID
+    public let text: String
+    public let timestamp: Int32
+    public let thread: Int64?
+    public let revisionSignature: Data?
+    public let isBotDialog: Bool?
+    public let chatTitle: String
+    public let senderTitle: String
+    public let kind: Kind
+    /// Versioned Telegram adapter payload; the storage layer never interprets it.
+    public let payload: Data
+
+    public enum Kind: String, Codable, CaseIterable { case text, photo, video, voice, file }
+
+    public init(
+        id: ArchivedMessageID, text: String, timestamp: Int32, chatTitle: String,
+        senderTitle: String, kind: Kind, payload: Data, thread: Int64? = nil, revisionSignature: Data? = nil,
+        isBotDialog: Bool? = nil
+    ) {
+        self.id = id
+        self.text = text
+        self.timestamp = timestamp
+        self.thread = thread
+        self.revisionSignature = revisionSignature
+        self.isBotDialog = isBotDialog
+        self.chatTitle = chatTitle
+        self.senderTitle = senderTitle
+        self.kind = kind
+        self.payload = payload
+    }
+}
+
+public struct ArchiveCursor: Equatable {
+    public let observed: Int64
+    public let sequence: Int64
+    public init(observed: Int64, sequence: Int64) {
+        self.observed = observed
+        self.sequence = sequence
+    }
+}
+
+public struct ArchivedMessageEntry {
+    public let message: ArchivedMessage
+    public let observed: Int64
+    public let deletedAt: Int64?
+    public let cursor: ArchiveCursor
+}
+
+public struct ArchivePage {
+    public let entries: [ArchivedMessageEntry]
+    public let next: ArchiveCursor?
+}
+
+/// Owns snapshots separately from the host cache. All mutations commit before returning.
+public final class DeletedMessageArchive {
+    public static let shared: DeletedMessageArchive = {
+        #if TESTING
+            let root = URL(fileURLWithPath: ProcessInfo.processInfo.environment["SGA_TEST_DIRECTORY"]!)
+        #else
+            let root = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
+        #endif
+        return DeletedMessageArchive(directory: root.appendingPathComponent("SwiftgramArchive"))
+    }()
+
+    private let queue = DispatchQueue(label: "app.swiftgram.archive.snapshots", qos: .utility)
+    private let directory: URL
+    private var database: OpaquePointer?
+    private var failure: String?
+    private let transient = unsafeBitCast(-1, to: sqlite3_destructor_type.self)
+
+    public init(directory: URL) {
+        self.directory = directory
+        do {
+            #if os(iOS)
+                let attributes: [FileAttributeKey: Any] = [
+                    .protectionKey: FileProtectionType.completeUntilFirstUserAuthentication
+                ]
+            #else
+                let attributes: [FileAttributeKey: Any] = [:]
+            #endif
+            try FileManager.default.createDirectory(
+                at: directory, withIntermediateDirectories: true, attributes: attributes)
+            var protected = directory
+            var values = URLResourceValues()
+            values.isExcludedFromBackup = true
+            try protected.setResourceValues(values)
+            guard
+                sqlite3_open_v2(
+                    directory.appendingPathComponent("archive.sqlite3").path, &database,
+                    SQLITE_OPEN_CREATE | SQLITE_OPEN_READWRITE | SQLITE_OPEN_FULLMUTEX, nil) == SQLITE_OK
+            else { throw SettingsError.invalid("Cannot open message archive.") }
+            sqlite3_busy_timeout(database, 1000)
+            try execute("PRAGMA journal_mode=WAL")
+            try transaction {
+                let version = try prepare("PRAGMA user_version")
+                defer { sqlite3_finalize(version) }
+                guard sqlite3_step(version) == SQLITE_ROW, sqlite3_column_int(version, 0) <= 4 else {
+                    throw SettingsError.invalid("Message archive requires a newer application version.")
+                }
+                try execute(
+                    """
+                    CREATE TABLE IF NOT EXISTS snapshots (
+                      sequence INTEGER PRIMARY KEY AUTOINCREMENT,
+                      account TEXT NOT NULL, chat TEXT NOT NULL, namespace INTEGER NOT NULL, message INTEGER NOT NULL,
+                      observed INTEGER NOT NULL, deleted INTEGER, kind TEXT NOT NULL, timestamp INTEGER NOT NULL,
+                      payload BLOB NOT NULL, UNIQUE(account,chat,namespace,message));
+                    CREATE INDEX IF NOT EXISTS archive_page ON snapshots(account,observed DESC,sequence DESC);
+                    CREATE INDEX IF NOT EXISTS archive_chat ON snapshots(account,chat,observed DESC,sequence DESC);
+                    CREATE TABLE IF NOT EXISTS purged (
+                      account TEXT NOT NULL, chat TEXT NOT NULL, namespace INTEGER NOT NULL, message INTEGER NOT NULL,
+                      PRIMARY KEY(account,chat,namespace,message));
+                    CREATE TABLE IF NOT EXISTS removed_accounts(account TEXT PRIMARY KEY);
+                    CREATE VIRTUAL TABLE IF NOT EXISTS archive_search USING fts5(text);
+                    CREATE TABLE IF NOT EXISTS attachments (
+                      id TEXT PRIMARY KEY, account TEXT NOT NULL, resource TEXT NOT NULL, descriptor BLOB NOT NULL,
+                      filename TEXT, bytes INTEGER NOT NULL DEFAULT 0, status TEXT NOT NULL DEFAULT 'pending',
+                      UNIQUE(account,resource));
+                    CREATE TABLE IF NOT EXISTS attachment_owners (
+                      sequence INTEGER NOT NULL, attachment TEXT NOT NULL, PRIMARY KEY(sequence,attachment));
+                    CREATE INDEX IF NOT EXISTS attachment_references ON attachment_owners(attachment);
+                    CREATE TABLE IF NOT EXISTS legacy_progress(account TEXT PRIMARY KEY, cursor BLOB NOT NULL);
+                    CREATE TABLE IF NOT EXISTS snapshot_versions (
+                      sequence INTEGER PRIMARY KEY AUTOINCREMENT, owner INTEGER NOT NULL, observed INTEGER NOT NULL, payload BLOB NOT NULL);
+                    CREATE INDEX IF NOT EXISTS snapshot_version_owner ON snapshot_versions(owner,sequence);
+                    PRAGMA user_version=4;
+                    """)
+            }
+            try collectFiles()
+        } catch {
+            failure = error.localizedDescription
+            sqlite3_close(database)
+            database = nil
+        }
+    }
+
+    deinit { sqlite3_close(database) }
+
+    public func status() -> String? { queue.sync { failure } }
+
+    public func reportFailure(_ error: Error) { queue.sync { failure = error.localizedDescription } }
+
+    private func execute(_ sql: String) throws {
+        guard sqlite3_exec(database, sql, nil, nil, nil) == SQLITE_OK else {
+            throw SettingsError.invalid("Message archive storage operation failed.")
+        }
+    }
+
+    private func prepare(_ sql: String) throws -> OpaquePointer {
+        var statement: OpaquePointer?
+        guard sqlite3_prepare_v2(database, sql, -1, &statement, nil) == SQLITE_OK, let statement else {
+            throw SettingsError.invalid("Cannot query message archive.")
+        }
+        return statement
+    }
+
+    private func bind(_ statement: OpaquePointer, _ index: Int32, _ text: String) {
+        _ = text.withCString { sqlite3_bind_text(statement, index, $0, -1, transient) }
+    }
+
+    private func bind(_ statement: OpaquePointer, id: ArchivedMessageID) {
+        bind(statement, 1, id.account)
+        bind(statement, 2, id.chat)
+        sqlite3_bind_int(statement, 3, id.namespace)
+        sqlite3_bind_int(statement, 4, id.message)
+    }
+
+    private func done(_ statement: OpaquePointer) throws {
+        guard sqlite3_step(statement) == SQLITE_DONE else {
+            throw SettingsError.invalid("Cannot update message archive.")
+        }
+    }
+
+    private func transaction<T>(_ body: () throws -> T) throws -> T {
+        try execute("BEGIN IMMEDIATE")
+        do {
+            let result = try body()
+            try execute("COMMIT")
+            return result
+        } catch {
+            try? execute("ROLLBACK")
+            throw error
+        }
+    }
+
+    /// Returns false for explicitly purged identities or accounts awaiting authorization.
+    @discardableResult public func capture(
+        _ message: ArchivedMessage, now: Int64 = Int64(Date().timeIntervalSince1970), ifAbsent: Bool = false,
+        keepRevision: Bool = false
+    )
+        throws -> Bool
+    {
+        try queue.sync {
+            try transaction {
+                let permitted = try prepare(
+                    """
+                    SELECT 1 WHERE NOT EXISTS(SELECT 1 FROM purged WHERE account=? AND chat=? AND namespace=? AND message=?)
+                    AND NOT EXISTS(SELECT 1 FROM removed_accounts WHERE account=?)
+                    """)
+                defer { sqlite3_finalize(permitted) }
+                bind(permitted, id: message.id)
+                bind(permitted, 5, message.id.account)
+                guard sqlite3_step(permitted) == SQLITE_ROW else { return false }
+                if keepRevision && !ifAbsent {
+                    let previous = try prepare(
+                        "SELECT sequence,payload FROM snapshots WHERE account=? AND chat=? AND namespace=? AND message=?"
+                    )
+                    defer { sqlite3_finalize(previous) }
+                    bind(previous, id: message.id)
+                    if sqlite3_step(previous) == SQLITE_ROW, let bytes = sqlite3_column_blob(previous, 1) {
+                        let data = Data(bytes: bytes, count: Int(sqlite3_column_bytes(previous, 1)))
+                        let old = try JSONDecoder().decode(ArchivedMessage.self, from: data)
+                        let changed =
+                            message.revisionSignature.map { $0 != old.revisionSignature }
+                            ?? (old.text != message.text || old.payload != message.payload)
+                        if changed {
+                            let version = try prepare(
+                                "INSERT INTO snapshot_versions(owner,observed,payload) VALUES(?,?,?)")
+                            defer { sqlite3_finalize(version) }
+                            sqlite3_bind_int64(version, 1, sqlite3_column_int64(previous, 0))
+                            sqlite3_bind_int64(version, 2, now)
+                            _ = data.withUnsafeBytes {
+                                sqlite3_bind_blob(version, 3, $0.baseAddress, Int32($0.count), transient)
+                            }
+                            try done(version)
+                        }
+                    }
+                }
+                let data = try JSONEncoder().encode(message)
+                let statement = try prepare(
+                    """
+                    INSERT INTO snapshots(account,chat,namespace,message,observed,kind,timestamp,payload) VALUES(?,?,?,?,?,?,?,?)
+                    ON CONFLICT(account,chat,namespace,message) DO UPDATE SET
+                      kind=excluded.kind,timestamp=excluded.timestamp,payload=excluded.payload WHERE ?=0
+                    """)
+                defer { sqlite3_finalize(statement) }
+                bind(statement, id: message.id)
+                sqlite3_bind_int64(statement, 5, now)
+                bind(statement, 6, message.kind.rawValue)
+                sqlite3_bind_int(statement, 7, message.timestamp)
+                _ = data.withUnsafeBytes { sqlite3_bind_blob(statement, 8, $0.baseAddress, Int32($0.count), transient) }
+                sqlite3_bind_int(statement, 9, ifAbsent ? 1 : 0)
+                try done(statement)
+                if sqlite3_changes(database) == 0 { return true }
+                let identity = try prepare(
+                    "SELECT sequence FROM snapshots WHERE account=? AND chat=? AND namespace=? AND message=?")
+                defer { sqlite3_finalize(identity) }
+                bind(identity, id: message.id)
+                guard sqlite3_step(identity) == SQLITE_ROW else {
+                    throw SettingsError.invalid("Cannot find saved message snapshot.")
+                }
+                let sequence = sqlite3_column_int64(identity, 0)
+                try removeSearch(sequence)
+                let search = try prepare("INSERT INTO archive_search(rowid,text) VALUES(?,?)")
+                defer { sqlite3_finalize(search) }
+                sqlite3_bind_int64(search, 1, sequence)
+                bind(search, 2, message.text)
+                try done(search)
+                return true
+            }
+        }
+    }
+
+    public func markDeleted(_ id: ArchivedMessageID, now: Int64 = Int64(Date().timeIntervalSince1970)) throws -> Bool {
+        try queue.sync {
+            let statement = try prepare(
+                "UPDATE snapshots SET deleted=COALESCE(deleted,?) WHERE account=? AND chat=? AND namespace=? AND message=?"
+            )
+            defer { sqlite3_finalize(statement) }
+            sqlite3_bind_int64(statement, 1, now)
+            bind(statement, 2, id.account)
+            bind(statement, 3, id.chat)
+            sqlite3_bind_int(statement, 4, id.namespace)
+            sqlite3_bind_int(statement, 5, id.message)
+            try done(statement)
+            return sqlite3_changes(database) > 0
+        }
+    }
+
+    public func page(
+        account: String, chat: String? = nil, search: String = "", kind: ArchivedMessage.Kind? = nil,
+        before: ArchiveCursor? = nil, deletedOnly: Bool = true, limit: Int = 50
+    ) throws -> ArchivePage {
+        try queue.sync {
+            let count = min(100, max(1, limit))
+            let statement = try prepare(
+                """
+                SELECT s.sequence,s.observed,s.deleted,s.payload FROM snapshots s
+                WHERE s.account=? AND (? IS NULL OR s.chat=?) AND (? IS NULL OR s.kind=?)
+                  AND (?=0 OR s.deleted IS NOT NULL)
+                  AND (? IS NULL OR s.observed<? OR (s.observed=? AND s.sequence<?))
+                  AND (?='' OR s.sequence IN (SELECT rowid FROM archive_search WHERE archive_search MATCH ?))
+                ORDER BY s.observed DESC,s.sequence DESC LIMIT ?
+                """)
+            defer { sqlite3_finalize(statement) }
+            bind(statement, 1, account)
+            if let chat {
+                bind(statement, 2, chat)
+                bind(statement, 3, chat)
+            }
+            if let kind {
+                bind(statement, 4, kind.rawValue)
+                bind(statement, 5, kind.rawValue)
+            }
+            sqlite3_bind_int(statement, 6, deletedOnly ? 1 : 0)
+            if let before {
+                for index: Int32 in [7, 8, 9] { sqlite3_bind_int64(statement, index, before.observed) }
+                sqlite3_bind_int64(statement, 10, before.sequence)
+            }
+            bind(statement, 11, search)
+            // Treat user input as a literal FTS phrase, never as query syntax.
+            bind(statement, 12, "\"" + search.replacingOccurrences(of: "\"", with: "\"\"") + "\"")
+            sqlite3_bind_int(statement, 13, Int32(count + 1))
+            var entries: [ArchivedMessageEntry] = []
+            while true {
+                let step = sqlite3_step(statement)
+                if step == SQLITE_DONE { break }
+                guard step == SQLITE_ROW, let bytes = sqlite3_column_blob(statement, 3) else {
+                    throw SettingsError.invalid("Cannot read archived messages.")
+                }
+                let data = Data(bytes: bytes, count: Int(sqlite3_column_bytes(statement, 3)))
+                let cursor = ArchiveCursor(
+                    observed: sqlite3_column_int64(statement, 1), sequence: sqlite3_column_int64(statement, 0))
+                entries.append(
+                    ArchivedMessageEntry(
+                        message: try JSONDecoder().decode(ArchivedMessage.self, from: data), observed: cursor.observed,
+                        deletedAt: sqlite3_column_type(statement, 2) == SQLITE_NULL
+                            ? nil : sqlite3_column_int64(statement, 2), cursor: cursor))
+            }
+            let more = entries.count > count
+            if more { entries.removeLast() }
+            return ArchivePage(entries: entries, next: more ? entries.last?.cursor : nil)
+        }
+    }
+
+    private func removeSearch(_ sequence: Int64) throws {
+        let statement = try prepare("DELETE FROM archive_search WHERE rowid=?")
+        defer { sqlite3_finalize(statement) }
+        sqlite3_bind_int64(statement, 1, sequence)
+        try done(statement)
+    }
+
+    /// Tombstones prevent a late server refresh from resurrecting explicitly deleted content.
+    public func purge(_ id: ArchivedMessageID) throws {
+        try queue.sync {
+            try transaction {
+                let tombstone = try prepare("INSERT OR IGNORE INTO purged VALUES(?,?,?,?)")
+                defer { sqlite3_finalize(tombstone) }
+                bind(tombstone, id: id)
+                try done(tombstone)
+                let statement = try prepare(
+                    "SELECT sequence FROM snapshots WHERE account=? AND chat=? AND namespace=? AND message=?")
+                defer { sqlite3_finalize(statement) }
+                bind(statement, id: id)
+                if sqlite3_step(statement) == SQLITE_ROW { try removeSnapshot(sqlite3_column_int64(statement, 0)) }
+            }
+            try collectFiles()
+        }
+    }
+
+    private func removeSnapshot(_ sequence: Int64) throws {
+        let owners = try prepare("DELETE FROM attachment_owners WHERE sequence=?")
+        defer { sqlite3_finalize(owners) }
+        sqlite3_bind_int64(owners, 1, sequence)
+        try done(owners)
+        let versions = try prepare("DELETE FROM snapshot_versions WHERE owner=?")
+        defer { sqlite3_finalize(versions) }
+        sqlite3_bind_int64(versions, 1, sequence)
+        try done(versions)
+        try removeSearch(sequence)
+        let statement = try prepare("DELETE FROM snapshots WHERE sequence=?")
+        defer { sqlite3_finalize(statement) }
+        sqlite3_bind_int64(statement, 1, sequence)
+        try done(statement)
+    }
+
+    /// The account fence also rejects work enqueued before logout but delivered afterwards.
+    public func removeAccount(_ account: String) throws {
+        try queue.sync {
+            try transaction {
+                let fence = try prepare("INSERT OR IGNORE INTO removed_accounts VALUES(?)")
+                defer { sqlite3_finalize(fence) }
+                bind(fence, 1, account)
+                try done(fence)
+                let rows = try prepare("SELECT sequence FROM snapshots WHERE account=?")
+                defer { sqlite3_finalize(rows) }
+                bind(rows, 1, account)
+                var ids: [Int64] = []
+                while sqlite3_step(rows) == SQLITE_ROW { ids.append(sqlite3_column_int64(rows, 0)) }
+                for id in ids { try removeSnapshot(id) }
+                let tombstones = try prepare("DELETE FROM purged WHERE account=?")
+                defer { sqlite3_finalize(tombstones) }
+                bind(tombstones, 1, account)
+                try done(tombstones)
+                let progress = try prepare("DELETE FROM legacy_progress WHERE account=?")
+                defer { sqlite3_finalize(progress) }
+                bind(progress, 1, account)
+                try done(progress)
+            }
+            try collectFiles()
+        }
+    }
+
+    public func authorizeAccount(_ account: String) throws {
+        try queue.sync {
+            let statement = try prepare("DELETE FROM removed_accounts WHERE account=?")
+            defer { sqlite3_finalize(statement) }
+            bind(statement, 1, account)
+            try done(statement)
+        }
+    }
+
+    /// Evict whole snapshots in first-observed order; updates never refresh their age.
+    @discardableResult public func enforcePolicy(
+        account: String, days: Int = 30, quota: Int64 = 1_073_741_824,
+        now: Int64 = Int64(Date().timeIntervalSince1970)
+    ) throws -> [ArchivedMessageID] {
+        guard (1...365).contains(days), quota >= 0 else {
+            throw SettingsError.invalid("Invalid archive storage policy.")
+        }
+        return try queue.sync {
+            let removed = try transaction { () -> [ArchivedMessageID] in
+                let rows = try prepare(
+                    "SELECT sequence,observed,length(payload) FROM snapshots WHERE account=? ORDER BY observed,sequence"
+                )
+                defer { sqlite3_finalize(rows) }
+                bind(rows, 1, account)
+                var records: [(Int64, Int64, Int64)] = []
+                while sqlite3_step(rows) == SQLITE_ROW {
+                    let size = sqlite3_column_int64(rows, 2)
+                    records.append((sqlite3_column_int64(rows, 0), sqlite3_column_int64(rows, 1), size))
+                }
+                let cutoff = now - Int64(days) * 86_400
+                var evicted: [ArchivedMessageID] = []
+                var used = try usedBytes(account)
+                for (sequence, observed, _) in records {
+                    if observed < cutoff || used > quota {
+                        let row = try prepare("SELECT payload FROM snapshots WHERE sequence=?")
+                        defer { sqlite3_finalize(row) }
+                        sqlite3_bind_int64(row, 1, sequence)
+                        guard sqlite3_step(row) == SQLITE_ROW, let bytes = sqlite3_column_blob(row, 0) else {
+                            throw SettingsError.invalid("Cannot expire archived message.")
+                        }
+                        let data = Data(bytes: bytes, count: Int(sqlite3_column_bytes(row, 0)))
+                        let id = try JSONDecoder().decode(ArchivedMessage.self, from: data).id
+                        let marker = try prepare("INSERT OR IGNORE INTO purged VALUES(?,?,?,?)")
+                        defer { sqlite3_finalize(marker) }
+                        bind(marker, id: id)
+                        try done(marker)
+                        let released = try prepare(
+                            """
+                            SELECT length(s.payload)
+                              + COALESCE((SELECT SUM(length(payload)) FROM snapshot_versions WHERE owner=s.sequence),0)
+                              + COALESCE((SELECT SUM(a.bytes) FROM attachments a JOIN attachment_owners o ON o.attachment=a.id
+                                  WHERE o.sequence=s.sequence AND NOT EXISTS(SELECT 1 FROM attachment_owners other
+                                    WHERE other.attachment=a.id AND other.sequence!=s.sequence)),0)
+                            FROM snapshots s WHERE sequence=?
+                            """)
+                        defer { sqlite3_finalize(released) }
+                        sqlite3_bind_int64(released, 1, sequence)
+                        guard sqlite3_step(released) == SQLITE_ROW else {
+                            throw SettingsError.invalid("Cannot measure expired archive storage.")
+                        }
+                        used -= sqlite3_column_int64(released, 0)
+                        evicted.append(id)
+                        try removeSnapshot(sequence)
+                    }
+                }
+                return evicted
+            }
+            try collectFiles()
+            return removed
+        }
+    }
+}
+
+public struct ArchivedAttachment {
+    public let chats: [String]
+    public let id: String
+    public let resource: String
+    public let descriptor: Data
+    public let status: String
+    public let bytes: Int64
+    public let file: URL?
