+import Foundation
+
+public struct ArchiveChatOverride: Codable, Equatable {
+    public var deleted: Bool?
+    public var history: Bool?
+    public var media: Bool?
+    public init(deleted: Bool? = nil, history: Bool? = nil, media: Bool? = nil) {
+        self.deleted = deleted
+        self.history = history
+        self.media = media
+    }
+}
+
+public struct ArchivePolicy: Codable, Equatable {
+    public enum Network: String, Codable { case wifi, all, cached }
+    public var quotaMiB = 1024
+    public var fileLimitMiB = 100
+    public var network: Network = .wifi
+    public var media = true
+    public var bots = false
+    public var chats: [String: ArchiveChatOverride] = [:]
+
+    public init() {}
+
+    /// Old installations already captured bot dialogs; preserve that choice on migration.
+    public static var legacy: ArchivePolicy {
+        var policy = ArchivePolicy()
+        policy.bots = true
+        return policy
+    }
+
+    public func validate() throws {
+        guard (1...1_048_576).contains(quotaMiB), (1...1024).contains(fileLimitMiB), chats.count <= 10_000 else {
+            throw SettingsError.invalid("Invalid archive size limits or chat overrides.")
+        }
+        if !chats.isEmpty {
+            var rule = FilterRule()
+            rule.pattern = "archive"
+            rule.chats = Array(chats.keys)
+            try rule.validate()
+        }
+    }
+
+    public func capturesDeleted(chat: String, bot: Bool, enabled: Bool) -> Bool {
+        chats[chat]?.deleted ?? (enabled && (!bot || bots))
+    }
+
+    public func capturesHistory(chat: String, bot: Bool, enabled: Bool) -> Bool {
+        chats[chat]?.history ?? (enabled && (!bot || bots))
+    }
+
+    public func capturesMedia(chat: String) -> Bool { chats[chat]?.media ?? media }
+}
