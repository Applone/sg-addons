diff --git a/submodules/TelegramApi/Sources/LegacyConstructors.swift b/submodules/TelegramApi/Sources/LegacyConstructors.swift
new file mode 100644
index 00000000..e910b5c5
--- /dev/null
+++ b/submodules/TelegramApi/Sources/LegacyConstructors.swift
@@ -0,0 +1,22 @@
+// Legacy constructors still sent by servers at the pinned API layer.
+// Keep current serialization unchanged; adapt only the older incoming layouts.
+extension Api.UserFull {
+    static func parseLegacyUserFull(_ reader: BufferReader) -> Api.UserFull? {
+        guard let value = parse_userFull(reader), case .userFull(let data) = value else { return nil }
+        if data.flags2 & (1 << 27) != 0 {
+            guard parseString(reader) != nil else { return nil }
+        }
+        return value
+    }
+}
+
+extension Api.WalletUserAddress {
+    static func parseLegacyWalletUserAddress(_ reader: BufferReader) -> Api.WalletUserAddress? {
+        guard let userId = reader.readInt64(), let address = parseString(reader), let publicKey = parseBytes(reader)
+        else {
+            return nil
+        }
+        return .walletUserAddress(
+            Cons_walletUserAddress(flags: 1, userId: userId, address: address, publicKey: publicKey))
+    }
+}
