@@ -0,0 +1,146 @@
+"""Compile and exercise the actual C bridge in an independent CPython process."""
+
+from __future__ import annotations
+
+import json
+import shutil
+import subprocess
+import sys
+import sysconfig
+import tempfile
+import unittest
+from pathlib import Path
+from typing import Any
+
+HARNESS = r"""
+#include "SGPythonBridge.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+int main(int argc, char **argv) {
+    if (argc != 3) return 2;
+    char *error = NULL;
+    if (!SGPythonInitialize(argv[1], argv[2], &error)) {
+        fprintf(stderr, "%s\n", error); SGPythonFree(error); return 3;
+    }
+    char *line = NULL;
+    size_t capacity = 0;
+    while (getline(&line, &capacity, stdin) > 0) {
+        char *payload = strchr(line, '\t');
+        if (!payload) return 4;
+        *payload++ = '\0';
+        int release = *payload++ == '1';
+        if (*payload++ != '\t') return 5;
+        char *result = SGPythonCallIsolated(line, payload, release, &error);
+        if (!result) {
+            fprintf(stderr, "%s\n", error); SGPythonFree(error); return 6;
+        }
+        puts(result);
+        SGPythonFree(result);
+    }
+    free(line);
+    return 0;
+}
+"""
+
+
+class BridgeTests(unittest.TestCase):
+    def test_conflicting_versions_and_module_state_are_isolated(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            python = Path(__file__).resolve().parents[1]
+            bridge = python / "Bridge"
+            harness = root / "harness.c"
+            harness.write_text(HARNESS)
+            executable = root / "bridge-check"
+            compiler = shutil.which("clang") or "cc"
+            library = Path(sysconfig.get_config_var("LIBDIR")) / sysconfig.get_config_var(
+                "LDLIBRARY"
+            )
+            subprocess.run(
+                [
+                    compiler,
+                    "-std=c11",
+                    "-D_POSIX_C_SOURCE=200809L",
+                    "-Wall",
+                    "-Wextra",
+                    "-Werror",
+                    "-I",
+                    sysconfig.get_path("include"),
+                    "-I",
+                    str(bridge),
+                    str(harness),
+                    str(bridge / "SGPythonBridge.c"),
+                    str(library),
+                    "-Wl,-rpath," + str(library.parent),
+                    "-o",
+                    str(executable),
+                ],
+                check=True,
+                capture_output=True,
+                text=True,
+            )
+            environments = [root / "one", root / "two"]
+            for index, directory in enumerate(environments):
+                directory.mkdir()
+                (directory / "shared_dependency.py").write_text(f"VERSION = {index + 1}\n")
+            source = """# /// script
+# id = "isolated-plugin"
+# name = "Isolated"
+# ///
+import json
+import math
+import shared_dependency
+from swiftgram import BasePlugin, HookResult, HookStrategy
+class Plugin(BasePlugin):
+    def on_message(self, event):
+        previous = getattr(json, "plugin_state", "clean")
+        json.plugin_state = str(shared_dependency.VERSION)
+        text = f"{shared_dependency.VERSION}:{previous}:{math.factorial(3)}"
+        return HookResult(HookStrategy.MODIFY, text=text)
+"""
+
+            def request(index: int, *, unload: bool = False) -> str:
+                payload = {
+                    "operation": "unload" if unload else "hook",
+                    "id": "isolated-plugin",
+                    "account": "77",
+                    "source": source,
+                    "settings": {},
+                    "dependencyPath": str(environments[index]),
+                    "callback": "on_message",
+                    "event": {"kind": "message", "name": "message", "account": "77", "text": "x"},
+                }
+                return f"plugin-{index}\t{int(unload)}\t{json.dumps(payload)}\n"
+
+            calls = (
+                request(0)
+                + request(1)
+                + request(0)
+                + request(0, unload=True)
+                + request(0)
+                + request(1)
+            )
+            completed = subprocess.run(
+                [str(executable), sys.base_prefix, str(python / "SDK")],
+                input=calls,
+                capture_output=True,
+                text=True,
+                check=True,
+                timeout=20,
+            )
+            replies: list[dict[str, Any]] = [
+                json.loads(line) for line in completed.stdout.splitlines()
+            ]
+            self.assertFalse(any("failure" in reply for reply in replies), replies)
+            self.assertFalse(
+                any(root.rglob("__pycache__")), "Plugin imports must not mutate environments"
+            )
+            self.assertEqual(
+                [reply.get("result", {}).get("text") for reply in replies],
+                ["1:clean:6", "2:clean:6", "1:1:6", None, "1:clean:6", "2:2:6"],
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
