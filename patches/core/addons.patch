+"""Offline contracts for review, resolution, artifact verification and installation."""
+
+from __future__ import annotations
+
+import hashlib
+import io
+import json
+import tempfile
+import unittest
+import zipfile
+from pathlib import Path
+from typing import Any
+from unittest.mock import patch
+
+import _swiftgram_dependencies as deps
+from _swiftgram_runtime import metadata
+from resolvelib.resolvers import ResolutionImpossible
+
+
+def script(requirements: list[str]) -> str:
+    return (
+        '# /// script\n# id = "dependency-test"\n# name = "Dependencies"\n'
+        f"# dependencies = {json.dumps(requirements)}\n# ///\n"
+        'raise RuntimeError("inspection must not run this")\n'
+    )
+
+
+class Index:
+    def __init__(self) -> None:
+        self.files: dict[str, bytes] = {}
+        self.projects: dict[str, list[dict[str, Any]]] = {}
+
+    def add(
+        self,
+        name: str,
+        version: str,
+        requirements: tuple[str, ...] = (),
+        *,
+        extras: tuple[str, ...] = (),
+        members: dict[str, str] | None = None,
+        tag: str = "py3-none-any",
+        sidecar: bool = True,
+        yanked: bool = False,
+    ) -> str:
+        filename = f"{name.replace('-', '_')}-{version}-{tag}.whl"
+        url = f"https://files.pythonhosted.org/packages/{filename}"
+        info = (
+            f"Metadata-Version: 2.3\nName: {name}\nVersion: {version}\nRequires-Python: >=3.12\n"
+            + "".join(f"Requires-Dist: {item}\n" for item in requirements)
+            + "".join(f"Provides-Extra: {item}\n" for item in extras)
+            + "\n"
+        ).encode()
+        stream = io.BytesIO()
+        with zipfile.ZipFile(stream, "w") as archive:
+            archive.writestr(f"{name}-{version}.dist-info/METADATA", info)
+            archive.writestr(
+                f"{name}-{version}.dist-info/WHEEL",
+                "Wheel-Version: 1.0\nRoot-Is-Purelib: true\nTag: py3-none-any\n",
+            )
+            for path, content in (
+                members or {f"{name}/__init__.py": f'VERSION = "{version}"'}
+            ).items():
+                archive.writestr(path, content)
+        self.files[url] = stream.getvalue()
+        self.files[url + ".metadata"] = info
+        self.projects.setdefault(name, []).append(
+            {
+                "filename": filename,
+                "url": url,
+                "requires-python": ">=3.12",
+                "yanked": yanked,
+                "hashes": {"sha256": hashlib.sha256(self.files[url]).hexdigest()},
+                "core-metadata": {"sha256": hashlib.sha256(info).hexdigest()} if sidecar else False,
+            }
+        )
+        return url
+
+    def fetch(self, url: str, limit: int, *, index: bool = False) -> bytes:
+        if index:
+            name = url.rstrip("/").rsplit("/", 1)[-1]
+            return json.dumps(
+                {"meta": {"api-version": "1.1"}, "files": self.projects.get(name, [])}
+            ).encode()
+        return self.files[url]
+
+
+class DependencyTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.temporary = tempfile.TemporaryDirectory()
+        self.root = Path(self.temporary.name) / "environments"
+        self.index = Index()
+        self.network = patch.object(deps, "fetch", self.index.fetch)
+        self.network.start()
+
+    def tearDown(self) -> None:
+        self.network.stop()
+        self.temporary.cleanup()
+        deps._plans.clear()
+
+    def prepare(self, requirements: list[str]) -> dict[str, Any]:
+        return deps.manage(
+            {"operation": "resolve", "source": script(requirements), "root": str(self.root)}
+        )
+
+    def install(self, plan: dict[str, Any]) -> Path:
+        reply = deps.manage(
+            {
+                "operation": "install",
+                "token": plan["token"],
+                "root": str(self.root),
+                "source": deps._plans[plan["token"]].source if plan["token"] in deps._plans else "",
+                "dependencies": plan["dependencies"],
+            }
+        )
+        return self.root / str(reply["environment"])
+
+    def test_backtracking_and_transitive_pins(self) -> None:
+        self.index.add("alpha", "2", ("shared>=2",))
+        self.index.add("alpha", "1", ("shared<2",))
+        self.index.add("shared", "2")
+        self.index.add("shared", "1")
+        self.index.add("beta", "1", ("shared<2",))
+        plan = self.prepare(["alpha", "beta"])
+        self.assertEqual(
+            [(item["name"], item["version"], item["direct"]) for item in plan["dependencies"]],
+            [("alpha", "1", True), ("beta", "1", True), ("shared", "1", False)],
+        )
+        self.assertFalse(self.root.exists())
+        directory = self.install(plan)
+        deps.verify(directory, plan["dependencies"])
+
+    def test_constraints_extras_and_markers(self) -> None:
+        self.index.add(
+            "alpha",
+            "1",
+            ('extra-package; extra == "fast"', 'ignored; sys_platform == "win32"'),
+            extras=("fast",),
+        )
+        self.index.add("extra-package", "1")
+        plan = self.prepare(["alpha[fast]~=1.0", 'unavailable; python_version < "3.0"'])
+        self.assertEqual(
+            [item["name"] for item in plan["dependencies"]], ["alpha", "extra-package"]
+        )
+        self.assertFalse(plan["dependencies"][1]["direct"])
+
+    def test_late_extra_merges_are_resolved(self) -> None:
+        self.index.add("alpha", "1", ('extra-package; extra == "fast"',), extras=("fast",))
+        self.index.add("zeta", "1", ("alpha[fast]",))
+        self.index.add("extra-package", "1")
+        plan = self.prepare(["alpha", "zeta"])
+        self.assertEqual(
+            [item["name"] for item in plan["dependencies"]], ["alpha", "extra-package", "zeta"]
+        )
+
+    def test_conflicts_and_native_only_releases_fail_before_install(self) -> None:
+        self.index.add("alpha", "1", ("shared<2",))
+        self.index.add("beta", "1", ("shared>=2",))
+        self.index.add("shared", "1")
+        self.index.add("shared", "2")
+        with self.assertRaises(ResolutionImpossible):
+            self.prepare(["alpha", "beta"])
+        self.index.add("native", "1", tag="cp314-cp314-manylinux_2_17_x86_64")
+        with self.assertRaises(ResolutionImpossible):
+            self.prepare(["native"])
+        self.assertFalse(self.root.exists())
+
+    def test_install_never_resolves_again_and_versions_are_private(self) -> None:
+        self.index.add("shared", "1")
+        self.index.add("shared", "2")
+        first = self.prepare(["shared==1"])
+        second = self.prepare(["shared==2"])
+        with patch.object(deps.Provider, "versions", side_effect=AssertionError("re-resolved")):
+            one = self.install(first)
+            two = self.install(second)
+        self.assertNotEqual(one, two)
+        self.assertIn('"1"', (one / "shared/__init__.py").read_text())
+        self.assertIn('"2"', (two / "shared/__init__.py").read_text())
+        (two / "shared/__init__.py").write_text("changed")
+        deps.verify(one, first["dependencies"])
+        with self.assertRaisesRegex(ValueError, "SHA-256"):
+            deps.verify(two, second["dependencies"])
+
+    def test_artifact_tampering_rolls_back_staging(self) -> None:
+        url = self.index.add("shared", "1")
+        plan = self.prepare(["shared"])
+        self.index.files[url] += b"tampered"
+        with self.assertRaisesRegex(ValueError, "SHA-256"):
+            self.install(plan)
+        self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_metadata_sidecar_must_match_wheel(self) -> None:
+        url = self.index.add("shared", "1")
+        plan = self.prepare(["shared"])
+        # A valid artifact hash cannot excuse different reviewed metadata.
+        candidate = deps._plans[plan["token"]].candidates[0]
+        deps._plans[plan["token"]].provider.metadata[candidate] += b"Requires-Dist: hidden\n"
+        with self.assertRaisesRegex(ValueError, "metadata changed"):
+            self.install(plan)
+        self.assertEqual(list(self.root.iterdir()), [])
+        self.assertTrue(url)
+
+    def test_fallback_without_sidecar_and_cancelled_review(self) -> None:
+        self.index.add("shared", "1", sidecar=False)
+        plan = self.prepare(["shared"])
+        self.assertFalse(self.root.exists())
+        deps.manage({"operation": "discard", "token": plan["token"]})
+        with self.assertRaisesRegex(ValueError, "expired"):
+            self.install(plan)
+        self.assertFalse(self.root.exists())
+        self.install(self.prepare(["shared"]))
+
+    def test_expired_and_wrong_registry_reviews_fail(self) -> None:
+        plan = self.prepare([])
+        deps._plans[plan["token"]].created -= 1801
+        with self.assertRaisesRegex(ValueError, "expired"):
+            self.install(plan)
+        plan = self.prepare([])
+        with self.assertRaisesRegex(ValueError, "expired"):
+            deps.manage({"operation": "install", "token": plan["token"], "root": "/different"})
+        self.assertFalse(self.root.exists())
+
+    def test_review_is_bound_to_source_and_dependency_list(self) -> None:
+        self.index.add("shared", "1")
+        changes: list[dict[str, object]] = [{"source": script([])}, {"dependencies": []}]
+        for changed in changes:
+            plan = self.prepare(["shared"])
+            payload = {
+                "operation": "install",
+                "token": plan["token"],
+                "root": str(self.root),
+                "source": script(["shared"]),
+                "dependencies": plan["dependencies"],
+                **changed,
+            }
+            with self.subTest(changed=changed), self.assertRaisesRegex(ValueError, "review"):
+                deps.manage(payload)
+            self.assertFalse(self.root.exists())
+
+    def test_archive_traversal_collisions_and_import_hooks_are_rejected(self) -> None:
+        for member in (
+            "../escaped.py",
+            "/absolute.py",
+            "pkg/../../escape.py",
+            "sitecustomize.py",
+            "swiftgram.py",
+            "evil.pth",
+            "pkg/extension.so",
+        ):
+            with self.subTest(member=member):
+                self.index = Index()
+                self.index.add("unsafe", "1", members={member: "bad"})
+                with patch.object(deps, "fetch", self.index.fetch):
+                    plan = self.prepare(["unsafe"])
+                    with self.assertRaises(ValueError):
+                        self.install(plan)
+                self.assertEqual(list(self.root.iterdir()), [])
+        self.index.add("alpha", "1", members={"same.py": "a"})
+        self.index.add("beta", "1", members={"SAME.py": "b"})
+        with (
+            patch.object(deps, "fetch", self.index.fetch),
+            self.assertRaisesRegex(ValueError, "collision"),
+        ):
+            self.install(self.prepare(["alpha", "beta"]))
+
+    def test_source_urls_and_python_constraints_are_validated(self) -> None:
+        for requirements in (["pkg @ https://example.org/pkg.whl"], ["not a requirement"]):
+            with self.subTest(requirements=requirements), self.assertRaises(ValueError):
+                metadata(script(requirements))
+        with self.assertRaisesRegex(ValueError, "requires Python"):
+            metadata(script([]).replace("# id =", '# requires-python = ">=4"\n# id ='))
+
+    def test_added_files_are_detected_on_activation(self) -> None:
+        plan = self.prepare([])
+        directory = self.install(plan)
+        (directory / "injected.py").write_text("bad")
+        with self.assertRaisesRegex(ValueError, "unapproved files"):
+            deps.verify(directory, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
