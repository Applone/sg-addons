diff --git a/Swiftgram/SGPython/Bridge/SGPythonBridge.c b/Swiftgram/SGPython/Bridge/SGPythonBridge.c
new file mode 100644
index 00000000..250f3dd6
--- /dev/null
+++ b/Swiftgram/SGPython/Bridge/SGPythonBridge.c
@@ -0,0 +1,202 @@
+#include "SGPythonBridge.h"
+#if __has_include(<Python/Python.h>)
+#include <Python/Python.h>
+#else
+#include <Python.h>
+#endif
+#include <stdlib.h>
+#include <string.h>
+
+static PyObject *handler;
+static PyThreadState *manager;
+static PyThreadState *plugin_host;
+static char **paths;
+static Py_ssize_t path_count;
+
+typedef struct Interpreter {
+  char *key;
+  PyThreadState *state;
+  PyObject *handler;
+  struct Interpreter *next;
+} Interpreter;
+
+static Interpreter *interpreters;
+
+static char *python_error(void) {
+  PyObject *exception = PyErr_GetRaisedException();
+  PyObject *text = exception ? PyObject_Str(exception) : NULL;
+  const char *message = text ? PyUnicode_AsUTF8(text) : NULL;
+  char *copy = strdup(message ? message : "CPython execution failed");
+  Py_XDECREF(text);
+  Py_XDECREF(exception);
+  PyErr_Clear();
+  return copy;
+}
+
+int SGPythonInitialize(const char *home, const char *sdk, char **error) {
+  if (handler)
+    return 1;
+  if (Py_IsInitialized()) {
+    *error = strdup("An unmanaged Python interpreter is already running");
+    return 0;
+  }
+  PyConfig config;
+  PyConfig_InitIsolatedConfig(&config);
+  config.install_signal_handlers = 0;
+  config.write_bytecode = 0;
+  config.parse_argv = 0;
+  config.site_import = 0;
+  config.user_site_directory = 0;
+  config.safe_path = 1;
+  PyStatus status = PyStatus_Ok();
+  if (home && *home)
+    status = PyConfig_SetBytesString(&config, &config.home, home);
+  if (!PyStatus_Exception(status))
+    status = Py_InitializeFromConfig(&config);
+  PyConfig_Clear(&config);
+  if (PyStatus_Exception(status)) {
+    *error = strdup(status.err_msg ? status.err_msg
+                                   : "CPython initialization failed");
+    return 0;
+  }
+  PyObject *path = PyUnicode_DecodeFSDefault(sdk);
+  int inserted = path ? PyList_Insert(PySys_GetObject("path"), 0, path) : -1;
+  Py_XDECREF(path);
+  PyObject *module =
+      inserted == 0 ? PyImport_ImportModule("_swiftgram_runtime") : NULL;
+  if (module)
+    handler = PyObject_GetAttrString(module, "handle");
+  Py_XDECREF(module);
+  int success = handler && PyCallable_Check(handler);
+  if (!success)
+    *error = python_error();
+  if (success) {
+    PyObject *search = PySys_GetObject("path");
+    path_count = PyList_Size(search);
+    paths = calloc((size_t)path_count, sizeof(char *));
+    if (!paths) {
+      *error = strdup("Cannot allocate Python paths");
+      success = 0;
+    } else {
+      for (Py_ssize_t i = 0; i < path_count; i++)
+        paths[i] = strdup(PyUnicode_AsUTF8(PyList_GetItem(search, i)));
+    }
+  }
+  plugin_host = PyThreadState_New(PyInterpreterState_Get());
+  manager = PyEval_SaveThread();
+  return success;
+}
+
+char *SGPythonCall(const char *request, char **error) {
+  if (!handler) {
+    *error = strdup("CPython is not initialized");
+    return NULL;
+  }
+  PyEval_RestoreThread(manager);
+  PyObject *response = PyObject_CallFunction(handler, "s", request);
+  const char *text = response ? PyUnicode_AsUTF8(response) : NULL;
+  char *result = text ? strdup(text) : NULL;
+  if (!result)
+    *error = python_error();
+  Py_XDECREF(response);
+  manager = PyEval_SaveThread();
+  return result;
+}
+
+// All calls are serialized by the native worker. Each plugin/account owns its
+// sys.modules and search path; no plugin object crosses an interpreter
+// boundary.
+char *SGPythonCallIsolated(const char *key, const char *request, int release,
+                           char **error) {
+  if (!handler) {
+    *error = strdup("CPython is not initialized");
+    return NULL;
+  }
+  PyEval_RestoreThread(plugin_host);
+  Interpreter **link = &interpreters;
+  while (*link && strcmp((*link)->key, key) != 0)
+    link = &(*link)->next;
+  Interpreter *entry = *link;
+  if (!entry && release) {
+    plugin_host = PyEval_SaveThread();
+    return strdup("{\"result\":{}}");
+  }
+  if (!entry) {
+    entry = calloc(1, sizeof(Interpreter));
+    if (!entry || !(entry->key = strdup(key))) {
+      free(entry);
+      *error = strdup("Cannot allocate plugin interpreter");
+      plugin_host = PyEval_SaveThread();
+      return NULL;
+    }
+    PyInterpreterConfig config = {
+        .use_main_obmalloc = 0,
+        .allow_fork = 0,
+        .allow_exec = 0,
+        .allow_threads = 0,
+        .allow_daemon_threads = 0,
+        .check_multi_interp_extensions = 1,
+        .gil = PyInterpreterConfig_SHARED_GIL,
+    };
+    PyStatus status = Py_NewInterpreterFromConfig(&entry->state, &config);
+    if (PyStatus_Exception(status)) {
+      *error =
+          strdup(status.err_msg ? status.err_msg : "Cannot create interpreter");
+      free(entry->key);
+      free(entry);
+      PyThreadState_Swap(plugin_host);
+      plugin_host = PyEval_SaveThread();
+      return NULL;
+    }
+    // New interpreters must not inherit manager tooling or another plugin's
+    // path.
+    PyObject *search = PyList_New(0);
+    for (Py_ssize_t i = 0; search && i < path_count; i++) {
+      PyObject *path = PyUnicode_FromString(paths[i]);
+      if (!path || PyList_Append(search, path) < 0) {
+        Py_XDECREF(path);
+        Py_CLEAR(search);
+        break;
+      }
+      Py_DECREF(path);
+    }
+    int configured = search ? PySys_SetObject("path", search) : -1;
+    Py_XDECREF(search);
+    PyObject *module =
+        configured == 0 ? PyImport_ImportModule("_swiftgram_runtime") : NULL;
+    if (module)
+      entry->handler = PyObject_GetAttrString(module, "handle");
+    Py_XDECREF(module);
+    if (!entry->handler || !PyCallable_Check(entry->handler)) {
+      *error = python_error();
+      Py_XDECREF(entry->handler);
+      Py_EndInterpreter(entry->state);
+      PyThreadState_Swap(plugin_host);
+      free(entry->key);
+      free(entry);
+      plugin_host = PyEval_SaveThread();
+      return NULL;
+    }
+    *link = entry;
+  } else {
+    PyThreadState_Swap(entry->state);
+  }
+  PyObject *response = PyObject_CallFunction(entry->handler, "s", request);
+  const char *text = response ? PyUnicode_AsUTF8(response) : NULL;
+  char *result = text ? strdup(text) : NULL;
+  if (!result)
+    *error = python_error();
+  Py_XDECREF(response);
+  if (release) {
+    Py_DECREF(entry->handler);
+    Py_EndInterpreter(entry->state);
+    *link = entry->next;
+    free(entry->key);
+    free(entry);
+  }
+  PyThreadState_Swap(plugin_host);
+  plugin_host = PyEval_SaveThread();
+  return result;
+}
+
+void SGPythonFree(char *value) { free(value); }
