@@ -0,0 +1,454 @@
+import AccountContext
+import Display
+import Foundation
+import ItemListUI
+import PresentationDataUtils
+import SGAdditionalCore
+import SGStrings
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import UIKit
+import UniformTypeIdentifiers
+
+func additionalPluginsController(context: AccountContext, account selected: String?) -> ViewController {
+    let model = AdditionalForm(context: context)
+    let account = selected ?? additionalAccountKey(context.account.peerId)
+    var records: [PluginRecord] = []
+    model.entries = { lang in
+        records = PluginRegistry.shared.records()
+        var entries = [
+            AdditionalFormEntry(
+                stableId: 0, section: 0, kind: .notice, title: i18n("Additional.PluginAccount", lang) + ": " + account),
+            AdditionalFormEntry(
+                stableId: 1, section: 0, kind: .toggle, title: i18n("Additional.PluginSafeMode", lang),
+                value: PluginRegistry.shared.safeMode() ? "1" : "0"),
+            AdditionalFormEntry(stableId: 2, section: 1, kind: .action, title: i18n("Additional.PluginImport", lang)),
+            AdditionalFormEntry(stableId: 3, section: 1, kind: .notice, title: i18n("Additional.PluginFormat", lang)),
+        ]
+        if let status = PluginRegistry.shared.status() {
+            entries.append(AdditionalFormEntry(stableId: 4, section: 1, kind: .notice, title: status))
+        }
+        for (index, record) in records.enumerated() {
+            let status =
+                record.error != nil
+                ? "PluginFailed" : record.isEnabled(account: account) ? "PluginEnabled" : "PluginDisabled"
+            entries.append(
+                AdditionalFormEntry(
+                    stableId: index + 10, section: 2, kind: .disclosure,
+                    title: record.manifest.name, value: i18n("Additional." + status, lang)))
+        }
+        entries.append(
+            AdditionalFormEntry(stableId: 100, section: 3, kind: .action, title: i18n("Additional.PluginReset", lang)))
+        return entries
+    }
+    model.input = { [weak model] id, value in
+        guard id == 1, let model else { return }
+        do {
+            try PluginRegistry.shared.setSafeMode(value == "1")
+            model.refresh()
+        } catch { model.error(error) }
+    }
+    model.action = { [weak model] id in
+        guard let model else { return }
+        if id == 2 {
+            let delegate = AdditionalPluginDocument(model: model)
+            model.documentDelegate = delegate
+            delegate.open()
+        } else if id == 100 {
+            pluginConfirm(model: model, titleKey: "PluginReset", noticeKey: "PluginResetNotice") {
+                try PluginRegistry.shared.reset()
+                model.refresh()
+            }
+        } else if id >= 10, records.indices.contains(id - 10) {
+            model.push(additionalPluginController(context: context, record: records[id - 10], account: account))
+        }
+    }
+    return model.make(
+        title: i18n(
+            "Additional.Plugins", context.sharedContext.currentPresentationData.with { $0.strings.baseLanguageCode }))
+}
+
+private func additionalPluginController(context: AccountContext, record: PluginRecord, account: String)
+    -> ViewController
+{
+    let model = AdditionalForm(context: context)
+    let manifest = record.manifest
+    var values = record.values(account: account)
+    var menus: [PluginMenuItem] = []
+    let event = PluginEvent(kind: .message, name: "settings", account: account)
+    model.entries = { lang in
+        let current = PluginRegistry.shared.records().first { $0.manifest.id == manifest.id }
+        var entries = [
+            AdditionalFormEntry(
+                stableId: 0, section: 0, kind: .toggle, title: i18n("Additional.PluginEnabled", lang),
+                value: current?.isEnabled(account: account) == true ? "1" : "0"),
+            AdditionalFormEntry(
+                stableId: 1, section: 0, kind: .notice,
+                title: manifest.id + " · " + manifest.version + "\n" + (manifest.description ?? "")),
+            AdditionalFormEntry(
+                stableId: 2, section: 0, kind: .notice,
+                title: manifest.permissions.map { i18n("Additional.PluginPermission." + $0.rawValue, lang) }.joined(
+                    separator: "\n")),
+        ]
+        entries.append(
+            AdditionalFormEntry(
+                stableId: 4, section: 0, kind: .disclosure,
+                title: i18n("Additional.PluginDependencies", lang), value: String(record.dependencies?.count ?? 0)))
+        if let error = current?.error {
+            entries.append(AdditionalFormEntry(stableId: 3, section: 0, kind: .notice, title: error))
+        }
+        for (index, setting) in manifest.settings.enumerated() {
+            let value = values[setting.key] ?? setting.defaultValue
+            let kind: AdditionalFormEntry.Kind
+            let text: String
+            if case .bool(let enabled) = value {
+                kind = .toggle
+                text = enabled ? "1" : "0"
+            } else {
+                kind = setting.choices == nil ? .input : .disclosure
+                text = value.text
+            }
+            entries.append(
+                AdditionalFormEntry(stableId: index + 10, section: 1, kind: kind, title: setting.title, value: text))
+        }
+        if !manifest.settings.isEmpty {
+            entries.append(
+                AdditionalFormEntry(stableId: 50, section: 1, kind: .action, title: i18n("Additional.Save", lang)))
+        }
+        menus = PluginRegistry.shared.menuItems(location: .settings, event: event).filter { $0.pluginID == manifest.id }
+        for (index, menu) in menus.enumerated() {
+            entries.append(AdditionalFormEntry(stableId: index + 60, section: 2, kind: .action, title: menu.title))
+        }
+        entries.append(
+            AdditionalFormEntry(stableId: 100, section: 3, kind: .action, title: i18n("Additional.Remove", lang)))
+        return entries
+    }
+    model.input = { [weak model] id, text in
+        guard let model else { return }
+        if id == 0 {
+            do {
+                try PluginRegistry.shared.setEnabled(manifest.id, account: account, enabled: text == "1")
+                model.refresh()
+            } catch { model.error(error) }
+        } else if manifest.settings.indices.contains(id - 10) {
+            let setting = manifest.settings[id - 10]
+            switch setting.defaultValue {
+            case .bool: values[setting.key] = .bool(text == "1")
+            case .integer:
+                // Keep invalid draft text so Save reports the error instead of silently reverting it.
+                values[setting.key] = Int(text).map(PluginValue.integer) ?? .string(text)
+            case .string: values[setting.key] = .string(text)
+            }
+        }
+    }
+    model.action = { [weak model] id in
+        guard let model else { return }
+        if id == 4 {
+            model.push(pluginDependenciesController(context: context, dependencies: record.dependencies ?? []))
+        } else if id == 50 {
+            do {
+                guard
+                    PluginRegistry.shared.records().first(where: { $0.manifest.id == manifest.id })?.manifest
+                        == manifest
+                else {
+                    throw SettingsError.invalid("Plugin changed. Reopen its settings.")
+                }
+                try PluginRegistry.shared.saveSettings(manifest.id, account: account, values: values)
+                model.refresh()
+            } catch { model.error(error) }
+        } else if id == 100 {
+            pluginConfirm(model: model, titleKey: "Remove", noticeKey: "PluginRemoveNotice") {
+                try PluginRegistry.shared.remove(manifest.id)
+                model.controller?.navigationController?.popViewController(animated: true)
+            }
+        } else if id >= 60, menus.indices.contains(id - 60),
+            let result = PluginRegistry.shared.performMenu(menus[id - 60], location: .settings, event: event)
+        {
+            showPluginMenuResult(model: model, result: result)
+        } else if manifest.settings.indices.contains(id - 10), let choices = manifest.settings[id - 10].choices {
+            let setting = manifest.settings[id - 10]
+            let data = context.sharedContext.currentPresentationData.with { $0 }
+            let sheet = ActionSheetController(presentationData: data)
+            sheet.setItemGroups([
+                ActionSheetItemGroup(
+                    items: choices.map { choice in
+                        ActionSheetButtonItem(
+                            title: choice, color: .accent,
+                            action: { [weak sheet, weak model] in
+                                sheet?.dismissAnimated()
+                                values[setting.key] = .string(choice)
+                                model?.refresh()
+                            })
+                    }),
+                ActionSheetItemGroup(items: [
+                    ActionSheetButtonItem(
+                        title: data.strings.Common_Cancel, color: .accent,
+                        action: { [weak sheet] in sheet?.dismissAnimated() })
+                ]),
+            ])
+            model.controller?.present(sheet, in: .window(.root))
+        }
+    }
+    return model.make(title: manifest.name)
+}
+
+private func showPluginMenuResult(model: AdditionalForm, result: PluginMenuResult) {
+    if result.action == .copyText {
+        UIPasteboard.general.string = result.text
+    } else {
+        let data = model.context.sharedContext.currentPresentationData.with { $0 }
+        model.controller?.present(
+            textAlertController(
+                context: model.context, title: nil, text: result.text,
+                actions: [TextAlertAction(type: .defaultAction, title: data.strings.Common_OK, action: {})]),
+            in: .window(.root))
+    }
+}
+
+private func pluginConfirm(
+    model: AdditionalForm, titleKey: String, noticeKey: String, action: @escaping () throws -> Void
+) {
+    let data = model.context.sharedContext.currentPresentationData.with { $0 }
+    let lang = data.strings.baseLanguageCode
+    let sheet = ActionSheetController(presentationData: data)
+    sheet.setItemGroups([
+        ActionSheetItemGroup(items: [
+            ActionSheetTextItem(title: i18n("Additional." + noticeKey, lang)),
+            ActionSheetButtonItem(
+                title: i18n("Additional." + titleKey, lang), color: .destructive,
+                action: { [weak sheet, weak model] in
+                    sheet?.dismissAnimated()
+                    do { try action() } catch { model?.error(error) }
+                }),
+        ]),
+        ActionSheetItemGroup(items: [
+            ActionSheetButtonItem(
+                title: data.strings.Common_Cancel, color: .accent, action: { [weak sheet] in sheet?.dismissAnimated() })
+        ]),
+    ])
+    model.controller?.present(sheet, in: .window(.root))
+}
+
+private final class AdditionalPluginDocument: NSObject, UIDocumentPickerDelegate {
+    private weak var model: AdditionalForm?
+    init(model: AdditionalForm) { self.model = model }
+
+    func open() {
+        let picker = UIDocumentPickerViewController(
+            forOpeningContentTypes: [
+                UTType(filenameExtension: "py") ?? .plainText, UTType(filenameExtension: "plugin") ?? .data,
+            ], asCopy: false)
+        picker.allowsMultipleSelection = false
+        picker.delegate = self
+        model?.controller?.present(picker, animated: true)
+    }
+
+    func documentPicker(_ controller: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
+        guard let url = urls.first else { return }
+        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
+            let result = Result { () throws -> (Data, PluginManifest) in
+                let access = url.startAccessingSecurityScopedResource()
+                defer { if access { url.stopAccessingSecurityScopedResource() } }
+                let size = try url.resourceValues(forKeys: [.fileSizeKey]).fileSize ?? 0
+                try pluginFileSize(size)
+                let data = try Data(contentsOf: url)
+                return (data, try PluginRegistry.shared.inspect(data))
+            }
+            DispatchQueue.main.async { [weak self] in
+                guard let model = self?.model else { return }
+                switch result {
+                case .success((let data, let manifest)):
+                    model.push(pluginInstallController(context: model.context, data: data, manifest: manifest))
+                case .failure(let error): model.error(error)
+                }
+            }
+        }
+    }
+}
+
+private func pluginFileSize(_ size: Int) throws {
+    guard size <= 256 * 1024 else { throw SettingsError.invalid("Plugin exceeds 256 KB.") }
+}
+
+private func pluginMetadataEntries(_ manifest: PluginManifest, lang: String) -> [AdditionalFormEntry] {
+    let pythonVersion = manifest.requiresPython ?? ""
+    let fields = [
+        ("PluginName", manifest.name), ("PluginID", manifest.id), ("PluginVersion", manifest.version),
+        ("PluginAuthor", manifest.author ?? "—"), ("PluginDescription", manifest.description ?? "—"),
+        ("PluginPythonVersion", pythonVersion.isEmpty ? "—" : pythonVersion),
+    ]
+    return fields.enumerated().map { index, field in
+        AdditionalFormEntry(
+            stableId: index, section: 0, kind: .notice,
+            title: i18n("Additional." + field.0, lang) + "\n" + field.1)
+    }
+}
+
+private func pluginDependenciesController(context: AccountContext, dependencies: [PluginDependency]) -> ViewController {
+    let model = AdditionalForm(context: context)
+    model.entries = { lang in
+        var entries = [
+            AdditionalFormEntry(
+                stableId: 0, section: 0, kind: .notice,
+                title: i18n("Additional.PluginDependencyNotice", lang))
+        ]
+        if dependencies.isEmpty {
+            entries.append(
+                AdditionalFormEntry(
+                    stableId: 1, section: 0, kind: .notice,
+                    title: i18n("Additional.PluginNoDependencies", lang)))
+        }
+        for (index, dependency) in dependencies.enumerated() {
+            let origin = i18n("Additional." + (dependency.direct ? "PluginDirect" : "PluginTransitive"), lang)
+            entries.append(
+                AdditionalFormEntry(
+                    stableId: index * 2 + 10, section: Int32(index + 1), kind: .disclosure,
+                    title: dependency.name + " == " + dependency.version, value: "PyPI ↗"))
+            entries.append(
+                AdditionalFormEntry(
+                    stableId: index * 2 + 11, section: Int32(index + 1), kind: .notice,
+                    title: origin + "\n" + dependency.filename + "\nSHA-256: " + dependency.sha256))
+        }
+        return entries
+    }
+    model.action = { id in
+        let index = (id - 10) / 2
+        guard id >= 10, dependencies.indices.contains(index), let url = dependencies[index].pypiURL else { return }
+        context.sharedContext.applicationBindings.openUrl(url.absoluteString)
+    }
+    let lang = context.sharedContext.currentPresentationData.with { $0.strings.baseLanguageCode }
+    return model.make(title: i18n("Additional.PluginDependencies", lang))
+}
+
+private final class PluginReviewState {
+    var review: PluginInstallation?
+    var resolving = false
+    var installing = false
+    var declined = false
+    var error: String?
+
+    deinit {
+        if let review {
+            DispatchQueue.global(qos: .utility).async { PluginRegistry.shared.discardInstallation(review) }
+        }
+    }
+}
+
+private func pluginInstallController(context: AccountContext, data: Data, manifest: PluginManifest) -> ViewController {
+    let model = AdditionalForm(context: context)
+    let state = PluginReviewState()
+    let resolve: () -> Void = { [weak model] in
+        guard let model else { return }
+        guard !state.resolving, !state.installing, !state.declined else { return }
+        state.resolving = true
+        state.error = nil
+        model.refresh()
+        DispatchQueue.global(qos: .userInitiated).async { [weak model] in
+            let result = Result { try PluginRegistry.shared.prepareInstallation(data) }
+            DispatchQueue.main.async {
+                state.resolving = false
+                guard let model, !state.declined else {
+                    if case .success(let review) = result {
+                        DispatchQueue.global(qos: .utility).async { PluginRegistry.shared.discardInstallation(review) }
+                    }
+                    return
+                }
+                switch result {
+                case .success(let review): state.review = review
+                case .failure(let error): state.error = error.localizedDescription
+                }
+                model.refresh()
+            }
+        }
+    }
+    model.entries = { lang in
+        var entries = pluginMetadataEntries(manifest, lang: lang)
+        let permissions = manifest.permissions.map { i18n("Additional.PluginPermission." + $0.rawValue, lang) }.joined(
+            separator: "\n")
+        entries.append(
+            AdditionalFormEntry(
+                stableId: 10, section: 1, kind: .notice,
+                title: i18n("Additional.PluginPermissions", lang) + "\n" + (permissions.isEmpty ? "—" : permissions)))
+        entries.append(
+            AdditionalFormEntry(
+                stableId: 11, section: 1, kind: .notice,
+                title: i18n("Additional.PluginPythonNotice", lang)))
+        if let previous = PluginRegistry.shared.records().first(where: { $0.manifest.id == manifest.id }) {
+            entries.append(
+                AdditionalFormEntry(
+                    stableId: 12, section: 1, kind: .notice,
+                    title: i18n("Additional.PluginUpdate", lang) + ": " + previous.manifest.version + " → "
+                        + manifest.version))
+        }
+        if state.resolving || state.installing {
+            entries.append(
+                AdditionalFormEntry(
+                    stableId: 20, section: 2, kind: .notice,
+                    title: i18n("Additional." + (state.installing ? "PluginInstalling" : "PluginResolving"), lang)))
+        } else if let review = state.review {
+            entries.append(
+                AdditionalFormEntry(
+                    stableId: 21, section: 2, kind: .disclosure,
+                    title: i18n("Additional.PluginDependencies", lang), value: String(review.dependencies.count)))
+            entries.append(
+                AdditionalFormEntry(
+                    stableId: 22, section: 2, kind: .notice,
+                    title: i18n(
+                        review.dependencies.isEmpty
+                            ? "Additional.PluginNoDependencies" : "Additional.PluginDependencyNotice", lang)))
+            entries.append(
+                AdditionalFormEntry(
+                    stableId: 30, section: 3, kind: .action,
+                    title: i18n("Additional.PluginInstall", lang)))
+        } else if let error = state.error {
+            entries.append(AdditionalFormEntry(stableId: 23, section: 2, kind: .notice, title: error))
+            entries.append(
+                AdditionalFormEntry(
+                    stableId: 24, section: 2, kind: .action,
+                    title: i18n("Additional.PluginResolveAgain", lang)))
+        }
+        if !state.installing {
+            entries.append(
+                AdditionalFormEntry(
+                    stableId: 31, section: 3, kind: .action,
+                    title: i18n("Additional.PluginDecline", lang)))
+        }
+        return entries
+    }
+    model.action = { [weak model] id in
+        guard let model, !state.installing else { return }
+        if id == 21, let review = state.review {
+            model.push(pluginDependenciesController(context: context, dependencies: review.dependencies))
+        } else if id == 24 {
+            resolve()
+        } else if id == 31 {
+            state.declined = true
+            if let review = state.review {
+                state.review = nil
+                DispatchQueue.global(qos: .utility).async { PluginRegistry.shared.discardInstallation(review) }
+            }
+            model.controller?.navigationController?.popViewController(animated: true)
+        } else if id == 30, let review = state.review {
+            state.review = nil
+            state.installing = true
+            model.refresh()
+            DispatchQueue.global(qos: .userInitiated).async { [weak model] in
+                let result = Result { try PluginRegistry.shared.install(review) }
+                DispatchQueue.main.async {
+                    state.installing = false
+                    guard let model else { return }
+                    switch result {
+                    case .success: model.controller?.navigationController?.popViewController(animated: true)
+                    case .failure(let error):
+                        state.error = error.localizedDescription
+                        model.refresh()
+                    }
+                }
+            }
+        }
+    }
+    let controller = model.make(title: manifest.name)
+    resolve()
+    return controller
+}
