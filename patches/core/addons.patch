+def _python_ios_repository_impl(ctx):
+    ctx.download_and_extract(
+        url = "https://github.com/beeware/Python-Apple-support/releases/download/3.14-b10/Python-3.14-iOS-support.b10.tar.gz",
+        sha256 = "200ef60eb67be0483ceb638daa9048f84f41a9a952707a5ad4c3198037c7b583",
+    )
+    ctx.download(
+        url = "https://files.pythonhosted.org/packages/20/12/38679034af332785aac8774540895e234f4d07f7545804097de4b666afd8/packaging-25.0-py3-none-any.whl",
+        sha256 = "29572ef2b1f17581046b3a2227d5c611fb25ec70ca1ba8554b24b0e69331a484",
+        output = "packaging.whl",
+    )
+    ctx.download(
+        url = "https://files.pythonhosted.org/packages/e2/23/c941a0d0353681ca138489983c4309e0f5095dfd902e1357004f2357ddf2/resolvelib-1.2.1-py3-none-any.whl",
+        sha256 = "fb06b66c8da04172d9e72a21d7d06186d8919e32ae5ab5cdf5b9d920be805ac2",
+        output = "resolvelib.whl",
+    )
+    ctx.download(
+        url = "https://files.pythonhosted.org/packages/e4/37/af0d2ef3967ac0d6113837b44a4f0bfe1328c2b9763bd5b1744520e5cfed/certifi-2025.10.5-py3-none-any.whl",
+        sha256 = "0f212c2744a9bb6de0c56639a6f68afe01ecd92d91f14ae897c4fe7bbeeef0de",
+        output = "certifi.whl",
+    )
+    result = ctx.execute(["python3", str(ctx.path(ctx.attr.prepare_script)), str(ctx.path("."))])
+    if result.return_code:
+        fail("Preparing CPython frameworks failed: " + result.stderr)
+
+python_ios_repository = repository_rule(
+    implementation = _python_ios_repository_impl,
+    attrs = {"prepare_script": attr.label(default = Label("//Swiftgram/SGPython:prepare_runtime.py"), allow_single_file = True)},
+)
