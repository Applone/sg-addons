+        }
+    }
+
+    public func registerActionAdapter(account: String, adapter: PluginActionAdapter?) {
+        actions.register(account: account, adapter: adapter)
+    }
+
+    private func actionDirectory(_ id: String, account: String) -> URL {
+        directory.appendingPathComponent("data").appendingPathComponent(id).appendingPathComponent(account)
+    }
+
+    private func acceptActions(_ reply: PythonPluginReply, record: PluginRecord, account: String, allowed: Bool) throws
+    {
+        let pending = reply.actions ?? []
+        try pluginRequire(
+            pending.count <= 32 && (allowed || pending.isEmpty), "Actions are unavailable in this callback.")
+        for action in pending {
+            try action.validate()
+            try pluginRequire(
+                action.permissions.isSubset(of: Set(record.manifest.permissions)), "Action permission denied.")
+        }
+        guard !pending.isEmpty else { return }
+        let key = record.manifest.id + ":" + account
+        if generations[key] == nil { generations[key] = UUID().uuidString }
+        let generation = generations[key]!
