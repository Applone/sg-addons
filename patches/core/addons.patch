index 00000000..faf7f33b
--- /dev/null
+++ b/Swiftgram/SGPython/Tests/test_actions.py
@@ -0,0 +1,105 @@
+"""Value-only action protocol and callback boundaries."""
+
+from __future__ import annotations
+
+import json
+import unittest
+from typing import Any, cast
+
+from _swiftgram_runtime import handle
+
+HEADER = '# /// script\n# id = "actions-test"\n# name = "Actions"\n# ///\n'
+BODY = """
+from swiftgram import BasePlugin
+class Plugin(BasePlugin):
+    def on_message(self, event):
+        self.send_message(event.chat, "reply", reply_to=17)
+    def on_action_result(self, result):
+        self.settings["status"] = result["status"]
+    def pre_request_hook(self, event):
+        self.send_message("user:42", "forbidden")
+"""
+
+
+class ActionTests(unittest.TestCase):
+    def call(self, operation: str, **values: object) -> dict[str, Any]:
+        return cast(
+            dict[str, Any],
+            json.loads(
+                handle(
+                    json.dumps(
+                        {
+                            "operation": operation,
+                            "id": "actions-test",
+                            "account": "77",
+                            "source": HEADER + BODY,
+                            "settings": {},
+                            **values,
+                        }
+                    )
+                )
+            ),
+        )
+
+    def tearDown(self) -> None:
+        self.call("unload")
+
+    def test_action_is_returned_with_successful_hook(self) -> None:
+        result = self.call(
+            "hook",
+            callback="on_message",
+            event={
+                "kind": "message",
+                "name": "message",
+                "account": "77",
+                "chat": "user:42",
+                "text": "hello",
+            },
+        )
+        actions = result["result"]["actions"]
+        self.assertEqual(actions[0]["operation"], "sendMessage")
+        self.assertEqual(actions[0]["replyTo"], 17)
+        self.assertEqual(len(actions[0]["id"]), 32)
+        reply = self.call(
+            "actionResult", actionResult={"id": actions[0]["id"], "status": "accepted"}
+        )
+        self.assertEqual(reply["result"]["settings"]["status"], "accepted")
+
+    def test_failed_callback_does_not_emit_actions(self) -> None:
+        source = HEADER + BODY.replace(
+            'self.send_message(event.chat, "reply", reply_to=17)',
+            'self.send_message(event.chat, "reply"); raise ValueError("failed")',
+        )
+        result = self.call(
+            "hook",
+            source=source,
+            callback="on_message",
+            event={
+                "kind": "message",
+                "name": "message",
+                "account": "77",
+                "chat": "user:42",
+                "text": "hello",
+            },
+        )
+        self.assertIn("failure", result)
+        self.assertNotIn("result", result)
+
+    def test_origin_and_request_callbacks_cannot_emit_actions(self) -> None:
+        for kind, callback, origin in (
+            ("message", "on_message", True),
+            ("preRequest", "pre_request_hook", False),
+        ):
+            result = self.call(
+                "hook",
+                callback=callback,
+                event={
+                    "kind": kind,
+                    "name": "message",
+                    "account": "77",
+                    "chat": "user:42",
+                    "text": "hello",
+                    "pluginOrigin": origin,
+                },
+            )
+            self.assertIn("Actions are unavailable", result["failure"])
diff --git a/Swiftgram/SGPython/Tests/test_bridge.py b/Swiftgram/SGPython/Tests/test_bridge.py
