+    }
+
+    public func setEnabled(_ id: String, account: String, enabled: Bool) throws {
+        try Self.validateAccount(account)
+        lock.lock()
+        defer { lock.unlock() }
+        var next = document
+        guard var record = next.records[id] else { throw SettingsError.invalid("Plugin is not installed.") }
+        if enabled {
+            try record.manifest.validate(hostVersion: hostVersion)
+            record.enabledAccounts.insert(account)
+            record.error = nil
+        } else {
+            record.enabledAccounts.remove(account)
+        }
+        next.records[id] = record
+        do { try commit(next) } catch {
+            if enabled { fail(id, error: error) }
+            throw error
+        }
+    }
+
+    public func saveSettings(_ id: String, account: String, values: [String: PluginValue]) throws {
+        try Self.validateAccount(account)
+        lock.lock()
+        defer { lock.unlock() }
+        var next = document
+        guard var record = next.records[id] else { throw SettingsError.invalid("Plugin is not installed.") }
+        for (key, value) in values {
+            guard let setting = record.manifest.settings.first(where: { $0.key == key }) else {
+                throw SettingsError.invalid("Unknown plugin setting: " + key)
+            }
+            try setting.validate(value)
+        }
+        record.settings[account] = values
+        next.records[id] = record
+        try commit(next)
+    }
+
+    public func remove(_ id: String) throws {
+        lock.lock()
+        defer { lock.unlock() }
+        var next = document
+        let removed = next.records.removeValue(forKey: id)
+        try commit(next)
+        try? FileManager.default.removeItem(at: directory.appendingPathComponent("data").appendingPathComponent(id))
+        if let environment = removed?.environment {
+            try? FileManager.default.removeItem(at: environments.appendingPathComponent(environment))
+        }
+    }
+
+    public func setSafeMode(_ enabled: Bool) throws {
+        lock.lock()
+        defer { lock.unlock() }
+        var next = document
+        next.safeMode = enabled
+        try commit(next)
+    }
+
+    /// Explicit recovery from malformed storage keeps the original bytes for inspection.
+    public func reset() throws {
+        lock.lock()
+        defer { lock.unlock() }
+        if FileManager.default.fileExists(atPath: file.path) {
+            try FileManager.default.copyItem(
+                at: file, to: directory.appendingPathComponent("registry-" + UUID().uuidString + ".bak"))
+        }
+        var empty = Document()
+        try transitionPython(from: document, to: &empty)
+        try persist(empty)
+        document = empty
+        try? FileManager.default.removeItem(at: directory.appendingPathComponent("data"))
+        corrupt = false
+        failure = nil
+        try clearRecovery()
+        if FileManager.default.fileExists(atPath: pythonRecovery.path) {
+            try FileManager.default.removeItem(at: pythonRecovery)
+        }
+        changed()
+    }
+
+    public func dispatch(_ original: PluginEvent) -> PluginEvent? {
+        lock.lock()
+        defer { lock.unlock() }
+        guard !document.safeMode, original.text.utf8.count <= 65536 else { return original }
+        var current = original
+        // One invocation per plugin using its highest matching priority; IDs break ties.
+        let candidates: [(String, Int)] = document.records.compactMap { id, record in
+            guard record.isEnabled(account: original.account) else { return nil }
+            let priorities = record.manifest.hooks.filter { $0.event == original.kind && $0.matchesName(original.name) }
+                .map { $0.priority ?? 0 }
+            return priorities.max().map { (id, $0) }
+        }.sorted { $0.1 == $1.1 ? $0.0 < $1.0 : $0.1 > $1.1 }
+        for (id, _) in candidates {
+            guard let record = document.records[id], record.isEnabled(account: current.account) else { continue }
+            let hooks = record.manifest.hooks.enumerated().filter {
+                $0.element.event == current.kind && $0.element.matchesName(current.name)
+            }.sorted {
+                let left = $0.element.priority ?? 0
+                let right = $1.element.priority ?? 0
+                return left == right ? $0.offset < $1.offset : left > right
+            }
+            guard let hook = hooks.first?.element else { continue }
+            do {
+                var visible = current
+                if !record.manifest.permissions.contains(.readMessages) { visible.message = nil }
+                let reply = try PythonPluginRuntime.shared.invoke(
+                    record, event: visible, callback: hook.callback, marker: pythonRecovery)
+                let strategy = reply.strategy ?? .default
+                let replacementText = reply.text
+                let replacementError = reply.error
+                try acceptPythonSettings(reply.settings, id: id, account: current.account)
+                if current.kind == .preRequest {
+                    try pluginRequire(
+                        (strategy == .default || strategy == .cancel) && replacementText == nil
+                            && replacementError == nil,
+                        "Pre-request hooks support default or cancel only.")
+                } else if current.kind == .postRequest {
+                    try pluginRequire(
+                        strategy != .cancel && replacementText == nil,
+                        "Post-request hooks cannot cancel or replace a response.")
+                } else {
+                    try pluginRequire(replacementError == nil, "Message hooks cannot return errors.")
+                }
+                if strategy == .modify || strategy == .modifyFinal {
+                    try pluginRequire(
+                        current.kind == .postRequest ? replacementError != nil : replacementText != nil,
+                        "Python modification returned no replacement value.")
+                }
+                try acceptActions(
+                    reply, record: record, account: current.account,
+                    allowed: current.kind != .preRequest && current.kind != .postRequest && current.pluginOrigin != true
+                )
+                switch strategy {
+                case .default: continue
+                case .cancel: return nil
+                case .modify, .modifyFinal:
+                    var modified = current
+                    if let text = replacementText {
+                        try pluginRequire(text.utf8.count <= 65536, "Python text exceeds 64 KB.")
+                        modified.text = text
+                    }
+                    if let error = replacementError, current.error != nil {
+                        try pluginRequire(error.utf8.count <= 512, "Plugin error text exceeds 512 bytes.")
+                        modified.error = error
+                    }
+                    if current.kind == .sendMessage {
+                        try pluginRequire(
+                            modified.text.utf16.count <= 4096, "Outgoing plugin text exceeds 4096 characters.")
+                    }
+                    current = modified
+                    if strategy == .modifyFinal { return current }
+                }
+            } catch { fail(id, error: error) }
+        }
+        return current
+    }
+
+    public func menuItems(location: PluginMenu.Location, event: PluginEvent) -> [PluginMenuItem] {
+        lock.lock()
+        defer { lock.unlock() }
+        guard !document.safeMode else { return [] }
+        return document.records.keys.sorted().flatMap { id -> [PluginMenuItem] in
+            guard let record = document.records[id], record.isEnabled(account: event.account) else { return [] }
+            return record.manifest.menus.filter {
+                $0.location == location
+            }.map { PluginMenuItem(pluginID: id, menuID: $0.id, title: $0.title) }
+        }
+    }
+
+    public func performMenu(_ item: PluginMenuItem, location: PluginMenu.Location, event: PluginEvent)
+        -> PluginMenuResult?
+    {
+        lock.lock()
+        defer { lock.unlock() }
+        guard !document.safeMode, let record = document.records[item.pluginID],
+            record.isEnabled(account: event.account),
+            let menu = record.manifest.menus.first(where: { $0.id == item.menuID && $0.location == location })
+        else { return nil }
+        do {
+            var visible = event
+            if !record.manifest.permissions.contains(.readMessages) { visible.message = nil }
+            let reply = try PythonPluginRuntime.shared.invoke(
+                record, event: visible, callback: menu.callback, menuID: menu.id, marker: pythonRecovery)
+            guard let text = reply.text, text.utf8.count <= 65536 else {
+                throw SettingsError.invalid("Python menu returned invalid text.")
+            }
+            try acceptPythonSettings(reply.settings, id: item.pluginID, account: event.account)
+            try acceptActions(reply, record: record, account: event.account, allowed: event.pluginOrigin != true)
+            return PluginMenuResult(action: menu.action, text: text)
+        } catch {
+            fail(item.pluginID, error: error)
+            return nil
+        }
+    }
+
+    private static func validateAccount(_ account: String) throws {
+        try pluginRequire(
+            !account.isEmpty && account.utf8.count <= 32 && account.utf8.allSatisfy { (48...57).contains($0) },
+            "Invalid plugin account ID.")
+    }
+
+    private func fail(_ id: String, error: Error) {
+        var next = document
+        next.records[id]?.error = error.localizedDescription
+        // Runtime failure preserves desired enablement but removes every active registration.
+        do { try commit(next) } catch {
+            document = next
+            document.safeMode = true
+            failure = error.localizedDescription
+            changed()
+        }
+    }
+
+    private func commit(_ proposed: Document) throws {
+        try pluginRequire(!corrupt, "Plugin registry is damaged. Reset it before making changes.")
+        var next = proposed
+        loadReplies = []
+        // One atomic document covers sources, settings, and desired enablement. Memory changes last.
+        try Data("{\"operation\":\"registry-change\"}".utf8).write(to: recoveryFile, options: .atomic)
+        do {
+            try transitionPython(from: document, to: &next)
+            try persist(next)
+        } catch {
+            var restored = document
+            do { try transitionPython(from: next, to: &restored) } catch {
+                document.safeMode = true
+                failure = "Python rollback failed. Restart in safe mode: " + error.localizedDescription
+            }
+            throw error
+        }
+        document = next
+        for (id, previous) in document.records {
+            for account in previous.enabledAccounts where previous.isEnabled(account: account) {
+                let key = id + ":" + account
+                if generations[key] == nil { generations[key] = UUID().uuidString }
+            }
+        }
+        for (record, account, reply) in loadReplies {
+            try acceptActions(reply, record: record, account: account, allowed: true)
+        }
+        loadReplies = []
+        do {
+            try clearRecovery()
+            failure = nil
+        } catch {
+            document.safeMode = true
+            failure = error.localizedDescription
+        }
+        changed()
+    }
+
+    private func checkedPythonSettings(_ values: [String: PluginValue], record: PluginRecord) throws {
+        for (key, value) in values {
+            guard let setting = record.manifest.settings.first(where: { $0.key == key }) else {
+                throw SettingsError.invalid("Python changed an undeclared setting: " + key)
+            }
+            try setting.validate(value)
+        }
+    }
+
+    private func acceptPythonSettings(_ values: [String: PluginValue]?, id: String, account: String) throws {
+        guard let values, let record = document.records[id] else { return }
+        try checkedPythonSettings(values, record: record)
+        guard values != record.values(account: account) else { return }
+        var next = document
+        next.records[id]?.settings[account] = values
+        try commit(next)
+    }
+
+    private func transitionPython(from old: Document, to next: inout Document) throws {
+        for id in Set(old.records.keys).union(next.records.keys).sorted() {
+            let previous = old.records[id]
+            let updated = next.records[id]
+            let accounts = (previous?.enabledAccounts ?? []).union(updated?.enabledAccounts ?? [])
+            for account in accounts.sorted() {
+                let wasActive = !old.safeMode && previous?.isEnabled(account: account) == true
+                let active = !next.safeMode && next.records[id]?.isEnabled(account: account) == true
+                let changedSource =
+                    previous?.manifest.pythonSource != updated?.manifest.pythonSource
+                    || previous?.environment != updated?.environment
+                if wasActive, !active || changedSource {
+                    let key = id + ":" + account
+                    if let generation = generations.removeValue(forKey: key) {
+                        actions.cancel(owner: .init(plugin: id, account: account, generation: generation))
+                    }
+                    do {
+                        try PythonPluginRuntime.shared.unload(previous!, account: account, marker: pythonRecovery)
+                    } catch {
+                        next.records[id]?.error = error.localizedDescription
+                    }
+                }
+                if active, var record = next.records[id], !wasActive || changedSource {
+                    let reply = try PythonPluginRuntime.shared.load(record, account: account, marker: pythonRecovery)
+                    let values = reply.settings ?? [:]
+                    try checkedPythonSettings(values, record: record)
+                    for action in reply.actions ?? [] {
+                        try action.validate()
+                        try pluginRequire(
+                            action.permissions.isSubset(of: Set(record.manifest.permissions)),
+                            "Action permission denied.")
+                    }
+                    loadReplies.append((record, account, reply))
+                    record.settings[account] = values
+                    next.records[id] = record
+                }
+            }
+        }
+    }
+
+    private func persist(_ next: Document) throws {
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        let data = try encoder.encode(next)
+        try pluginRequire(data.count <= 32 * 1024 * 1024, "Plugin registry exceeds 32 MB.")
+        try data.write(to: file, options: .atomic)
+    }
+
+    private func clearRecovery() throws {
+        if FileManager.default.fileExists(atPath: recoveryFile.path) {
+            try FileManager.default.removeItem(at: recoveryFile)
+        }
+    }
+
+    private func changed() {
+        DispatchQueue.main.async { NotificationCenter.default.post(name: .pluginsChanged, object: nil) }
+    }
+}
+
+extension Notification.Name {
+    public static let pluginsChanged = Notification.Name("SGAPluginsChanged")
+}
diff --git a/Swiftgram/SGAdditionalCore/Sources/PythonPluginRuntime.swift b/Swiftgram/SGAdditionalCore/Sources/PythonPluginRuntime.swift
new file mode 100644
index 00000000..59fda8c9
--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Sources/PythonPluginRuntime.swift
@@ -0,0 +1,290 @@
+import Foundation
+import SGPythonBridge
+
+struct PythonPluginReply: Decodable {
+    var actions: [PluginAction]?
+    var manifest: PluginManifest?
+    var dependencies: [PluginDependency]?
+    var token: String?
+    var environment: String?
+    var settings: [String: PluginValue]?
+    var strategy: PluginStrategy?
+    var text: String?
+    var error: String?
+}
+
+/// Calls CPython on a worker and bounds the host's wait. A timeout quarantines the
+/// interpreter until restart; it does not pretend to terminate arbitrary Python/C code.
+final class PythonPluginRuntime {
+    static let shared = PythonPluginRuntime()
+    private let worker = DispatchQueue(label: "app.swiftgram.python")
+    private let managerWorker = DispatchQueue(label: "app.swiftgram.python.packages")
+    private let initializer = DispatchQueue(label: "app.swiftgram.python.initialize")
+    private let stateLock = NSLock()
+    private var quarantined = false
+    private var initialized = false
+    private var loadedScopes: Set<String> = []
+
+    private struct Request: Encodable {
+        let operation: String
+        var id: String?
+        var account: String?
+        var source: String?
+        var settings: [String: PluginValue]?
+        var event: PluginEvent?
+        var callback: String?
+        var menuID: String?
+        var root: String?
+        var token: String?
+        var dependencyPath: String?
+        var dependencies: [PluginDependency]?
+        var scope: String?
+        var dataDirectory: String?
+        var actionResult: PluginActionResult?
+    }
+
+    private struct Envelope: Decodable {
+        var result: PythonPluginReply?
+        var failure: String?
+    }
+
+    private final class Job {
+        let semaphore = DispatchSemaphore(value: 0)
+        let lock = NSLock()
+        var expired = false
+        var result: Result<PythonPluginReply, Error>?
+    }
+
+    func inspect(_ source: String, marker: URL) throws -> PluginManifest {
+        let reply = try request(Request(operation: "inspect", source: source), marker: marker)
+        guard var manifest = reply.manifest else { throw SettingsError.invalid("Python returned no metadata.") }
+        manifest.pythonSource = source
+        return manifest
+    }
+
+    func prepare(_ manifest: PluginManifest, directory: URL, marker: URL) throws -> PluginInstallation {
+        let reply = try request(
+            Request(operation: "resolve", source: manifest.pythonSource, root: directory.path), marker: marker)
+        guard let token = reply.token, let dependencies = reply.dependencies else {
+            throw SettingsError.invalid("Python returned no dependency review.")
+        }
+        return PluginInstallation(manifest: manifest, dependencies: dependencies, token: token)
+    }
+
+    func install(_ review: PluginInstallation, directory: URL, marker: URL) throws -> String {
+        let reply = try request(
+            Request(
+                operation: "install", source: review.manifest.pythonSource, root: directory.path, token: review.token,
+                dependencies: review.dependencies), marker: marker)
+        guard let environment = reply.environment, reply.dependencies == review.dependencies,
+            environment.count == 32, environment.allSatisfy({ $0.isHexDigit })
+        else {
+            throw SettingsError.invalid("Invalid dependency installation result.")
+        }
+        return environment
+    }
+
+    func discard(_ review: PluginInstallation, marker: URL) throws {
+        _ = try request(Request(operation: "discard", token: review.token), marker: marker)
+    }
+
+    private func dependencyDirectory(_ record: PluginRecord, marker: URL) -> URL? {
+        record.environment.map {
+            marker.deletingLastPathComponent().appendingPathComponent("environments").appendingPathComponent($0)
+        }
+    }
+
+    private func scope(_ record: PluginRecord, account: String, marker: URL) -> String {
+        (dependencyDirectory(record, marker: marker)?.path ?? marker.path + "/" + record.manifest.id) + "/" + account
+    }
+
+    func load(_ record: PluginRecord, account: String, marker: URL) throws -> PythonPluginReply {
+        let inspected = try inspect(record.manifest.pythonSource, marker: marker)
+        try pluginRequire(inspected == record.manifest, "Stored plugin metadata changed. Import and review it again.")
+        try pluginRequire(
+            record.environment != nil || (record.manifest.dependencies ?? []).isEmpty,
+            "Plugin dependencies have no reviewed environment. Import it again.")
+        if let directory = dependencyDirectory(record, marker: marker) {
+            _ = try request(
+                Request(operation: "verify", dependencyPath: directory.path, dependencies: record.dependencies ?? []),
+                marker: marker)
+        }
+        let reply = try request(
+            Request(
+                operation: "load", id: record.manifest.id, account: account,
+                source: record.manifest.pythonSource, settings: record.values(account: account),
+                dependencyPath: dependencyDirectory(record, marker: marker)?.path,
+                scope: scope(record, account: account, marker: marker),
+                dataDirectory: try dataDirectory(record, account: account, marker: marker)), marker: marker
+        )
+        stateLock.lock()
+        loadedScopes.insert(scope(record, account: account, marker: marker))
+        stateLock.unlock()
+        return reply
+    }
+
+    private func dataDirectory(_ record: PluginRecord, account: String, marker: URL) throws -> String {
+        let directory = marker.deletingLastPathComponent().appendingPathComponent("data").appendingPathComponent(
+            record.manifest.id
+        ).appendingPathComponent(account)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        return directory.path
+    }
+
+    func actionResult(_ record: PluginRecord, account: String, result: PluginActionResult, marker: URL) throws
+        -> PythonPluginReply
+    {
+        try request(
+            Request(
+                operation: result.status == "progress" ? "actionProgress" : "actionResult",
+                id: record.manifest.id, account: account, source: record.manifest.pythonSource,
+                settings: record.values(account: account),
+                dependencyPath: dependencyDirectory(record, marker: marker)?.path,
+                scope: scope(record, account: account, marker: marker),
+                dataDirectory: try dataDirectory(record, account: account, marker: marker), actionResult: result),
+            marker: marker)
+    }
+
+    func unload(_ record: PluginRecord, account: String, marker: URL) throws {
+        stateLock.lock()
+        let blocked = quarantined
+        stateLock.unlock()
+        if blocked { return }
+        stateLock.lock()
+        loadedScopes.remove(scope(record, account: account, marker: marker))
+        stateLock.unlock()
+        _ = try request(
+            Request(
+                operation: "unload", id: record.manifest.id, account: account,
+                scope: scope(record, account: account, marker: marker)), marker: marker)
+    }
+
+    func invoke(
+        _ record: PluginRecord, event: PluginEvent, callback: String, menuID: String? = nil,
+        marker: URL
+    ) throws -> PythonPluginReply {
+        stateLock.lock()
+        let loaded = loadedScopes.contains(scope(record, account: event.account, marker: marker))
+        stateLock.unlock()
+        let bootstrap = loaded ? nil : try load(record, account: event.account, marker: marker)
+        var reply = try request(
+            Request(
+                operation: menuID == nil ? "hook" : "menu", id: record.manifest.id,
+                account: event.account, source: record.manifest.pythonSource,
+                settings: bootstrap?.settings ?? record.values(account: event.account),
+                event: event, callback: callback, menuID: menuID,
+                dependencyPath: dependencyDirectory(record, marker: marker)?.path,
+                scope: scope(record, account: event.account, marker: marker),
+                dataDirectory: try dataDirectory(record, account: event.account, marker: marker)), marker: marker)
+        reply.actions = (bootstrap?.actions ?? []) + (reply.actions ?? [])
+        return reply
+    }
+
+    private func request(_ request: Request, marker: URL) throws -> PythonPluginReply {
+        stateLock.lock()
+        let blocked = quarantined
+        stateLock.unlock()
+        try pluginRequire(!blocked, "Python stopped responding. Restart Swiftgram to recover.")
+        let payload = String(decoding: try JSONEncoder().encode(request), as: UTF8.self)
+        let job = Job()
+        let recovery = try JSONEncoder().encode(["id": request.id ?? "", "operation": request.operation])
+        let queue = request.scope == nil ? managerWorker : worker
+        queue.async { [self] in
+            job.lock.lock()
+            let expired = job.expired
+            job.lock.unlock()
+            if expired {
+                job.semaphore.signal()
+                return
+            }
+            let result = Result { () throws -> PythonPluginReply in
+                if request.scope != nil { try recovery.write(to: marker, options: .atomic) }
+                try initializer.sync {
+                    if !initialized {
+                        #if TESTING
+                            let home = ProcessInfo.processInfo.environment["SGA_PYTHON_HOME"] ?? ""
+                            let sdk = ProcessInfo.processInfo.environment["SGA_PYTHON_SDK"] ?? ""
+                        #else
+                            guard let home = Self.bundledResource("SwiftgramPython.bundle"),
+                                let sdk = Self.bundledResource("SwiftgramPythonSDK.bundle")
+                            else {
+                                throw SettingsError.invalid("Bundled Python resources are unavailable.")
+                            }
+                        #endif
+                        var error: UnsafeMutablePointer<CChar>?
+                        let success = SGPythonInitialize(home, sdk, &error)
+                        defer { SGPythonFree(error) }
+                        try pluginRequire(
+                            success != 0, error.map { String(cString: $0) } ?? "Cannot initialize CPython.")
+                        initialized = true
+                    }
+                }
+                var error: UnsafeMutablePointer<CChar>?
+                let response: UnsafeMutablePointer<CChar>?
+                if let scope = request.scope {
+                    response = SGPythonCallIsolated(scope, payload, request.operation == "unload" ? 1 : 0, &error)
+                } else {
+                    response = SGPythonCall(payload, &error)
+                }
+                defer {
+                    SGPythonFree(response)
+                    SGPythonFree(error)
+                }
+                guard let response else {
+                    throw SettingsError.invalid(error.map { String(cString: $0) } ?? "Python failed.")
+                }
+                let data = Data(String(cString: response).utf8)
+                try pluginRequire(data.count <= 512 * 1024, "Python returned an oversized response.")
+                let envelope = try JSONDecoder().decode(Envelope.self, from: data)
+                if let failure = envelope.failure { throw SettingsError.invalid(failure) }
+                guard let reply = envelope.result else { throw SettingsError.invalid("Invalid Python response.") }
+                return reply
+            }
+            job.lock.lock()
+            if !job.expired {
+                if request.scope != nil { try? FileManager.default.removeItem(at: marker) }
+                job.result = result
+            }
+            job.lock.unlock()
+            job.semaphore.signal()
+        }
+        let seconds: Double
+        switch request.operation {
+        case "hook", "menu", "actionResult", "actionProgress": seconds = 0.25
+        case "resolve", "install": seconds = 120
+        case "verify": seconds = 10
+        default: seconds = 2
+        }
+        if job.semaphore.wait(timeout: .now() + seconds) == .timedOut {
+            job.lock.lock()
+            job.expired = true
+            job.lock.unlock()
+            if request.scope != nil {
+                stateLock.lock()
+                quarantined = true
+                stateLock.unlock()
+                // Keep recovery even if completion raced the caller's deadline.
+                try? recovery.write(to: marker, options: .atomic)
+                throw SettingsError.invalid(
+                    "Python exceeded the host deadline. The interpreter is paused until restart.")
+            }
+            throw SettingsError.invalid("Dependency operation timed out. Please retry.")
+        }
+        job.lock.lock()
+        let result = job.result
+        job.lock.unlock()
+        guard let result else { throw SettingsError.invalid("Missing Python result.") }
+        return try result.get()
+    }
+
+    private static func bundledResource(_ name: String) -> String? {
+        for bundle in [Bundle.main] + Bundle.allFrameworks {
+            if let directory = bundle.resourceURL?.appendingPathComponent(name),
+                FileManager.default.fileExists(atPath: directory.path)
+            {
+                return directory.path
+            }
+        }
+        return nil
+    }
+}
