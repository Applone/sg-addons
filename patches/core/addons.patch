index 0000000000000000000000000000000000000000..44661a557c4f95e30a3979728ee6c8ce6c4fad79
--- /dev/null
+++ b/Swiftgram/SGPython/prepare_runtime.py
@@ -0,0 +1,121 @@
+"""Package pinned CPython slices as signed-by-the-app Bazel framework imports."""
+
+from __future__ import annotations
+
+import plistlib
+import shutil
+import sys
+from pathlib import Path
+
+
+def prepare(root: Path) -> None:
+    python = root / "Python.xcframework"
+    bundle = root / "SwiftgramPython.bundle"
+    library = bundle / "lib/python3.14"
+    shutil.copytree(
+        python / "lib/python3.14",
+        library,
+        ignore=shutil.ignore_patterns("__pycache__", "site-packages", "ensurepip", "venv", "*.whl"),
+    )
+    with (bundle / "Info.plist").open("wb") as stream:
+        plistlib.dump(
+            {"CFBundleIdentifier": "org.swiftgram.python.stdlib", "CFBundlePackageType": "BNDL"},
+            stream,
+        )
+    slices = [
+        ("ios-arm64", "ios-arm64", "arm64", False),
+        ("ios-arm64_x86_64-simulator", "ios-arm64-simulator", "arm64", True),
+        ("ios-arm64_x86_64-simulator", "ios-x86_64-simulator", "x86_64", True),
+    ]
+    modules: dict[str, list[dict[str, object]]] = {}
+    for source_slice, identifier, arch, simulator in slices:
+        # These names include their architecture; copying them does not choose packages.
+        config_directory = python / source_slice / f"lib-{arch}/python3.14"
+        for config in config_directory.glob("_sysconfig*"):
+            shutil.copy2(config, library / config.name)
+        for binary in sorted(
+            (python / source_slice / f"lib-{arch}/python3.14/lib-dynload").glob("*.so")
+        ):
+            module = binary.name.split(".")[0]
+            if module.startswith(("_test", "_xx", "xx", "_interp")):
+                continue
+            name = "sgpython." + module
+            framework = root / f"Extensions/{name}.xcframework/{identifier}/{name}.framework"
+            framework.mkdir(parents=True)
+            shutil.copy2(binary, framework / name)
+            marker = binary.with_suffix(".fwork").name
+            marker_path = f"SwiftgramPython.bundle/lib/python3.14/lib-dynload/{marker}"
+            (framework / f"{name}.origin").write_text(marker_path + "\n")
+            destination = library / "lib-dynload" / marker
+            destination.parent.mkdir(exist_ok=True)
+            destination.write_text(f"Frameworks/{name}.framework/{name}\n")
+            with (framework / "Info.plist").open("wb") as stream:
+                plistlib.dump(
+                    {
+                        "CFBundleExecutable": name,
+                        "CFBundleName": name,
+                        "CFBundleIdentifier": "org.swiftgram.python." + module.replace("_", "-"),
+                        "CFBundlePackageType": "FMWK",
+                        "CFBundleVersion": "1",
+                        "CFBundleShortVersionString": "3.14.6",
+                        "MinimumOSVersion": "13.0",
+                        "CFBundleSupportedPlatforms": [
+                            "iPhoneSimulator" if simulator else "iPhoneOS"
+                        ],
+                    },
+                    stream,
+                )
+            entry: dict[str, object] = {
+                "LibraryIdentifier": identifier,
+                "LibraryPath": f"{name}.framework",
+                "SupportedArchitectures": [arch],
+                "SupportedPlatform": "ios",
+            }
+            if simulator:
+                entry["SupportedPlatformVariant"] = "simulator"
+            modules.setdefault(name, []).append(entry)
+    for name, entries in modules.items():
+        if len(entries) != 3:
+            raise ValueError(f"Missing architecture for {name}")
+        with (root / f"Extensions/{name}.xcframework/Info.plist").open("wb") as stream:
+            plistlib.dump(
+                {
+                    "AvailableLibraries": entries,
+                    "CFBundlePackageType": "XFWK",
+                    "XCFrameworkFormatVersion": "1.0",
+                },
+                stream,
+            )
+    targets = []
+    for name in sorted(modules):
+        targets.append(f'''
+apple_dynamic_xcframework_import(
+    name = "{name}",
+    xcframework_imports = glob(["Extensions/{name}.xcframework/**"]),
+    bundle_only = True,
+)
+''')
+    deps = [":" + name for name in sorted(modules)]
+    (root / "BUILD.bazel").write_text(
+        """
+load("@build_bazel_rules_apple//apple:apple.bzl", "apple_dynamic_xcframework_import")
+load("@build_bazel_rules_apple//apple:resources.bzl", "apple_bundle_import")
+package(default_visibility = ["//visibility:public"])
+apple_bundle_import(name = "stdlib", bundle_imports = glob(["SwiftgramPython.bundle/**"]))
+apple_dynamic_xcframework_import(
+    name = "Python",
+    xcframework_imports = glob([
+        "Python.xcframework/Info.plist",
+        "Python.xcframework/*/Python.framework/**",
+    ]),
+    deps = [":stdlib"] + """
+        + repr(deps)
+        + """,
+)
+"""
+        + "".join(targets)
+    )
+
+
+if __name__ == "__main__":
+    prepare(Path(sys.argv[1]))
