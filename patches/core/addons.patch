+"""Trusted CPython bootstrap and value-only protocol used by the native bridge."""
+
+from __future__ import annotations
+
+import ast
+import importlib
+import io
+import json
+import sys
+import time
+import tokenize
+import tomllib
+import types
+from pathlib import Path
+from typing import TYPE_CHECKING, Any, cast
+
+if TYPE_CHECKING:
+    from _typeshed import TraceFunction
+
+from swiftgram import BasePlugin, Event, HookResult, HookStrategy, SettingValue
+
+_sessions: dict[tuple[str, str], tuple[str, types.ModuleType, BasePlugin]] = {}
+_generation = 0
+_callbacks = {
+    "message": "on_message",
+    "sendMessage": "on_send_message",
+    "preRequest": "pre_request_hook",
+    "postRequest": "post_request_hook",
+}
+
+
+def _dependency_manager() -> types.ModuleType:
+    # Only the manager uses build-pinned tooling. Its wheel paths are never added
+    # to plugin interpreters, so plugins can depend on their own tooling versions.
+    bundle = Path(__file__).parent
+    for wheel in ("packaging.whl", "resolvelib.whl"):
+        if (bundle / wheel).is_file() and str(bundle / wheel) not in sys.path:
+            sys.path.insert(0, str(bundle / wheel))
+    return importlib.import_module("_swiftgram_dependencies")
+
+
+def metadata(source: str, *, validate_dependencies: bool = True) -> dict[str, object]:
+    """Parse PEP 723 TOML and literal SDK registrations without executing source."""
+    source = source.lstrip("\ufeff")
+    tree = ast.parse(source, filename="<plugin>")
+    comments = {
+        token.start[0]: token.string
+        for token in tokenize.generate_tokens(io.StringIO(source).readline)
+        if token.type == tokenize.COMMENT and token.start[1] == 0
+    }
+    blocks: list[str] = []
+    lines = source.splitlines()
+    for number, comment in comments.items():
+        if comment != "# /// script":
+            continue
+        content: list[str] = []
+        for offset in range(number, len(lines)):
+            line = comments.get(offset + 1, "")
+            if line == "# ///":
+                blocks.append("\n".join(content))
+                break
+            if line != "#" and not line.startswith("# "):
+                raise ValueError("Unclosed PEP 723 script block")
+            content.append(line[2:] if line.startswith("# ") else "")
+        else:
+            raise ValueError("Unclosed PEP 723 script block")
+    if len(blocks) != 1:
+        raise ValueError("Python plugins require exactly one PEP 723 script block")
+    config = tomllib.loads(blocks[0])
+    tool = config.get("tool", {})
+    if not isinstance(tool, dict) or not isinstance(tool.get("swiftgram", {}), dict):
+        raise ValueError("tool.swiftgram must be a table")
+    info = tool.get("swiftgram", {})
+    fields = {
+        "id": "id",
+        "name": "name",
+        "version": "version",
+        "author": "author",
+        "description": "description",
+        "sdk-version": "sdkVersion",
+        "app-version": "appVersion",
+        "permissions": "permissions",
+        "hooks": "hooks",
+        "settings": "settings",
+        "menus": "menus",
+    }
+    if (
+        set(config) - {"dependencies", "requires-python", "tool", *fields}
+        or set(info) - fields.keys()
+    ):
+        raise ValueError("Unknown Swiftgram script metadata field")
+    result: dict[str, Any] = {
+        "schemaVersion": 1,
+        "version": "1.0",
+        "permissions": [],
+        "hooks": [],
+        "pythonSource": "",
+        "settings": [],
+        "menus": [],
+        "dependencies": config.get("dependencies", []),
+        "requiresPython": config.get("requires-python", ""),
+    }
+    for key, destination in fields.items():
+        if key in config and key in info:
+            raise ValueError(f"Duplicate metadata field: {key}")
+        if key in info or key in config:
+            result[destination] = info.get(key, config.get(key))
+    if (
+        not isinstance(result["dependencies"], list)
+        or len(result["dependencies"]) > 64
+        or any(not isinstance(value, str) or len(value) > 512 for value in result["dependencies"])
+    ):
+        raise ValueError("dependencies must contain at most 64 PEP 508 strings")
+    if not isinstance(result["requiresPython"], str):
+        raise ValueError("requires-python must be a version specifier string")
+    # Legacy SDK registration literals remain supported; identity comes only from TOML.
+    declarations = {
+        "__sdk_version__": "sdkVersion",
+        "__app_version__": "appVersion",
+        "__permissions__": "permissions",
+        "__hooks__": "hooks",
+        "__settings__": "settings",
+        "__menus__": "menus",
+    }
+    seen = {fields[key] for key in fields if key in info or key in config}
+    for node in tree.body:
+        targets = (
+            node.targets
+            if isinstance(node, ast.Assign)
+            else ([node.target] if isinstance(node, ast.AnnAssign | ast.AugAssign) else [])
+        )
+        for target in targets:
+            if not isinstance(target, ast.Name):
+                continue
+            if target.id in {
+                "__requirements__",
+                "__dependencies__",
+                "requirements",
+                "dependencies",
+            }:
+                raise ValueError("Declare dependencies in the PEP 723 script block")
+            if target.id in {"__id__", "__name__", "__version__", "__author__", "__description__"}:
+                raise ValueError("Declare plugin information in the PEP 723 script block")
+            if target.id not in declarations:
+                continue
+            field = declarations[target.id]
+            if field in seen:
+                raise ValueError(f"Duplicate metadata declaration: {target.id}")
+            seen.add(field)
+            if not isinstance(node, ast.Assign | ast.AnnAssign) or node.value is None:
+                raise ValueError("Metadata must use literal assignments")
+            result[field] = ast.literal_eval(node.value)
+    if "id" not in result or "name" not in result:
+        raise ValueError("Python plugins require id and name in the PEP 723 script block")
+    for field in ("id", "name", "version", "author", "description", "sdkVersion", "appVersion"):
+        if field in result and not isinstance(result[field], str):
+            raise ValueError(f"{field} must be text")
+    if validate_dependencies:
+        _dependency_manager().validate_script(result["dependencies"], result["requiresPython"])
+    for key in ("hooks", "menus"):
+        registrations = result[key]
+        if not isinstance(registrations, list) or any(
+            not isinstance(item, dict) for item in registrations
+        ):
+            raise ValueError(f"{key} must be a list of dictionaries")
+        for entry in registrations:
+            allowed = (
+                {"event", "name", "substring", "priority", "callback"}
+                if key == "hooks"
+                else {"id", "title", "location", "action", "callback"}
+            )
+            if set(entry) - allowed:
+                raise ValueError(
+                    f"Unsupported {key} fields; implement behavior in Python callbacks"
+                )
+            if key == "hooks":
+                entry.setdefault("callback", _callbacks.get(entry.get("event", ""), ""))
+            else:
+                entry.setdefault("callback", "on_menu")
+    return result
+
+
+def _settings(instance: BasePlugin) -> dict[str, SettingValue]:
+    values = instance.settings
+    if type(values) is not dict or len(values) > 32:
+        raise ValueError("Plugin settings must be a dictionary with at most 32 entries")
+    for key, value in values.items():
+        if type(key) is not str or type(value) not in (bool, int, str):
+            raise TypeError("Settings support boolean, integer, and text values")
+        if isinstance(value, str) and len(value.encode()) > 2048:
+            raise ValueError("Setting text exceeds 2048 bytes")
+        if type(value) is int and not -1_000_000 <= value <= 1_000_000:
+            raise ValueError("Setting integer is out of range")
+    return values
+
+
+def _unload(key: tuple[str, str]) -> None:
+    session = _sessions.pop(key, None)
+    if session is not None:
+        _, module, instance = session
+        try:
+            instance.on_plugin_unload()
+        finally:
+            sys.modules.pop(module.__name__, None)
+
+
+def _load(request: dict[str, Any]) -> BasePlugin:
+    global _generation
+    key = (str(request["id"]), str(request["account"]))
+    source = str(request["source"])
+    previous = _sessions.get(key)
+    if previous is not None and previous[0] == source:
+        instance = previous[2]
+        instance.settings = dict(request["settings"])
+        return instance
+    metadata(source, validate_dependencies=False)
+    _generation += 1
+    module = types.ModuleType(f"_swiftgram_plugin_{_generation}")
+    module.__file__ = f"swiftgram-plugin:{key[0]}"
+    sys.modules[module.__name__] = module
+    candidate: BasePlugin | None = None
+    try:
+        exec(compile(source.lstrip("\ufeff"), module.__file__, "exec"), module.__dict__)
+        plugin_class = module.__dict__.get("Plugin")
+        if not isinstance(plugin_class, type) or not issubclass(plugin_class, BasePlugin):
+            raise TypeError("Define class Plugin(BasePlugin)")
+        candidate = plugin_class()
+        candidate.account = key[1]
+        candidate.settings = dict(request["settings"])
+        candidate.data_directory = Path(request.get("dataDirectory", "."))
+        candidate._actions_allowed = request["operation"] == "load"
+        candidate.on_plugin_load()
+        _settings(candidate)
+        _unload(key)
+        _sessions[key] = (source, module, candidate)
+        return candidate
+    except BaseException:
+        try:
+            if candidate is not None:
+                candidate.on_plugin_unload()
+        finally:
+            sys.modules.pop(module.__name__, None)
+        raise
+
+
+def _execute(request: dict[str, Any]) -> dict[str, object]:
+    operation = request["operation"]
+    if operation in ("resolve", "install", "discard", "verify"):
+        return cast(dict[str, object], _dependency_manager().manage(request))
+    if operation == "inspect":
+        return {"manifest": metadata(request["source"])}
+    key = (str(request["id"]), str(request["account"]))
+    if operation == "unload":
+        _unload(key)
+        return {}
+    dependency_path = request.get("dependencyPath")
+    if dependency_path and dependency_path not in sys.path:
+        sys.path.append(dependency_path)
+    instance = _load(request)
+    if operation != "load":
+        instance._actions = []
+    instance._actions_allowed = operation in ("load", "menu", "actionResult") or (
+        operation == "hook"
+        and request["event"]["kind"] in ("message", "sendMessage")
+        and not request["event"].get("pluginOrigin", False)
+    )
+    if operation == "load":
+        return {"settings": _settings(instance), "actions": instance._actions}
+    if operation in ("actionResult", "actionProgress"):
+        callback = (
+            instance.on_action_result
+            if operation == "actionResult"
+            else instance.on_action_progress
+        )
+        callback(request["actionResult"])
+        return {"settings": _settings(instance), "actions": instance._actions}
+    event = Event(request["event"])
+    callback = getattr(instance, request["callback"])
+    if operation == "menu":
+        text = callback(event, request["menuID"])
+        if type(text) is not str or len(text.encode()) > 65536:
+            raise ValueError("Menu callback must return text up to 64 KB")
+        return {"text": text, "settings": _settings(instance), "actions": instance._actions}
+    result = callback(event)
+    if result is None:
+        result = HookResult()
+    if not isinstance(result, HookResult):
+        raise TypeError("Hook callbacks must return HookResult or None")
+    strategy = HookStrategy(result.strategy)
+    for value in (result.text, result.error):
+        if value is not None and (type(value) is not str or len(value.encode()) > 65536):
+            raise ValueError("Hook output must be text up to 64 KB")
+    return {
+        "strategy": strategy.value,
+        "text": result.text,
+        "error": result.error,
+        "settings": _settings(instance),
+        **({"actions": instance._actions} if instance._actions else {}),
+    }
+
+
+def handle(payload: str) -> str:
+    request = cast(dict[str, Any], json.loads(payload))
+    deadline = time.monotonic() + (
+        0.1 if request["operation"] in ("hook", "menu", "actionResult", "actionProgress") else 0.5
+    )
+
+    def trace(frame: types.FrameType, event: str, arg: object) -> TraceFunction:
+        if time.monotonic() > deadline:
+            raise TimeoutError("Python plugin exceeded its execution deadline")
+        return trace
+
+    response: dict[str, object]
+    if request["operation"] not in ("resolve", "install", "discard", "verify"):
+        sys.settrace(trace)
+    try:
+        response = {"result": _execute(request)}
+    except BaseException as error:
+        response = {"failure": f"{type(error).__name__}: {error}"[:2048]}
+    finally:
+        sys.settrace(None)
+    return json.dumps(response, ensure_ascii=True, allow_nan=False)
diff --git a/Swiftgram/SGPython/SDK/swiftgram.py b/Swiftgram/SGPython/SDK/swiftgram.py
new file mode 100644
index 00000000..e0a84959
--- /dev/null
+++ b/Swiftgram/SGPython/SDK/swiftgram.py
@@ -0,0 +1,156 @@
+"""Swiftgram's Python plugin API. Host objects never cross this boundary."""
+
+from __future__ import annotations
+
+from enum import StrEnum
+from pathlib import Path
+from typing import Any
+from uuid import uuid4
+
+SettingValue = bool | int | str
+
+
+class HookStrategy(StrEnum):
+    DEFAULT = "default"
+    MODIFY = "modify"
+    MODIFY_FINAL = "modifyFinal"
+    CANCEL = "cancel"
+
+
+class HookResult:
+    def __init__(
+        self,
+        strategy: HookStrategy = HookStrategy.DEFAULT,
+        *,
+        text: str | None = None,
+        error: str | None = None,
+    ) -> None:
+        self.strategy = strategy
+        self.text = text
+        self.error = error
+
+
+class Event:
+    def __init__(self, payload: dict[str, object]) -> None:
+        def string(key: str) -> str:
+            value = payload[key]
+            if not isinstance(value, str):
+                raise TypeError(f"Event {key} must be a string")
+            return value
+
+        self.kind = string("kind")
+        self.name = string("name")
+        self.account = string("account")
+        self.text = string("text")
+        chat, error = payload.get("chat"), payload.get("error")
+        if chat is not None and not isinstance(chat, str):
+            raise TypeError("Event chat must be a string")
+        if error is not None and not isinstance(error, str):
+            raise TypeError("Event error must be a string")
+        self.chat = chat
+        self.error = error
+        self.message = payload.get("message")
+        self.plugin_origin = payload.get("pluginOrigin", False)
+
+
+class BasePlugin:
+    def __init__(self) -> None:
+        self.account = ""
+        self.settings: dict[str, SettingValue] = {}
+        self.data_directory = Path()
+        self._actions: list[dict[str, Any]] = []
+        self._actions_allowed = False
+
+    def _queue(self, operation: str, **arguments: Any) -> str:
+        if not self._actions_allowed:
+            raise RuntimeError("Actions are unavailable in this callback")
+        if len(self._actions) >= 32:
+            raise ValueError("At most 32 actions per callback")
+        identifier = uuid4().hex
+        self._actions.append({"id": identifier, "operation": operation, **arguments})
+        return identifier
+
+    def get_message(self, chat: str, message_id: int) -> str:
+        return self._queue("getMessage", chat=chat, messageID=message_id)
+
+    def send_message(
+        self,
+        chat: str,
+        text: str,
+        *,
+        entities: tuple[dict[str, Any], ...] = (),
+        reply_to: int | None = None,
+        thread_id: int | None = None,
+    ) -> str:
+        return self._queue(
+            "sendMessage",
+            chat=chat,
+            text=text,
+            entities=list(entities),
+            replyTo=reply_to,
+            threadID=thread_id,
+        )
+
+    def edit_message(
+        self, chat: str, message_id: int, text: str, *, entities: tuple[dict[str, Any], ...] = ()
+    ) -> str:
+        return self._queue(
+            "editMessage", chat=chat, messageID=message_id, text=text, entities=list(entities)
+        )
+
+    def download_media(self, chat: str, message_id: int, attachment_id: str) -> str:
+        return self._queue(
+            "downloadMedia", chat=chat, messageID=message_id, attachmentID=attachment_id
+        )
+
+    def send_media(
+        self,
+        chat: str,
+        path: str,
+        *,
+        kind: str,
+        caption: str = "",
+        entities: tuple[dict[str, Any], ...] = (),
+        reply_to: int | None = None,
+        thread_id: int | None = None,
+    ) -> str:
+        return self._queue(
+            "sendMedia",
+            chat=chat,
+            path=path,
+            mediaKind=kind,
+            text=caption,
+            entities=list(entities),
+            replyTo=reply_to,
+            threadID=thread_id,
+        )
+
+    def cancel_action(self, action_id: str) -> str:
+        return self._queue("cancel", targetID=action_id)
+
+    def on_action_result(self, result: dict[str, Any]) -> None:
+        """Receive action status; accepted precedes completed, failed, or cancelled."""
+
+    def on_action_progress(self, progress: dict[str, Any]) -> None:
+        """Receive coalesced transfer progress."""
+
+    def on_plugin_load(self) -> None:
+        """Initialize this account's instance; raise to reject activation."""
+
+    def on_plugin_unload(self) -> None:
+        """Release plugin-owned resources. Host registration cleanup is automatic."""
+
+    def on_message(self, event: Event) -> HookResult | None:
+        return None
+
+    def on_send_message(self, event: Event) -> HookResult | None:
+        return None
+
+    def pre_request_hook(self, event: Event) -> HookResult | None:
+        return None
+
+    def post_request_hook(self, event: Event) -> HookResult | None:
+        return None
+
+    def on_menu(self, event: Event, menu_id: str) -> str:
+        return event.text
diff --git a/Swiftgram/SGPython/Tests/test_actions.py b/Swiftgram/SGPython/Tests/test_actions.py
