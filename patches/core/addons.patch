index 0000000000000000000000000000000000000000..c2a602d36b5a359ba33353a03ac4d812e39dab8a
--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Tests/PluginChecks.swift
@@ -0,0 +1,310 @@
+import Foundation
+
+enum PluginChecks {
+    private static func source(
+        _ id: String = "aa", name: String = "Test", version: String = "1.0",
+        permissions: String = "['incomingMessages']",
+        hooks: String = "[{'event': 'message', 'name': 'message'}]",
+        settings: String = "[]", menus: String = "[]", metadata: String = "",
+        methods: String =
+            "    def on_message(self, event):\n        return HookResult(HookStrategy.MODIFY, text=event.text + 'A')"
+    ) -> Data {
+        func literal(_ value: String) -> String {
+            let encoder = JSONEncoder()
+            encoder.outputFormatting = [.withoutEscapingSlashes]
+            return String(decoding: try! encoder.encode(value), as: UTF8.self)
+        }
+        return Data(
+            """
+            __id__ = \(literal(id))
+            __name__ = \(literal(name))
+            __version__ = \(literal(version))
+            __permissions__ = \(permissions)
+            __hooks__ = \(hooks)
+            __settings__ = \(settings)
+            __menus__ = \(menus)
+            \(metadata)
+            from swiftgram import BasePlugin, HookResult, HookStrategy
+            class Plugin(BasePlugin):
+            \(methods)
+            """.utf8)
+    }
+
+    private static func rejects(_ label: String, _ action: () throws -> Void) {
+        do { try action() } catch { return }
+        fatalError("FAILED: accepted " + label)
+    }
+
+    static func run(root: URL) throws {
+        let directory = root.appendingPathComponent("plugin-checks")
+        let registry = PluginRegistry(directory: directory, hostVersion: "13.0.1")
+        let event = PluginEvent(kind: .message, name: "message", account: "77", chat: "user:42", text: "x")
+        for id in ["ab", "a_", "a-", "a" + String(repeating: "1", count: 31)] {
+            _ = try registry.inspect(source(id))
+        }
+        for id in ["a", "a" + String(repeating: "1", count: 32), "1a", "éa", "a/a", "../a", "a.b", ""] {
+            rejects("invalid ID " + id) { _ = try registry.inspect(source(id)) }
+        }
+        rejects("blank name") { _ = try registry.inspect(source(name: " \n ")) }
+        rejects("invalid UTF-8") { _ = try registry.inspect(Data([0xff])) }
+        rejects("source-size limit") { _ = try registry.inspect(Data(repeating: 32, count: 256 * 1024 + 1)) }
+        rejects("missing metadata") { _ = try registry.inspect(Data("print('not metadata')".utf8)) }
+        for expression in [">=1", "<=1.0.0", "==1", ">0.9", "<1.1"] {
+            _ = try registry.inspect(source(metadata: "__sdk_version__ = '\(expression)'"))
+        }
+        for expression in [">1", "<1.0", ">=2", "1", "~=1", ">=1..0", ">=-1", ">=9999999", "=="] {
+            rejects("SDK constraint " + expression) {
+                _ = try registry.inspect(source(metadata: "__sdk_version__ = '\(expression)'"))
+            }
+        }
+        rejects("host constraint") { _ = try registry.inspect(source(metadata: "__app_version__ = '>13.0.1'")) }
+        rejects("missing capability") { _ = try registry.inspect(source(permissions: "[]")) }
+        rejects("priority overflow") {
+            _ = try registry.inspect(source(hooks: "[{'event':'message','name':'message','priority':1001}]"))
+        }
+        rejects("invalid callback") {
+            _ = try registry.inspect(source(hooks: "[{'event':'message','name':'message','callback':'not.a.method'}]"))
+        }
+        rejects("declarative hook behavior") {
+            _ = try registry.inspect(source(hooks: "[{'event':'message','name':'message','strategy':'cancel'}]"))
+        }
+        rejects("declarative menu text") {
+            _ = try registry.inspect(source(menus: "[{'id':'copy','text':'${text}'}]"))
+        }
+        try registry.install(source())
+        CheckCore.require(registry.dispatch(event) == event, "installation does not enable Python")
+        let stored = try Data(contentsOf: directory.appendingPathComponent("registry.json"))
+        for input in [
+            "{}", "[]",
+            "{\"schemaVersion\":1,\"id\":\"json-test\",\"name\":\"JSON\",\"version\":\"1\",\"permissions\":[],\"rules\":[],\"settings\":[],\"menus\":[]}",
+        ] {
+            rejects("JSON plugin") { try registry.install(Data(input.utf8)) }
+        }
+        let afterRejectedImports = try Data(contentsOf: directory.appendingPathComponent("registry.json"))
+        CheckCore.require(
+            afterRejectedImports == stored,
+            "rejected JSON imports preserve installed Python plugins")
+        try registry.setEnabled("aa", account: "77", enabled: true)
+        CheckCore.require(registry.dispatch(event)?.text == "xA", "Python callback changes message text")
+        let other = PluginEvent(kind: .message, name: "message", account: "88", text: "x")
+        CheckCore.require(registry.dispatch(other) == other, "account isolation")
+        for (id, suffix, priority) in [("bb", "B", 0), ("cc", "C", -1)] {
+            try registry.install(
+                source(
+                    id, hooks: "[{'event':'message','name':'message','priority':\(priority)}]",
+                    methods:
+                        "    def on_message(self, event):\n        return HookResult(HookStrategy.MODIFY, text=event.text + '\(suffix)')"
+                ))
+            try registry.setEnabled(id, account: "77", enabled: true)
+        }
+        CheckCore.require(registry.dispatch(event)?.text == "xABC", "priority order and ID tie break")
+        let overlapping = """
+            [{'event':'message','name':'message','priority':1},
+             {'event':'message','name':'mess','substring':True,'priority':10,'callback':'high'}]
+            """
+        let methods = """
+                def on_message(self, event):
+                    return HookResult(HookStrategy.MODIFY, text=event.text + 'L')
+                def high(self, event):
+                    return HookResult(HookStrategy.MODIFY, text=event.text + 'H')
+            """
+        try registry.install(source(hooks: overlapping, methods: methods))
+        CheckCore.require(registry.dispatch(event)?.text == "xHBC", "highest priority callback runs once per plugin")
+        try registry.setEnabled("aa", account: "77", enabled: true)
+        CheckCore.require(registry.dispatch(event)?.text == "xHBC", "repeated enable does not duplicate callbacks")
+        let uppercase = PluginEvent(kind: .message, name: "Message", account: "77", text: "x")
+        CheckCore.require(registry.dispatch(uppercase) == uppercase, "event names are case sensitive")
+        try registry.install(
+            source(
+                methods:
+                    "    def on_message(self, event):\n        return HookResult(HookStrategy.MODIFY_FINAL, text=event.text + 'F')"
+            ))
+        CheckCore.require(registry.dispatch(event)?.text == "xF", "final modification stops later plugins")
+        try registry.install(
+            source(methods: "    def on_message(self, event):\n        return HookResult(HookStrategy.CANCEL)"))
+        CheckCore.require(registry.dispatch(event) == nil, "Python cancellation stops processing")
+        let before = registry.records()
+        rejects("invalid update") { try registry.install(source(version: "invalid")) }
+        CheckCore.require(
+            registry.records() == before && registry.dispatch(event) == nil, "invalid update preserves installation")
+
+        let settings = """
+            [{'key':'caption','title':'Caption','defaultValue':'A','choices':['A','B']},
+             {'key':'amount','title':'Amount','defaultValue':2},
+             {'key':'enabled','title':'Enabled','defaultValue':True}]
+            """
+        let menus = "[{'id':'copy','title':'Copy','location':'message','action':'copyText'}]"
+        let configured = source(
+            permissions: "['incomingMessages','menus']", settings: settings, menus: menus,
+            methods:
+                "    def on_message(self, event):\n        return HookResult(HookStrategy.MODIFY, text=event.text + str(self.settings['caption']))"
+        )
+        try registry.install(configured)
+        CheckCore.require(
+            registry.records().first?.enabledAccounts.isEmpty == true, "added permissions require reenabling")
+        try registry.setEnabled("aa", account: "77", enabled: true)
+        try registry.saveSettings("aa", account: "77", values: ["caption": .string("B"), "amount": .integer(7)])
+        CheckCore.require(registry.dispatch(event)?.text == "xBBC", "settings reach Python callbacks")
+        rejects("wrong setting type") {
+            try registry.saveSettings("aa", account: "77", values: ["amount": .string("bad")])
+        }
+        rejects("unknown choice") { try registry.saveSettings("aa", account: "77", values: ["caption": .string("C")]) }
+        rejects("unknown setting") { try registry.saveSettings("aa", account: "77", values: ["missing": .bool(true)]) }
+        let reloaded = PluginRegistry(directory: directory, hostVersion: "13.0.1")
+        CheckCore.require(
+            reloaded.dispatch(event)?.text == "xBBC", "registry round trip preserves settings and activation")
+        let items = reloaded.menuItems(location: .message, event: event)
+        CheckCore.require(
+            items.count == 1 && reloaded.performMenu(items[0], location: .message, event: event)?.text == "x",
+            "native menu invokes Python")
+        CheckCore.require(
+            reloaded.menuItems(location: .settings, event: event).isEmpty, "menu locations remain distinct")
+        try reloaded.setSafeMode(true)
+        CheckCore.require(
+            reloaded.dispatch(event) == event && reloaded.menuItems(location: .message, event: event).isEmpty,
+            "safe mode pauses callbacks")
+        CheckCore.require(
+            reloaded.performMenu(items[0], location: .message, event: event) == nil, "safe mode rejects stale menus")
+        try reloaded.setSafeMode(false)
+        try reloaded.setEnabled("aa", account: "77", enabled: false)
+        CheckCore.require(reloaded.dispatch(event)?.text == "xBC", "disable removes callbacks")
+        try reloaded.setEnabled("aa", account: "77", enabled: true)
+        try reloaded.remove("aa")
+        CheckCore.require(
+            reloaded.performMenu(items[0], location: .message, event: event) == nil, "uninstall rejects stale menus")
+
+        try reloaded.install(
+            source(
+                "overflow", hooks: "[{'event':'message','name':'message','priority':100}]",
+                methods:
+                    "    def on_message(self, event):\n        return HookResult(HookStrategy.MODIFY, text='x' * 65537)"
+            ))
+        try reloaded.setEnabled("overflow", account: "77", enabled: true)
+        CheckCore.require(
+            reloaded.dispatch(event)?.text == "xBC", "failed callback preserves preceding value and continues")
+        CheckCore.require(
+            reloaded.records().first { $0.manifest.id == "overflow" }?.error != nil, "runtime failure disables plugin")
+        CheckCore.require(
+            PluginRegistry(directory: directory, hostVersion: "13.0.1").records().first {
+                $0.manifest.id == "overflow"
+            }?.error != nil, "runtime failure persists")
+
+        let post = source(
+            "network", permissions: "['network']", hooks: "[{'event':'postRequest','name':'messages.sendMessage'}]",
+            methods:
+                "    def post_request_hook(self, event):\n        return HookResult(HookStrategy.MODIFY, error=(event.error or '') + ' local')"
+        )
+        try reloaded.install(post)
+        try reloaded.setEnabled("network", account: "77", enabled: true)
+        let error = PluginEvent(kind: .postRequest, name: "messages.sendMessage", account: "77", error: "FAILED")
+        CheckCore.require(reloaded.dispatch(error)?.error == "FAILED local", "Python changes existing request errors")
+        let success = PluginEvent(kind: .postRequest, name: error.name, account: "77")
+        CheckCore.require(
+            reloaded.dispatch(success)?.error == nil, "post-request callback cannot turn success into failure")
+        try reloaded.install(
+            source(
+                "network", permissions: "['network']", hooks: "[{'event':'postRequest','name':'messages.sendMessage'}]",
+                methods: "    def post_request_hook(self, event):\n        return HookResult(HookStrategy.CANCEL)"))
+        CheckCore.require(reloaded.dispatch(error) == error, "post-request cancellation is rejected at runtime")
+        try reloaded.install(
+            source(
+                "block", permissions: "['network']", hooks: "[{'event':'preRequest','name':'account.updateStatus'}]",
+                methods: "    def pre_request_hook(self, event):\n        return HookResult(HookStrategy.CANCEL)"))
+        try reloaded.setEnabled("block", account: "77", enabled: true)
+        CheckCore.require(
+            reloaded.dispatch(PluginEvent(kind: .preRequest, name: "account.updateStatus", account: "77")) == nil,
+            "Python pre-request cancellation")
+        try reloaded.install(
+            source(
+                "send", permissions: "['outgoingMessages']", hooks: "[{'event':'sendMessage','name':'send_message'}]",
+                methods:
+                    "    def on_send_message(self, event):\n        return HookResult(HookStrategy.MODIFY, text='x' * 4097)"
+            ))
+        try reloaded.setEnabled("send", account: "77", enabled: true)
+        let send = PluginEvent(kind: .sendMessage, name: "send_message", account: "77", text: "original")
+        CheckCore.require(reloaded.dispatch(send) == send, "outgoing text limit preserves original message")
+
+        let file = directory.appendingPathComponent("registry.json")
+        let backup = directory.appendingPathComponent("io-fixture.json")
+        let savedRecords = reloaded.records()
+        try FileManager.default.moveItem(at: file, to: backup)
+        try FileManager.default.createDirectory(at: file, withIntermediateDirectories: false)
+        rejects("failed replacement write") { try reloaded.install(source("bb")) }
+        CheckCore.require(reloaded.records() == savedRecords, "I/O failure preserves source, settings, and enablement")
+        try FileManager.default.removeItem(at: file)
+        try FileManager.default.moveItem(at: backup, to: file)
+        let recovered = PluginRegistry(directory: directory, hostVersion: "13.0.1")
+        CheckCore.require(
+            recovered.safeMode() && recovered.dispatch(event) == event, "interrupted mutation enters safe mode")
+        try recovered.setSafeMode(false)
+        CheckCore.require(
+            !PluginRegistry(directory: directory, hostVersion: "13.0.1").safeMode(),
+            "explicit recovery survives restart")
+
+        let corruptDirectory = root.appendingPathComponent("corrupt-plugins")
+        try FileManager.default.createDirectory(at: corruptDirectory, withIntermediateDirectories: false)
+        try Data("broken".utf8).write(to: corruptDirectory.appendingPathComponent("registry.json"))
+        let corrupt = PluginRegistry(directory: corruptDirectory, hostVersion: "13.0.1")
+        CheckCore.require(corrupt.safeMode() && corrupt.status() != nil, "corrupt storage leaves recovery available")
+        rejects("overwrite damaged registry") { try corrupt.install(source()) }
+        try corrupt.reset()
+        CheckCore.require(corrupt.records().isEmpty && !corrupt.safeMode(), "reset repairs registry")
+        let recoveredFiles = try FileManager.default.contentsOfDirectory(atPath: corruptDirectory.path)
+        CheckCore.require(recoveredFiles.contains { $0.hasSuffix(".bak") }, "reset backs up damaged storage")
+
+        let sourceRequiredDirectory = root.appendingPathComponent("source-required")
+        try FileManager.default.createDirectory(at: sourceRequiredDirectory, withIntermediateDirectories: false)
+        var storedDocument = try JSONSerialization.jsonObject(with: stored) as! [String: Any]
+        var storedRecords = storedDocument["records"] as! [String: [String: Any]]
+        var storedRecord = storedRecords["aa"]!
+        var storedManifest = storedRecord["manifest"] as! [String: Any]
+        storedManifest.removeValue(forKey: "pythonSource")
+        storedRecord["manifest"] = storedManifest
+        storedRecords["aa"] = storedRecord
+        storedDocument["records"] = storedRecords
+        try JSONSerialization.data(withJSONObject: storedDocument).write(
+            to: sourceRequiredDirectory.appendingPathComponent("registry.json"))
+        let sourceRequired = PluginRegistry(directory: sourceRequiredDirectory, hostVersion: "13.0.1")
+        CheckCore.require(
+            sourceRequired.safeMode() && sourceRequired.records().isEmpty,
+            "stored plugins without Python source cannot become active")
+
+        let migration = PluginRegistry(
+            directory: root.appendingPathComponent("plugin-migration"), hostVersion: "13.0.1")
+        try migration.install(source(settings: settings))
+        try migration.setEnabled("aa", account: "77", enabled: true)
+        try migration.saveSettings("aa", account: "77", values: ["caption": .string("B"), "amount": .integer(7)])
+        try migration.install(
+            source(
+                settings:
+                    "[{'key':'caption','title':'Caption','defaultValue':'A','choices':['A','B']},{'key':'amount','title':'Amount','defaultValue':'new'}]"
+            ))
+        let migrated = migration.records()[0]
+        CheckCore.require(migrated.isEnabled(account: "77"), "update preserves activation without added permissions")
+        CheckCore.require(
+            migrated.values(account: "77")["caption"] == .string("B"), "update preserves compatible settings")
+        CheckCore.require(migrated.values(account: "77")["amount"] == .string("new"), "changed types reset settings")
+        CheckCore.require(migrated.values(account: "77")["enabled"] == nil, "removed setting is pruned")
+        rejects("invalid account") { try migration.setEnabled("aa", account: "other", enabled: true) }
+
+        let concurrent = PluginRegistry(directory: root.appendingPathComponent("plugin-races"), hostVersion: "13.0.1")
+        try concurrent.install(source())
+        let group = DispatchGroup()
+        for _ in 0..<4 {
+            group.enter()
+            DispatchQueue.global().async {
+                do {
+                    try concurrent.setEnabled("aa", account: "77", enabled: true)
+                    _ = concurrent.dispatch(event)
+                    try concurrent.setEnabled("aa", account: "77", enabled: false)
+                } catch { fatalError("Concurrent lifecycle failed: \(error)") }
+                group.leave()
+            }
+        }
+        group.wait()
+        try concurrent.setEnabled("aa", account: "77", enabled: false)
+        CheckCore.require(concurrent.dispatch(event) == event, "disable race leaves no registrations")
+        try concurrent.setEnabled("aa", account: "77", enabled: true)
+        CheckCore.require(concurrent.dispatch(event)?.text == "xA", "enable race does not duplicate callbacks")
+    }
+}
diff --git a/Swiftgram/SGAdditionalCore/Tests/PythonPluginChecks.swift b/Swiftgram/SGAdditionalCore/Tests/PythonPluginChecks.swift
new file mode 100644
index 0000000000000000000000000000000000000000..120e4a1087cb7e78127ac1e610289f9ef753f729
--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Tests/PythonPluginChecks.swift
@@ -0,0 +1,98 @@
+import Foundation
+
+enum PythonPluginChecks {
+    static func run(root: URL) throws {
+        let registry = PluginRegistry(directory: root.appendingPathComponent("python-core"), hostVersion: "13.0.1")
+        guard let examples = ProcessInfo.processInfo.environment["SGA_PLUGIN_EXAMPLES"] else {
+            throw SettingsError.invalid("Run Python checks using tools/test-core.sh.")
+        }
+        let example = URL(fileURLWithPath: examples).appendingPathComponent("uppercase.py")
+        let uppercase = try registry.install(Data(contentsOf: example))
+        try registry.setEnabled(uppercase.id, account: "77", enabled: true)
+        let send = PluginEvent(kind: .sendMessage, name: "send_message", account: "77", text: "Hello")
+        CheckCore.require(
+            registry.dispatch(send)?.text == "HELLO", "shipped Python example executes without dependencies")
+        try registry.remove(uppercase.id)
+        let source = """
+            __id__ = "real-python"
+            __name__ = "Real Python"
+            __permissions__ = ["incomingMessages", "menus"]
+            __hooks__ = [{"event": "message", "name": "message"}]
+            __settings__ = [{"key": "counter", "title": "Counter", "defaultValue": 0}]
+            __menus__ = [{"id": "copy", "title": "Python copy", "location": "message", "action": "copyText"}]
+            import json
+            import math
+            import sys
+            from swiftgram import BasePlugin, HookResult, HookStrategy
+            class Plugin(BasePlugin):
+                def on_plugin_load(self):
+                    if any("site-packages" in path for path in sys.path):
+                        raise RuntimeError("Third-party search path was enabled")
+                def on_message(self, event):
+                    self.settings["counter"] += 1
+                    numbers = [math.factorial(number) for number in range(5)]
+                    return HookResult(HookStrategy.MODIFY, text=event.text.upper() + ":" + str(sum(numbers)))
+                def on_menu(self, event, menu_id):
+                    return json.dumps([event.account, event.chat, event.text])
+            """
+        let manifest = try registry.install(Data(source.utf8))
+        CheckCore.require(manifest.pythonSource == source, "Python source is preserved")
+        let event = PluginEvent(kind: .message, name: "message", account: "77", chat: "user:42", text: "hello")
+        CheckCore.require(registry.dispatch(event) == event, "Python installation is separate from execution")
+        try registry.setEnabled(manifest.id, account: "77", enabled: true)
+        CheckCore.require(
+            registry.dispatch(event)?.text == "HELLO:34", "Swift invokes real Python functions and stdlib")
+        CheckCore.require(
+            registry.records()[0].values(account: "77")["counter"] == .integer(1), "Python setting changes persist")
+        CheckCore.require(
+            registry.records()[0].values(account: "88")["counter"] == .integer(0), "Python settings are account scoped")
+        let items = registry.menuItems(location: .message, event: event)
+        CheckCore.require(items.count == 1, "Python menu metadata registers a native item")
+        CheckCore.require(
+            registry.performMenu(items[0], location: .message, event: event)?.text
+                == "[\"77\", \"user:42\", \"hello\"]", "Python menu callback returns native action content")
+
+        let broken = source.replacingOccurrences(
+            of: "import json", with: "raise RuntimeError('bad update')\nimport json")
+        do {
+            try registry.install(Data(broken.utf8))
+            fatalError("Broken Python update accepted")
+        } catch {}
+        CheckCore.require(
+            registry.records()[0].manifest.pythonSource == source, "failed import restores previous source")
+        CheckCore.require(
+            registry.dispatch(event)?.text == "HELLO:34", "failed update restores previous Python behavior")
+        try registry.setEnabled(manifest.id, account: "77", enabled: false)
+        CheckCore.require(registry.dispatch(event) == event, "Python disable removes active hooks")
+        CheckCore.require(
+            registry.performMenu(items[0], location: .message, event: event) == nil, "stale Python menu cannot execute")
+
+        for declaration in ["__requirements__ = []", "__dependencies__ = ['requests']"] {
+            do {
+                _ = try registry.install(Data((source + "\n" + declaration).utf8))
+                fatalError("Python dependency declaration accepted")
+            } catch {
+                CheckCore.require(
+                    error.localizedDescription.contains("Third-party dependencies are unsupported"),
+                    "dependency error is explicit")
+            }
+        }
+        let missing = """
+            __id__ = "missing-import"
+            __name__ = "Missing import"
+            import swiftgram_missing_third_party_package_987654321
+            """
+        try registry.install(Data(missing.utf8))
+        do {
+            try registry.setEnabled("missing-import", account: "77", enabled: true)
+            fatalError("Missing dependency installed implicitly")
+        } catch {
+            CheckCore.require(
+                error.localizedDescription.contains("ModuleNotFoundError"),
+                "missing dependency fails without resolution")
+        }
+        CheckCore.require(
+            registry.records().first { $0.manifest.id == "missing-import" }?.isEnabled(account: "77") == false,
+            "failed activation stays inactive")
+    }
+}
