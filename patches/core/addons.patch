+            pending, owner: .init(plugin: record.manifest.id, account: account, generation: generation),
+            directory: actionDirectory(record.manifest.id, account: account))
+    }
+
+    private func receiveAction(_ owner: PluginActionExecutor.Owner, result: PluginActionResult) {
+        lock.lock()
+        defer { lock.unlock() }
+        guard !document.safeMode, generations[owner.plugin + ":" + owner.account] == owner.generation,
+            let record = document.records[owner.plugin], record.isEnabled(account: owner.account)
+        else { return }
+        do {
+            let reply = try PythonPluginRuntime.shared.actionResult(
+                record, account: owner.account, result: result, marker: pythonRecovery)
+            try checkedPythonSettings(reply.settings ?? [:], record: record)
+            try acceptPythonSettings(reply.settings, id: owner.plugin, account: owner.account)
+            try acceptActions(reply, record: record, account: owner.account, allowed: result.status != "progress")
+        } catch { fail(owner.plugin, error: error) }
+    }
+
+    public func records() -> [PluginRecord] {
+        lock.lock()
+        defer { lock.unlock() }
+        return document.records.values.sorted { $0.manifest.id < $1.manifest.id }
+    }
+
+    public func safeMode() -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        return document.safeMode
+    }
+    public func status() -> String? {
+        lock.lock()
+        defer { lock.unlock() }
+        return failure
+    }
+
+    public func inspect(_ data: Data) throws -> PluginManifest {
+        try pluginRequire(data.count <= 256 * 1024, "Plugin exceeds 256 KB.")
+        guard let source = String(data: data, encoding: .utf8) else {
+            throw SettingsError.invalid("Plugin must be UTF-8.")
+        }
+        let manifest = try PythonPluginRuntime.shared.inspect(source, marker: pythonRecovery)
+        try manifest.validate(hostVersion: hostVersion)
+        return manifest
+    }
+
+    public func prepareInstallation(_ data: Data) throws -> PluginInstallation {
+        let manifest = try inspect(data)
+        return try PythonPluginRuntime.shared.prepare(manifest, directory: environments, marker: pythonRecovery)
+    }
+
+    public func discardInstallation(_ review: PluginInstallation) {
+        try? PythonPluginRuntime.shared.discard(review, marker: pythonRecovery)
+    }
+
+    private var environments: URL { directory.appendingPathComponent("environments", isDirectory: true) }
+
+    /// Convenience for dependency-free callers. Dependencies always require an explicit reviewed plan.
+    @discardableResult public func install(_ data: Data) throws -> PluginManifest {
+        let manifest = try inspect(data)
+        try pluginRequire((manifest.dependencies ?? []).isEmpty, "Review dependencies before installing this plugin.")
+        return try install(prepareInstallation(data))
+    }
+
+    @discardableResult public func install(_ review: PluginInstallation) throws -> PluginManifest {
+        let manifest = review.manifest
+        try manifest.validate(hostVersion: hostVersion)
+        let environment = try PythonPluginRuntime.shared.install(
+            review, directory: environments, marker: pythonRecovery)
+        var committed = false
+        defer {
+            if !committed { try? FileManager.default.removeItem(at: environments.appendingPathComponent(environment)) }
+        }
+        lock.lock()
+        defer { lock.unlock() }
+        var next = document
+        let previous = next.records[manifest.id]
+        try pluginRequire(previous != nil || next.records.count < 64, "Maximum 64 installed plugins.")
+        let gainedPermissions = !Set(manifest.permissions).isSubset(of: Set(previous?.manifest.permissions ?? []))
+        var record = PluginRecord(
+            manifest: manifest, environment: environment, dependencies: review.dependencies,
+            enabledAccounts: gainedPermissions ? [] : previous?.enabledAccounts ?? [], settings: [:], error: nil)
+        // Keep compatible settings. Removed keys and changed types return to new defaults.
+        for (account, values) in previous?.settings ?? [:] {
+            for setting in manifest.settings {
+                if let value = values[setting.key], (try? setting.validate(value)) != nil {
+                    record.settings[account, default: [:]][setting.key] = value
+                }
+            }
+        }
+        next.records[manifest.id] = record
+        try commit(next)
+        committed = true
+        if let oldEnvironment = previous?.environment, oldEnvironment != environment {
+            try? FileManager.default.removeItem(at: environments.appendingPathComponent(oldEnvironment))
+        }
