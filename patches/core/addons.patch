diff --git a/Swiftgram/SGAdditionalCore/Tests/PluginActionChecks.swift b/Swiftgram/SGAdditionalCore/Tests/PluginActionChecks.swift
new file mode 100644
index 00000000..7e281d4e
--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Tests/PluginActionChecks.swift
@@ -0,0 +1,110 @@
+import Foundation
+
+enum PluginActionChecks {
+    static func run(root: URL) throws {
+        let action = try JSONDecoder().decode(
+            PluginAction.self,
+            from: Data(
+                """
+                {"id":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","operation":"sendMessage","chat":"user:42","text":"hello"}
+                """.utf8))
+        try action.validate()
+        CheckCore.require(action.permissions == [.sendMessages], "write action requires declared permission")
+        do {
+            try PluginTextEntity(kind: "Bold", offset: 1, length: 1).validate(text: "😀")
+            fatalError("Entity split surrogate pair")
+        } catch {}
+        try PluginTextEntity(kind: "Bold", offset: 0, length: 2).validate(text: "😀")
+        let directory = root.appendingPathComponent("plugin-data")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        let source = directory.appendingPathComponent("file.txt")
+        try Data("snapshot".utf8).write(to: source)
+        let copy = try PluginFiles.snapshot(path: source.path, directory: directory)
+        try Data("changed".utf8).write(to: source)
+        let copied = try Data(contentsOf: copy)
+        CheckCore.require(copied == Data("snapshot".utf8), "upload snapshot is immutable relative to source")
+        do {
+            _ = try PluginFiles.snapshot(path: "../escape", directory: directory)
+            fatalError("Storage escape accepted")
+        } catch {}
+        let link = directory.appendingPathComponent("link")
+        try FileManager.default.createSymbolicLink(at: link, withDestinationURL: source)
+        do {
+            _ = try PluginFiles.snapshot(path: link.path, directory: directory)
+            fatalError("Symbolic link accepted")
+        } catch {}
+        try FileManager.default.removeItem(at: link)
+        let executor = PluginActionExecutor()
+        let completed = DispatchSemaphore(value: 0)
+        let adapter = Adapter()
+        executor.authorized = { $0.generation == "current" }
+        executor.deliver = { _, result in
+            CheckCore.require(result.status == "completed", "native action result delivered")
+            completed.signal()
+        }
+        executor.register(account: "77", adapter: adapter)
+        executor.submit(
+            [action], owner: .init(plugin: "test", account: "77", generation: "current"), directory: directory)
+        CheckCore.require(completed.wait(timeout: .now() + 2) == .success, "queued adapter executes asynchronously")
+        executor.submit(
+            [action], owner: .init(plugin: "test", account: "77", generation: "retired"), directory: directory)
+        executor.queue.sync {}
+        CheckCore.require(adapter.calls == 1, "retired generation cannot execute")
+        try cancellation(root: root)
+    }
+
+    static func cancellation(root: URL) throws {
+        let action = try JSONDecoder().decode(
+            PluginAction.self,
+            from: Data(
+                """
+                {"id":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb","operation":"sendMessage","chat":"user:42","text":"hello"}
+                """.utf8))
+        let executor = PluginActionExecutor()
+        let adapter = HoldingAdapter()
+        let owner = PluginActionExecutor.Owner(plugin: "test", account: "77", generation: "current")
+        var results = 0
+        executor.authorized = { _ in true }
+        executor.deliver = { _, _ in results += 1 }
+        executor.register(account: "77", adapter: adapter)
+        executor.submit([action], owner: owner, directory: root)
+        executor.queue.sync {}
+        let first = executor.queue.sync { adapter.completions[0] }
+        executor.cancel(owner: owner)
+        executor.queue.sync {}
+        executor.submit([action], owner: owner, directory: root)
+        executor.queue.sync {}
+        first(.init(id: action.id, status: "completed"))
+        executor.queue.sync {}
+        CheckCore.require(executor.queue.sync { results } == 1, "late completion cannot finish reused action ID")
+        let second = executor.queue.sync { adapter.completions[1] }
+        second(.init(id: action.id, status: "completed"))
+        executor.queue.sync {}
+        CheckCore.require(executor.queue.sync { results } == 2, "replacement action completes once")
+        CheckCore.require(executor.queue.sync { adapter.cancellations } == 2, "cancellation disposes adapters")
+    }
+
+    private final class HoldingAdapter: PluginActionAdapter {
+        var completions: [(PluginActionResult) -> Void] = []
+        var cancellations = 0
+        func execute(
+            _ action: PluginAction, directory: URL, progress: @escaping (Double) -> Void,
+            completion: @escaping (PluginActionResult) -> Void
+        ) -> () -> Void {
+            completions.append(completion)
+            return { self.cancellations += 1 }
+        }
+    }
+
+    private final class Adapter: PluginActionAdapter {
+        var calls = 0
+        func execute(
+            _ action: PluginAction, directory: URL, progress: @escaping (Double) -> Void,
+            completion: @escaping (PluginActionResult) -> Void
+        ) -> () -> Void {
+            calls += 1
+            completion(.init(id: action.id, status: "completed"))
+            return {}
+        }
+    }
+}
