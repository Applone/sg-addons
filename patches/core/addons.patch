+"""Behavioral checks for the bundled Python SDK and import contract."""
+
+from __future__ import annotations
+
+import json
+import sys
+import unittest
+
+from _swiftgram_runtime import handle, metadata
+
+HEADER = '# /// script\n# id = "python-test"\n# name = "Python test"\n# ///\n'
+
+
+class RuntimeTests(unittest.TestCase):
+    def call(self, operation: str, **values: object) -> dict[str, object]:
+        reply: dict[str, object] = json.loads(
+            handle(
+                json.dumps(
+                    {
+                        "operation": operation,
+                        "id": "python-test",
+                        "account": "77",
+                        **values,
+                    }
+                )
+            )
+        )
+        return reply
+
+    def tearDown(self) -> None:
+        self.call("unload")
+
+    def test_inspection_never_executes_plugin_code(self) -> None:
+        source = HEADER + 'raise RuntimeError("must not execute")\n'
+        self.assertEqual(metadata(source)["id"], "python-test")
+
+    def test_only_python_metadata_is_accepted(self) -> None:
+        for source in ("{}", "[]", '{"id":"json-plugin","name":"JSON","rules":[]}'):
+            with self.subTest(source=source), self.assertRaisesRegex(ValueError, "Python plugins"):
+                metadata(source)
+            response = self.call("load", source=source, settings={})
+            self.assertIn("Python plugins", str(response.get("failure")))
+
+    def test_registrations_use_python_callbacks(self) -> None:
+        result = metadata(HEADER + "__hooks__ = [{'event': 'sendMessage', 'name': 'send_message'}]")
+        self.assertEqual(
+            result["hooks"],
+            [{"event": "sendMessage", "name": "send_message", "callback": "on_send_message"}],
+        )
+        for declaration in (
+            "__hooks__ = [{'event':'message','name':'message','strategy':'cancel'}]",
+            "__hooks__ = [{'event':'message','name':'message','condition':{}}]",
+            "__menus__ = [{'id':'copy','text':'${text}'}]",
+        ):
+            with (
+                self.subTest(declaration=declaration),
+                self.assertRaisesRegex(ValueError, "Python callbacks"),
+            ):
+                metadata(HEADER + declaration)
+
+    def test_dependency_declarations_rejected_before_evaluation(self) -> None:
+        for name in ("__requirements__", "__dependencies__", "requirements", "dependencies"):
+            for declaration in (
+                f"{name} = []",
+                f"{name}: list[str] = []",
+                f"{name} += []",
+                f"{name} = unexpected_network_request()",
+            ):
+                with (
+                    self.subTest(declaration=declaration),
+                    self.assertRaisesRegex(ValueError, "PEP 723"),
+                ):
+                    metadata(HEADER + declaration)
+
+    def test_pep723_metadata_and_types(self) -> None:
+        source = HEADER.replace("# id =", '# dependencies = ["requests>=2"]\n# id =')
+        self.assertEqual(metadata(source)["dependencies"], ["requests>=2"])
+        for declaration in (
+            'dependencies = "requests"',
+            "requires-python = 314",
+            "id = 17",
+            'unknown = "x"',
+        ):
+            with self.subTest(declaration=declaration), self.assertRaises(ValueError):
+                metadata(HEADER.replace("# ///\n", f"# {declaration}\n# ///\n"))
+        with self.assertRaisesRegex(ValueError, "exactly one"):
+            metadata(HEADER + HEADER)
+        with self.assertRaisesRegex(ValueError, "Unclosed"):
+            metadata(HEADER.removesuffix("# ///\n"))
+        # A script marker inside a string is not a metadata comment.
+        self.assertEqual(metadata(HEADER + 'description = "# /// script"')["id"], "python-test")
+
+    def test_restored_sources_are_validated_before_execution(self) -> None:
+        response = self.call("load", source=HEADER + '__requirements__ = ["requests"]', settings={})
+        self.assertIn("PEP 723", str(response.get("failure")))
+
+    def test_missing_import_fails_without_installing_or_changing_search_paths(self) -> None:
+        source = HEADER + "\nimport swiftgram_missing_third_party_package_987654321\n"
+        paths = sys.path.copy()
+        response = self.call("load", source=source, settings={})
+        self.assertIn("ModuleNotFoundError", str(response.get("failure")))
+        self.assertEqual(sys.path, paths)
+
+    def test_real_python_and_bundled_sdk(self) -> None:
+        source = (
+            HEADER
+            + """
+import math
+from swiftgram import BasePlugin, HookResult, HookStrategy
+class Plugin(BasePlugin):
+    def on_plugin_load(self):
+        self.calls = 0
+    def on_message(self, event):
+        self.calls += 1
+        total = sum(math.factorial(number) for number in range(5))
+        return HookResult(HookStrategy.MODIFY, text=f"{event.text}:{total}:{self.calls}")
+"""
+        )
+        event = {"kind": "message", "name": "message", "account": "77", "text": "hello"}
+        first = self.call("hook", source=source, settings={}, event=event, callback="on_message")
+        second = self.call("hook", source=source, settings={}, event=event, callback="on_message")
+        self.assertEqual(
+            first["result"],
+            {"strategy": "modify", "text": "hello:34:1", "error": None, "settings": {}},
+        )
+        self.assertEqual(
+            second["result"],
+            {"strategy": "modify", "text": "hello:34:2", "error": None, "settings": {}},
+        )
+        self.call("unload")
+        reloaded = self.call("hook", source=source, settings={}, event=event, callback="on_message")
+        self.assertEqual(first, reloaded)
+
+    def test_exception_and_infinite_loop_return_failures(self) -> None:
+        for body, message in (
+            ("raise RuntimeError('failed')", "RuntimeError: failed"),
+            ("while True: pass", "TimeoutError"),
+        ):
+            source = (
+                HEADER
+                + "\nfrom swiftgram import BasePlugin\nclass Plugin(BasePlugin):\n"
+                + f"    def on_plugin_load(self):\n        {body}\n"
+            )
+            reply = self.call("load", source=source, settings={})
+            self.assertIn(message, str(reply.get("failure")))
+
+
+if __name__ == "__main__":
+    unittest.main()
