diff --git a/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalPluginActions.swift b/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalPluginActions.swift
new file mode 100644
index 00000000..24d3c2ac
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalPluginActions.swift
@@ -0,0 +1,328 @@
+import AVFoundation
+import Foundation
+import ImageIO
+import Postbox
+import SGAdditionalCore
+import SwiftSignalKit
+import UIKit
+
+private let pluginOrigins = Atomic<(Set<Int64>, Set<MessageId>)>(value: ([], []))
+
+func additionalPluginCorrelation() -> Int64 {
+    let value = Int64.random(in: Int64.min ... -1)
+    _ = pluginOrigins.modify { current in
+        var current = current
+        current.0.insert(value)
+        return current
+    }
+    return value
+}
+
+func additionalPluginIsOrigin(_ correlation: Int64?) -> Bool {
+    guard let correlation else { return false }
+    return pluginOrigins.with { $0.0.contains(correlation) }
+}
+
+public func additionalPluginIsOrigin(_ message: MessageId) -> Bool {
+    pluginOrigins.with { $0.1.contains(message) }
+}
+
+private func pluginPeer(_ chat: String) -> PeerId? {
+    let parts = chat.split(separator: ":")
+    guard parts.count == 2, let value = Int64(parts[1]), value > 0 else { return nil }
+    let namespace: Int32
+    switch parts[0] {
+    case "user": namespace = Namespaces.Peer.CloudUser
+    case "chat": namespace = Namespaces.Peer.CloudGroup
+    case "channel": namespace = Namespaces.Peer.CloudChannel
+    default: return nil
+    }
+    return PeerId(namespace: namespace, id: ._internalFromInt64Value(value))
+}
+
+public func additionalPluginSnapshot(
+    id: Int32?, sender: PeerId?, timestamp: Int32?, thread: Int64?, text: String, attributes: [MessageAttribute],
+    media: [Media]
+) -> PluginMessage {
+    let entities = additionalRevision(text: text, timestamp: timestamp ?? 0, attributes: attributes).entities.compactMap
+    { entity -> PluginTextEntity? in
+        let kind = String(entity.kind.dropFirst("messageEntity".count))
+        guard ["Bold", "Italic", "Underline", "Strike", "Spoiler", "Code", "Pre", "TextUrl"].contains(kind) else {
+            return nil
+        }
+        return PluginTextEntity(kind: kind, offset: entity.offset, length: entity.length, value: entity.value)
+    }
+    let attachments = media.enumerated().compactMap { index, value -> PluginAttachment? in
+        if let file = value as? TelegramMediaFile {
+            return PluginAttachment(
+                id: String(index), kind: file.isVideo ? "video" : "document", filename: file.fileName,
+                mimeType: file.mimeType, size: file.size)
+        }
+        if value is TelegramMediaImage { return PluginAttachment(id: String(index), kind: "photo") }
+        return nil
+    }
+    let reply = attributes.compactMap { ($0 as? ReplyMessageAttribute)?.messageId.id }.first
+    return PluginMessage(
+        id: id, sender: sender.flatMap(additionalChatKey), timestamp: timestamp, replyTo: reply, threadID: thread,
+        text: text, entities: entities, attachments: attachments)
+}
+
+final class AdditionalPluginActionAdapter: PluginActionAdapter {
+    private weak var account: Account?
+    init(account: Account) { self.account = account }
+
+    func execute(
+        _ action: PluginAction, directory: URL, progress: @escaping (Double) -> Void,
+        completion: @escaping (PluginActionResult) -> Void
+    ) -> () -> Void {
+        guard let account, let peer = pluginPeer(action.chat ?? "") else {
+            completion(.init(id: action.id, status: "failed", error: "unavailableTarget"))
+            return {}
+        }
+        let disposables = DisposableSet()
+        let cancelled = Atomic<Bool>(value: false)
+        let fail: (String) -> Void = { completion(.init(id: action.id, status: "failed", error: $0)) }
+        let messageID = MessageId(peerId: peer, namespace: Namespaces.Message.Cloud, id: action.messageID ?? 0)
+        if action.operation == "sendMessage" || action.operation == "sendMedia" {
+            do {
+                let media: AnyMediaReference?
+                if action.operation == "sendMedia" {
+                    media = try upload(action, account: account, directory: directory)
+                } else {
+                    media = nil
+                }
+                let attributes: [MessageAttribute] = [TextEntitiesMessageAttribute(entities: textEntities(action))]
+                let reply = action.replyTo.map {
+                    EngineMessageReplySubject(
+                        messageId: MessageId(peerId: peer, namespace: Namespaces.Message.Cloud, id: $0), quote: nil,
+                        innerSubject: nil)
+                }
+                let correlation = additionalPluginCorrelation()
+                let message = EnqueueMessage.message(
+                    text: action.text ?? "", attributes: attributes, inlineStickers: [:], mediaReference: media,
+                    threadId: action.threadID, replyToMessageId: reply, replyToStoryId: nil, localGroupingKey: nil,
+                    correlationId: correlation, bubbleUpEmojiOrStickersets: nil)
+                disposables.add(
+                    enqueueMessages(account: account, peerId: peer, messages: [message]).start(next: { ids in
+                        let localIDs = ids.compactMap { $0 }
+                        _ = pluginOrigins.modify { current in
+                            var current = current
+                            current.1.formUnion(localIDs)
+                            return current
+                        }
+                        completion(.init(id: action.id, status: "accepted", messageIDs: localIDs.map { $0.id }))
+                        guard let localID = localIDs.first else {
+                            fail("unavailableTarget")
+                            return
+                        }
+                        disposables.add(
+                            account.pendingMessageManager.pendingMessageStatus(localID).start(next: { status, failure in
+                                if failure != nil {
+                                    fail("telegramRestriction")
+                                } else if let status {
+                                    progress(Double(status.progress.progress))
+                                } else if let sent = account.pendingMessageManager.synchronouslyLookupCorrelationId(
+                                    correlationId: correlation)
+                                {
+                                    _ = pluginOrigins.modify { current in
+                                        var current = current
+                                        current.1.insert(sent)
+                                        return current
+                                    }
+                                    completion(.init(id: action.id, status: "completed", messageIDs: [sent.id]))
+                                }
+                            }))
+                    }))
+            } catch { fail("invalidContent") }
+        } else {
+            disposables.add(
+                TelegramEngine(account: account).messages.downloadMessage(messageId: messageID).start(next: {
+                    [weak self] value in
+                    guard let self, let message = value?._asMessage() else {
+                        fail("unavailableTarget")
+                        return
+                    }
+                    switch action.operation {
+                    case "getMessage":
+                        completion(
+                            .init(
+                                id: action.id, status: "completed",
+                                message: additionalPluginSnapshot(
+                                    id: message.id.id, sender: message.author?.id, timestamp: message.timestamp,
+                                    thread: message.threadId, text: message.text, attributes: message.attributes,
+                                    media: message.media)))
+                    case "editMessage":
+                        guard message.author?.id == account.peerId else {
+                            fail("permissionDenied")
+                            return
+                        }
+                        disposables.add(
+                            TelegramEngine(account: account).messages.requestEditMessage(
+                                messageId: messageID, text: action.text ?? "", media: .keep,
+                                entities: TextEntitiesMessageAttribute(entities: self.textEntities(action)),
+                                richText: nil, inlineStickers: [:]
+                            ).start(
+                                next: { result in
+                                    switch result {
+                                    case .progress(let value): progress(Double(value))
+                                    case .done(let success):
+                                        if success {
+                                            completion(.init(id: action.id, status: "completed"))
+                                        } else {
+                                            fail("telegramRestriction")
+                                        }
+                                    }
+                                }, error: { _ in fail("telegramRestriction") }))
+                    case "downloadMedia":
+                        self.download(
+                            action, message: message, account: account, directory: directory, disposables: disposables,
+                            cancelled: cancelled,
+                            progress: progress, completion: completion)
+                    default: fail("invalidContent")
+                    }
+                }))
+        }
+        return {
+            _ = cancelled.swap(true)
+            disposables.dispose()
+        }
+    }
+
+    private func textEntities(_ action: PluginAction) -> [MessageTextEntity] {
+        let revision = MessageRevision(
+            text: action.text ?? "",
+            entities: (action.entities ?? []).map {
+                RevisionEntity(kind: "messageEntity" + $0.kind, offset: $0.offset, length: $0.length, value: $0.value)
+            }, messageDate: 0, editDate: nil)
+        return additionalTextEntities(revision)
+    }
+
+    private func upload(_ action: PluginAction, account: Account, directory: URL) throws -> AnyMediaReference {
+        let snapshot = try PluginFiles.snapshot(path: action.path ?? "", directory: directory)
+        defer { try? FileManager.default.removeItem(at: snapshot) }
+        let resource = LocalFileMediaResource(fileId: Int64.random(in: 1...Int64.max))
+        var data = try Data(contentsOf: snapshot, options: .mappedIfSafe)
+        if action.mediaKind == "photo" {
+            guard let source = CGImageSourceCreateWithData(data as CFData, nil),
+                let properties = CGImageSourceCopyPropertiesAtIndex(source, 0, nil) as? [CFString: Any],
+                let width = properties[kCGImagePropertyPixelWidth] as? Int,
+                let height = properties[kCGImagePropertyPixelHeight] as? Int,
+                width > 0, height > 0, width <= 10000, height <= 10000, width * height <= 40_000_000,
+                let image = UIImage(data: data), let jpeg = image.jpegData(compressionQuality: 0.9)
+            else { throw SettingsError.invalid("Invalid photo.") }
+            data = jpeg
+            account.postbox.mediaBox.storeResourceData(resource.id, data: data)
+            return .standalone(
+                media: TelegramMediaImage(
+                    imageId: MediaId(namespace: Namespaces.Media.LocalImage, id: resource.fileId),
+                    representations: [
+                        TelegramMediaImageRepresentation(
+                            dimensions: PixelDimensions(width: Int32(width), height: Int32(height)), resource: resource,
+                            progressiveSizes: [], immediateThumbnailData: nil, hasVideo: false, isPersonal: false)
+                    ], immediateThumbnailData: nil, reference: nil, partialReference: nil, flags: []))
+        }
+        var attributes: [TelegramMediaFileAttribute] = [
+            .FileName(fileName: URL(fileURLWithPath: action.path ?? "file").lastPathComponent)
+        ]
+        var mimeType = "application/octet-stream"
+        if action.mediaKind == "video" {
+            let asset = AVURLAsset(url: snapshot)
+            guard let track = asset.tracks(withMediaType: .video).first, asset.duration.seconds.isFinite,
+                asset.duration.seconds > 0
+            else { throw SettingsError.invalid("Invalid video.") }
+            let size = track.naturalSize.applying(track.preferredTransform)
+            guard abs(size.width) <= 10000, abs(size.height) <= 10000 else {
+                throw SettingsError.invalid("Invalid video size.")
+            }
+            attributes.append(
+                .Video(
+                    duration: asset.duration.seconds,
+                    size: PixelDimensions(width: Int32(abs(size.width)), height: Int32(abs(size.height))), flags: [],
+                    preloadSize: nil, coverTime: nil, videoCodec: nil))
+            mimeType = "video/mp4"
+        }
+        account.postbox.mediaBox.storeResourceData(resource.id, data: data)
+        return .standalone(
+            media: TelegramMediaFile(
+                fileId: MediaId(namespace: Namespaces.Media.LocalFile, id: resource.fileId), partialReference: nil,
+                resource: resource,
+                previewRepresentations: [], videoThumbnails: [], immediateThumbnailData: nil, mimeType: mimeType,
+                size: Int64(data.count), attributes: attributes, alternativeRepresentations: []))
+    }
+
+    private func download(
+        _ action: PluginAction, message: Message, account: Account, directory: URL, disposables: DisposableSet,
+        cancelled: Atomic<Bool>,
+        progress: @escaping (Double) -> Void, completion: @escaping (PluginActionResult) -> Void
+    ) {
+        let fail: (String) -> Void = { completion(.init(id: action.id, status: "failed", error: $0)) }
+        guard !message.flags.contains(.CopyProtected), !message.containsSecretMedia,
+            !message.attributes.contains(where: {
+                $0 is AutoremoveTimeoutMessageAttribute || $0 is AutoclearTimeoutMessageAttribute
+            }),
+            message.peers[message.id.peerId]?.isCopyProtectionEnabled != true,
+            let index = Int(action.attachmentID ?? ""), message.media.indices.contains(index)
+        else {
+            fail("permissionDenied")
+            return
+        }
+        let media = message.media[index]
+        let resource: MediaResource
+        if let file = media as? TelegramMediaFile {
+            guard let size = file.size, size <= PluginFiles.maximumFileSize else {
+                fail("quotaExceeded")
+                return
+            }
+            resource = file.resource
+        } else if let image = media as? TelegramMediaImage,
+            let representation = image.representations.max(by: { $0.dimensions.width < $1.dimensions.width })
+        {
+            resource = representation.resource
+        } else {
+            fail("invalidContent")
+            return
+        }
+        disposables.add(
+            (account.postbox.transaction { transaction -> Bool in
+                guard let cached = transaction.getPeerCachedData(peerId: message.id.peerId) as? CachedUserData else {
+                    return true
+                }
+                return !cached.flags.contains(.copyProtectionEnabled)
+                    && !cached.flags.contains(.myCopyProtectionEnabled)
+            }).start(next: { allowed in
+                guard allowed else {
+                    fail("permissionDenied")
+                    return
+                }
+                let reference = MediaResourceReference.media(
+                    media: .message(message: MessageReference(message), media: media), resource: resource)
+                disposables.add(
+                    fetchedMediaResource(
+                        mediaBox: account.postbox.mediaBox, userLocation: .peer(message.id.peerId),
+                        userContentType: .other, reference: reference
+                    ).start(error: { _ in fail("unavailableTarget") }))
+                disposables.add(
+                    account.postbox.mediaBox.resourceStatus(resource).start(next: { status in
+                        if case .Fetching(_, let value) = status { progress(Double(value)) }
+                    }))
+                disposables.add(
+                    (account.postbox.mediaBox.resourceData(resource)).start(next: {
+                        data in
+                        guard data.size <= PluginFiles.maximumFileSize else {
+                            fail("quotaExceeded")
+                            return
+                        }
+                        guard data.complete, !cancelled.with({ $0 }) else { return }
+                        do {
+                            let path = try PluginFiles.importDownload(
+                                source: URL(fileURLWithPath: data.path), directory: directory)
+                            if cancelled.with({ $0 }) {
+                                try? FileManager.default.removeItem(at: path)
+                                return
+                            }
+                            completion(.init(id: action.id, status: "completed", path: path.path))
+                        } catch { fail("quotaExceeded") }
+                    }))
+            }))
+    }
+}
