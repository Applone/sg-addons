@@ -0,0 +1,453 @@
+"""PyPI-only resolution and immutable wheel environments; never executes package code."""
+
+from __future__ import annotations
+
+import hashlib
+import io
+import json
+import re
+import shutil
+import ssl
+import sys
+import time
+import uuid
+import zipfile
+from collections.abc import Iterable, Iterator, Mapping, Sequence
+from dataclasses import dataclass, replace
+from email.parser import BytesParser
+from pathlib import Path, PurePosixPath
+from typing import Any, cast
+from urllib.parse import urlsplit
+from urllib.request import Request, urlopen
+
+from packaging.markers import default_environment
+from packaging.requirements import Requirement
+from packaging.specifiers import SpecifierSet
+from packaging.tags import Tag, parse_tag
+from packaging.utils import canonicalize_name, parse_wheel_filename
+from packaging.version import Version
+from resolvelib import BaseReporter, Resolver
+from resolvelib.providers import AbstractProvider
+from resolvelib.structs import RequirementInformation
+
+_bundle = Path(__file__).parent
+
+MAX_WHEEL = 32 * 1024 * 1024
+MAX_EXPANDED = 128 * 1024 * 1024
+MAX_PACKAGES = 64
+_plans: dict[str, Plan] = {}
+
+
+def environment() -> dict[str, str]:
+    """Use the embedded runtime's marker values, never the build machine's values."""
+    values = {key: str(value) for key, value in default_environment().items()}
+    if sys.platform == "ios":
+        values.update(sys_platform="ios", platform_system="iOS", os_name="posix")
+    return values
+
+
+def requirement(value: str) -> Requirement:
+    result = Requirement(value)
+    if result.url:
+        raise ValueError("Only named PyPI dependencies are supported; direct URLs are disabled")
+    return result
+
+
+def active(item: Requirement, extras: Iterable[str] = ("",)) -> bool:
+    return item.marker is None or any(
+        item.marker.evaluate({**environment(), "extra": extra}) for extra in extras
+    )
+
+
+def validate_script(dependencies: list[str], requires_python: str) -> None:
+    current = environment()["python_full_version"]
+    if not SpecifierSet(requires_python).contains(current, prereleases=True):
+        raise ValueError(f"Plugin requires Python {requires_python}; this runtime is {current}")
+    for value in dependencies:
+        requirement(value)
+
+
+def fetch(url: str, limit: int, *, index: bool = False) -> bytes:
+    allowed = "pypi.org" if index else "files.pythonhosted.org"
+    parsed = urlsplit(url)
+    if parsed.scheme != "https" or parsed.netloc != allowed:
+        raise ValueError("Package downloads must use the official PyPI HTTPS hosts")
+    certificates = _bundle / "cacert.pem"
+    if not certificates.exists():
+        import certifi
+
+        certificates = Path(certifi.where())
+    context = ssl.create_default_context(cafile=str(certificates))
+    request = Request(url, headers={"Accept": "application/vnd.pypi.simple.v1+json"})
+    with urlopen(request, timeout=15, context=context) as response:
+        if urlsplit(response.url).netloc != allowed:
+            raise ValueError("Unexpected package download redirect")
+        data = response.read(limit + 1)
+    if len(data) > limit:
+        raise ValueError("Package response exceeds its size limit")
+    return cast(bytes, data)
+
+
+def digest(data: bytes, expected: str) -> None:
+    if not re.fullmatch(r"[a-f0-9]{64}", expected) or hashlib.sha256(data).hexdigest() != expected:
+        raise ValueError("Package SHA-256 verification failed")
+
+
+@dataclass(frozen=True)
+class Candidate:
+    name: str
+    version: Version
+    filename: str
+    url: str
+    sha256: str
+    metadata_hash: str | None = None
+    extras: frozenset[str] = frozenset()
+
+    def display(self, direct: set[str]) -> dict[str, object]:
+        return {
+            "name": self.name,
+            "version": str(self.version),
+            "filename": self.filename,
+            "sha256": self.sha256,
+            "url": self.url,
+            "direct": self.name in direct,
+        }
+
+
+class Provider(AbstractProvider[Requirement, Candidate, str]):
+    def __init__(self) -> None:
+        self.projects: dict[str, list[Candidate]] = {}
+        self.metadata: dict[Candidate, bytes] = {}
+        self.downloads: dict[Candidate, bytes] = {}
+        self.started = time.monotonic()
+        self.downloaded = 0
+
+    def check_budget(self) -> None:
+        if time.monotonic() - self.started > 90:
+            raise ValueError(
+                "Dependency operation exceeded 90 seconds; retry with tighter constraints"
+            )
+
+    def read(self, url: str, limit: int, *, index: bool = False) -> bytes:
+        self.check_budget()
+        data = fetch(url, limit, index=index)
+        self.downloaded += len(data)
+        if self.downloaded > MAX_EXPANDED:
+            raise ValueError("Dependency download budget exceeds 128 MB")
+        return data
+
+    def identify(self, requirement_or_candidate: Requirement | Candidate) -> str:
+        return str(canonicalize_name(requirement_or_candidate.name))
+
+    def get_preference(
+        self,
+        identifier: str,
+        resolutions: Mapping[str, Candidate],
+        candidates: Mapping[str, Iterator[Candidate]],
+        information: Mapping[str, Iterator[RequirementInformation[Requirement, Candidate]]],
+        backtrack_causes: Sequence[RequirementInformation[Requirement, Candidate]],
+    ) -> str:
+        return identifier
+
+    def versions(self, name: str) -> list[Candidate]:
+        if name in self.projects:
+            return self.projects[name]
+        if len(self.projects) >= MAX_PACKAGES:
+            raise ValueError("Dependency graph exceeds 64 projects")
+        response = json.loads(self.read(f"https://pypi.org/simple/{name}/", MAX_WHEEL, index=True))
+        if str(response.get("meta", {}).get("api-version", "1.0")).split(".")[0] != "1":
+            raise ValueError("Unsupported PyPI index API version")
+        candidates: list[Candidate] = []
+        for file in response["files"]:
+            if file.get("yanked") or not file["filename"].endswith(".whl"):
+                continue
+            try:
+                project, version, _, tags = parse_wheel_filename(file["filename"])
+            except ValueError:
+                continue
+            if project != name or not any(
+                tag.abi == "none" and tag.platform == "any" and tag in self.tags() for tag in tags
+            ):
+                continue
+            if not SpecifierSet(file.get("requires-python") or "").contains(
+                environment()["python_full_version"], prereleases=True
+            ):
+                continue
+            core = file.get("core-metadata", file.get("dist-info-metadata"))
+            candidates.append(
+                Candidate(
+                    name,
+                    version,
+                    file["filename"],
+                    file["url"],
+                    file.get("hashes", {}).get("sha256", ""),
+                    core.get("sha256") if isinstance(core, dict) else None,
+                )
+            )
+        candidates.sort(key=lambda item: (item.version, item.filename), reverse=True)
+        self.projects[name] = candidates
+        return candidates
+
+    @staticmethod
+    def tags() -> set[Tag]:
+        major, minor = sys.version_info[:2]
+        return {Tag(f"py{major}", "none", "any")} | {
+            Tag(f"py{major}{value}", "none", "any") for value in range(minor + 1)
+        }
+
+    def find_matches(
+        self,
+        identifier: str,
+        requirements: Mapping[str, Iterator[Requirement]],
+        incompatibilities: Mapping[str, Iterator[Candidate]],
+    ) -> Iterable[Candidate]:
+        self.check_budget()
+        constraints = list(requirements[identifier])
+        excluded = set(incompatibilities[identifier])
+        extras = frozenset(
+            str(canonicalize_name(extra)) for item in constraints for extra in item.extras
+        )
+        for candidate in self.versions(identifier):
+            candidate = replace(candidate, extras=extras)
+            if candidate not in excluded and all(
+                self.is_satisfied_by(item, candidate) for item in constraints
+            ):
+                yield candidate
+
+    def is_satisfied_by(self, requirement: Requirement, candidate: Candidate) -> bool:
+        return (
+            self.identify(requirement) == candidate.name
+            and {str(canonicalize_name(extra)) for extra in requirement.extras} <= candidate.extras
+            and requirement.specifier.contains(candidate.version)
+        )
+
+    def wheel(self, candidate: Candidate) -> bytes:
+        base = replace(candidate, extras=frozenset())
+        if base not in self.downloads:
+            data = self.read(candidate.url, MAX_WHEEL)
+            digest(data, candidate.sha256)
+            self.downloads[base] = data
+        return self.downloads[base]
+
+    def core(self, candidate: Candidate) -> bytes:
+        base = replace(candidate, extras=frozenset())
+        if base not in self.metadata:
+            if candidate.metadata_hash:
+                data = self.read(candidate.url + ".metadata", 1024 * 1024)
+                digest(data, candidate.metadata_hash)
+            else:
+                data = wheel_metadata(self.wheel(candidate))
+            message = BytesParser().parsebytes(data)
+            if (
+                canonicalize_name(message["Name"] or "") != candidate.name
+                or Version(message["Version"] or "") != candidate.version
+            ):
+                raise ValueError("Wheel metadata identity does not match the selected package")
+            if not SpecifierSet(message["Requires-Python"] or "").contains(
+                environment()["python_full_version"], prereleases=True
+            ):
+                raise ValueError("Wheel metadata requires an incompatible Python version")
+            self.metadata[base] = data
+        return self.metadata[base]
+
+    def get_dependencies(self, candidate: Candidate) -> Iterable[Requirement]:
+        message = BytesParser().parsebytes(self.core(candidate))
+        available = {
+            str(canonicalize_name(extra)) for extra in message.get_all("Provides-Extra", [])
+        }
+        if not candidate.extras <= available:
+            raise ValueError(
+                f"Unknown extras for {candidate.name}: {sorted(candidate.extras - available)}"
+            )
+        for value in message.get_all("Requires-Dist", []):
+            item = requirement(value)
+            if active(item, ("", *candidate.extras)):
+                yield item
+
+
+def wheel_metadata(data: bytes) -> bytes:
+    with zipfile.ZipFile(io.BytesIO(data)) as archive:
+        files = [
+            item
+            for item in archive.infolist()
+            if item.filename.count("/") == 1 and item.filename.endswith(".dist-info/METADATA")
+        ]
+        if len(files) != 1 or files[0].file_size > 1024 * 1024:
+            raise ValueError("Wheel must contain exactly one bounded METADATA file")
+        return archive.read(files[0])
+
+
+def extract(data: bytes, destination: Path, occupied: set[str]) -> int:
+    total = 0
+    with zipfile.ZipFile(io.BytesIO(data)) as archive:
+        wheels = [
+            item
+            for item in archive.infolist()
+            if item.filename.count("/") == 1 and item.filename.endswith(".dist-info/WHEEL")
+        ]
+        if len(wheels) != 1 or wheels[0].file_size > 65536:
+            raise ValueError("Wheel must contain exactly one bounded WHEEL description")
+        wheel = BytesParser().parsebytes(archive.read(wheels[0]))
+        tags = {tag for value in wheel.get_all("Tag", []) for tag in parse_tag(value)}
+        if (
+            wheel["Root-Is-Purelib"] != "true"
+            or wheel["Wheel-Version"] != "1.0"
+            or not tags
+            or not tags <= Provider.tags()
+        ):
+            raise ValueError("Only compatible pure Python wheels are supported")
+        for item in archive.infolist():
+            path = PurePosixPath(item.filename)
+            mode = (item.external_attr >> 16) & 0o170000
+            if (
+                path.is_absolute()
+                or ".." in path.parts
+                or "\\" in item.filename
+                or mode not in (0, 0o100000, 0o040000)
+            ):
+                raise ValueError("Unsafe wheel member")
+            if item.is_dir():
+                continue
+            parts = list(path.parts)
+            if not parts:
+                raise ValueError("Empty wheel member")
+            if parts[0].endswith(".data"):
+                if len(parts) < 3 or parts[1] not in ("purelib", "platlib"):
+                    raise ValueError(
+                        "Wheel scripts, headers and external data are unsupported on iOS"
+                    )
+                parts = parts[2:]
+            top = parts[0].split(".")[0].casefold()
+            if top in sys.stdlib_module_names or top in {
+                "swiftgram",
+                "_swiftgram_runtime",
+                "_swiftgram_dependencies",
+                "sitecustomize",
+                "usercustomize",
+            }:
+                raise ValueError("Dependency attempts to replace the standard library or host SDK")
+            if parts[0].casefold().startswith(".swiftgram"):
+                raise ValueError("Reserved dependency lock path")
+            if path.suffix.lower() in {".pth", ".so", ".dylib", ".dll", ".pyd", ".fwork"}:
+                raise ValueError("Native extensions and .pth import hooks are unsupported")
+            relative = "/".join(parts)
+            collision = relative.casefold()
+            if collision in occupied:
+                raise ValueError(f"Dependency file collision: {relative}")
+            occupied.add(collision)
+            total += item.file_size
+            if total > MAX_EXPANDED:
+                raise ValueError("Expanded wheel exceeds 128 MB")
+            target = destination.joinpath(*parts)
+            target.parent.mkdir(parents=True, exist_ok=True)
+            with archive.open(item) as source, target.open("xb") as output:
+                shutil.copyfileobj(source, output)
+    return total
+
+
+@dataclass
+class Plan:
+    source: str
+    root: str
+    provider: Provider
+    candidates: list[Candidate]
+    dependencies: list[dict[str, object]]
+    created: float
+
+
+def manage(request: dict[str, Any]) -> dict[str, object]:
+    operation = request["operation"]
+    if operation == "resolve":
+        from _swiftgram_runtime import metadata
+
+        info = metadata(request["source"])
+        roots = [requirement(value) for value in cast(list[str], info["dependencies"])]
+        roots = [item for item in roots if active(item)]
+        provider = Provider()
+        result = Resolver(provider, BaseReporter()).resolve(roots, max_rounds=1000)
+        candidates = sorted(result.mapping.values(), key=lambda item: item.name)
+        direct = {str(canonicalize_name(item.name)) for item in roots}
+        dependencies = [item.display(direct) for item in candidates]
+        # Reviews are memory-only, bounded and expiring. No plugin code is imported.
+        for token, pending in list(_plans.items()):
+            if time.monotonic() - pending.created > 1800:
+                _plans.pop(token)
+        selected = {replace(item, extras=frozenset()) for item in candidates}
+        provider.downloads = {
+            key: value for key, value in provider.downloads.items() if key in selected
+        }
+        provider.metadata = {
+            key: value for key, value in provider.metadata.items() if key in selected
+        }
+        provider.projects.clear()
+        cached = sum(len(value) for value in provider.downloads.values()) + sum(
+            len(value)
+            for pending in _plans.values()
+            for value in pending.provider.downloads.values()
+        )
+        if len(_plans) >= 4 or cached > MAX_EXPANDED:
+            raise ValueError("Too many pending plugin reviews; close an earlier review")
+        token = uuid.uuid4().hex
+        _plans[token] = Plan(
+            request["source"], request["root"], provider, candidates, dependencies, time.monotonic()
+        )
+        return {"token": token, "dependencies": dependencies}
+    if operation == "discard":
+        _plans.pop(request["token"], None)
+        return {}
+    if operation == "verify":
+        verify(Path(request["dependencyPath"]), request["dependencies"])
+        return {}
+    plan = _plans.pop(request["token"], None)
+    if (
+        plan is None
+        or time.monotonic() - plan.created > 1800
+        or plan.root != request["root"]
+        or plan.source != request.get("source")
+        or plan.dependencies != request.get("dependencies")
+    ):
+        raise ValueError("Plugin review expired; import and review it again")
+    identifier = uuid.uuid4().hex
+    root = Path(plan.root)
+    root.mkdir(parents=True, exist_ok=True)
+    stage = root / (".staging-" + identifier)
+    final = root / identifier
+    stage.mkdir()
+    try:
+        occupied: set[str] = set()
+        total = 0
+        plan.provider.started = time.monotonic()
+        for candidate in plan.candidates:
+            data = plan.provider.wheel(candidate)
+            if wheel_metadata(data) != plan.provider.core(candidate):
+                raise ValueError("Wheel metadata changed since dependency review")
+            total += extract(data, stage, occupied)
+            if total > MAX_EXPANDED:
+                raise ValueError("Expanded dependency environment exceeds 128 MB")
+        files = {
+            str(file.relative_to(stage)): hashlib.sha256(file.read_bytes()).hexdigest()
+            for file in sorted(stage.rglob("*"))
+            if file.is_file()
+        }
+        (stage / ".swiftgram-lock.json").write_text(
+            json.dumps({"dependencies": plan.dependencies, "files": files}, sort_keys=True)
+        )
+        stage.rename(final)
+        return {"environment": identifier, "dependencies": plan.dependencies}
+    except BaseException:
+        shutil.rmtree(stage, ignore_errors=True)
+        raise
+
+
+def verify(directory: Path, dependencies: list[dict[str, object]]) -> None:
+    lock = json.loads((directory / ".swiftgram-lock.json").read_text())
+    if lock["dependencies"] != dependencies:
+        raise ValueError("Installed dependencies differ from the approved lock")
+    for relative, expected in lock["files"].items():
+        file = directory / relative
+        if not file.resolve().is_relative_to(directory.resolve()) or file.is_symlink():
+            raise ValueError("Unsafe installed dependency path")
+        digest(file.read_bytes(), expected)
+    actual = {str(file.relative_to(directory)) for file in directory.rglob("*") if file.is_file()}
+    if actual != {*lock["files"], ".swiftgram-lock.json"}:
+        raise ValueError("Dependency environment contains unapproved files")
