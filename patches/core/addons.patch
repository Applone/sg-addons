+
+func additionalPluginStoreMessage(_ message: StoreMessage, previous: Message?, account: PeerId) -> StoreMessage? {
+    guard message.flags.contains(.Incoming), case .Id(let id) = message.id,
+        let chat = additionalChatKey(id.peerId), id.namespace == Namespaces.Message.Cloud,
+        previous?.text != message.text
+    else { return message }
+    var event = PluginEvent(
+        kind: .message, name: "message", account: additionalAccountKey(account), chat: chat, text: message.text)
+    event.message = additionalPluginSnapshot(
+        id: id.id, sender: message.authorId, timestamp: message.timestamp, thread: message.threadId, text: message.text,
+        attributes: message.attributes, media: message.media)
+    guard let result = PluginRegistry.shared.dispatch(event) else { return nil }
+    guard result.text != message.text else { return message }
+    // Text offsets and inline emoji entities refer to the original UTF-16 text.
+    return StoreMessage(
+        id: message.id, customStableId: message.customStableId, globallyUniqueId: message.globallyUniqueId,
+        groupingKey: message.groupingKey, threadId: message.threadId, timestamp: message.timestamp,
+        flags: message.flags,
+        tags: message.tags, globalTags: message.globalTags, localTags: message.localTags,
+        forwardInfo: message.forwardInfo,
+        authorId: message.authorId, text: result.text,
+        attributes: message.attributes.filter { !($0 is TextEntitiesMessageAttribute) }, media: message.media)
+}
+
+func additionalPluginEnqueue(_ message: EnqueueMessage, account: PeerId, peerId: PeerId) -> EnqueueMessage? {
+    guard let chat = additionalChatKey(peerId) else { return message }
+    guard
+        case .message(
+            let text, let attributes, _, let mediaReference, let threadId, let replyToMessageId,
+            let
+                replyToStoryId, let localGroupingKey, let correlationId, let bubbleUpEmojiOrStickersets) = message
+    else { return message }
+    var event = PluginEvent(
+        kind: .sendMessage, name: "send_message", account: additionalAccountKey(account), chat: chat, text: text)
+    event.pluginOrigin = additionalPluginIsOrigin(correlationId)
+    event.message = additionalPluginSnapshot(
+        id: nil, sender: account, timestamp: nil, thread: threadId, text: text, attributes: attributes, media: [])
+    guard let result = PluginRegistry.shared.dispatch(event) else { return nil }
+    guard result.text != text else { return message }
+    return .message(
+        text: result.text, attributes: attributes.filter { !($0 is TextEntitiesMessageAttribute) },
+        inlineStickers: [:], mediaReference: mediaReference, threadId: threadId,
+        replyToMessageId: replyToMessageId, replyToStoryId: replyToStoryId, localGroupingKey: localGroupingKey,
+        correlationId: correlationId, bubbleUpEmojiOrStickersets: bubbleUpEmojiOrStickersets)
+}
+
+func additionalPluginAllowRequest(account: String?, name: String) -> Bool {
+    guard let account else { return true }
+    return PluginRegistry.shared.dispatch(PluginEvent(kind: .preRequest, name: name, account: account)) != nil
+}
+
+@discardableResult func additionalPluginPostRequest(account: String?, name: String, error: MTRpcError?) -> MTRpcError? {
+    guard let account else { return error }
+    let event = PluginEvent(kind: .postRequest, name: name, account: account, error: error?.errorDescription)
+    let dispatched = PluginRegistry.shared.dispatch(event)
+    guard let error, let result = dispatched, let description = result.error else { return error }
+    return MTRpcError(errorCode: error.errorCode, errorDescription: description)
+}
