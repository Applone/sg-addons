diff --git a/Swiftgram/SGAdditionalCore/Sources/PluginManifest.swift b/Swiftgram/SGAdditionalCore/Sources/PluginManifest.swift
new file mode 100644
index 0000000000000000000000000000000000000000..fc1cb6f42e745244412b19652baeac3366651258
--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Sources/PluginManifest.swift
@@ -0,0 +1,235 @@
+import Foundation
+
+public enum PluginPermission: String, Codable, CaseIterable {
+    case incomingMessages, outgoingMessages, network, menus
+}
+
+public enum PluginEventKind: String, Codable {
+    case message, sendMessage, preRequest, postRequest
+
+    var permission: PluginPermission {
+        switch self {
+        case .message: return .incomingMessages
+        case .sendMessage: return .outgoingMessages
+        case .preRequest, .postRequest: return .network
+        }
+    }
+}
+
+public enum PluginStrategy: String, Codable {
+    case `default`, modify, modifyFinal, cancel
+}
+
+public enum PluginValue: Codable, Equatable {
+    case bool(Bool)
+    case integer(Int)
+    case string(String)
+
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.singleValueContainer()
+        if let value = try? container.decode(Bool.self) {
+            self = .bool(value)
+        } else if let value = try? container.decode(Int.self) {
+            self = .integer(value)
+        } else {
+            self = .string(try container.decode(String.self))
+        }
+    }
+
+    public func encode(to encoder: Encoder) throws {
+        var container = encoder.singleValueContainer()
+        switch self {
+        case .bool(let value): try container.encode(value)
+        case .integer(let value): try container.encode(value)
+        case .string(let value): try container.encode(value)
+        }
+    }
+
+    public var text: String {
+        switch self {
+        case .bool(let value): return value ? "true" : "false"
+        case .integer(let value): return String(value)
+        case .string(let value): return value
+        }
+    }
+
+    func sameType(as other: PluginValue) -> Bool {
+        switch (self, other) {
+        case (.bool, .bool), (.integer, .integer), (.string, .string): return true
+        default: return false
+        }
+    }
+
+    func validate() throws {
+        switch self {
+        case .string(let value): try pluginRequire(value.utf8.count <= 2048, "Setting text exceeds 2048 bytes.")
+        case .integer(let value):
+            try pluginRequire((-1_000_000...1_000_000).contains(value), "Setting number is out of range.")
+        case .bool: break
+        }
+    }
+}
+
+public struct PluginSetting: Codable, Equatable {
+    public let key: String
+    public let title: String
+    public let defaultValue: PluginValue
+    public var choices: [String]?
+
+    func validate(_ value: PluginValue) throws {
+        try pluginRequire(value.sameType(as: defaultValue), "Setting type changed: " + key)
+        try value.validate()
+        if let choices {
+            try pluginRequire(choices.contains(value.text), "Unknown choice: " + key)
+        }
+    }
+}
+
+public struct PluginHook: Codable, Equatable {
+    public let event: PluginEventKind
+    public let name: String
+    public var substring: Bool?
+    public var priority: Int?
+    public let callback: String
+
+    func matchesName(_ value: String) -> Bool {
+        substring == true ? !name.isEmpty && value.contains(name) : name == value
+    }
+}
+
+public struct PluginMenu: Codable, Equatable {
+    public enum Location: String, Codable { case message, settings }
+    public enum Action: String, Codable { case copyText, showText }
+    public let id: String
+    public let title: String
+    public let location: Location
+    public let callback: String
+    public let action: Action
+}
+
+public struct PluginManifest: Codable, Equatable {
+    public var pythonSource: String
+    public let schemaVersion: Int
+    public let id: String
+    public let name: String
+    public let version: String
+    public var author: String?
+    public var description: String?
+    public var sdkVersion: String?
+    public var appVersion: String?
+    public let permissions: [PluginPermission]
+    public let hooks: [PluginHook]
+    public let settings: [PluginSetting]
+    public let menus: [PluginMenu]
+
+    public func validate(hostVersion: String) throws {
+        try pluginRequire(
+            !pythonSource.isEmpty && pythonSource.utf8.count <= 256 * 1024,
+            "Python source must be present and at most 256 KB.")
+        try pluginRequire(schemaVersion == 1, "Unsupported plugin format.")
+        try pluginRequire(Self.validID(id), "Plugin ID must be 2–32 ASCII characters, starting with a letter.")
+        try pluginRequire(
+            !name.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty && name.utf8.count <= 120,
+            "Invalid plugin name.")
+        _ = try PluginVersion(version)
+        try pluginRequire(
+            (author?.utf8.count ?? 0) <= 120 && (description?.utf8.count ?? 0) <= 2048, "Plugin metadata is too long.")
+        if let sdkVersion { try PluginVersion.check(sdkVersion, current: "1.0") }
+        if let appVersion { try PluginVersion.check(appVersion, current: hostVersion) }
+        try pluginRequire(Set(permissions).count == permissions.count, "Duplicate permissions.")
+        try pluginRequire(
+            hooks.count <= 32 && settings.count <= 32 && menus.count <= 16, "Too many plugin registrations.")
+        try pluginRequire(
+            Set(settings.map(\.key)).count == settings.count && Set(menus.map(\.id)).count == menus.count,
+            "Duplicate setting or menu IDs.")
+        for setting in settings {
+            try pluginRequire(
+                Self.validID(setting.key) && !setting.title.isEmpty && setting.title.utf8.count <= 120,
+                "Invalid setting definition.")
+            if let choices = setting.choices {
+                try pluginRequire(
+                    !choices.isEmpty && choices.count <= 20 && Set(choices).count == choices.count,
+                    "Invalid setting choices.")
+                try pluginRequire(choices.allSatisfy { $0.utf8.count <= 120 }, "Setting choice is too long.")
+                guard case .string = setting.defaultValue else {
+                    throw SettingsError.invalid("Choices require a text setting.")
+                }
+            }
+            try setting.validate(setting.defaultValue)
+        }
+        for hook in hooks {
+            try pluginRequire(
+                permissions.contains(hook.event.permission),
+                "Hook requires permission: " + hook.event.permission.rawValue)
+            try pluginRequire(
+                !hook.name.isEmpty && hook.name.utf8.count <= 120 && (-1000...1000).contains(hook.priority ?? 0),
+                "Invalid event name or priority.")
+            try validateCallback(hook.callback)
+        }
+        for menu in menus {
+            try pluginRequire(
+                permissions.contains(.menus) && Self.validID(menu.id), "Menu permission or ID is invalid.")
+            if menu.location == .message {
+                try pluginRequire(
+                    permissions.contains(.incomingMessages), "Message menus require incomingMessages permission.")
+            }
+            try pluginRequire(!menu.title.isEmpty && menu.title.utf8.count <= 120, "Invalid menu title.")
+            try validateCallback(menu.callback)
+        }
+    }
+
+    private func validateCallback(_ callback: String) throws {
+        let bytes = Array(callback.utf8)
+        try pluginRequire(
+            !bytes.isEmpty && bytes.count <= 64
+                && bytes.allSatisfy {
+                    (65...90).contains($0) || (97...122).contains($0) || (48...57).contains($0) || $0 == 95
+                } && !((48...57).contains(bytes[0])), "Invalid Python callback name.")
+    }
+
+    public static func validID(_ value: String) -> Bool {
+        let bytes = Array(value.utf8)
+        func letter(_ byte: UInt8) -> Bool { (65...90).contains(byte) || (97...122).contains(byte) }
+        return (2...32).contains(bytes.count) && letter(bytes[0])
+            && bytes.dropFirst().allSatisfy { letter($0) || (48...57).contains($0) || $0 == 95 || $0 == 45 }
+    }
+}
+
+struct PluginVersion: Comparable {
+    let parts: [Int]
+    init(_ value: String) throws {
+        let components = value.split(separator: ".", omittingEmptySubsequences: false)
+        try pluginRequire((1...4).contains(components.count), "Invalid numeric plugin version.")
+        var numbers: [Int] = []
+        for component in components {
+            guard !component.isEmpty, component.utf8.allSatisfy({ (48...57).contains($0) }),
+                component.count <= 6, let number = Int(component)
+            else { throw SettingsError.invalid("Invalid numeric plugin version.") }
+            numbers.append(number)
+        }
+        parts = numbers + Array(repeating: 0, count: 4 - numbers.count)
+    }
+    static func < (lhs: Self, rhs: Self) -> Bool { lhs.parts.lexicographicallyPrecedes(rhs.parts) }
+    static func check(_ expression: String, current: String) throws {
+        let operators = [">=", "<=", "==", ">", "<"]
+        guard let op = operators.first(where: { expression.hasPrefix($0) }) else {
+            throw SettingsError.invalid("Version constraint needs >=, <=, ==, >, or <.")
+        }
+        let required = try Self(String(expression.dropFirst(op.count)).trimmingCharacters(in: .whitespaces))
+        let actual = try Self(current)
+        let accepted: Bool
+        switch op {
+        case ">=": accepted = actual >= required
+        case "<=": accepted = actual <= required
+        case ">": accepted = actual > required
+        case "<": accepted = actual < required
+        default: accepted = actual == required
+        }
+        try pluginRequire(
+            accepted, "Plugin is incompatible with version " + current + " (requires " + expression + ").")
+    }
+}
+
+func pluginRequire(_ condition: Bool, _ message: String) throws {
+    guard condition else { throw SettingsError.invalid(message) }
+}
diff --git a/Swiftgram/SGAdditionalCore/Sources/PluginRegistry.swift b/Swiftgram/SGAdditionalCore/Sources/PluginRegistry.swift
new file mode 100644
index 0000000000000000000000000000000000000000..03e1442931011d5d51e3953dbb9774fd71a01e16
--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Sources/PluginRegistry.swift
@@ -0,0 +1,481 @@
+import Foundation
+
+public struct PluginEvent: Codable, Equatable {
+    public let kind: PluginEventKind
+    public let name: String
+    public let account: String
+    public var chat: String?
+    public var text: String
+    public var error: String?
+
+    public init(
+        kind: PluginEventKind, name: String, account: String, chat: String? = nil,
+        text: String = "", error: String? = nil
+    ) {
+        self.kind = kind
+        self.name = name
+        self.account = account
+        self.chat = chat
+        self.text = text
+        self.error = error
+    }
+}
+
+public struct PluginRecord: Codable, Equatable {
+    public let manifest: PluginManifest
+    public var enabledAccounts: Set<String>
+    public var settings: [String: [String: PluginValue]]
+    public var error: String?
+
+    public func values(account: String) -> [String: PluginValue] {
+        var values: [String: PluginValue] = [:]
+        for setting in manifest.settings { values[setting.key] = setting.defaultValue }
+        for (key, value) in settings[account] ?? [:] { values[key] = value }
+        return values
+    }
+
+    public func isEnabled(account: String) -> Bool { enabledAccounts.contains(account) && error == nil }
+}
+
+public struct PluginMenuItem: Equatable {
+    public let pluginID: String
+    public let menuID: String
+    public let title: String
+}
+
+public struct PluginMenuResult: Equatable {
+    public let action: PluginMenu.Action
+    public let text: String
+}
+
+/// Coordinates Python plugins with account-owned registrations.
+/// A lock covers dispatch and lifecycle so a completed disable removes all registrations.
+public final class PluginRegistry {
+    public static let shared: PluginRegistry = {
+        #if TESTING
+            let root = URL(fileURLWithPath: ProcessInfo.processInfo.environment["SGA_TEST_DIRECTORY"]!)
+        #else
+            let root = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
+        #endif
+        return PluginRegistry(
+            directory: root.appendingPathComponent("SwiftgramPlugins", isDirectory: true),
+            hostVersion: Bundle.main.object(forInfoDictionaryKey: "CFBundleShortVersionString") as? String ?? "13.0.1")
+    }()
+
+    private struct Document: Codable {
+        var schemaVersion = 1
+        var safeMode = false
+        var records: [String: PluginRecord] = [:]
+    }
+
+    private let lock = NSLock()
+    private let directory: URL
+    private let file: URL
+    private let recoveryFile: URL
+    private let pythonRecovery: URL
+    public let hostVersion: String
+    private var document = Document()
+    private var failure: String?
+    private var corrupt = false
+
+    public init(directory: URL, hostVersion: String) {
+        self.directory = directory
+        self.file = directory.appendingPathComponent("registry.json")
+        self.recoveryFile = directory.appendingPathComponent("recovery.json")
+        self.pythonRecovery = directory.appendingPathComponent("python-invocation.json")
+        self.hostVersion = hostVersion
+        do {
+            #if os(iOS)
+                let attributes: [FileAttributeKey: Any] = [
+                    .protectionKey: FileProtectionType.completeUntilFirstUserAuthentication
+                ]
+            #else
+                let attributes: [FileAttributeKey: Any] = [:]
+            #endif
+            try FileManager.default.createDirectory(
+                at: directory, withIntermediateDirectories: true, attributes: attributes)
+            var protectedDirectory = directory
+            var resourceValues = URLResourceValues()
+            resourceValues.isExcludedFromBackup = true
+            try protectedDirectory.setResourceValues(resourceValues)
+            if FileManager.default.fileExists(atPath: file.path) {
+                let size = try file.resourceValues(forKeys: [.fileSizeKey]).fileSize ?? 0
+                try pluginRequire(size <= 32 * 1024 * 1024, "Plugin registry exceeds 32 MB.")
+                let stored = try JSONDecoder().decode(Document.self, from: Data(contentsOf: file))
+                try pluginRequire(stored.schemaVersion == 1 && stored.records.count <= 64, "Invalid plugin registry.")
+                for (id, record) in stored.records {
+                    try pluginRequire(id == record.manifest.id, "Plugin registry identity mismatch.")
+                    // An application upgrade can make one plugin incompatible without losing the others.
+                    var validated = record
+                    do { try record.manifest.validate(hostVersion: hostVersion) } catch {
+                        validated.error = error.localizedDescription
+                    }
+                    for (account, values) in record.settings {
+                        try Self.validateAccount(account)
+                        for (key, value) in values {
+                            guard let setting = record.manifest.settings.first(where: { $0.key == key }) else {
+                                throw SettingsError.invalid("Unknown stored plugin setting.")
+                            }
+                            try setting.validate(value)
+                        }
+                    }
+                    for account in record.enabledAccounts { try Self.validateAccount(account) }
+                    document.records[id] = validated
+                }
+                document.safeMode = stored.safeMode
+            }
+            if FileManager.default.fileExists(atPath: recoveryFile.path)
+                || FileManager.default.fileExists(atPath: pythonRecovery.path)
+            {
+                // Recovery never executes Python. An interrupted lifecycle mutation enters safe mode.
+                document.safeMode = true
+                failure = "An interrupted plugin change was recovered. Plugins are in safe mode."
+            }
+        } catch {
+            document = Document()
+            document.safeMode = true
+            failure = error.localizedDescription
+            corrupt = true
+        }
+    }
+
+    public func records() -> [PluginRecord] {
+        lock.lock()
+        defer { lock.unlock() }
+        return document.records.values.sorted { $0.manifest.id < $1.manifest.id }
+    }
+
+    public func safeMode() -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        return document.safeMode
+    }
+    public func status() -> String? {
+        lock.lock()
+        defer { lock.unlock() }
+        return failure
+    }
+
+    public func inspect(_ data: Data) throws -> PluginManifest {
+        try pluginRequire(data.count <= 256 * 1024, "Plugin exceeds 256 KB.")
+        guard let source = String(data: data, encoding: .utf8) else {
+            throw SettingsError.invalid("Plugin must be UTF-8.")
+        }
+        let manifest = try PythonPluginRuntime.shared.inspect(source, marker: pythonRecovery)
+        try manifest.validate(hostVersion: hostVersion)
+        return manifest
+    }
+
+    @discardableResult public func install(_ data: Data) throws -> PluginManifest {
+        let manifest = try inspect(data)
+        lock.lock()
+        defer { lock.unlock() }
+        var next = document
+        let previous = next.records[manifest.id]
+        try pluginRequire(previous != nil || next.records.count < 64, "Maximum 64 installed plugins.")
+        let gainedPermissions = !Set(manifest.permissions).isSubset(of: Set(previous?.manifest.permissions ?? []))
+        var record = PluginRecord(
+            manifest: manifest,
+            enabledAccounts: gainedPermissions ? [] : previous?.enabledAccounts ?? [], settings: [:], error: nil)
+        // Keep compatible settings. Removed keys and changed types return to new defaults.
+        for (account, values) in previous?.settings ?? [:] {
+            for setting in manifest.settings {
+                if let value = values[setting.key], (try? setting.validate(value)) != nil {
+                    record.settings[account, default: [:]][setting.key] = value
+                }
+            }
+        }
+        next.records[manifest.id] = record
+        try commit(next)
+        return manifest
+    }
+
+    public func setEnabled(_ id: String, account: String, enabled: Bool) throws {
+        try Self.validateAccount(account)
+        lock.lock()
+        defer { lock.unlock() }
+        var next = document
+        guard var record = next.records[id] else { throw SettingsError.invalid("Plugin is not installed.") }
+        if enabled {
+            try record.manifest.validate(hostVersion: hostVersion)
+            record.enabledAccounts.insert(account)
+            record.error = nil
+        } else {
+            record.enabledAccounts.remove(account)
+        }
+        next.records[id] = record
+        do { try commit(next) } catch {
+            if enabled { fail(id, error: error) }
+            throw error
+        }
+    }
+
+    public func saveSettings(_ id: String, account: String, values: [String: PluginValue]) throws {
+        try Self.validateAccount(account)
+        lock.lock()
+        defer { lock.unlock() }
+        var next = document
+        guard var record = next.records[id] else { throw SettingsError.invalid("Plugin is not installed.") }
+        for (key, value) in values {
+            guard let setting = record.manifest.settings.first(where: { $0.key == key }) else {
+                throw SettingsError.invalid("Unknown plugin setting: " + key)
+            }
+            try setting.validate(value)
+        }
+        record.settings[account] = values
+        next.records[id] = record
+        try commit(next)
+    }
+
+    public func remove(_ id: String) throws {
+        lock.lock()
+        defer { lock.unlock() }
+        var next = document
+        next.records.removeValue(forKey: id)
+        try commit(next)
+    }
+
+    public func setSafeMode(_ enabled: Bool) throws {
+        lock.lock()
+        defer { lock.unlock() }
+        var next = document
+        next.safeMode = enabled
+        try commit(next)
+    }
+
+    /// Explicit recovery from malformed storage keeps the original bytes for inspection.
+    public func reset() throws {
+        lock.lock()
+        defer { lock.unlock() }
+        if FileManager.default.fileExists(atPath: file.path) {
+            try FileManager.default.copyItem(
+                at: file, to: directory.appendingPathComponent("registry-" + UUID().uuidString + ".bak"))
+        }
+        var empty = Document()
+        try transitionPython(from: document, to: &empty)
+        try persist(empty)
+        document = empty
+        corrupt = false
+        failure = nil
+        try clearRecovery()
+        if FileManager.default.fileExists(atPath: pythonRecovery.path) {
+            try FileManager.default.removeItem(at: pythonRecovery)
+        }
+        changed()
+    }
+
+    public func dispatch(_ original: PluginEvent) -> PluginEvent? {
+        lock.lock()
+        defer { lock.unlock() }
+        guard !document.safeMode, original.text.utf8.count <= 65536 else { return original }
+        var current = original
+        // One invocation per plugin using its highest matching priority; IDs break ties.
+        let candidates: [(String, Int)] = document.records.compactMap { id, record in
+            guard record.isEnabled(account: original.account) else { return nil }
+            let priorities = record.manifest.hooks.filter { $0.event == original.kind && $0.matchesName(original.name) }
+                .map { $0.priority ?? 0 }
+            return priorities.max().map { (id, $0) }
+        }.sorted { $0.1 == $1.1 ? $0.0 < $1.0 : $0.1 > $1.1 }
+        for (id, _) in candidates {
+            guard let record = document.records[id], record.isEnabled(account: current.account) else { continue }
+            let hooks = record.manifest.hooks.enumerated().filter {
+                $0.element.event == current.kind && $0.element.matchesName(current.name)
+            }.sorted {
+                let left = $0.element.priority ?? 0
+                let right = $1.element.priority ?? 0
+                return left == right ? $0.offset < $1.offset : left > right
+            }
+            guard let hook = hooks.first?.element else { continue }
+            do {
+                let reply = try PythonPluginRuntime.shared.invoke(
+                    record, event: current, callback: hook.callback, marker: pythonRecovery)
+                let strategy = reply.strategy ?? .default
+                let replacementText = reply.text
+                let replacementError = reply.error
+                try acceptPythonSettings(reply.settings, id: id, account: current.account)
+                if current.kind == .preRequest {
+                    try pluginRequire(
+                        (strategy == .default || strategy == .cancel) && replacementText == nil
+                            && replacementError == nil,
+                        "Pre-request hooks support default or cancel only.")
+                } else if current.kind == .postRequest {
+                    try pluginRequire(
+                        strategy != .cancel && replacementText == nil,
+                        "Post-request hooks cannot cancel or replace a response.")
+                } else {
+                    try pluginRequire(replacementError == nil, "Message hooks cannot return errors.")
+                }
+                if strategy == .modify || strategy == .modifyFinal {
+                    try pluginRequire(
+                        current.kind == .postRequest ? replacementError != nil : replacementText != nil,
+                        "Python modification returned no replacement value.")
+                }
+                switch strategy {
+                case .default: continue
+                case .cancel: return nil
+                case .modify, .modifyFinal:
+                    var modified = current
+                    if let text = replacementText {
+                        try pluginRequire(text.utf8.count <= 65536, "Python text exceeds 64 KB.")
+                        modified.text = text
+                    }
+                    if let error = replacementError, current.error != nil {
+                        try pluginRequire(error.utf8.count <= 512, "Plugin error text exceeds 512 bytes.")
+                        modified.error = error
+                    }
+                    if current.kind == .sendMessage {
+                        try pluginRequire(
+                            modified.text.utf16.count <= 4096, "Outgoing plugin text exceeds 4096 characters.")
+                    }
+                    current = modified
+                    if strategy == .modifyFinal { return current }
+                }
+            } catch { fail(id, error: error) }
+        }
+        return current
+    }
+
+    public func menuItems(location: PluginMenu.Location, event: PluginEvent) -> [PluginMenuItem] {
+        lock.lock()
+        defer { lock.unlock() }
+        guard !document.safeMode else { return [] }
+        return document.records.keys.sorted().flatMap { id -> [PluginMenuItem] in
+            guard let record = document.records[id], record.isEnabled(account: event.account) else { return [] }
+            return record.manifest.menus.filter {
+                $0.location == location
+            }.map { PluginMenuItem(pluginID: id, menuID: $0.id, title: $0.title) }
+        }
+    }
+
+    public func performMenu(_ item: PluginMenuItem, location: PluginMenu.Location, event: PluginEvent)
+        -> PluginMenuResult?
+    {
+        lock.lock()
+        defer { lock.unlock() }
+        guard !document.safeMode, let record = document.records[item.pluginID],
+            record.isEnabled(account: event.account),
+            let menu = record.manifest.menus.first(where: { $0.id == item.menuID && $0.location == location })
+        else { return nil }
+        do {
+            let reply = try PythonPluginRuntime.shared.invoke(
+                record, event: event, callback: menu.callback, menuID: menu.id, marker: pythonRecovery)
+            guard let text = reply.text, text.utf8.count <= 65536 else {
+                throw SettingsError.invalid("Python menu returned invalid text.")
+            }
+            try acceptPythonSettings(reply.settings, id: item.pluginID, account: event.account)
+            return PluginMenuResult(action: menu.action, text: text)
+        } catch {
+            fail(item.pluginID, error: error)
+            return nil
+        }
+    }
+
+    private static func validateAccount(_ account: String) throws {
+        try pluginRequire(
+            !account.isEmpty && account.utf8.count <= 32 && account.utf8.allSatisfy { (48...57).contains($0) },
+            "Invalid plugin account ID.")
+    }
+
+    private func fail(_ id: String, error: Error) {
+        var next = document
+        next.records[id]?.error = error.localizedDescription
+        // Runtime failure preserves desired enablement but removes every active registration.
+        do { try commit(next) } catch {
+            document = next
+            document.safeMode = true
+            failure = error.localizedDescription
+            changed()
+        }
+    }
+
+    private func commit(_ proposed: Document) throws {
+        try pluginRequire(!corrupt, "Plugin registry is damaged. Reset it before making changes.")
+        var next = proposed
+        // One atomic document covers sources, settings, and desired enablement. Memory changes last.
+        try Data("{\"operation\":\"registry-change\"}".utf8).write(to: recoveryFile, options: .atomic)
+        do {
+            try transitionPython(from: document, to: &next)
+            try persist(next)
+        } catch {
+            var restored = document
+            do { try transitionPython(from: next, to: &restored) } catch {
+                document.safeMode = true
+                failure = "Python rollback failed. Restart in safe mode: " + error.localizedDescription
+            }
+            throw error
+        }
+        document = next
+        do {
+            try clearRecovery()
+            failure = nil
+        } catch {
+            document.safeMode = true
+            failure = error.localizedDescription
+        }
+        changed()
+    }
+
+    private func checkedPythonSettings(_ values: [String: PluginValue], record: PluginRecord) throws {
+        for (key, value) in values {
+            guard let setting = record.manifest.settings.first(where: { $0.key == key }) else {
+                throw SettingsError.invalid("Python changed an undeclared setting: " + key)
+            }
+            try setting.validate(value)
+        }
+    }
+
+    private func acceptPythonSettings(_ values: [String: PluginValue]?, id: String, account: String) throws {
+        guard let values, let record = document.records[id] else { return }
+        try checkedPythonSettings(values, record: record)
+        guard values != record.values(account: account) else { return }
+        var next = document
+        next.records[id]?.settings[account] = values
+        try commit(next)
+    }
+
+    private func transitionPython(from old: Document, to next: inout Document) throws {
+        for id in Set(old.records.keys).union(next.records.keys).sorted() {
+            let previous = old.records[id]
+            let updated = next.records[id]
+            let accounts = (previous?.enabledAccounts ?? []).union(updated?.enabledAccounts ?? [])
+            for account in accounts.sorted() {
+                let wasActive = !old.safeMode && previous?.isEnabled(account: account) == true
+                let active = !next.safeMode && next.records[id]?.isEnabled(account: account) == true
+                let changedSource = previous?.manifest.pythonSource != updated?.manifest.pythonSource
+                if wasActive, !active || changedSource {
+                    do { try PythonPluginRuntime.shared.unload(id, account: account, marker: pythonRecovery) } catch {
+                        next.records[id]?.error = error.localizedDescription
+                    }
+                }
+                if active, var record = next.records[id], !wasActive || changedSource {
+                    let values = try PythonPluginRuntime.shared.load(record, account: account, marker: pythonRecovery)
+                    try checkedPythonSettings(values, record: record)
+                    record.settings[account] = values
+                    next.records[id] = record
+                }
+            }
+        }
+    }
+
+    private func persist(_ next: Document) throws {
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        let data = try encoder.encode(next)
+        try pluginRequire(data.count <= 32 * 1024 * 1024, "Plugin registry exceeds 32 MB.")
+        try data.write(to: file, options: .atomic)
+    }
+
+    private func clearRecovery() throws {
+        if FileManager.default.fileExists(atPath: recoveryFile.path) {
+            try FileManager.default.removeItem(at: recoveryFile)
+        }
+    }
+
+    private func changed() {
+        DispatchQueue.main.async { NotificationCenter.default.post(name: .pluginsChanged, object: nil) }
+    }
+}
+
+extension Notification.Name {
+    public static let pluginsChanged = Notification.Name("SGAPluginsChanged")
+}
diff --git a/Swiftgram/SGAdditionalCore/Sources/PythonPluginRuntime.swift b/Swiftgram/SGAdditionalCore/Sources/PythonPluginRuntime.swift
new file mode 100644
index 0000000000000000000000000000000000000000..607293863bdafe357d1b4c184c1a70f82d79a448
--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Sources/PythonPluginRuntime.swift
@@ -0,0 +1,167 @@
+import Foundation
+import SGPythonBridge
+
+struct PythonPluginReply: Decodable {
+    var manifest: PluginManifest?
+    var settings: [String: PluginValue]?
+    var strategy: PluginStrategy?
+    var text: String?
+    var error: String?
+}
+
+/// Calls CPython on a worker and bounds the host's wait. A timeout quarantines the
+/// interpreter until restart; it does not pretend to terminate arbitrary Python/C code.
+final class PythonPluginRuntime {
+    static let shared = PythonPluginRuntime()
+    private let worker = DispatchQueue(label: "app.swiftgram.python")
+    private let stateLock = NSLock()
+    private var quarantined = false
+    private var initialized = false
+
+    private struct Request: Encodable {
+        let operation: String
+        var id: String?
+        var account: String?
+        var source: String?
+        var settings: [String: PluginValue]?
+        var event: PluginEvent?
+        var callback: String?
+        var menuID: String?
+    }
+
+    private struct Envelope: Decodable {
+        var result: PythonPluginReply?
+        var failure: String?
+    }
+
+    private final class Job {
+        let semaphore = DispatchSemaphore(value: 0)
+        let lock = NSLock()
+        var expired = false
+        var result: Result<PythonPluginReply, Error>?
+    }
+
+    func inspect(_ source: String, marker: URL) throws -> PluginManifest {
+        let reply = try request(Request(operation: "inspect", source: source), marker: marker)
+        guard var manifest = reply.manifest else { throw SettingsError.invalid("Python returned no metadata.") }
+        manifest.pythonSource = source
+        return manifest
+    }
+
+    func load(_ record: PluginRecord, account: String, marker: URL) throws -> [String: PluginValue] {
+        try request(
+            Request(
+                operation: "load", id: record.manifest.id, account: account,
+                source: record.manifest.pythonSource, settings: record.values(account: account)), marker: marker
+        ).settings ?? [:]
+    }
+
+    func unload(_ id: String, account: String, marker: URL) throws {
+        stateLock.lock()
+        let blocked = quarantined
+        stateLock.unlock()
+        if blocked { return }
+        _ = try request(Request(operation: "unload", id: id, account: account), marker: marker)
+    }
+
+    func invoke(
+        _ record: PluginRecord, event: PluginEvent, callback: String, menuID: String? = nil,
+        marker: URL
+    ) throws -> PythonPluginReply {
+        try request(
+            Request(
+                operation: menuID == nil ? "hook" : "menu", id: record.manifest.id,
+                account: event.account, source: record.manifest.pythonSource,
+                settings: record.values(account: event.account),
+                event: event, callback: callback, menuID: menuID), marker: marker)
+    }
+
+    private func request(_ request: Request, marker: URL) throws -> PythonPluginReply {
+        stateLock.lock()
+        let blocked = quarantined
+        stateLock.unlock()
+        try pluginRequire(!blocked, "Python stopped responding. Restart Swiftgram to recover.")
+        let payload = String(decoding: try JSONEncoder().encode(request), as: UTF8.self)
+        let job = Job()
+        let recovery = try JSONEncoder().encode(["id": request.id ?? "", "operation": request.operation])
+        worker.async { [self] in
+            job.lock.lock()
+            let expired = job.expired
+            job.lock.unlock()
+            if expired {
+                job.semaphore.signal()
+                return
+            }
+            let result = Result { () throws -> PythonPluginReply in
+                try recovery.write(to: marker, options: .atomic)
+                if !initialized {
+                    #if TESTING
+                        let home = ProcessInfo.processInfo.environment["SGA_PYTHON_HOME"] ?? ""
+                        let sdk = ProcessInfo.processInfo.environment["SGA_PYTHON_SDK"] ?? ""
+                    #else
+                        guard let home = Self.bundledResource("SwiftgramPython.bundle"),
+                            let sdk = Self.bundledResource("SwiftgramPythonSDK.bundle")
+                        else {
+                            throw SettingsError.invalid("Bundled Python resources are unavailable.")
+                        }
+                    #endif
+                    var error: UnsafeMutablePointer<CChar>?
+                    let success = SGPythonInitialize(home, sdk, &error)
+                    defer { SGPythonFree(error) }
+                    try pluginRequire(success != 0, error.map { String(cString: $0) } ?? "Cannot initialize CPython.")
+                    initialized = true
+                }
+                var error: UnsafeMutablePointer<CChar>?
+                let response = SGPythonCall(payload, &error)
+                defer {
+                    SGPythonFree(response)
+                    SGPythonFree(error)
+                }
+                guard let response else {
+                    throw SettingsError.invalid(error.map { String(cString: $0) } ?? "Python failed.")
+                }
+                let data = Data(String(cString: response).utf8)
+                try pluginRequire(data.count <= 512 * 1024, "Python returned an oversized response.")
+                let envelope = try JSONDecoder().decode(Envelope.self, from: data)
+                if let failure = envelope.failure { throw SettingsError.invalid(failure) }
+                guard let reply = envelope.result else { throw SettingsError.invalid("Invalid Python response.") }
+                return reply
+            }
+            job.lock.lock()
+            if !job.expired {
+                try? FileManager.default.removeItem(at: marker)
+                job.result = result
+            }
+            job.lock.unlock()
+            job.semaphore.signal()
+        }
+        let seconds: Double = (request.operation == "hook" || request.operation == "menu") ? 0.25 : 2.0
+        if job.semaphore.wait(timeout: .now() + seconds) == .timedOut {
+            job.lock.lock()
+            job.expired = true
+            job.lock.unlock()
+            stateLock.lock()
+            quarantined = true
+            stateLock.unlock()
+            // Keep recovery even if completion raced the caller's deadline.
+            try? recovery.write(to: marker, options: .atomic)
+            throw SettingsError.invalid("Python exceeded the host deadline. The interpreter is paused until restart.")
+        }
+        job.lock.lock()
+        let result = job.result
+        job.lock.unlock()
+        guard let result else { throw SettingsError.invalid("Missing Python result.") }
+        return try result.get()
+    }
+
+    private static func bundledResource(_ name: String) -> String? {
+        for bundle in [Bundle.main] + Bundle.allFrameworks {
+            if let directory = bundle.resourceURL?.appendingPathComponent(name),
+                FileManager.default.fileExists(atPath: directory.path)
+            {
+                return directory.path
+            }
+        }
+        return nil
+    }
+}
