+import Foundation
+
+public struct PluginTextEntity: Codable, Equatable {
+    public let kind: String
+    public let offset: Int
+    public let length: Int
+    public var value: String?
+
+    public init(kind: String, offset: Int, length: Int, value: String? = nil) {
+        self.kind = kind
+        self.offset = offset
+        self.length = length
+        self.value = value
+    }
+    public func validate(text: String) throws {
+        try pluginRequire(
+            ["Bold", "Italic", "Underline", "Strike", "Spoiler", "Code", "Pre", "TextUrl"].contains(kind),
+            "Unsupported text entity.")
+        let count = text.utf16.count
+        try pluginRequire(
+            offset >= 0 && length > 0 && offset <= count && length <= count - offset, "Invalid UTF-16 entity range.")
+        let units = Array(text.utf16)
+        for boundary in [offset, offset + length] where boundary > 0 && boundary < count {
+            try pluginRequire(!(0xDC00...0xDFFF).contains(units[boundary]), "Entity splits a surrogate pair.")
+        }
+        if kind == "TextUrl" { try pluginRequire(URL(string: value ?? "")?.scheme != nil, "Invalid entity URL.") }
+    }
+}
+
+public struct PluginAttachment: Codable, Equatable {
+    public let id: String
+    public let kind: String
+    public let filename: String?
+    public let mimeType: String?
+    public let size: Int64?
+    public init(id: String, kind: String, filename: String? = nil, mimeType: String? = nil, size: Int64? = nil) {
+        self.id = id
+        self.kind = kind
+        self.filename = filename
+        self.mimeType = mimeType
+        self.size = size
+    }
+}
+
+public struct PluginMessage: Codable, Equatable {
+    public let id: Int32?
+    public let sender: String?
+    public let timestamp: Int32?
+    public let replyTo: Int32?
+    public let threadID: Int64?
+    public let text: String
+    public let entities: [PluginTextEntity]
+    public let attachments: [PluginAttachment]
+    public init(
+        id: Int32?, sender: String?, timestamp: Int32?, replyTo: Int32? = nil, threadID: Int64? = nil, text: String,
+        entities: [PluginTextEntity] = [], attachments: [PluginAttachment] = []
+    ) {
+        self.id = id
+        self.sender = sender
+        self.timestamp = timestamp
+        self.replyTo = replyTo
+        self.threadID = threadID
+        self.text = text
+        self.entities = entities
+        self.attachments = attachments
+    }
+}
+
+public struct PluginAction: Codable {
+    public let id: String
+    public let operation: String
+    public var chat: String?
+    public var messageID: Int32?
+    public var text: String?
+    public var entities: [PluginTextEntity]?
+    public var replyTo: Int32?
+    public var threadID: Int64?
+    public var attachmentID: String?
+    public var path: String?
+    public var mediaKind: String?
+    public var targetID: String?
+
+    var permissions: Set<PluginPermission> {
+        switch operation {
+        case "getMessage": return [.readMessages]
+        case "sendMessage": return [.sendMessages]
+        case "editMessage": return [.editMessages]
+        case "downloadMedia": return [.readMessages, .downloadMedia]
+        case "sendMedia": return [.sendMessages, .sendMedia]
+        default: return []
+        }
+    }
+
+    func validate() throws {
+        try pluginRequire(id.count == 32 && id.allSatisfy(\.isHexDigit), "Invalid action ID.")
+        try pluginRequire(
+            ["getMessage", "sendMessage", "editMessage", "downloadMedia", "sendMedia", "cancel"].contains(operation),
+            "Unknown action.")
+        if operation == "cancel" {
+            try pluginRequire(
+                targetID?.count == 32 && targetID?.allSatisfy(\.isHexDigit) == true, "Invalid cancellation target.")
+            return
+        }
+        let parts = (chat ?? "").split(separator: ":")
+        try pluginRequire(
+            parts.count == 2 && ["user", "chat", "channel"].contains(String(parts[0]))
+                && Int64(parts[1]).map { $0 > 0 } == true, "Invalid cloud chat.")
+        if ["getMessage", "editMessage", "downloadMedia"].contains(operation) {
+            try pluginRequire((messageID ?? 0) > 0, "Invalid message ID.")
+        }
+        if let replyTo { try pluginRequire(replyTo > 0, "Invalid reply ID.") }
+        if let threadID { try pluginRequire(threadID > 0, "Invalid thread ID.") }
+        let content = text ?? ""
+        let limit = operation == "sendMedia" ? 1024 : 4096
+        try pluginRequire(content.utf16.count <= limit && (entities?.count ?? 0) <= 100, "Action text is too large.")
+        if operation == "sendMessage" { try pluginRequire(!content.isEmpty, "Message text is empty.") }
+        for entity in entities ?? [] { try entity.validate(text: content) }
+        if operation == "sendMedia" {
+            try pluginRequire(
+                ["photo", "video", "document"].contains(mediaKind ?? "") && path != nil, "Invalid media kind or path.")
+        }
+    }
+}
+
+public struct PluginActionResult: Codable {
+    public let id: String
+    public let status: String
+    public var error: String?
+    public var message: PluginMessage?
+    public var path: String?
+    public var messageIDs: [Int32]?
+    public var progress: Double?
+    public init(
+        id: String, status: String, error: String? = nil, message: PluginMessage? = nil, path: String? = nil,
+        messageIDs: [Int32]? = nil, progress: Double? = nil
+    ) {
+        self.id = id
+        self.status = status
+        self.error = error
+        self.message = message
+        self.path = path
+        self.messageIDs = messageIDs
+        self.progress = progress
+    }
+}
+
+/// Adapter cancellation is best effort once Telegram has accepted an outbox entry.
+public protocol PluginActionAdapter: AnyObject {
+    func execute(
+        _ action: PluginAction, directory: URL, progress: @escaping (Double) -> Void,
+        completion: @escaping (PluginActionResult) -> Void
+    ) -> () -> Void
+}
+
+final class PluginActionExecutor {
+    struct Owner: Equatable {
+        let plugin: String
+        let account: String
+        let generation: String
+    }
+    struct Task {
+        let nonce = UUID()
+        let owner: Owner
+        let action: PluginAction
+        let directory: URL
+        var cancel: (() -> Void)?
+        var started = false
+        var lastProgress = Date.distantPast
+        var lastActivity = Date()
+    }
+    let queue = DispatchQueue(label: "app.swiftgram.plugin.actions")
+    private var adapters: [String: PluginActionAdapter] = [:]
+    private var tasks: [String: Task] = [:]
+    private var order: [String] = []
+    private var writes: [String: [Date]] = [:]
+    var authorized: ((Owner) -> Bool)?
+    var deliver: ((Owner, PluginActionResult) -> Void)?
+
+    func register(account: String, adapter: PluginActionAdapter?) {
+        queue.async {
+            self.adapters[account] = adapter
+            if adapter == nil {
+                for (id, task) in self.tasks where task.owner.account == account {
+                    self.finish(id, status: "cancelled")
+                }
+            }
+            self.pump()
+        }
+    }
+
+    func cancel(owner: Owner) {
+        queue.async {
+            for (id, task) in self.tasks where task.owner == owner { self.finish(id, status: "cancelled") }
+        }
+    }
+
+    func submit(_ actions: [PluginAction], owner: Owner, directory: URL) {
+        queue.async {
+            guard self.authorized?(owner) == true else { return }
+            for action in actions {
+                if action.operation == "cancel" {
+                    if let target = action.targetID, self.tasks[target]?.owner == owner {
+                        self.finish(target, status: "cancelled")
+                    }
+                    self.deliver?(owner, PluginActionResult(id: action.id, status: "completed"))
+                    continue
+                }
+                guard self.tasks[action.id] == nil else { continue }
+                guard self.tasks.values.filter({ $0.owner == owner }).count < 32 else {
+                    self.deliver?(owner, PluginActionResult(id: action.id, status: "failed", error: "quotaExceeded"))
+                    continue
+                }
+                self.tasks[action.id] = Task(owner: owner, action: action, directory: directory)
+                self.order.append(action.id)
+            }
+            self.pump()
+        }
+    }
+
+    private func pump() {
+        for id in order {
+            guard var task = tasks[id], !task.started else { continue }
+            guard authorized?(task.owner) == true else {
+                finish(id, status: "cancelled")
+                continue
+            }
+            let media = ["sendMedia", "downloadMedia"].contains(task.action.operation)
+            if media
+                && tasks.values.filter({
+                    $0.owner == task.owner && $0.started
+                        && ["sendMedia", "downloadMedia"].contains($0.action.operation)
+                }).count >= 2
+            {
+                continue
+            }
+            guard let adapter = adapters[task.owner.account] else {
+                finish(id, status: "failed", error: "unavailableTarget")
+                continue
+            }
+            if ["sendMessage", "editMessage", "sendMedia"].contains(task.action.operation) {
+                let key = task.owner.plugin + ":" + task.owner.account
+                let recent = (writes[key] ?? []).filter { Date().timeIntervalSince($0) < 60 }
+                guard recent.count < 30 else {
+                    finish(id, status: "failed", error: "quotaExceeded")
+                    continue
+                }
+                writes[key] = recent + [Date()]
+            }
+            task.started = true
+            tasks[id] = task
+            let nonce = task.nonce
+            let cancel = adapter.execute(
+                task.action, directory: task.directory,
+                progress: { value in
+                    self.queue.async {
+                        guard var current = self.tasks[id], current.nonce == nonce else { return }
+                        current.lastActivity = Date()
+                        if Date().timeIntervalSince(current.lastProgress) >= 0.25 {
+                            current.lastProgress = Date()
+                            self.deliver?(
+                                current.owner,
+                                PluginActionResult(id: id, status: "progress", progress: min(1, max(0, value))))
+                        }
+                        self.tasks[id] = current
+                    }
+                },
+                completion: { result in
+                    self.queue.async {
+                        guard self.tasks[id]?.nonce == nonce else { return }
+                        if result.status == "accepted", let current = self.tasks[id],
+                            self.authorized?(current.owner) == true
+                        {
+                            self.deliver?(current.owner, result)
+                        } else {
+                            self.finish(id, result: result)
+                        }
+                        self.pump()
+                    }
+                })
+            tasks[id]?.cancel = cancel
+            queue.asyncAfter(deadline: .now() + (media ? 600 : 60)) {
+                guard self.tasks[id]?.nonce == nonce else { return }
+                self.finish(id, status: "failed", error: "timeout")
+                self.pump()
+            }
+            if media { checkStall(id, nonce: nonce) }
+        }
+        order.removeAll { tasks[$0] == nil }
+    }
+
+    private func checkStall(_ id: String, nonce: UUID) {
+        queue.asyncAfter(deadline: .now() + 60) {
+            guard let task = self.tasks[id], task.nonce == nonce else { return }
+            if Date().timeIntervalSince(task.lastActivity) >= 60 {
+                self.finish(id, status: "failed", error: "timeout")
+                self.pump()
+            } else {
+                self.checkStall(id, nonce: nonce)
+            }
+        }
+    }
+
+    private func finish(
+        _ id: String, status: String = "completed", error: String? = nil, result: PluginActionResult? = nil
+    ) {
+        guard let task = tasks.removeValue(forKey: id) else { return }
+        task.cancel?()
+        if authorized?(task.owner) == true {
+            deliver?(task.owner, result ?? PluginActionResult(id: id, status: status, error: error))
+        }
+    }
+}
+
+public enum PluginFiles {
+    private static let lock = NSLock()
+    public static let maximumFileSize: Int64 = 100 * 1024 * 1024
+    public static let maximumStorage: Int64 = 256 * 1024 * 1024
+
+    private static func usage(_ directory: URL) throws -> Int64 {
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        var total: Int64 = 0
+        guard
+            let entries = FileManager.default.enumerator(
+                at: directory, includingPropertiesForKeys: [.isSymbolicLinkKey, .fileSizeKey])
+        else {
+            throw SettingsError.invalid("Cannot inspect plugin storage.")
+        }
+        for case let url as URL in entries {
+            let values = try url.resourceValues(forKeys: [.isSymbolicLinkKey, .fileSizeKey])
+            try pluginRequire(values.isSymbolicLink != true, "Symbolic links are unavailable in plugin storage.")
+            total += Int64(values.fileSize ?? 0)
+            try pluginRequire(total <= maximumStorage, "Plugin storage quota exceeded.")
+        }
+        return total
+    }
+
+    public static func snapshot(path: String, directory: URL) throws -> URL {
+        let root = directory.standardizedFileURL
+        let source = (path.hasPrefix("/") ? URL(fileURLWithPath: path) : root.appendingPathComponent(path))
+            .standardizedFileURL
+        try pluginRequire(
+            source.path.hasPrefix(root.path + "/")
+                && source.resolvingSymlinksInPath().path == root.resolvingSymlinksInPath().path
+                    + String(source.path.dropFirst(root.path.count)),
+            "File is outside plugin storage.")
+        return try copy(source: source, directory: root, temporary: true)
+    }
+
+    public static func importDownload(source: URL, directory: URL) throws -> URL {
+        try copy(source: source, directory: directory, temporary: false)
+    }
+
+    private static func copy(source: URL, directory: URL, temporary: Bool) throws -> URL {
+        lock.lock()
+        defer { lock.unlock() }
+        let used = try usage(directory)
+        let values = try source.resourceValues(forKeys: [.isRegularFileKey, .fileSizeKey, .isSymbolicLinkKey])
+        let size = Int64(values.fileSize ?? 0)
+        try pluginRequire(
+            values.isRegularFile == true && values.isSymbolicLink != true && size <= maximumFileSize
+                && used + size <= maximumStorage, "File quota exceeded.")
+        let output = directory.appendingPathComponent((temporary ? ".transfer-" : "download-") + UUID().uuidString)
+        _ = FileManager.default.createFile(atPath: output.path, contents: nil)
+        var complete = false
+        defer { if !complete { try? FileManager.default.removeItem(at: output) } }
+        let reader = try FileHandle(forReadingFrom: source)
+        let writer = try FileHandle(forWritingTo: output)
+        defer {
+            try? reader.close()
+            try? writer.close()
+        }
+        var copied: Int64 = 0
+        while let chunk = try reader.read(upToCount: 1024 * 1024), !chunk.isEmpty {
+            copied += Int64(chunk.count)
+            try pluginRequire(copied <= maximumFileSize && used + copied <= maximumStorage, "File grew beyond quota.")
+            try writer.write(contentsOf: chunk)
+        }
+        complete = true
+        return output
+    }
+}
diff --git a/Swiftgram/SGAdditionalCore/Sources/PluginManifest.swift b/Swiftgram/SGAdditionalCore/Sources/PluginManifest.swift
new file mode 100644
index 00000000..0d57804f
--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Sources/PluginManifest.swift
@@ -0,0 +1,256 @@
+import Foundation
+
+public enum PluginPermission: String, Codable, CaseIterable {
+    case incomingMessages, outgoingMessages, network, menus
+    case readMessages, sendMessages, editMessages, downloadMedia, sendMedia
+}
+
+public enum PluginEventKind: String, Codable {
+    case message, sendMessage, preRequest, postRequest
+
+    var permission: PluginPermission {
+        switch self {
+        case .message: return .incomingMessages
+        case .sendMessage: return .outgoingMessages
+        case .preRequest, .postRequest: return .network
+        }
+    }
+}
+
+public enum PluginStrategy: String, Codable {
+    case `default`, modify, modifyFinal, cancel
+}
+
+public enum PluginValue: Codable, Equatable {
+    case bool(Bool)
+    case integer(Int)
+    case string(String)
+
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.singleValueContainer()
+        if let value = try? container.decode(Bool.self) {
+            self = .bool(value)
+        } else if let value = try? container.decode(Int.self) {
+            self = .integer(value)
+        } else {
+            self = .string(try container.decode(String.self))
+        }
+    }
+
+    public func encode(to encoder: Encoder) throws {
+        var container = encoder.singleValueContainer()
+        switch self {
+        case .bool(let value): try container.encode(value)
+        case .integer(let value): try container.encode(value)
+        case .string(let value): try container.encode(value)
+        }
+    }
+
+    public var text: String {
+        switch self {
+        case .bool(let value): return value ? "true" : "false"
+        case .integer(let value): return String(value)
+        case .string(let value): return value
+        }
+    }
+
+    func sameType(as other: PluginValue) -> Bool {
+        switch (self, other) {
+        case (.bool, .bool), (.integer, .integer), (.string, .string): return true
+        default: return false
+        }
+    }
+
+    func validate() throws {
+        switch self {
+        case .string(let value): try pluginRequire(value.utf8.count <= 2048, "Setting text exceeds 2048 bytes.")
+        case .integer(let value):
+            try pluginRequire((-1_000_000...1_000_000).contains(value), "Setting number is out of range.")
+        case .bool: break
+        }
+    }
+}
+
+public struct PluginSetting: Codable, Equatable {
+    public let key: String
+    public let title: String
+    public let defaultValue: PluginValue
+    public var choices: [String]?
+
+    func validate(_ value: PluginValue) throws {
+        try pluginRequire(value.sameType(as: defaultValue), "Setting type changed: " + key)
+        try value.validate()
+        if let choices {
+            try pluginRequire(choices.contains(value.text), "Unknown choice: " + key)
+        }
+    }
+}
+
+public struct PluginHook: Codable, Equatable {
+    public let event: PluginEventKind
+    public let name: String
+    public var substring: Bool?
+    public var priority: Int?
+    public let callback: String
+
+    func matchesName(_ value: String) -> Bool {
+        substring == true ? !name.isEmpty && value.contains(name) : name == value
+    }
+}
+
+public struct PluginMenu: Codable, Equatable {
+    public enum Location: String, Codable { case message, settings }
+    public enum Action: String, Codable { case copyText, showText }
+    public let id: String
+    public let title: String
+    public let location: Location
+    public let callback: String
+    public let action: Action
+}
+
+public struct PluginDependency: Codable, Equatable {
+    public let name: String
+    public let version: String
+    public let filename: String
+    public let sha256: String
+    public let url: String
+    public let direct: Bool
+
+    public var pypiURL: URL? { URL(string: "https://pypi.org/project/" + name + "/" + version + "/") }
+}
+
+/// A review is bound to the source and the exact resolved artifacts in the manager.
+public struct PluginInstallation {
+    public let manifest: PluginManifest
+    public let dependencies: [PluginDependency]
+    let token: String
+}
+
+public struct PluginManifest: Codable, Equatable {
+    public var pythonSource: String
+    public var dependencies: [String]?
+    public var requiresPython: String?
+    public let schemaVersion: Int
+    public let id: String
+    public let name: String
+    public let version: String
+    public var author: String?
+    public var description: String?
+    public var sdkVersion: String?
+    public var appVersion: String?
+    public let permissions: [PluginPermission]
+    public let hooks: [PluginHook]
+    public let settings: [PluginSetting]
+    public let menus: [PluginMenu]
+
+    public func validate(hostVersion: String) throws {
+        try pluginRequire(
+            !pythonSource.isEmpty && pythonSource.utf8.count <= 256 * 1024,
+            "Python source must be present and at most 256 KB.")
+        try pluginRequire(schemaVersion == 1, "Unsupported plugin format.")
+        try pluginRequire(Self.validID(id), "Plugin ID must be 2–32 ASCII characters, starting with a letter.")
+        try pluginRequire(
+            !name.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty && name.utf8.count <= 120,
+            "Invalid plugin name.")
+        _ = try PluginVersion(version)
+        try pluginRequire(
+            (author?.utf8.count ?? 0) <= 120 && (description?.utf8.count ?? 0) <= 2048, "Plugin metadata is too long.")
+        if let sdkVersion { try PluginVersion.check(sdkVersion, current: "1.1") }
+        if let appVersion { try PluginVersion.check(appVersion, current: hostVersion) }
+        try pluginRequire(Set(permissions).count == permissions.count, "Duplicate permissions.")
+        try pluginRequire(
+            hooks.count <= 32 && settings.count <= 32 && menus.count <= 16, "Too many plugin registrations.")
+        try pluginRequire(
+            Set(settings.map(\.key)).count == settings.count && Set(menus.map(\.id)).count == menus.count,
+            "Duplicate setting or menu IDs.")
+        for setting in settings {
+            try pluginRequire(
+                Self.validID(setting.key) && !setting.title.isEmpty && setting.title.utf8.count <= 120,
+                "Invalid setting definition.")
+            if let choices = setting.choices {
+                try pluginRequire(
+                    !choices.isEmpty && choices.count <= 20 && Set(choices).count == choices.count,
+                    "Invalid setting choices.")
+                try pluginRequire(choices.allSatisfy { $0.utf8.count <= 120 }, "Setting choice is too long.")
+                guard case .string = setting.defaultValue else {
+                    throw SettingsError.invalid("Choices require a text setting.")
+                }
+            }
+            try setting.validate(setting.defaultValue)
+        }
+        for hook in hooks {
+            try pluginRequire(
+                permissions.contains(hook.event.permission),
+                "Hook requires permission: " + hook.event.permission.rawValue)
+            try pluginRequire(
+                !hook.name.isEmpty && hook.name.utf8.count <= 120 && (-1000...1000).contains(hook.priority ?? 0),
+                "Invalid event name or priority.")
+            try validateCallback(hook.callback)
+        }
+        for menu in menus {
+            try pluginRequire(
+                permissions.contains(.menus) && Self.validID(menu.id), "Menu permission or ID is invalid.")
+            if menu.location == .message {
+                try pluginRequire(
+                    permissions.contains(.incomingMessages), "Message menus require incomingMessages permission.")
+            }
+            try pluginRequire(!menu.title.isEmpty && menu.title.utf8.count <= 120, "Invalid menu title.")
+            try validateCallback(menu.callback)
+        }
+    }
+
+    private func validateCallback(_ callback: String) throws {
+        let bytes = Array(callback.utf8)
+        try pluginRequire(
+            !bytes.isEmpty && bytes.count <= 64
+                && bytes.allSatisfy {
+                    (65...90).contains($0) || (97...122).contains($0) || (48...57).contains($0) || $0 == 95
+                } && !((48...57).contains(bytes[0])), "Invalid Python callback name.")
+    }
+
+    public static func validID(_ value: String) -> Bool {
+        let bytes = Array(value.utf8)
+        func letter(_ byte: UInt8) -> Bool { (65...90).contains(byte) || (97...122).contains(byte) }
+        return (2...32).contains(bytes.count) && letter(bytes[0])
+            && bytes.dropFirst().allSatisfy { letter($0) || (48...57).contains($0) || $0 == 95 || $0 == 45 }
+    }
+}
+
+struct PluginVersion: Comparable {
+    let parts: [Int]
+    init(_ value: String) throws {
+        let components = value.split(separator: ".", omittingEmptySubsequences: false)
+        try pluginRequire((1...4).contains(components.count), "Invalid numeric plugin version.")
+        var numbers: [Int] = []
+        for component in components {
+            guard !component.isEmpty, component.utf8.allSatisfy({ (48...57).contains($0) }),
+                component.count <= 6, let number = Int(component)
+            else { throw SettingsError.invalid("Invalid numeric plugin version.") }
+            numbers.append(number)
+        }
+        parts = numbers + Array(repeating: 0, count: 4 - numbers.count)
+    }
+    static func < (lhs: Self, rhs: Self) -> Bool { lhs.parts.lexicographicallyPrecedes(rhs.parts) }
+    static func check(_ expression: String, current: String) throws {
+        let operators = [">=", "<=", "==", ">", "<"]
+        guard let op = operators.first(where: { expression.hasPrefix($0) }) else {
+            throw SettingsError.invalid("Version constraint needs >=, <=, ==, >, or <.")
+        }
+        let required = try Self(String(expression.dropFirst(op.count)).trimmingCharacters(in: .whitespaces))
+        let actual = try Self(current)
+        let accepted: Bool
+        switch op {
+        case ">=": accepted = actual >= required
+        case "<=": accepted = actual <= required
+        case ">": accepted = actual > required
+        case "<": accepted = actual < required
+        default: accepted = actual == required
+        }
+        try pluginRequire(
+            accepted, "Plugin is incompatible with version " + current + " (requires " + expression + ").")
+    }
+}
+
+func pluginRequire(_ condition: Bool, _ message: String) throws {
+    guard condition else { throw SettingsError.invalid(message) }
+}
