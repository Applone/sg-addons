index 0000000000000000000000000000000000000000..04c0d3835cb4151dad68fe935ba89aaac272b9a5
--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Sources/LocalProfileState.swift
@@ -0,0 +1,40 @@
+import Foundation
+
+/// The legacy record is preserved byte-for-byte except for an explicit badge selection.
+public final class AdditionalLocalProfileState {
+    public static let shared = AdditionalLocalProfileState()
+    private struct State: Codable { var serverUser: Data?; var badge: Data? }
+    private let lock = NSLock()
+    #if TESTING
+    private let defaults = UserDefaults(suiteName: "app.swiftgram.native-premium.tests.\(ProcessInfo.processInfo.processIdentifier)")!
+    #else
+    private let defaults = UserDefaults(suiteName: "app.swiftgram.ayu-addon")!
+    #endif
+    private var accounts: [String: State]
+    private init() {
+        accounts = defaults.data(forKey: "localPremiumState").flatMap { try? JSONDecoder().decode([String: State].self, from: $0) } ?? [:]
+    }
+    public func legacyServerUser(account: String) -> Data? {
+        lock.lock(); defer { lock.unlock() }; return accounts[account]?.serverUser
+    }
+    public func legacyProfileNeedsRestoration(account: String) -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        return accounts[account]?.serverUser != nil && !(defaults.stringArray(forKey: "nativeRestoredProfiles") ?? []).contains(account)
+    }
+    public func didRestoreLegacyProfile(account: String) {
+        lock.lock(); defer { lock.unlock() }
+        var values = defaults.stringArray(forKey: "nativeRestoredProfiles") ?? []
+        if !values.contains(account) { values.append(account); defaults.set(values, forKey: "nativeRestoredProfiles") }
+    }
+    public func badge(account: String) -> Data? {
+        lock.lock(); defer { lock.unlock() }; return accounts[account]?.badge
+    }
+    public func select(badge: Data, account: String) {
+        lock.lock()
+        var state = accounts[account] ?? State(); state.badge = badge
+        accounts[account] = state
+        if let data = try? JSONEncoder().encode(accounts) { defaults.set(data, forKey: "localPremiumState") }
+        lock.unlock()
+        DispatchQueue.main.async { NotificationCenter.default.post(name: Notification.Name("SGASettingsDidChange"), object: nil) }
+    }
+}
diff --git a/Swiftgram/SGAdditionalCore/Sources/MessageArchive.swift b/Swiftgram/SGAdditionalCore/Sources/MessageArchive.swift
new file mode 100644
index 0000000000000000000000000000000000000000..f9fa6267ac4ab931e1720d0a012a907437ff3b69
--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Sources/MessageArchive.swift
@@ -0,0 +1,293 @@
+import Foundation
+import SQLite3
+
+public struct MessageKey: Hashable {
+    public let account: String
+    public let chat: String
+    public let id: Int64
+    public init(account: String, chat: String, id: Int64) { self.account = account; self.chat = chat; self.id = id }
+}
+
+// The native Postbox remains the message store. This database records which
+// ordinary messages may be retained and which of them were remotely deleted.
+// Keep the previous path/schema so existing local data is not discarded.
+public final class MessageArchive {
+    public static let shared = MessageArchive()
+    private let queue = DispatchQueue(label: "app.swiftgram.functions.messages", qos: .utility)
+    private let lock = NSLock()
+    private var db: OpaquePointer?
+    private var eligible = Set<MessageKey>()
+    private var deleted = Set<MessageKey>()
+    private var excluded = Set<MessageKey>()
+    private var pending = Set<MessageKey>()
+    private var flushScheduled = false
+    private var lastHistoryPrune: [String: Date] = [:]
+    private var settingsObserver: NSObjectProtocol?
+    private var failure: String?
+    private let transient = unsafeBitCast(-1, to: sqlite3_destructor_type.self)
+
+    private init() {
+        queue.async { self.load(); self.pruneAllHistory() }
+        settingsObserver = NotificationCenter.default.addObserver(forName: Notification.Name("SGASettingsDidChange"), object: nil, queue: nil) { [weak self] _ in
+            self?.queue.async { [weak self] in self?.pruneAllHistory() }
+        }
+    }
+    deinit {
+        if let settingsObserver { NotificationCenter.default.removeObserver(settingsObserver) }
+        sqlite3_close(db)
+    }
+    private func pruneAllHistory() {
+        guard let sql = statement("SELECT DISTINCT account FROM revisions") else { return }
+        var accounts: [String] = []
+        while sqlite3_step(sql) == SQLITE_ROW { accounts.append(String(cString: sqlite3_column_text(sql, 0))) }
+        sqlite3_finalize(sql)
+        for account in accounts { pruneHistory(account: account, days: AddonSettings.shared.profile(account).retentionDays, force: true) }
+    }
+
+    private func load() {
+        do {
+            #if TESTING
+            let root = URL(fileURLWithPath: ProcessInfo.processInfo.environment["SGA_TEST_DIRECTORY"]!)
+            #else
+            let root = try FileManager.default.url(for: .applicationSupportDirectory,
+                in: .userDomainMask, appropriateFor: nil, create: true)
+            #endif
+            var directory = root.appendingPathComponent("SwiftgramAyu", isDirectory: true)
+            #if os(iOS)
+            let attributes: [FileAttributeKey: Any] = [.protectionKey: FileProtectionType.completeUntilFirstUserAuthentication]
+            #else
+            let attributes: [FileAttributeKey: Any] = [:]
+            #endif
+            try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true, attributes: attributes)
+            var values = URLResourceValues(); values.isExcludedFromBackup = true
+            try directory.setResourceValues(values)
+            guard sqlite3_open_v2(directory.appendingPathComponent("messages.sqlite3").path, &db,
+                SQLITE_OPEN_CREATE | SQLITE_OPEN_READWRITE | SQLITE_OPEN_FULLMUTEX, nil) == SQLITE_OK else {
+                throw SettingsError.invalid("Cannot open retained-message metadata.")
+            }
+            sqlite3_busy_timeout(db, 1000)
+            try execute("PRAGMA journal_mode=WAL")
+            try execute("""
+                CREATE TABLE IF NOT EXISTS messages (
+                  account TEXT NOT NULL, chat TEXT NOT NULL, id INTEGER NOT NULL,
+                  sender TEXT NOT NULL, body TEXT NOT NULL, date INTEGER NOT NULL,
+                  seen INTEGER NOT NULL, deleted INTEGER, wire BLOB NOT NULL,
+                  PRIMARY KEY(account,chat,id))
+                """)
+            try execute("CREATE INDEX IF NOT EXISTS retained_message_ids ON messages(account,id)")
+            try execute("""
+                CREATE TABLE IF NOT EXISTS revisions (
+                  sequence INTEGER PRIMARY KEY AUTOINCREMENT,
+                  account TEXT NOT NULL, chat TEXT NOT NULL, id INTEGER NOT NULL,
+                  version INTEGER NOT NULL, observed INTEGER NOT NULL,
+                  payload BLOB NOT NULL)
+                """)
+            try execute("CREATE INDEX IF NOT EXISTS revision_keys ON revisions(account,chat,id,version,sequence)")
+            try execute("CREATE INDEX IF NOT EXISTS revision_expiry ON revisions(account,observed)")
+            guard let sql = statement("SELECT account,chat,id,deleted FROM messages") else { return }
+            defer { sqlite3_finalize(sql) }
+            lock.lock(); defer { lock.unlock() }
+            while sqlite3_step(sql) == SQLITE_ROW {
+                let key = MessageKey(account: String(cString: sqlite3_column_text(sql, 0)),
+                    chat: String(cString: sqlite3_column_text(sql, 1)), id: sqlite3_column_int64(sql, 2))
+                if excluded.contains(key) { continue }
+                eligible.insert(key)
+                if sqlite3_column_type(sql, 3) != SQLITE_NULL { deleted.insert(key) }
+            }
+        } catch { setFailure(error.localizedDescription) }
+    }
+    private func setFailure(_ value: String) { lock.lock(); failure = value; lock.unlock() }
+    private func execute(_ sql: String) throws {
+        guard sqlite3_exec(db, sql, nil, nil, nil) == SQLITE_OK else {
+            throw SettingsError.invalid("Retained-message metadata could not be updated.")
+        }
+    }
+    private func statement(_ query: String) -> OpaquePointer? {
+        guard db != nil else { return nil }
+        var sql: OpaquePointer?
+        guard sqlite3_prepare_v2(db, query, -1, &sql, nil) == SQLITE_OK else {
+            setFailure("Retained-message query failed."); return nil
+        }
+        return sql
+    }
+    private func bind(_ sql: OpaquePointer, _ index: Int32, _ text: String) {
+        _ = text.withCString { sqlite3_bind_text(sql, index, $0, -1, transient) }
+    }
+    public func observe(_ key: MessageKey) {
+        lock.lock()
+        guard !excluded.contains(key), eligible.insert(key).inserted else { lock.unlock(); return }
+        pending.insert(key)
+        let schedule = !flushScheduled
+        flushScheduled = true
+        lock.unlock()
+        if schedule { queue.asyncAfter(deadline: .now() + 0.1) { self.flush() } }
+    }
+    public func exclude(_ key: MessageKey) {
+        lock.lock(); excluded.insert(key); eligible.remove(key); deleted.remove(key); pending.remove(key); lock.unlock()
+        queue.async {
+            for table in ["messages", "revisions"] {
+                guard let sql = self.statement("DELETE FROM \(table) WHERE account=? AND chat=? AND id=?") else { continue }
+                self.bind(sql, 1, key.account); self.bind(sql, 2, key.chat); sqlite3_bind_int64(sql, 3, key.id)
+                if sqlite3_step(sql) != SQLITE_DONE { self.setFailure("Removing expiring message data failed.") }
+                sqlite3_finalize(sql)
+            }
+        }
+    }
+    private func flush() {
+        lock.lock(); let batch = pending; pending.removeAll(keepingCapacity: true); flushScheduled = false; lock.unlock()
+        guard !batch.isEmpty, db != nil else { return }
+        do {
+            try execute("BEGIN IMMEDIATE")
+            defer { try? execute("COMMIT") }
+            guard let sql = statement("""
+                INSERT INTO messages(account,chat,id,sender,body,date,seen,wire)
+                VALUES(?,?,?,'','',0,?,zeroblob(0))
+                ON CONFLICT(account,chat,id) DO NOTHING
+                """) else { return }
+            defer { sqlite3_finalize(sql) }
+            for key in batch {
+                sqlite3_reset(sql); sqlite3_clear_bindings(sql)
+                bind(sql, 1, key.account); bind(sql, 2, key.chat); sqlite3_bind_int64(sql, 3, key.id)
+                sqlite3_bind_int64(sql, 4, Int64(Date().timeIntervalSince1970))
+
+                if sqlite3_step(sql) != SQLITE_DONE { setFailure("Saving retained-message metadata failed.") }
+            }
+        } catch { setFailure(error.localizedDescription) }
+    }
+
+    // Return only known, non-expiring messages. Unknown/secret/TTL deletions
+    // continue through the host. Preserve every update's pts and ptsCount.
+    public func retain(account: String, channel: Int64?, ids: [Int64]) -> Set<Int64> {
+        // Wait for the initial metadata read on the update-processing thread,
+        // never from the rendering path. This also drains pending captures.
+        queue.sync { flush() }
+        let wanted = Set(ids)
+        let channelChat = channel.map { "channel:\($0)" }
+        lock.lock()
+        let keys = eligible.filter { key in key.account == account && wanted.contains(key.id) &&
+            (channelChat.map { key.chat == $0 } ?? !key.chat.hasPrefix("channel:")) }
+        deleted.formUnion(keys)
+        lock.unlock()
+        guard !keys.isEmpty else { return [] }
+        queue.async {
+            do {
+                try self.execute("BEGIN IMMEDIATE")
+                defer { try? self.execute("COMMIT") }
+                guard let sql = self.statement("UPDATE messages SET deleted=COALESCE(deleted,?) WHERE account=? AND chat=? AND id=?") else { return }
+                defer { sqlite3_finalize(sql) }
+                for key in keys {
+                    sqlite3_reset(sql); sqlite3_clear_bindings(sql)
+                    sqlite3_bind_int64(sql, 1, Int64(Date().timeIntervalSince1970))
+                    self.bind(sql, 2, key.account); self.bind(sql, 3, key.chat); sqlite3_bind_int64(sql, 4, key.id)
+                    if sqlite3_step(sql) != SQLITE_DONE { self.setFailure("Marking a retained message failed.") }
+                }
+            } catch { self.setFailure(error.localizedDescription) }
+        }
+        DispatchQueue.main.async { NotificationCenter.default.post(name: .retainedMessagesChanged, object: nil) }
+        return Set(keys.map(\.id))
+    }
+    public func retain(_ key: MessageKey) -> Bool {
+        queue.sync { flush() }
+        lock.lock()
+        let allowed = eligible.contains(key) && !excluded.contains(key)
+        lock.unlock()
+        guard allowed else { return false }
+        var saved = false
+        queue.sync {
+            guard let sql = statement("UPDATE messages SET deleted=COALESCE(deleted,?) WHERE account=? AND chat=? AND id=?") else { return }
+            defer { sqlite3_finalize(sql) }
+            sqlite3_bind_int64(sql, 1, Int64(Date().timeIntervalSince1970))
+            bind(sql, 2, key.account); bind(sql, 3, key.chat); sqlite3_bind_int64(sql, 4, key.id)
+            saved = sqlite3_step(sql) == SQLITE_DONE && sqlite3_changes(db) > 0
+        }
+        guard saved else { return false }
+        lock.lock(); deleted.insert(key); lock.unlock()
+        DispatchQueue.main.async { NotificationCenter.default.post(name: .retainedMessagesChanged, object: nil) }
+        return true
+    }
+
+    /// Complete queued snapshots before allowing Postbox to replace their source.
+    public func synchronize() { queue.sync { flush() } }
+
+    public func capture(_ revision: MessageRevision, key: MessageKey, retentionDays: Int) {
+        lock.lock(); let allowed = !excluded.contains(key); lock.unlock()
+        guard allowed else { return }
+        queue.async {
+            self.lock.lock(); let excluded = self.excluded.contains(key); self.lock.unlock()
+            guard !excluded else { return }
+            self.pruneHistory(account: key.account, days: retentionDays)
+            // Compare with the latest snapshot no newer than this observation.
+            // A delayed history response must not replace a newer revision.
+            let previous = self.readHistory(key).last(where: { $0.version <= revision.version })
+            if let previous, previous.text == revision.text && previous.entities == revision.entities { return }
+            guard let payload = try? JSONEncoder().encode(revision), let sql = self.statement("""
+                INSERT INTO revisions(account,chat,id,version,observed,payload) VALUES(?,?,?,?,?,?)
+                """) else { return }
+            defer { sqlite3_finalize(sql) }
+            self.bind(sql, 1, key.account); self.bind(sql, 2, key.chat); sqlite3_bind_int64(sql, 3, key.id)
+            sqlite3_bind_int64(sql, 4, revision.version)
+            sqlite3_bind_int64(sql, 5, Int64(Date().timeIntervalSince1970))
+            _ = payload.withUnsafeBytes { sqlite3_bind_blob(sql, 6, $0.baseAddress, Int32($0.count), self.transient) }
+            if sqlite3_step(sql) != SQLITE_DONE { self.setFailure("Saving message history failed.") }
+        }
+    }
+    private func pruneHistory(account: String, days: Int, force: Bool = false) {
+        let now = Date()
+        guard force || now.timeIntervalSince(lastHistoryPrune[account] ?? .distantPast) > 60 else { return }
+        guard let sql = statement("DELETE FROM revisions WHERE account=? AND observed<?") else { return }
+        defer { sqlite3_finalize(sql) }
+        bind(sql, 1, account); sqlite3_bind_int64(sql, 2, Int64(now.timeIntervalSince1970) - Int64(days) * 86400)
+        if sqlite3_step(sql) == SQLITE_DONE { lastHistoryPrune[account] = now }
+        else { setFailure("Expiring message history failed.") }
+    }
+    private func readHistory(_ key: MessageKey) -> [MessageRevision] {
+        guard let sql = statement("SELECT payload FROM revisions WHERE account=? AND chat=? AND id=? ORDER BY version,sequence") else { return [] }
+        defer { sqlite3_finalize(sql) }
+        bind(sql, 1, key.account); bind(sql, 2, key.chat); sqlite3_bind_int64(sql, 3, key.id)
+        var result: [MessageRevision] = []
+        while sqlite3_step(sql) == SQLITE_ROW {
+            guard let bytes = sqlite3_column_blob(sql, 0) else { continue }
+            let data = Data(bytes: bytes, count: Int(sqlite3_column_bytes(sql, 0)))
+            if let revision = try? JSONDecoder().decode(MessageRevision.self, from: data) { result.append(revision) }
+        }
+        return result
+    }
+    public func history(_ key: MessageKey, completion: @escaping ([MessageRevision]) -> Void) {
+        queue.async {
+            self.pruneHistory(account: key.account, days: AddonSettings.shared.profile(key.account).retentionDays, force: true)
+            let revisions = self.readHistory(key)
+            DispatchQueue.main.async { completion(revisions) }
+        }
+    }
+    public func clearHistory(account: String?, completion: @escaping (Bool) -> Void) {
+        queue.async {
+            // The default settings page clears all accounts; an account page clears only itself.
+            guard let sql = self.statement(account == nil ? "DELETE FROM revisions" : "DELETE FROM revisions WHERE account=?") else {
+                DispatchQueue.main.async { completion(false) }; return
+            }
+            if let account { self.bind(sql, 1, account) }
+            let success = sqlite3_step(sql) == SQLITE_DONE
+            sqlite3_finalize(sql)
+            DispatchQueue.main.async { completion(success) }
+        }
+    }
+    #if TESTING
+    public func pruneHistoryForTesting(account: String, days: Int) { queue.sync { pruneHistory(account: account, days: days, force: true) } }
+    public func clearHistoryForTesting(account: String) { queue.sync {
+        guard let sql = statement("DELETE FROM revisions WHERE account=?") else { return }
+        bind(sql, 1, account); _ = sqlite3_step(sql); sqlite3_finalize(sql)
+    } }
+    public func historyForTesting(_ key: MessageKey) -> [MessageRevision] { queue.sync { readHistory(key) } }
+    #endif
+    public func isDeleted(_ key: MessageKey) -> Bool {
+        lock.lock(); defer { lock.unlock() }; return deleted.contains(key)
+    }
+    public func status() -> String? { lock.lock(); defer { lock.unlock() }; return failure }
+    #if TESTING
+    public func drain() { queue.sync { flush() } }
+    #endif
+}
+
+extension Notification.Name {
+    public static let retainedMessagesChanged = Notification.Name("SGARetainedMessagesChanged")
+}
