+import Foundation
+#if os(Linux)
+import Glibc
+#else
+import Darwin
+#endif
+
+struct CheckCore {
+    static func require(_ condition: @autoclosure () -> Bool, _ label: String) {
+        guard condition() else { fatalError("FAILED: " + label) }
+    }
+}
+
+@main struct NativeCoreChecks {
+    static func main() throws {
+        let root = FileManager.default.temporaryDirectory.appendingPathComponent("swiftgram-native-tests-" + UUID().uuidString)
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)
+        setenv("SGA_TEST_DIRECTORY", root.path, 1)
+        defer { try? FileManager.default.removeItem(at: root) }
+        let suite = "app.swiftgram.functions.tests.\(ProcessInfo.processInfo.processIdentifier)"
+        let defaults = UserDefaults(suiteName: suite)!
+        defaults.removePersistentDomain(forName: suite)
+        defer { defaults.removePersistentDomain(forName: suite) }
+        // Fixtures use the old suite keys and Codable shape.
+        defaults.set(Data(#"{"default":{"ghostEnabled":true,"hideRead":true,"saveEditHistory":true},"88":{"ghostEnabled":false}}"#.utf8), forKey: "profiles")
+        CheckCore.require(AddonSettings.shared.profile("77").ghostEnabled, "legacy default profile")
+        CheckCore.require(!AddonSettings.shared.profile("88").ghostEnabled, "legacy account override")
+        CheckCore.require(AdditionalPrivacy.suppress(.read, account: "77", chat: "user:42"), "hide reads")
+        CheckCore.require(!AdditionalPrivacy.suppress(.read, account: "88", chat: "user:42"), "privacy account isolation")
+        var profile = AddonSettings.shared.profile("77")
+        profile.ghostExceptions = ["user:42"]
+        try AddonSettings.shared.save(profile, account: "77")
+        CheckCore.require(!AdditionalPrivacy.suppress(.read, account: "77", chat: "user:42"), "chat exception")
+        CheckCore.require(AdditionalPrivacy.suppress(.online, account: "77", chat: "user:42"), "online applies to account")
+        CheckCore.require(!AdditionalPrivacy.suppress(.cancel, account: "77"), "cancel is transmitted")
+        try HistoryChecks.run(root: root)
+        let key = MessageKey(account: "77", chat: "user:42", id: 1)
+        let other = MessageKey(account: "77", chat: "channel:42", id: 1)
+        MessageArchive.shared.observe(key)
+        CheckCore.require(MessageArchive.shared.retain(key), "typed retention persists deletion")
+        CheckCore.require(!MessageArchive.shared.retain(other), "typed retention never collides across chats")
+        MessageArchive.shared.exclude(key)
+        CheckCore.require(!MessageArchive.shared.retain(key), "TTL exclusion overrides retention")
+        var rule = FilterRule(); rule.pattern = "spam"; rule.chats = ["user:42"]
+        profile.filters = [rule]; profile.filtersEnabled = true
+        let filters = CompiledFilters()
+        CheckCore.require(filters.matches(text: "SPAM", chat: "user:42", authors: [], profile: profile, account: "77"), "legacy filter semantics")
+        CheckCore.require(!filters.matches(text: "spam", chat: "channel:42", authors: [], profile: profile, account: "77"), "filter chat namespace")
+        rule.mode = "regex"; rule.pattern = "["
+        do { try rule.validate(); fatalError("invalid regex accepted") } catch { }
+        let premiumSuite = "app.swiftgram.native-premium.tests.\(ProcessInfo.processInfo.processIdentifier)"
+        let premiumDefaults = UserDefaults(suiteName: premiumSuite)!
+        premiumDefaults.removePersistentDomain(forName: premiumSuite)
+        defer { premiumDefaults.removePersistentDomain(forName: premiumSuite) }
+        let legacy: [String: [String: Data]] = ["77": ["serverUser": Data([1, 2]), "badge": Data([3, 4])]]
+        premiumDefaults.set(try JSONEncoder().encode(legacy), forKey: "localPremiumState")
+        CheckCore.require(AdditionalLocalProfileState.shared.badge(account: "77") == Data([3, 4]), "legacy badge imported")
+        AdditionalLocalProfileState.shared.select(badge: Data([0]), account: "77")
+        let saved = try JSONDecoder().decode([String: [String: Data]].self, from: premiumDefaults.data(forKey: "localPremiumState")!)
+        CheckCore.require(saved["77"]?["serverUser"] == Data([1, 2]), "badge changes preserve legacy server snapshot")
+        CheckCore.require(AdditionalLocalProfileState.shared.badge(account: "88") == nil, "badge account isolation")
+        print("Native core checks passed: legacy settings, revisions, expiry, retention, privacy, filters, local badge storage")
+    }
+}
