@@ -0,0 +1,22 @@
+import Foundation
+
+public struct RevisionEntity: Codable, Equatable {
+    public let kind: String
+    public let offset: Int
+    public let length: Int
+    public let value: String?
+    public init(kind: String, offset: Int, length: Int, value: String? = nil) {
+        self.kind = kind; self.offset = offset; self.length = length; self.value = value
+    }
+}
+
+public struct MessageRevision: Codable, Equatable {
+    public let text: String
+    public let entities: [RevisionEntity]
+    public let messageDate: Int64
+    public let editDate: Int64?
+    public var version: Int64 { editDate ?? messageDate }
+    public init(text: String, entities: [RevisionEntity], messageDate: Int64, editDate: Int64?) {
+        self.text = text; self.entities = entities; self.messageDate = messageDate; self.editDate = editDate
+    }
+}
diff --git a/Swiftgram/SGAdditionalCore/Sources/Privacy.swift b/Swiftgram/SGAdditionalCore/Sources/Privacy.swift
new file mode 100644
index 0000000000000000000000000000000000000000..b3b29bd49a0ddf7632d7365671e17dd9c230d4b5
--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Sources/Privacy.swift
@@ -0,0 +1,19 @@
+import Foundation
+
+public enum AdditionalPrivacyAction { case read, story, typing, upload, online, cancel }
+
+public enum AdditionalPrivacy {
+    public static func suppress(_ action: AdditionalPrivacyAction, account: String, chat: String? = nil) -> Bool {
+        let profile = AddonSettings.shared.profile(account)
+        guard profile.ghostEnabled else { return false }
+        if action != .online, let chat, profile.ghostExceptions.contains(chat) { return false }
+        switch action {
+        case .read: return profile.hideRead
+        case .story: return profile.hideStories
+        case .typing: return profile.hideTyping
+        case .upload: return profile.hideUpload
+        case .online: return profile.hideOnline
+        case .cancel: return false
+        }
+    }
+}
diff --git a/Swiftgram/SGAdditionalCore/Sources/Settings.swift b/Swiftgram/SGAdditionalCore/Sources/Settings.swift
new file mode 100644
index 0000000000000000000000000000000000000000..1472f7142b85b821b0e2fdc5f2a00164659a6272
--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Sources/Settings.swift
@@ -0,0 +1,211 @@
+import Foundation
+
+public struct FilterRule: Codable, Equatable {
+    public var enabled = true
+    public var pattern = ""
+    public var mode = "contains"
+    public var caseSensitive = false
+    public var reversed = false
+    public var chats: [String] = []
+    public var excludeChats: [String] = []
+    public var users: [String] = []
+
+    public init() {}
+    private enum CodingKeys: String, CodingKey {
+        case enabled, pattern, mode, caseSensitive, reversed, chats, excludeChats, users
+    }
+    public init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        enabled = try values.decodeIfPresent(Bool.self, forKey: .enabled) ?? true
+        pattern = try values.decodeIfPresent(String.self, forKey: .pattern) ?? ""
+        mode = try values.decodeIfPresent(String.self, forKey: .mode) ?? "contains"
+        caseSensitive = try values.decodeIfPresent(Bool.self, forKey: .caseSensitive) ?? false
+        reversed = try values.decodeIfPresent(Bool.self, forKey: .reversed) ?? false
+        chats = try values.decodeIfPresent([String].self, forKey: .chats) ?? []
+        excludeChats = try values.decodeIfPresent([String].self, forKey: .excludeChats) ?? []
+        users = try values.decodeIfPresent([String].self, forKey: .users) ?? []
+    }
+
+    public func validate() throws {
+        guard pattern.utf16.count <= 2048 else {
+            throw SettingsError.invalid("Filter patterns may contain at most 2,048 characters.")
+        }
+        guard ["contains", "word", "regex"].contains(mode) else {
+            throw SettingsError.invalid("Filter mode must be contains, word, or regex.")
+        }
+        guard !pattern.isEmpty || !users.isEmpty else {
+            throw SettingsError.invalid("A filter needs a pattern or user IDs.")
+        }
+        if mode == "regex" { _ = try NSRegularExpression(pattern: pattern) }
+        for peer in chats + excludeChats + users {
+            guard let kind = peer.split(separator: ":").first,
+                  ["user", "chat", "channel"].contains(String(kind)),
+                  peer.split(separator: ":").count == 2,
+                  let id = Int64(peer.split(separator: ":")[1]), id > 0 else {
+                throw SettingsError.invalid("Peer IDs use user:123, chat:123, or channel:123.")
+            }
+        }
+    }
+}
+
+public enum SettingsError: LocalizedError {
+    case invalid(String)
+    public var errorDescription: String? { if case let .invalid(text) = self { return text }; return nil }
+}
+
+public struct AddonProfile: Codable {
+    public var ghostEnabled = false
+    public var hideRead = true
+    public var hideStories = true
+    public var hideOnline = true
+    public var hideTyping = true
+    public var hideUpload = true
+    public var ghostExceptions: [String] = []
+    public var saveDeleted = false
+    public var dimDeleted = true
+    public var retentionDays = 30
+    public var filtersEnabled = false
+    public var filters: [FilterRule] = []
+    public var saveEditHistory = false
+    public var localPremium = false
+
+    public init() {}
+    private enum CodingKeys: String, CodingKey {
+        case ghostEnabled, hideRead, hideStories, hideOnline, hideTyping, hideUpload
+        case ghostExceptions, saveDeleted, dimDeleted, retentionDays, filtersEnabled, filters, localPremium, saveEditHistory
+    }
+    public init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        ghostEnabled = try values.decodeIfPresent(Bool.self, forKey: .ghostEnabled) ?? false
+        hideRead = try values.decodeIfPresent(Bool.self, forKey: .hideRead) ?? true
+        hideStories = try values.decodeIfPresent(Bool.self, forKey: .hideStories) ?? true
+        hideOnline = try values.decodeIfPresent(Bool.self, forKey: .hideOnline) ?? true
+        hideTyping = try values.decodeIfPresent(Bool.self, forKey: .hideTyping) ?? true
+        hideUpload = try values.decodeIfPresent(Bool.self, forKey: .hideUpload) ?? true
+        ghostExceptions = try values.decodeIfPresent([String].self, forKey: .ghostExceptions) ?? []
+        saveDeleted = try values.decodeIfPresent(Bool.self, forKey: .saveDeleted) ?? false
+        dimDeleted = try values.decodeIfPresent(Bool.self, forKey: .dimDeleted) ?? true
+        retentionDays = try values.decodeIfPresent(Int.self, forKey: .retentionDays) ?? 30
+        filtersEnabled = try values.decodeIfPresent(Bool.self, forKey: .filtersEnabled) ?? false
+        filters = try values.decodeIfPresent([FilterRule].self, forKey: .filters) ?? []
+        saveEditHistory = try values.decodeIfPresent(Bool.self, forKey: .saveEditHistory) ?? false
+        localPremium = try values.decodeIfPresent(Bool.self, forKey: .localPremium) ?? false
+        try validate()
+    }
+
+    public func validate() throws {
+        guard (1...365).contains(retentionDays) else {
+            throw SettingsError.invalid("Retention must be between 1 and 365 days.")
+        }
+        guard filters.count <= 200 else { throw SettingsError.invalid("Maximum 200 filters.") }
+        for rule in filters { try rule.validate() }
+        if !ghostExceptions.isEmpty {
+            var rule = FilterRule()
+            rule.pattern = "validation"
+            rule.chats = ghostExceptions
+            try rule.validate()
+        }
+    }
+}
+
+public final class AddonSettings {
+    public static let shared = AddonSettings()
+    private let lock = NSLock()
+    #if TESTING
+    private let defaults = UserDefaults(suiteName: "app.swiftgram.functions.tests.\(ProcessInfo.processInfo.processIdentifier)")!
+    #else
+    private let defaults = UserDefaults(suiteName: "app.swiftgram.ayu-addon")!
+    #endif
+    private var profiles: [String: AddonProfile]
+    private var revision = 0
+    private var enabled = false
+    private var retaining = false
+
+    private init() {
+        profiles = defaults.data(forKey: "profiles").flatMap {
+            try? JSONDecoder().decode([String: AddonProfile].self, from: $0)
+        } ?? [:]
+        updateEnabled()
+    }
+    private func updateEnabled() {
+        enabled = profiles.values.contains { $0.ghostEnabled || $0.saveDeleted || $0.filtersEnabled || $0.localPremium || $0.saveEditHistory }
+        retaining = profiles.values.contains(where: \.saveDeleted)
+    }
+    public func anyEnabled() -> Bool { lock.lock(); defer { lock.unlock() }; return enabled }
+    public func anyHistoryEnabled() -> Bool { lock.lock(); defer { lock.unlock() }; return profiles.values.contains(where: \.saveEditHistory) }
+    public func anyRetentionEnabled() -> Bool { lock.lock(); defer { lock.unlock() }; return retaining }
+    public func profile(_ account: String?) -> AddonProfile {
+        lock.lock(); defer { lock.unlock() }
+        return profiles[account ?? "default"] ?? profiles["default"] ?? AddonProfile()
+    }
+    public func version() -> Int { lock.lock(); defer { lock.unlock() }; return revision }
+    public func save(_ profile: AddonProfile, account: String?) throws {
+        try profile.validate()
+        lock.lock(); defer { lock.unlock() }
+        var next = profiles
+        next[account ?? "default"] = profile
+        let bytes = try JSONEncoder().encode(next)
+        defaults.set(bytes, forKey: "profiles")
+        profiles = next
+        updateEnabled()
+        revision += 1
+        DispatchQueue.main.async {
+            NotificationCenter.default.post(name: Notification.Name("SGASettingsDidChange"), object: nil)
+        }
+    }
+    public func accounts() -> [String] {
+        lock.lock(); defer { lock.unlock() }
+        return profiles.keys.filter { $0 != "default" }.sorted()
+    }
+}
+
+public final class CompiledFilters {
+    public init() {}
+    private var version = -1
+    private var account: String?
+    private var rules: [(FilterRule, NSRegularExpression?)] = []
+
+    // Called under the engine's serial lock. Regex objects are reused per revision.
+    public func matches(text: String, chat: String, authors: [String], profile: AddonProfile, account: String?) -> Bool {
+        guard profile.filtersEnabled else { return false }
+        let currentVersion = AddonSettings.shared.version()
+        if version != currentVersion || self.account != account {
+            version = currentVersion
+            self.account = account
+            rules = profile.filters.filter(\.enabled).map { rule in
+                let pattern: String
+                switch rule.mode {
+                case "regex": pattern = rule.pattern
+                case "word": pattern = "\\b" + NSRegularExpression.escapedPattern(for: rule.pattern) + "\\b"
+                default: pattern = NSRegularExpression.escapedPattern(for: rule.pattern)
+                }
+                let regex = rule.pattern.isEmpty ? nil : try? NSRegularExpression(
+                    pattern: pattern, options: rule.caseSensitive ? [] : [.caseInsensitive])
+                return (rule, regex)
+            }
+        }
+        let deadline = Date().addingTimeInterval(0.025)
+        for (rule, regex) in rules {
+            if Date() > deadline { return false }
+            if !rule.chats.isEmpty && !rule.chats.contains(chat) { continue }
+            if rule.excludeChats.contains(chat) { continue }
+            if !rule.users.isEmpty && !authors.contains(where: rule.users.contains) { continue }
+            if rule.pattern.isEmpty { return true }
+            var found = false
+            var timedOut = false
+            let started = Date()
+            regex?.enumerateMatches(in: text, options: [.reportProgress], range: NSRange(text.startIndex..., in: text)) { match, _, stop in
+                if Date() > deadline || Date().timeIntervalSince(started) > 0.02 {
+                    timedOut = true
+                    stop.pointee = true
+                } else if match != nil {
+                    found = true
+                    stop.pointee = true
+                }
+            }
+            if timedOut { continue }
+            if rule.reversed ? !found : found { return true }
+        }
+        return false
+    }
+}
diff --git a/Swiftgram/SGAdditionalCore/Tests/History.swift b/Swiftgram/SGAdditionalCore/Tests/History.swift
new file mode 100644
index 0000000000000000000000000000000000000000..31e3982bb76515d2d30cbc1148e382472fac047c
--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Tests/History.swift
@@ -0,0 +1,46 @@
+import Foundation
+import SQLite3
+
+enum HistoryChecks {
+    static func run(root: URL) throws {
+        let key = MessageKey(account: "77", chat: "user:42", id: 811)
+        let otherAccount = MessageKey(account: "88", chat: key.chat, id: key.id)
+        let otherChat = MessageKey(account: key.account, chat: "channel:42", id: key.id)
+        let bold = RevisionEntity(kind: "messageEntityBold", offset: 0, length: 5, value: nil)
+        let original = MessageRevision(text: "First caption", entities: [bold], messageDate: 100, editDate: nil)
+        let edit = MessageRevision(text: "Edited caption", entities: [], messageDate: 100, editDate: 120)
+        let intermediate = MessageRevision(text: "Intermediate", entities: [], messageDate: 100, editDate: 110)
+        let archive = MessageArchive.shared
+        archive.capture(original, key: key, retentionDays: 30)
+        archive.capture(edit, key: key, retentionDays: 30)
+        archive.capture(edit, key: key, retentionDays: 30)
+        archive.capture(intermediate, key: key, retentionDays: 30)
+        archive.capture(original, key: key, retentionDays: 30)
+        CheckCore.require(archive.historyForTesting(key) == [original, intermediate, edit], "ordered, deduplicated revisions; stale fetch cannot replace latest")
+        archive.capture(original, key: otherAccount, retentionDays: 30)
+        archive.capture(edit, key: otherChat, retentionDays: 30)
+        CheckCore.require(archive.historyForTesting(otherAccount) == [original], "revision account isolation")
+        CheckCore.require(archive.historyForTesting(otherChat) == [edit], "revision chat namespace isolation")
+        let formatEdit = MessageRevision(text: edit.text, entities: [bold], messageDate: 100, editDate: 121)
+        archive.capture(formatEdit, key: key, retentionDays: 30)
+        CheckCore.require(archive.historyForTesting(key).last == formatEdit, "formatting-only edit is retained")
+        let sameSecondA = MessageRevision(text: "A", entities: [], messageDate: 100, editDate: 122)
+        let sameSecondB = MessageRevision(text: "B", entities: [], messageDate: 100, editDate: 122)
+        for revision in [sameSecondA, sameSecondB, sameSecondA, sameSecondB] { archive.capture(revision, key: key, retentionDays: 30) }
+        CheckCore.require(Array(archive.historyForTesting(key).suffix(4)) == [sameSecondA, sameSecondB, sameSecondA, sameSecondB], "repeated text edits within one second preserve reversions")
+        archive.exclude(key)
+        archive.capture(edit, key: key, retentionDays: 30)
+        CheckCore.require(archive.historyForTesting(key).isEmpty, "TTL exclusion purges revisions and blocks future captures")
+
+        var db: OpaquePointer?
+        CheckCore.require(sqlite3_open(root.appendingPathComponent("SwiftgramAyu/messages.sqlite3").path, &db) == SQLITE_OK, "history persisted database")
+        CheckCore.require(sqlite3_exec(db, "UPDATE revisions SET observed=1 WHERE account='88'", nil, nil, nil) == SQLITE_OK, "expiry fixture")
+        sqlite3_close(db)
+        archive.pruneHistoryForTesting(account: "88", days: 30)
+        CheckCore.require(archive.historyForTesting(otherAccount).isEmpty, "revision expiry is persisted")
+        CheckCore.require(archive.historyForTesting(otherChat) == [edit], "expiry respects accounts")
+        archive.clearHistoryForTesting(account: "77")
+        CheckCore.require(archive.historyForTesting(otherChat).isEmpty, "clear account history")
+
+    }
+}
diff --git a/Swiftgram/SGAdditionalCore/Tests/Main.swift b/Swiftgram/SGAdditionalCore/Tests/Main.swift
