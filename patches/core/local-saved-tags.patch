--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Sources/LocalSavedMessageTags.swift
@@ -0,0 +1,16 @@
+import Foundation
+
+public enum LocalSavedMessageTags {
+    public static func useLocalStorage(localPremium: Bool, serverPremium: Bool) -> Bool {
+        localPremium && !serverPremium
+    }
+
+    /// Keep the newest selections when the per-message limit is reached.
+    public static func updated<Reaction: Equatable>(
+        current: [Reaction], selected: [Reaction], add: Bool, limit: Int
+    ) -> [Reaction] {
+        var result = add ? current.filter { !selected.contains($0) } : []
+        for reaction in selected where !result.contains(reaction) { result.append(reaction) }
+        return Array(result.suffix(max(0, limit)))
+    }
+}
diff --git a/Swiftgram/SGAdditionalCore/Tests/LocalSavedTagChecks.swift b/Swiftgram/SGAdditionalCore/Tests/LocalSavedTagChecks.swift
new file mode 100644
index 00000000..59558eab
--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Tests/LocalSavedTagChecks.swift
@@ -0,0 +1,32 @@
+import Foundation
+
+enum LocalSavedTagChecks {
+    static func run() throws {
+        CheckCore.require(
+            LocalSavedMessageTags.useLocalStorage(localPremium: true, serverPremium: false),
+            "local Premium uses local tags for an unsubscribed account")
+        CheckCore.require(
+            !LocalSavedMessageTags.useLocalStorage(localPremium: false, serverPremium: false),
+            "local tags are opt in")
+        for local in [false, true] {
+            CheckCore.require(
+                !LocalSavedMessageTags.useLocalStorage(localPremium: local, serverPremium: true),
+                "subscribed accounts retain server tag synchronization")
+        }
+        let updated = LocalSavedMessageTags.updated(
+            current: ["old", "keep"], selected: ["new", "new"], add: true, limit: 2)
+        CheckCore.require(updated == ["keep", "new"], "new tags survive the reaction limit without duplicates")
+        CheckCore.require(
+            LocalSavedMessageTags.updated(current: updated, selected: ["keep"], add: false, limit: 2) == ["keep"],
+            "replacement removes unselected tags")
+        CheckCore.require(
+            LocalSavedMessageTags.updated(current: updated, selected: [], add: false, limit: 2).isEmpty,
+            "clearing tags persists an empty selection")
+        CheckCore.require(
+            LocalSavedMessageTags.updated(current: updated, selected: [], add: true, limit: 0).isEmpty,
+            "zero limits cannot retain tags")
+        let bytes = try JSONEncoder().encode(updated)
+        let restored = try JSONDecoder().decode([String].self, from: bytes)
+        CheckCore.require(restored == updated, "tag selection survives the Postbox payload round trip")
+    }
+}
