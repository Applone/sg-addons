diff --git a/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalLocalSavedTags.swift b/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalLocalSavedTags.swift
new file mode 100644
index 00000000..379ed7c7
--- /dev/null
+++ b/submodules/TelegramCore/Sources/AdditionalFunctions/AdditionalLocalSavedTags.swift
@@ -0,0 +1,101 @@
+import Foundation
+import Postbox
+import SGAdditionalCore
+
+func additionalUseLocalSavedTags(account: PeerId, serverPremium: Bool) -> Bool {
+    LocalSavedMessageTags.useLocalStorage(
+        localPremium: AddonSettings.shared.profile(additionalAccountKey(account)).localPremium,
+        serverPremium: serverPremium)
+}
+
+func additionalUseLocalSavedTags(transaction: Transaction, account: PeerId) -> Bool {
+    additionalUseLocalSavedTags(
+        account: account, serverPremium: (transaction.getPeer(account) as? TelegramUser)?.isPremium ?? false)
+}
+
+private func localTagKey(_ id: MessageId) -> String {
+    "SGALocalSavedTags:\(id.namespace):\(id.id)"
+}
+
+private func localTagAttributes(
+    _ attributes: [MessageAttribute], reactions: [MessageReaction.Reaction]
+) -> [MessageAttribute] {
+    var attributes = attributes.filter {
+        !($0 is ReactionsMessageAttribute || $0 is PendingReactionsMessageAttribute)
+    }
+    attributes.append(
+        ReactionsMessageAttribute(
+            canViewList: false, isTags: true,
+            reactions: reactions.enumerated().map {
+                MessageReaction(value: $0.element, count: 1, chosenOrder: $0.offset)
+            }, recentPeers: [], topPeers: []))
+    return attributes
+}
+
+/// Postbox keychain entries are durable and scoped to the authorized account.
+/// Keep an empty payload when clearing tags so a history refresh cannot restore them.
+func additionalApplyLocalSavedTags(
+    _ message: StoreMessage, account: PeerId, transaction: Transaction
+) -> StoreMessage {
+    guard case .Id(let id) = message.id, id.peerId == account,
+        id.namespace == Namespaces.Message.Cloud,
+        additionalUseLocalSavedTags(transaction: transaction, account: account),
+        let data = transaction.keychainEntryForKey(localTagKey(id)),
+        let reactions = try? JSONDecoder().decode([MessageReaction.Reaction].self, from: data)
+    else { return message }
+    return message.withUpdatedAttributes(localTagAttributes(message.attributes, reactions: reactions))
+}
+
+func additionalUpdateLocalSavedTags(
+    transaction: Transaction, account: PeerId, messageId: MessageId,
+    reactions: [UpdateMessageReaction], add: Bool
+) {
+    guard messageId.peerId == account, messageId.namespace == Namespaces.Message.Cloud,
+        let message = transaction.getMessage(messageId)
+    else { return }
+    let current =
+        message.effectiveReactions(isTags: true)?.filter { $0.isSelected && $0.value != .stars }.map(\.value) ?? []
+    let configuration =
+        transaction.getPreferencesEntry(key: PreferencesKeys.appConfiguration)?.get(AppConfiguration.self)
+        ?? .defaultValue
+    let limit = Int(UserLimitsConfiguration(appConfiguration: configuration, isPremium: true).maxReactionsPerMessage)
+    let selected = LocalSavedMessageTags.updated(
+        current: current, selected: reactions.map(\.reaction).filter { $0 != .stars }, add: add, limit: limit)
+    guard let data = try? JSONEncoder().encode(selected) else { return }
+    for reaction in reactions {
+        if case .custom(_, let file) = reaction, let file { transaction.storeMediaIfNotPresent(media: file) }
+    }
+    transaction.setKeychainEntry(data, forKey: localTagKey(messageId))
+    transaction.setPendingMessageAction(type: .updateReaction, id: messageId, action: nil)
+    transaction.updateMessage(messageId) { current in
+        let updated = StoreMessage(
+            id: current.id, customStableId: nil, globallyUniqueId: current.globallyUniqueId,
+            groupingKey: current.groupingKey, threadId: current.threadId, timestamp: current.timestamp,
+            flags: StoreMessageFlags(current.flags), tags: current.tags, globalTags: current.globalTags,
+            localTags: current.localTags, forwardInfo: current.forwardInfo.map(StoreMessageForwardInfo.init),
+            authorId: current.author?.id, text: current.text,
+            attributes: localTagAttributes(current.attributes, reactions: selected), media: current.media)
+        return .update(updated)
+    }
+    let previous = _internal_savedMessageTags(transaction: transaction, local: true)
+    var tags = previous?.tags.map { SavedMessageTags.Tag(reaction: $0.reaction, title: $0.title, count: 0) } ?? []
+    for tag in transaction.getMessageTagSummaryCustomTags(
+        peerId: account, threadId: nil, tagMask: [], namespace: Namespaces.Message.Cloud)
+    {
+        guard let reaction = ReactionsMessageAttribute.reactionFromMessageTag(tag: tag),
+            let summary = transaction.getMessageTagSummary(
+                peerId: account, threadId: nil, tagMask: [], namespace: Namespaces.Message.Cloud, customTag: tag),
+            summary.count > 0
+        else { continue }
+        let updated = SavedMessageTags.Tag(
+            reaction: reaction, title: previous?.tags.first(where: { $0.reaction == reaction })?.title,
+            count: Int(summary.count))
+        if let index = tags.firstIndex(where: { $0.reaction == reaction }) {
+            tags[index] = updated
+        } else {
+            tags.append(updated)
+        }
+    }
+    _internal_setSavedMessageTags(
+        transaction: transaction, savedMessageTags: SavedMessageTags(hash: 0, tags: tags), local: true)
+}
