diff --git a/Swiftgram/SGAdditionalCore/Tests/DisappearingChecks.swift b/Swiftgram/SGAdditionalCore/Tests/DisappearingChecks.swift
new file mode 100644
index 0000000000000000000000000000000000000000..5fb40944908f035a371d9fe69c4698ee796af250
--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Tests/DisappearingChecks.swift
@@ -0,0 +1,76 @@
+import Foundation
+import SQLite3
+
+enum DisappearingChecks {
+    static func run(root: URL) throws {
+        var profile = try JSONDecoder().decode(AddonProfile.self, from: Data("{\"saveDeleted\":true}".utf8))
+        CheckCore.require(!profile.saveDisappearing, "existing profiles do not silently enable disappearing capture")
+        func allowed(
+            cloud: Bool = true, timed: Bool = true, media: Bool = true, expired: Bool = false, service: Bool = false
+        ) -> Bool {
+            DisappearingMessages.shouldSave(
+                profile: profile, cloudMessage: cloud, hasTimeout: timed, hasMedia: media, expired: expired,
+                service: service)
+        }
+        CheckCore.require(!allowed(), "disappearing retention is opt in")
+        profile.saveDisappearing = true
+        CheckCore.require(allowed(), "observed timed cloud media are eligible")
+        CheckCore.require(!allowed(cloud: false), "secret chats remain excluded")
+        CheckCore.require(!allowed(expired: true), "unavailable media cannot be recovered")
+        CheckCore.require(!allowed(service: true), "service messages remain excluded")
+        CheckCore.require(!allowed(timed: false) && !allowed(media: false), "only timed media use disappearing capture")
+        profile.saveDeleted = false
+        CheckCore.require(!allowed(), "disappearing option requires deleted-message retention")
+        let encoded = try JSONEncoder().encode(profile)
+        let decoded = try JSONDecoder().decode(AddonProfile.self, from: encoded)
+        CheckCore.require(decoded.saveDisappearing, "disappearing setting round trip")
+
+        let archive = MessageArchive.shared
+        let key = MessageKey(account: "123", chat: "user:42", id: 10)
+        let otherChat = MessageKey(account: "123", chat: "channel:42", id: 10)
+        let otherAccount = MessageKey(account: "456", chat: "user:42", id: 10)
+        archive.exclude(key)
+        archive.drain()
+        CheckCore.require(
+            archive.observeDisappearing(key, resources: ["voice", "preview"]), "persist disappearing resource ownership"
+        )
+        CheckCore.require(
+            archive.hasDisappearingMedia(key) && archive.retain(key),
+            "opt-in observation can replace a previous TTL exclusion")
+        CheckCore.require(
+            !archive.hasDisappearingMedia(otherChat) && !archive.hasDisappearingMedia(otherAccount),
+            "disappearing keys include account and chat namespace")
+        CheckCore.require(
+            archive.observeDisappearing(otherChat, resources: ["voice", "photo"]), "shared resource ownership")
+        CheckCore.require(
+            archive.disappearingResourceIds(account: "123") == ["voice", "preview", "photo"],
+            "restart pin list includes all owned media")
+        CheckCore.require(archive.disappearingResourceIds(account: "456").isEmpty, "media pins are account scoped")
+        archive.forgetDisappearing([key])
+        CheckCore.require(
+            archive.disappearingResourceIds(account: "123") == ["voice", "photo"],
+            "removing a message preserves resources still owned by another message")
+        archive.forgetDisappearing([otherChat])
+        CheckCore.require(
+            archive.disappearingResourceIds(account: "123").isEmpty, "last local deletion releases resource ownership")
+
+        var db: OpaquePointer?
+        let path = root.appendingPathComponent("SwiftgramAyu/messages.sqlite3").path
+        CheckCore.require(sqlite3_open(path, &db) == SQLITE_OK, "open independent retention connection")
+        defer { sqlite3_close(db) }
+        CheckCore.require(
+            sqlite3_exec(
+                db,
+                "CREATE TRIGGER fail_disappearing BEFORE INSERT ON disappearing_media BEGIN SELECT RAISE(ABORT,'test failure'); END",
+                nil, nil, nil) == SQLITE_OK, "create retention failure fixture")
+        CheckCore.require(
+            !archive.observeDisappearing(otherAccount, resources: ["lost"]),
+            "storage failure prevents disabling host expiration")
+        CheckCore.require(
+            !archive.hasDisappearingMedia(otherAccount) && !archive.retain(otherAccount),
+            "failed capture does not become eligible")
+        CheckCore.require(
+            sqlite3_exec(db, "DROP TRIGGER fail_disappearing", nil, nil, nil) == SQLITE_OK,
+            "remove retention failure fixture")
+    }
+}
