+import Foundation
+
+public enum DisappearingMessages {
+    public static func shouldSave(
+        profile: AddonProfile, cloudMessage: Bool, hasTimeout: Bool,
+        hasMedia: Bool, expired: Bool, service: Bool
+    ) -> Bool {
+        profile.saveDeleted && profile.saveDisappearing && cloudMessage && hasTimeout
+            && hasMedia && !expired && !service
+    }
+}
