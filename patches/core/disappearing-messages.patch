+import Foundation
+import Postbox
+import SGAdditionalCore
+import SwiftSignalKit
+
+private func disappearingResources(_ media: [Media]) -> [MediaResource] {
+    media.flatMap { item -> [MediaResource] in
+        if let image = item as? TelegramMediaImage { return image.representations.map { $0.resource } }
+        if let file = item as? TelegramMediaFile {
+            return [file.resource] + file.previewRepresentations.map { $0.resource }
+        }
+        return []
+    }
+}
+
+private func withoutExpiration(_ attributes: [MessageAttribute]) -> [MessageAttribute] {
+    attributes.filter { !($0 is AutoremoveTimeoutMessageAttribute || $0 is AutoclearTimeoutMessageAttribute) }
+}
+
+/// Owns downloads and cache pins for one authorized account. Postbox owns its lifetime.
+final class AdditionalDisappearingMedia {
+    private let account: String
+    private let mediaBox: MediaBox
+    private let queue = Queue(name: "Swiftgram.DisappearingMedia")
+    private var pins: [MediaResourceId: Disposable] = [:]
+    private var downloads: [MediaResourceId: MetaDisposable] = [:]
+    private var pending: [MediaResource] = []
+
+    init(account: PeerId, mediaBox: MediaBox) {
+        self.account = additionalAccountKey(account)
+        self.mediaBox = mediaBox
+        let ids = MessageArchive.shared.disappearingResourceIds(account: self.account)
+        queue.async { [weak self] in
+            guard let self else { return }
+            for value in ids {
+                let id = MediaResourceId(value)
+                self.pins[id] = mediaBox.keepResource(id: id).start()
+            }
+        }
+    }
+
+    deinit {
+        for disposable in pins.values { disposable.dispose() }
+        for disposable in downloads.values { disposable.dispose() }
+    }
+
+    func process(_ proposed: StoreMessage, previous: Message?) -> StoreMessage {
+        guard case .Id(let id) = proposed.id, id.namespace == Namespaces.Message.Cloud,
+            let chat = additionalChatKey(id.peerId)
+        else { return proposed }
+        let key = MessageKey(account: account, chat: chat, id: Int64(id.id))
+        let profile = AddonSettings.shared.profile(account)
+        guard profile.saveDeleted && profile.saveDisappearing else { return proposed }
+        let timed = proposed.attributes.contains {
+            $0 is AutoremoveTimeoutMessageAttribute || $0 is AutoclearTimeoutMessageAttribute
+        }
+        let previouslyTimed =
+            previous?.attributes.contains {
+                $0 is AutoremoveTimeoutMessageAttribute || $0 is AutoclearTimeoutMessageAttribute
+            } ?? false
+        let expired = proposed.media.contains { $0 is TelegramMediaExpiredContent }
+        guard timed || previouslyTimed || expired else { return proposed }
+        var message = proposed
+        var restored = false
+        // A history refresh can deliver an expired placeholder after we saved the original.
+        if proposed.media.contains(where: { $0 is TelegramMediaExpiredContent }),
+            MessageArchive.shared.hasDisappearingMedia(key), let previous,
+            !disappearingResources(previous.media).isEmpty
+        {
+            message = proposed.withUpdatedMedia(previous.media)
+            restored = true
+        }
+        let resources = disappearingResources(message.media)
+        let save = DisappearingMessages.shouldSave(
+            profile: profile, cloudMessage: true, hasTimeout: timed || previouslyTimed,
+            hasMedia: !resources.isEmpty, expired: message.media.contains { $0 is TelegramMediaExpiredContent },
+            service: message.media.contains { $0 is TelegramMediaAction })
+        guard save || restored else { return message }
+        guard MessageArchive.shared.observeDisappearing(key, resources: resources.map { $0.id.stringRepresentation })
+        else { return proposed }
+        if restored { _ = MessageArchive.shared.retain(key) }
+        queue.async { [weak self] in self?.enqueue(resources) }
+        return message.withUpdatedAttributes(withoutExpiration(message.attributes))
+    }
+
+    private func enqueue(_ resources: [MediaResource]) {
+        for resource in resources {
+            if pins[resource.id] == nil { pins[resource.id] = mediaBox.keepResource(id: resource.id).start() }
+            if downloads[resource.id] == nil && !pending.contains(where: { $0.id == resource.id }) {
+                pending.append(resource)
+            }
+        }
+        startDownloads()
+    }
+
+    func deleted(_ ids: [MessageId]) {
+        let keys = ids.compactMap { id -> MessageKey? in
+            guard id.namespace == Namespaces.Message.Cloud, let chat = additionalChatKey(id.peerId) else { return nil }
+            return MessageKey(account: account, chat: chat, id: Int64(id.id))
+        }
+        MessageArchive.shared.forgetDisappearing(keys)
+        queue.async { [weak self] in
+            guard let self else { return }
+            let owned = MessageArchive.shared.disappearingResourceIds(account: self.account)
+            for id in Array(self.pins.keys) where !owned.contains(id.stringRepresentation) {
+                self.pins.removeValue(forKey: id)?.dispose()
+                self.downloads.removeValue(forKey: id)?.dispose()
+            }
+            self.pending.removeAll { !owned.contains($0.id.stringRepresentation) }
+            self.startDownloads()
+        }
+    }
+
+    private func startDownloads() {
+        while downloads.count < 4 && !pending.isEmpty {
+            let resource = pending.removeFirst()
+            let disposable = MetaDisposable()
+            downloads[resource.id] = disposable
+            let finished: () -> Void = { [weak self] in
+                guard let self else { return }
+                self.downloads.removeValue(forKey: resource.id)?.dispose()
+                self.startDownloads()
+            }
+            disposable.set(
+                (fetchedMediaResource(
+                    mediaBox: mediaBox, userLocation: .other,
+                    userContentType: .other, reference: .standalone(resource: resource))
+                    |> deliverOn(queue)).start(error: { _ in finished() }, completed: finished))
+        }
+    }
+}
+
+/// Captures media for an existing timer and removes its timestamp entries so later timers can run.
+func additionalRetainDisappearingAtExpiry(account: String?, message: Message, transaction: Transaction) -> Bool {
+    guard let account, message.id.namespace == Namespaces.Message.Cloud,
+        let chat = additionalChatKey(message.id.peerId)
+    else { return false }
+    let profile = AddonSettings.shared.profile(account)
+    let resources = disappearingResources(message.media)
+    guard
+        DisappearingMessages.shouldSave(
+            profile: profile, cloudMessage: true, hasTimeout: true,
+            hasMedia: !resources.isEmpty, expired: message.media.contains { $0 is TelegramMediaExpiredContent },
+            service: message.media.contains { $0 is TelegramMediaAction })
+    else { return false }
+    let key = MessageKey(account: account, chat: chat, id: Int64(message.id.id))
+    guard MessageArchive.shared.observeDisappearing(key, resources: resources.map { $0.id.stringRepresentation }),
+        MessageArchive.shared.retain(key)
+    else { return false }
+    transaction.updateMessage(message.id) { current in
+        let forward = current.forwardInfo.map {
+            StoreMessageForwardInfo(
+                authorId: $0.author?.id, sourceId: $0.source?.id, sourceMessageId: $0.sourceMessageId,
+                date: $0.date, authorSignature: $0.authorSignature, psaType: $0.psaType, flags: $0.flags)
+        }
+        return .update(
+            StoreMessage(
+                id: current.id, customStableId: nil, globallyUniqueId: current.globallyUniqueId,
+                groupingKey: current.groupingKey, threadId: current.threadId, timestamp: current.timestamp,
+                flags: StoreMessageFlags(current.flags), tags: current.tags, globalTags: current.globalTags,
+                localTags: current.localTags, forwardInfo: forward, authorId: current.author?.id, text: current.text,
+                attributes: withoutExpiration(current.attributes), media: current.media))
+    }
+    transaction.clearTimestampBasedAttribute(id: message.id, tag: 0)
+    transaction.clearTimestampBasedAttribute(id: message.id, tag: 1)
+    return true
+}
