diff --git a/Swiftgram/SGAdditionalCore/Tests/AdsChecks.swift b/Swiftgram/SGAdditionalCore/Tests/AdsChecks.swift
new file mode 100644
index 0000000000000000000000000000000000000000..9a88ad8af40516362c7f78bfa239e38e0b26f841
--- /dev/null
+++ b/Swiftgram/SGAdditionalCore/Tests/AdsChecks.swift
@@ -0,0 +1,57 @@
+import Foundation
+
+enum AdsChecks {
+    static func run(defaults: UserDefaults) throws {
+        CheckCore.require(!AddonProfile().blockAds, "ad blocking is opt-in")
+        let legacy = try JSONDecoder().decode(AddonProfile.self, from: Data(#"{"ghostEnabled":true,"localPremium":true}"#.utf8))
+        CheckCore.require(legacy.ghostEnabled && legacy.localPremium && !legacy.blockAds, "legacy profiles preserve settings without enabling ad blocking")
+        let empty = try JSONDecoder().decode(AddonProfile.self, from: Data("{}".utf8))
+        CheckCore.require(!empty.blockAds, "missing ad-blocking setting uses the default")
+        do {
+            _ = try JSONDecoder().decode(AddonProfile.self, from: Data(#"{"blockAds":"true"}"#.utf8))
+            fatalError("invalid ad-blocking setting accepted")
+        } catch { }
+
+        var blocked = AddonProfile()
+        blocked.blockAds = true
+        let decoded = try JSONDecoder().decode(AddonProfile.self, from: JSONEncoder().encode(blocked))
+        CheckCore.require(decoded.blockAds, "ad-blocking setting survives Codable round trip")
+
+        let settings = AddonSettings.shared
+        let originalDefault = settings.profile(nil)
+        let originalAccounts = settings.accounts().map { ($0, settings.profile($0)) }
+        defer {
+            try? settings.save(AddonProfile(), account: "99101")
+            try? settings.save(AddonProfile(), account: "99102")
+            try? settings.save(originalDefault, account: nil)
+            for (account, profile) in originalAccounts { try? settings.save(profile, account: account) }
+        }
+        for (account, _) in originalAccounts { try settings.save(AddonProfile(), account: account) }
+        try settings.save(AddonProfile(), account: nil)
+        CheckCore.require(!settings.anyEnabled(), "all addon features disabled")
+        CheckCore.require(!AdditionalAds.suppress(account: "99101"), "ads remain available when blocking is disabled")
+
+        try settings.save(blocked, account: nil)
+        CheckCore.require(AdditionalAds.suppress(account: "99101"), "ad blocking inherits the default profile")
+        CheckCore.require(settings.anyEnabled(), "ad blocking alone enables the addon")
+        CheckCore.require(!settings.anyHistoryEnabled() && !settings.anyRetentionEnabled(), "ad blocking does not enable message archiving")
+        try settings.save(AddonProfile(), account: "99102")
+        CheckCore.require(!AdditionalAds.suppress(account: "99102"), "account override can allow ads")
+
+        try settings.save(AddonProfile(), account: nil)
+        CheckCore.require(!AdditionalAds.suppress(account: "99101"), "disabling default ad blocking takes effect immediately")
+        try settings.save(blocked, account: "99101")
+        CheckCore.require(AdditionalAds.suppress(account: "99101"), "account override can block ads")
+        CheckCore.require(!AdditionalAds.suppress(account: "99102"), "ad blocking is isolated between accounts")
+        CheckCore.require(settings.anyEnabled(), "account-only ad blocking enables the addon")
+        let persisted = try JSONDecoder().decode([String: AddonProfile].self, from: defaults.data(forKey: "profiles")!)
+        CheckCore.require(persisted["99101"]?.blockAds == true && persisted["99102"]?.blockAds == false, "ad-blocking overrides are persisted independently")
+
+        blocked.ghostEnabled = true
+        blocked.ghostExceptions = ["user:42"]
+        try settings.save(blocked, account: "99101")
+        CheckCore.require(AdditionalAds.suppress(account: "99101"), "ghost-mode exceptions do not disable ad blocking")
+        try settings.save(AddonProfile(), account: "99101")
+        CheckCore.require(!AdditionalAds.suppress(account: "99101") && !settings.anyEnabled(), "disabling ad blocking restores ads without restarting")
+    }
+}
