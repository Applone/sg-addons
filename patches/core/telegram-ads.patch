@@ -0,0 +1,13 @@
+import Postbox
+import SwiftSignalKit
+import SGAdditionalCore
+
+public func additionalAdsBlocked(account: PeerId) -> Bool {
+    return AdditionalAds.suppress(account: additionalAccountKey(account))
+}
+
+public func additionalAdsBlockingChanges(account: PeerId) -> Signal<Bool, NoError> {
+    return additionalPresentationChanges()
+    |> map { additionalAdsBlocked(account: account) }
+    |> distinctUntilChanged
+}
